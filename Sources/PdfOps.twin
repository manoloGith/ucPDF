' ============================================================================'  PdfOps.twin'  Operaciones completas sobre documentos PDF sin interfaz grafica.'  Las usan el control ucPDF (metodos publicos) y la linea de comandos'  (modCommandLine). Todas reciben un PdfDocument ya abierto o rutas.''  Rangos de paginas (base 1):  "all" | "1-3,5,8-" | "-4" | "last" |'  "odd" | "even" | "3-last".  Tambien en espanol: todas, ultima, impares, pares.'  Coordenadas: en el unidades indicadas, medidas desde la esquina superior'  izquierda de la pagina tal como se ve (con giro y recorte aplicados).' ============================================================================[Description("Operaciones sobre PDF sin interfaz (texto, paginas, imagenes, impresion)")]Module PdfOps    ' ------------------------------------------------------------------------    '  Rangos de paginas    ' ------------------------------------------------------------------------    ' Convierte un rango en indices base 0 (en el orden indicado, sin repetir).    ' Devuelve cuantos hay, o -1 si el rango no es valido.    Public Function ParsePageRange(ByVal Spec As String, ByVal PageCount As Long, ByRef Idx() As Long) As Long        Dim parts() As String, k As Long, t As String, a As Long, b As Long, p As Long, n As Long, used() As Boolean, dash As Long        ParsePageRange = -1        If PageCount <= 0 Then Exit Function        ReDim used(0 To PageCount - 1)        ReDim Idx(0 To PageCount - 1)        Spec = LCase$(Trim$(Spec))        If Len(Spec) = 0 Then Spec = "all"        parts = Split(Replace$(Spec, ";", ","), ",")        For k = 0 To UBound(parts)            t = Replace$(Trim$(parts(k)), " ", "")            Select Case t                Case ""                    ' se ignora                Case "all", "todas", "*"                    AddPageRange 1, PageCount, used, Idx, n                Case "odd", "impares"                    For p = 1 To PageCount Step 2                        AddPageRange p, p, used, Idx, n                    Next                Case "even", "pares"                    For p = 2 To PageCount Step 2                        AddPageRange p, p, used, Idx, n                    Next                Case Else                    dash = InStr(1, t, "-")                    If dash = 0 Then                        a = PageNumberOf(t, PageCount)                        b = a                    Else                        If dash = 1 Then a = 1 Else a = PageNumberOf(Left$(t, dash - 1), PageCount)                        If dash = Len(t) Then b = PageCount Else b = PageNumberOf(Mid$(t, dash + 1), PageCount)                    End If                    If a < 1 Or b < 1 Or a > PageCount Or b > PageCount Then Exit Function                    AddPageRange a, b, used, Idx, n            End Select        Next        ParsePageRange = n    End Function    ' Anade las paginas a..b (base 1; admite a > b) sin repetir.    Private Sub AddPageRange(ByVal a As Long, ByVal b As Long, ByRef used() As Boolean, ByRef Idx() As Long, ByRef n As Long)        Dim p As Long, stp As Long        If a <= b Then stp = 1 Else stp = -1        For p = a To b Step stp            If Not used(p - 1) Then                used(p - 1) = True                Idx(n) = p - 1                n = n + 1            End If        Next    End Sub    Private Function PageNumberOf(ByVal t As String, ByVal PageCount As Long) As Long        Select Case t            Case "last", "ultima", "z", "end", "fin": PageNumberOf = PageCount            Case "first", "primera": PageNumberOf = 1            Case Else                If IsNumeric(t) Then PageNumberOf = CLng(Val(t)) Else PageNumberOf = -1        End Select    End Function    ' Ordena de menor a mayor (para operaciones que lo necesitan).    Public Sub SortIndices(ByRef Idx() As Long, ByVal n As Long)        Dim i As Long, j As Long, t As Long        For i = 1 To n - 1            t = Idx(i)            j = i - 1            Do While j >= 0                If Idx(j) <= t Then Exit Do                Idx(j + 1) = Idx(j)                j = j - 1            Loop            Idx(j + 1) = t        Next    End Sub    ' ------------------------------------------------------------------------    '  Archivos de texto    ' ------------------------------------------------------------------------    ' Encoding: "utf8" (con BOM, por defecto), "utf8nobom", "utf16" (con BOM)    ' o "ansi" (pagina de codigos del sistema).    Public Function WriteTextFile(ByVal Path As String, ByVal Text As String, Optional ByVal Encoding As String = "utf8") As Boolean        Dim b() As Byte, n As Long, cp As Long, bom As Long, total As Long        Select Case LCase$(Encoding)            Case "utf16", "unicode", "utf-16"                ReDim b(0 To 1 + Len(Text) * 2)                b(0) = &HFF: b(1) = &HFE                If Len(Text) > 0 Then CopyMemory b(2), ByVal StrPtr(Text), Len(Text) * 2                WriteTextFile = WriteAllBytes(Path, VarPtr(b(0)), UBound(b) + 1)                Exit Function            Case "ansi", "acp"                cp = 0            Case "utf8nobom", "utf-8-nobom"                cp = CP_UTF8            Case Else                cp = CP_UTF8                bom = 3        End Select        If Len(Text) > 0 Then n = WideCharToMultiByte(cp, 0, StrPtr(Text), Len(Text), 0, 0, 0, 0)        total = bom + n        If total = 0 Then            WriteTextFile = WriteAllBytes(Path, 0, 0)            Exit Function        End If        ReDim b(0 To total - 1)        If bom = 3 Then b(0) = &HEF: b(1) = &HBB: b(2) = &HBF        If n > 0 Then WideCharToMultiByte cp, 0, StrPtr(Text), Len(Text), VarPtr(b(bom)), n, 0, 0        WriteTextFile = WriteAllBytes(Path, VarPtr(b(0)), total)    End Function    ' ------------------------------------------------------------------------    '  Texto    ' ------------------------------------------------------------------------    ' Separator: "ff" (salto de pagina, como pdftotext), "header" (linea    ' "===== Pagina N =====" antes de cada pagina) o "none" (linea en blanco).    Public Function DocumentText(ByVal Doc As PdfDocument, ByRef Idx() As Long, ByVal n As Long, Optional ByVal Separator As String = "ff") As String        Dim k As Long, r As String, t As String        For k = 0 To n - 1            t = Doc.GetText(Idx(k))            Select Case LCase$(Separator)                Case "header", "cabecera"                    r = r & "===== " & Txt("P&aacute;gina ") & CStr(Idx(k) + 1) & " =====" & vbCrLf & t & vbCrLf                Case "none", "ninguno"                    If k > 0 Then r = r & vbCrLf & vbCrLf                    r = r & t                Case Else                    r = r & t & ChrW$(12)            End Select            Doc.ReleasePage Idx(k)        Next        DocumentText = r    End Function    ' Valor en las unidades indicadas a puntos. "%": porcentaje del lado.    Public Function ToPoints(ByVal v As Double, ByVal Units As String, ByVal SidePt As Double) As Double        Select Case LCase$(Units)            Case "mm": ToPoints = v * 72# / 25.4            Case "cm": ToPoints = v * 72# / 2.54            Case "in", "inch", "pulgadas": ToPoints = v * 72#            Case "%", "pct", "percent": ToPoints = v / 100# * SidePt            Case Else: ToPoints = v        End Select    End Function    ' Texto dentro de un rectangulo de la pagina (base 0).    Public Function TextInRect(ByVal Doc As PdfDocument, ByVal PageIndex As Long, ByVal L As Double, ByVal T As Double, ByVal R As Double, ByVal B As Double, Optional ByVal Units As String = "pt") As String        Dim w As Double, h As Double        w = Doc.PageWidth(PageIndex)        h = Doc.PageHeight(PageIndex)        TextInRect = Doc.GetTextInRect(PageIndex, ToPoints(L, Units, w), ToPoints(T, Units, h), ToPoints(R, Units, w), ToPoints(B, Units, h))    End Function    ' Lee "L,T,R,B" (tambien con ; o espacios).    Public Function ParseRect(ByVal Spec As String, ByRef L As Double, ByRef T As Double, ByRef R As Double, ByRef B As Double) As Boolean        Dim p() As String        Spec = Replace$(Replace$(Trim$(Spec), ";", ","), " ", ",")        Do While InStr(1, Spec, ",,") > 0            Spec = Replace$(Spec, ",,", ",")        Loop        p = Split(Spec, ",")        If UBound(p) <> 3 Then Exit Function        If Not (IsNumeric(p(0)) And IsNumeric(p(1)) And IsNumeric(p(2)) And IsNumeric(p(3))) Then Exit Function        L = Val(p(0)): T = Val(p(1)): R = Val(p(2)): B = Val(p(3))        ParseRect = (R > L And B > T)    End Function    ' Lee un archivo de texto: UTF-16 (BOM), UTF-8 (con o sin BOM) o ANSI.    Public Function ReadAllText(ByVal Path As String, Optional ByRef Ok As Boolean) As String        Dim h As LongPtr, n As Long, hi As Long, b() As Byte, got As Long, s As String, cch As Long, off As Long        Ok = False        h = CreateFileW(StrPtr(Path), GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)        If h = -1 Or h = 0 Then Exit Function        n = GetFileSize(h, hi)        If hi <> 0 Or n < 0 Then CloseHandle h: Exit Function        If n = 0 Then CloseHandle h: Ok = True: Exit Function        ReDim b(0 To n - 1)        If ReadFile(h, VarPtr(b(0)), n, got, 0) = 0 Or got <> n Then CloseHandle h: Exit Function        CloseHandle h        If n >= 2 And b(0) = &HFF And b(1) = &HFE Then            s = String$((n - 2) \ 2, vbNullChar)            If Len(s) > 0 Then CopyMemory ByVal StrPtr(s), b(2), Len(s) * 2        Else            If n >= 3 And b(0) = &HEF And b(1) = &HBB And b(2) = &HBF Then off = 3            ' UTF-8 estricto; si no lo es, pagina de codigos del sistema            cch = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, VarPtr(b(off)), n - off, 0, 0)            If cch > 0 Then                s = String$(cch, vbNullChar)                MultiByteToWideChar CP_UTF8, 0, VarPtr(b(off)), n - off, StrPtr(s), cch            ElseIf n - off > 0 Then                cch = MultiByteToWideChar(0, 0, VarPtr(b(off)), n - off, 0, 0)                s = String$(cch, vbNullChar)                MultiByteToWideChar 0, 0, VarPtr(b(off)), n - off, StrPtr(s), cch            End If        End If        ReadAllText = s        Ok = True    End Function    ' Numero con punto decimal y 2 decimales, sea cual sea la configuracion regional.    Public Function NumStr(ByVal v As Double) As String        NumStr = Replace$(Format$(v, "0.00"), ",", ".")    End Function    ' ------------------------------------------------------------------------    '  Zonas (rectangulos con nombre) en archivos INI    '    '    [Zonas]    '    Nombre=Pagina,Izquierda,Arriba,Derecha,Abajo    '    '  Coordenadas en puntos (1/72") desde la esquina superior izquierda de la    '  pagina tal como se ve; se usan tal cual con    '  GetTextInRect(Pagina, Izquierda, Arriba, Derecha, Abajo, "pt").    ' ------------------------------------------------------------------------    Public Function WriteAreasIni(ByVal Path As String, ByRef Names() As String, ByRef Pages() As Long, ByRef L() As Double, ByRef T() As Double, ByRef R() As Double, ByRef B() As Double, ByVal Count As Long, Optional ByVal DocumentName As String) As Boolean        Dim s As String, k As Long        s = "; Zonas de ucPDF" & vbCrLf & _            "; Valor = Pagina,Izquierda,Arriba,Derecha,Abajo  (puntos de 1/72"" desde la esquina superior izquierda)" & vbCrLf & _            "; Uso: ucPDF.GetTextInRect(Pagina, Izquierda, Arriba, Derecha, Abajo, ""pt"")" & vbCrLf & _            "[Info]" & vbCrLf & _            "Unidades=pt" & vbCrLf & _            "Origen=superior-izquierda" & vbCrLf        If Len(DocumentName) > 0 Then s = s & "Documento=" & DocumentName & vbCrLf        s = s & "Total=" & CStr(Count) & vbCrLf & vbCrLf & "[Zonas]" & vbCrLf        For k = 0 To Count - 1            s = s & Names(k) & "=" & CStr(Pages(k)) & "," & NumStr(L(k)) & "," & NumStr(T(k)) & "," & NumStr(R(k)) & "," & NumStr(B(k)) & vbCrLf        Next        ' UTF-16 con BOM: nombres con cualquier caracter y legible por GetPrivateProfileStringW        WriteAreasIni = WriteTextFile(Path, s, "utf16")    End Function    ' Lee la seccion [Zonas]. Devuelve cuantas zonas validas hay (-1 si no se pudo leer).    Public Function ReadAreasIni(ByVal Path As String, ByRef Names() As String, ByRef Pages() As Long, ByRef L() As Double, ByRef T() As Double, ByRef R() As Double, ByRef B() As Double) As Long        Dim text As String, ok As Boolean, lines() As String, k As Long, ln As String, sect As String        Dim eq As Long, key As String, v() As String, n As Long, hasSections As Boolean        text = ReadAllText(Path, ok)        If Not ok Then ReadAreasIni = -1: Exit Function        lines = Split(Replace$(Replace$(text, vbCrLf, vbLf), vbCr, vbLf), vbLf)        hasSections = (InStr(1, text, "[", vbBinaryCompare) > 0)        For k = 0 To UBound(lines)            ln = Trim$(lines(k))            If Len(ln) = 0 Then                ' vacia            ElseIf Left$(ln, 1) = ";" Or Left$(ln, 1) = "#" Then                ' comentario            ElseIf Left$(ln, 1) = "[" And Right$(ln, 1) = "]" Then                sect = LCase$(Trim$(Mid$(ln, 2, Len(ln) - 2)))            ElseIf sect = "zonas" Or sect = "areas" Or Not hasSections Then                eq = InStr(1, ln, "=")                If eq > 1 Then                    key = Trim$(Left$(ln, eq - 1))                    v = Split(Replace$(Mid$(ln, eq + 1), " ", ""), ",")                    If UBound(v) = 4 Then                        If IsNumeric(v(0)) And IsNumeric(Replace$(v(1), ".", "")) And IsNumeric(Replace$(v(2), ".", "")) And IsNumeric(Replace$(v(3), ".", "")) And IsNumeric(Replace$(v(4), ".", "")) Then                            ReDim Preserve Names(0 To n)                            ReDim Preserve Pages(0 To n)                            ReDim Preserve L(0 To n)                            ReDim Preserve T(0 To n)                            ReDim Preserve R(0 To n)                            ReDim Preserve B(0 To n)                            Names(n) = key                            Pages(n) = CLng(Val(v(0)))                            L(n) = Val(v(1)): T(n) = Val(v(2)): R(n) = Val(v(3)): B(n) = Val(v(4))                            n = n + 1                        End If                    End If                End If            End If        Next        ReadAreasIni = n    End Function    ' Texto de cada zona del INI aplicado al documento. Format: "ini"    ' (Nombre=texto en una linea) o "tab" (Nombre<TAB>Pagina<TAB>texto).    Public Function AreasText(ByVal Doc As PdfDocument, ByVal IniPath As String, Optional ByVal OutFormat As String = "ini", Optional ByRef Count As Long) As String        Dim names() As String, pages() As Long, aL() As Double, aT() As Double, aR() As Double, aB() As Double        Dim n As Long, k As Long, tx As String, out As String        Count = 0        n = ReadAreasIni(IniPath, names, pages, aL, aT, aR, aB)        If n <= 0 Then Count = n: Exit Function        For k = 0 To n - 1            If pages(k) >= 1 And pages(k) <= Doc.PageCount Then                tx = Doc.GetTextInRect(pages(k) - 1, aL(k), aT(k), aR(k), aB(k))            Else                tx = ""            End If            tx = Trim$(Replace$(Replace$(Replace$(tx, vbCrLf, " "), vbCr, " "), vbLf, " "))            If LCase$(OutFormat) = "tab" Then                out = out & names(k) & vbTab & CStr(pages(k)) & vbTab & tx & vbCrLf            Else                out = out & names(k) & "=" & tx & vbCrLf            End If            Count = Count + 1        Next        AreasText = out    End Function    ' Esquema de marcadores: una linea por marcador, sangrada dos espacios por    ' nivel, un tabulador y la pagina (base 1), "web <direccion>" o "-".    Public Function BookmarksReport(ByVal Doc As PdfDocument) As String        Dim k As Long, r As String, p As Long, dest As String        For k = 0 To Doc.BookmarkCount - 1            p = Doc.BookmarkPage(k)            If p >= 0 Then                dest = CStr(p + 1)            ElseIf Len(Doc.BookmarkUri(k)) > 0 Then                dest = "web " & Doc.BookmarkUri(k)            Else                dest = "-"            End If            r = r & Space$(2 * Doc.BookmarkLevel(k)) & Doc.BookmarkTitle(k) & vbTab & dest & vbCrLf        Next        BookmarksReport = r    End Function    ' ------------------------------------------------------------------------    '  Informacion y busqueda    ' ------------------------------------------------------------------------    Public Function DocumentInfo(ByVal Doc As PdfDocument) As String        Dim r As String, i As Long, tags As Variant, k As Long, v As String, ver As Long        ver = Doc.FileVersion        r = "Archivo: " & Doc.FileName & vbCrLf        If ver > 0 Then r = r & "Version PDF: " & CStr(ver \ 10) & "." & CStr(ver Mod 10) & vbCrLf        r = r & Txt("P&aacute;ginas: ") & CStr(Doc.PageCount) & vbCrLf        tags = Array("Title", "Author", "Subject", "Keywords", "Creator", "Producer", "CreationDate", "ModDate")        For k = 0 To UBound(tags)            v = Doc.MetaText(CStr(tags(k)))            If Len(v) > 0 Then r = r & tags(k) & ": " & v & vbCrLf        Next        For i = 0 To Doc.PageCount - 1            r = r & Txt("P&aacute;gina ") & CStr(i + 1) & ": " & Format$(Doc.PageWidth(i), "0.##") & " x " & Format$(Doc.PageHeight(i), "0.##") & " pt (" & _                Format$(Doc.PageWidth(i) / 72 * 25.4, "0.#") & " x " & Format$(Doc.PageHeight(i) / 72 * 25.4, "0.#") & " mm)" & vbCrLf        Next        DocumentInfo = r    End Function    ' Todas las coincidencias: "pagina<TAB>posicion<TAB>extracto" por linea.    Public Function SearchReport(ByVal Doc As PdfDocument, ByVal Text As String, ByVal Flags As Long, ByRef Count As Long) As String        Dim p As Long, tp As LongPtr, h As LongPtr, idx As Long, ln As Long, r As String, s0 As Long, snip As String        Count = 0        If Len(Text) = 0 Then Exit Function        For p = 0 To Doc.PageCount - 1            tp = Doc.TextPageHandle(p)            If tp <> 0 Then                h = FPDFText_FindStart(tp, StrPtr(Text), Flags, 0)                If h <> 0 Then                    Do While FPDFText_FindNext(h) <> 0                        idx = FPDFText_GetSchResultIndex(h)                        ln = FPDFText_GetSchCount(h)                        s0 = IMax(0, idx - 30)                        snip = Doc.GetText(p, s0, (idx - s0) + ln + 40)                        snip = Replace$(Replace$(Replace$(snip, vbCrLf, " "), vbCr, " "), vbLf, " ")                        r = r & CStr(p + 1) & vbTab & CStr(idx) & vbTab & snip & vbCrLf                        Count = Count + 1                    Loop                    FPDFText_FindClose h                End If            End If            Doc.ReleasePage p        Next        SearchReport = r    End Function    ' ------------------------------------------------------------------------    '  Imagenes (GDI+)    ' ------------------------------------------------------------------------    ' Exporta una pagina (base 0) como imagen. El formato sale de la extension:    ' .png, .jpg/.jpeg, .bmp, .tif/.tiff, .gif. Quality solo afecta a JPEG.    Public Function RenderPageToImage(ByVal Doc As PdfDocument, ByVal PageIndex As Long, ByVal OutFile As String, Optional ByVal Dpi As Long = 150, Optional ByVal Quality As Long = 90) As Boolean        Dim dib As PdfDib, w As Long, h As Long, bmp As LongPtr, enc As GUID, clsid As String, ext As String        Dim ep As EncoderParameters, q As Long, pEp As LongPtr        If PageIndex < 0 Or PageIndex >= Doc.PageCount Then Exit Function        If Dpi < 10 Then Dpi = 10        If Dpi > 1200 Then Dpi = 1200        ext = LCase$(Mid$(OutFile, InStrRev(OutFile, ".") + 1))        Select Case ext            Case "png": clsid = "{557CF406-1A04-11D3-9A73-0000F81EF32E}"            Case "jpg", "jpeg": clsid = "{557CF401-1A04-11D3-9A73-0000F81EF32E}"            Case "bmp": clsid = "{557CF400-1A04-11D3-9A73-0000F81EF32E}"            Case "tif", "tiff": clsid = "{557CF405-1A04-11D3-9A73-0000F81EF32E}"            Case "gif": clsid = "{557CF402-1A04-11D3-9A73-0000F81EF32E}"            Case Else: Exit Function        End Select        If CLSIDFromString(StrPtr(clsid), enc) <> 0 Then Exit Function        w = IMax(1, CLng(Doc.PageWidth(PageIndex) * Dpi / 72#))        h = IMax(1, CLng(Doc.PageHeight(PageIndex) * Dpi / 72#))        Set dib = New PdfDib        If Not dib.Create(w, h) Then Exit Function        If Not Doc.RenderTo(PageIndex, dib, 0, 0, w, h, 0, FPDF_ANNOT) Then Exit Function        Doc.ReleasePage PageIndex        If Not GdipAcquire() Then Exit Function        If GdipCreateBitmapFromScan0(w, h, dib.Stride, PixelFormat32bppRGB, dib.Bits, bmp) = GP_OK Then            If ext = "jpg" Or ext = "jpeg" Then                q = IMax(1, IMin(100, Quality))                ep.Count = 1                CLSIDFromString StrPtr("{1D5BE4B5-FA4A-452D-9CDD-5DB35105E7EB}"), ep.Parameter.ParamGuid                ep.Parameter.NumberOfValues = 1                ep.Parameter.ParamType = EncoderParameterValueTypeLong                ep.Parameter.Value = VarPtr(q)                pEp = VarPtr(ep)            End If            RenderPageToImage = (GdipSaveImageToFile(bmp, StrPtr(OutFile), enc, pEp) = GP_OK)            GdipDisposeImage bmp        End If        GdipRelease    End Function    ' Nombre de archivo para la pagina N: sustituye {n} (o anade _N).    Public Function NumberedFileName(ByVal Pattern As String, ByVal PageNumber As Long, ByVal Total As Long) As String        Dim num As String, dot As Long        num = Format$(PageNumber, String$(IMax(3, Len(CStr(Total))), "0"))        If InStr(1, Pattern, "{n}", vbTextCompare) > 0 Then            NumberedFileName = Replace$(Pattern, "{n}", num, , , vbTextCompare)        Else            dot = InStrRev(Pattern, ".")            If dot > InStrRev(Pattern, "\") Then                NumberedFileName = Left$(Pattern, dot - 1) & "_" & num & Mid$(Pattern, dot)            Else                NumberedFileName = Pattern & "_" & num            End If        End If    End Function    ' ------------------------------------------------------------------------    '  Unir y dividir    ' ------------------------------------------------------------------------    ' Une varios PDF en uno nuevo. Devuelve el numero de paginas (0 si falla).    Public Function MergeFiles(ByRef Files() As String, ByVal OutFile As String, Optional ByVal Password As String, Optional ByVal PdfiumPath As String, Optional ByRef FailedFile As String) As Long        Dim nd As LongPtr, k As Long, src As PdfDocument, outData() As Byte, total As Long        If Not PdfiumAcquire(PdfiumPath) Then Exit Function        nd = FPDF_CreateNewDocument()        If nd <> 0 Then            For k = LBound(Files) To UBound(Files)                Set src = New PdfDocument                If Not src.OpenFile(Files(k), Password, PdfiumPath) Then                    FailedFile = Files(k)                    GoTo Cleanup                End If                If FPDF_ImportPagesByIndex(nd, src.Handle, 0, 0, FPDF_GetPageCount(nd)) = 0 Then                    FailedFile = Files(k)                    GoTo Cleanup                End If                Set src = Nothing            Next            total = FPDF_GetPageCount(nd)            If PdfiumSaveToBytes(nd, outData) Then                If WriteAllBytes(OutFile, VarPtr(outData(0)), UBound(outData) + 1) Then MergeFiles = total            End If        End If    Cleanup:        Set src = Nothing        If nd <> 0 Then FPDF_CloseDocument nd        PdfiumRelease    End Function    ' Divide en archivos de Every paginas: <carpeta>\<base>_001.pdf, ...    ' Devuelve cuantos archivos se crearon.    Public Function SplitDocument(ByVal Doc As PdfDocument, ByVal OutFolder As String, ByVal BaseName As String, Optional ByVal Every As Long = 1) As Long        Dim n As Long, first As Long, k As Long, cnt As Long, idx() As Long, files As Long, total As Long        n = Doc.PageCount        If n <= 0 Then Exit Function        If Every < 1 Then Every = 1        If Right$(OutFolder, 1) = "\" Then OutFolder = Left$(OutFolder, Len(OutFolder) - 1)        If Not FolderExists(OutFolder) Then CreateDirectoryW StrPtr(OutFolder), 0        total = (n + Every - 1) \ Every        For first = 0 To n - 1 Step Every            cnt = IMin(Every, n - first)            ReDim idx(0 To cnt - 1)            For k = 0 To cnt - 1                idx(k) = first + k            Next            If Not Doc.ExtractPages(idx, cnt, OutFolder & "\" & NumberedFileName(BaseName & ".pdf", files + 1, total)) Then Exit For            files = files + 1        Next        SplitDocument = files    End Function    ' ------------------------------------------------------------------------    '  Impresion sin dialogos    ' ------------------------------------------------------------------------    ' Imprime las paginas indicadas en la impresora PrinterName (o la    ' predeterminada si se deja vacio). Ajusta, centra y gira cada pagina.    Public Function PrintPages(ByVal Doc As PdfDocument, ByRef Idx() As Long, ByVal n As Long, Optional ByVal PrinterName As String, Optional ByVal Copies As Long = 1, Optional ByVal DocumentName As String) As Boolean        Dim hdcPrn As LongPtr, di As DOCINFOW, c As Long, k As Long, p As Long, ok As Boolean, dib As PdfDib        Dim dpiX As Long, dpiY As Long, horz As Long, vert As Long, rot As Long        Dim wpt As Double, hpt As Double, s As Double, f As Double, tw As Long, th As Long, bw As Long, bh As Long        If n <= 0 Then Exit Function        If Len(PrinterName) = 0 Then PrinterName = DefaultPrinter()        If Len(PrinterName) = 0 Then Exit Function        hdcPrn = CreateDCW(StrPtr("WINSPOOL"), StrPtr(PrinterName), 0, 0)        If hdcPrn = 0 Then Exit Function        If Len(DocumentName) = 0 Then DocumentName = PathFileName(Doc.FileName)        If Len(DocumentName) = 0 Then DocumentName = "ucPDF"        di.cbSize = LenB(di)        di.lpszDocName = StrPtr(DocumentName)        If StartDocW(hdcPrn, di) <= 0 Then            DeleteDC hdcPrn            Exit Function        End If        dpiX = GetDeviceCaps(hdcPrn, LOGPIXELSX)        dpiY = GetDeviceCaps(hdcPrn, LOGPIXELSY)        horz = GetDeviceCaps(hdcPrn, HORZRES)        vert = GetDeviceCaps(hdcPrn, VERTRES)        Set dib = New PdfDib        ok = True        For c = 1 To IMax(1, Copies)            For k = 0 To n - 1                p = Idx(k)                If StartPage(hdcPrn) <= 0 Then                    ok = False                    Exit For                End If                wpt = Doc.PageWidth(p)                hpt = Doc.PageHeight(p)                rot = 0                If (wpt > hpt) <> (horz > vert) Then                    rot = 1                    s = wpt: wpt = hpt: hpt = s                End If                s = DMin(1#, DMin(horz / (wpt * dpiX / 72#), vert / (hpt * dpiY / 72#)))                tw = CLng(wpt * dpiX / 72# * s)                th = CLng(hpt * dpiY / 72# * s)                f = DMin(1#, 300# / dpiX)                bw = IMax(1, CLng(tw * f))                bh = IMax(1, CLng(th * f))                If dib.EnsureSize(bw, bh) Then                    If Doc.RenderTo(p, dib, 0, 0, bw, bh, rot, FPDF_ANNOT Or FPDF_PRINTING) Then                        SetStretchBltMode hdcPrn, HALFTONE                        SetBrushOrgEx hdcPrn, 0, 0, 0                        dib.StretchToDC hdcPrn, (horz - tw) \ 2, (vert - th) \ 2, tw, th                    End If                End If                Doc.ReleasePage p                EndPage hdcPrn            Next            If Not ok Then Exit For        Next        If ok Then EndDoc hdcPrn Else AbortDoc hdcPrn        DeleteDC hdcPrn        PrintPages = ok    End Function    Public Function DefaultPrinter() As String        Dim buf As String, n As Long        GetDefaultPrinterW 0, n        If n <= 0 Then Exit Function        buf = String$(n, vbNullChar)        If GetDefaultPrinterW(StrPtr(buf), n) <> 0 Then            n = InStr(1, buf, vbNullChar)            If n > 0 Then DefaultPrinter = Left$(buf, n - 1) Else DefaultPrinter = buf        End If    End FunctionEnd Module