' ============================================================================'  PdfDocument.twin'  Apartado 1 - Base funcional: documento PDFium con caches de paginas y texto.''  El archivo se lee completo en memoria y se abre con FPDF_LoadMemDocument,'  lo que permite rutas Unicode. El bufer se conserva mientras el documento'  esta abierto, tal como exige PDFium.' ============================================================================[Description("Documento PDF abierto con PDFium")]Class PdfDocument    Private m_Doc As LongPtr    Private m_Data() As Byte    Private m_Count As Long    Private m_W() As Double    Private m_H() As Double    Private m_Page() As LongPtr    Private m_Text() As LongPtr    Private m_LastError As Long    Private m_Acquired As Boolean    Private m_FileName As String    ' --- Apertura / cierre --------------------------------------------------    Public Function OpenFile(ByVal FileName As String, Optional ByVal Password As String, Optional ByVal PdfiumPath As String) As Boolean        Dim ff As Integer, b() As Byte, n As Long        CloseDocument        If Not FileExists(FileName) Then            m_LastError = FPDF_ERR_FILE            Exit Function        End If        On Error GoTo ReadFailed        ff = FreeFile        Open FileName For Binary Access Read Shared As #ff        n = LOF(ff)        If n > 0 Then            ReDim b(0 To n - 1)            Get #ff, , b        End If        Close #ff        On Error GoTo 0        If n = 0 Then            m_LastError = FPDF_ERR_FORMAT            Exit Function        End If        If OpenBytes(b, Password, PdfiumPath) Then            m_FileName = FileName            OpenFile = True        End If        Exit Function    ReadFailed:        If ff <> 0 Then Close #ff        m_LastError = FPDF_ERR_FILE    End Function    Public Function OpenBytes(ByRef Data() As Byte, Optional ByVal Password As String, Optional ByVal PdfiumPath As String) As Boolean        Dim pwd() As Byte, pPwd As LongPtr, i As Long, lb As Long, ub As Long        CloseDocument        If Not m_Acquired Then            m_Acquired = PdfiumAcquire(PdfiumPath)            If Not m_Acquired Then                m_LastError = FPDF_ERR_NOLIBRARY                Exit Function            End If        End If        On Error GoTo BadArray        lb = LBound(Data)        ub = UBound(Data)        On Error GoTo 0        If ub < lb Then            m_LastError = FPDF_ERR_FORMAT            Exit Function        End If        m_Data = Data        If Len(Password) > 0 Then            pwd = Utf8z(Password)            pPwd = VarPtr(pwd(0))        End If        m_Doc = FPDF_LoadMemDocument(VarPtr(m_Data(LBound(m_Data))), ub - lb + 1, pPwd)        If m_Doc = 0 Then            m_LastError = FPDF_GetLastError()            Erase m_Data            Exit Function        End If        m_Count = FPDF_GetPageCount(m_Doc)        ReDim m_W(0 To IMax(m_Count - 1, 0))        ReDim m_H(0 To IMax(m_Count - 1, 0))        ReDim m_Page(0 To IMax(m_Count - 1, 0))        ReDim m_Text(0 To IMax(m_Count - 1, 0))        For i = 0 To m_Count - 1            If FPDF_GetPageSizeByIndex(m_Doc, i, m_W(i), m_H(i)) = 0 Then                m_W(i) = 612                m_H(i) = 792            End If            If m_W(i) < 1 Then m_W(i) = 1            If m_H(i) < 1 Then m_H(i) = 1        Next        m_LastError = FPDF_ERR_SUCCESS        m_FileName = ""        OpenBytes = True        Exit Function    BadArray:        m_LastError = FPDF_ERR_FORMAT    End Function    Public Sub CloseDocument()        Dim i As Long        If m_Doc <> 0 Then            For i = 0 To m_Count - 1                ReleasePage i            Next            FPDF_CloseDocument m_Doc            m_Doc = 0        End If        m_Count = 0        m_FileName = ""        Erase m_Data        Erase m_W        Erase m_H        Erase m_Page        Erase m_Text    End Sub    ' --- Informacion --------------------------------------------------------    Public Property Get IsOpen() As Boolean        IsOpen = (m_Doc <> 0)    End Property    Public Property Get Handle() As LongPtr        Handle = m_Doc    End Property    Public Property Get PageCount() As Long        PageCount = m_Count    End Property    Public Property Get FileName() As String        FileName = m_FileName    End Property    Public Property Get LastError() As Long        LastError = m_LastError    End Property    Public Property Get LastErrorText() As String        LastErrorText = PdfiumErrorText(m_LastError)    End Property    ' Tamano de la pagina en puntos (1/72 pulgadas), sin rotacion.    Public Property Get PageWidth(ByVal Index As Long) As Double        If Index >= 0 And Index < m_Count Then PageWidth = m_W(Index)    End Property    Public Property Get PageHeight(ByVal Index As Long) As Double        If Index >= 0 And Index < m_Count Then PageHeight = m_H(Index)    End Property    ' --- Paginas (carga diferida) -------------------------------------------    Public Function PageHandle(ByVal Index As Long) As LongPtr        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        If m_Page(Index) = 0 Then m_Page(Index) = FPDF_LoadPage(m_Doc, Index)        PageHandle = m_Page(Index)    End Function    Public Function TextPageHandle(ByVal Index As Long) As LongPtr        Dim pg As LongPtr        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        If m_Text(Index) = 0 Then            pg = PageHandle(Index)            If pg <> 0 Then m_Text(Index) = FPDFText_LoadPage(pg)        End If        TextPageHandle = m_Text(Index)    End Function    Public Sub ReleasePage(ByVal Index As Long)        If Index < 0 Or Index >= m_Count Then Exit Sub        If m_Text(Index) <> 0 Then            FPDFText_ClosePage m_Text(Index)            m_Text(Index) = 0        End If        If m_Page(Index) <> 0 Then            FPDF_ClosePage m_Page(Index)            m_Page(Index) = 0        End If    End Sub    ' Libera todas las paginas cargadas fuera de los dos rangos indicados    ' (por ejemplo, paginas visibles y miniaturas visibles).    Public Sub ReleasePagesExcept(ByVal First1 As Long, ByVal Last1 As Long, Optional ByVal First2 As Long = -1, Optional ByVal Last2 As Long = -2)        Dim i As Long        For i = 0 To m_Count - 1            If m_Page(i) <> 0 Then                If Not ((i >= First1 And i <= Last1) Or (i >= First2 And i <= Last2)) Then ReleasePage i            End If        Next    End Sub    ' --- Renderizado --------------------------------------------------------    ' Renderiza la pagina sobre el DIB. StartX/StartY/SizeX/SizeY siguen la    ' convencion de FPDF_RenderPageBitmap: la pagina completa mide SizeX x SizeY    ' pixeles y su origen esta en (StartX, StartY) respecto al DIB, de modo que    ' se puede renderizar solo una porcion (mosaico) de una pagina muy ampliada.    Public Function RenderTo(ByVal Index As Long, ByVal Dib As PdfDib, ByVal StartX As Long, ByVal StartY As Long, ByVal SizeX As Long, ByVal SizeY As Long, ByVal Rotation As Long, ByVal Flags As Long) As Boolean        Dim pg As LongPtr, bmp As LongPtr        If Dib Is Nothing Then Exit Function        If Not Dib.IsValid Then Exit Function        pg = PageHandle(Index)        If pg = 0 Then Exit Function        bmp = FPDFBitmap_CreateEx(Dib.Width, Dib.Height, FPDFBitmap_BGRx, Dib.Bits, Dib.Stride)        If bmp = 0 Then Exit Function        FPDFBitmap_FillRect bmp, 0, 0, Dib.Width, Dib.Height, &HFFFFFFFF        FPDF_RenderPageBitmap bmp, pg, StartX, StartY, SizeX, SizeY, Rotation And 3, Flags        FPDFBitmap_Destroy bmp        RenderTo = True    End Function    ' --- Texto --------------------------------------------------------------    Public Function CharCount(ByVal Index As Long) As Long        Dim tp As LongPtr        tp = TextPageHandle(Index)        If tp <> 0 Then CharCount = FPDFText_CountChars(tp)    End Function    Public Function GetText(ByVal Index As Long, Optional ByVal StartChar As Long = 0, Optional ByVal Count As Long = -1) As String        Dim tp As LongPtr, n As Long, buf As String, r As Long        tp = TextPageHandle(Index)        If tp = 0 Then Exit Function        n = FPDFText_CountChars(tp)        If StartChar < 0 Then StartChar = 0        If StartChar >= n Then Exit Function        If Count < 0 Or StartChar + Count > n Then Count = n - StartChar        If Count <= 0 Then Exit Function        buf = String$(Count + 1, vbNullChar)        r = FPDFText_GetText(tp, StartChar, Count, StrPtr(buf))        If r > 1 Then GetText = Left$(buf, r - 1)    End Function    Private Sub Class_Terminate()        CloseDocument        If m_Acquired Then            PdfiumRelease            m_Acquired = False        End If    End SubEnd Class