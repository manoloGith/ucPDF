' ============================================================================'  PdfDocument.twin'  Apartado 1 - Base funcional: documento PDFium con caches de paginas y texto.''  El archivo se lee completo en memoria y se abre con FPDF_LoadMemDocument,'  lo que permite rutas Unicode. El bufer se conserva mientras el documento'  esta abierto, tal como exige PDFium.' ============================================================================[Description("Documento PDF abierto con PDFium")]Class PdfDocument    Private m_Doc As LongPtr    ' Copia del PDF en memoria nativa (HeapAlloc). PDFium la lee mientras el    ' documento esta abierto, por eso no se usa un array de VB: su direccion    ' no depende del runtime y se libera solo despues de FPDF_CloseDocument.    Private m_pData As LongPtr    Private m_Password As String         ' para reabrir instantaneas de documentos cifrados    Private m_cbData As Long    Private m_Count As Long    Private m_W() As Double    Private m_H() As Double    Private m_Page() As LongPtr    Private m_Text() As LongPtr    Private m_LastError As Long    Private m_Acquired As Boolean    Private m_FileName As String    Private m_Edited As Boolean         ' la estructura ha cambiado desde que se abrio    ' Formularios (AcroForm)    Private m_Form As LongPtr           ' FPDF_FORMHANDLE    Private m_FormInfo As LongPtr       ' FPDF_FORMFILLINFO (memoria nativa)    Private m_FormType As Long    Private m_FormDirty() As Boolean    ' paginas que PDFium ha pedido redibujar    Private m_FormAnyDirty As Boolean    Private m_FormChanged As Boolean    ' algun valor ha cambiado (FFI_OnChange)    Private m_FormHlOn As Boolean    Private m_FormHlColor As Long    Private m_FormHlAlpha As Long    Private m_EnableForms As Boolean    Private m_FieldsValid As Boolean    Private m_FldCount As Long    Private m_FldName() As String    Private m_FldType() As Long    Private m_FldFlags() As Long    Private m_FldFirst() As Long        ' primer widget del campo    Private m_FldAlt() As String    Private m_WgCount As Long    Private m_WgField() As Long    Private m_WgPage() As Long    Private m_WgIndex() As Long         ' indice de la anotacion en su pagina    Private m_WgExport() As String    ' Marcadores (arbol aplanado en orden de lectura)    Private m_BmValid As Boolean    Private m_BmCount As Long    Private m_BmTitle() As String    Private m_BmLevel() As Long    Private m_BmPage() As Long          ' base 0; -1 sin destino en el documento    Private m_BmHasY() As Boolean    Private m_BmX() As Double           ' destino en coordenadas de pagina de PDF    Private m_BmY() As Double    Private m_BmKids() As Boolean    Private m_BmOpen() As Boolean       ' abierto al abrir el documento    Private m_BmUri() As String    ' --- Apertura / cierre --------------------------------------------------    Public Function OpenFile(ByVal FileName As String, Optional ByVal Password As String, Optional ByVal PdfiumPath As String) As Boolean        Dim h As LongPtr, sizeLo As Long, sizeHi As Long, p As LongPtr, got As Long        CloseDocument        ' Lectura directa con la API (rutas Unicode, sin arrays intermedios)        h = CreateFileW(StrPtr(FileName), GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)        If h = -1 Or h = 0 Then            m_LastError = FPDF_ERR_FILE            Exit Function        End If        sizeLo = GetFileSize(h, sizeHi)        If sizeHi <> 0 Or sizeLo <= 0 Then            ' Vacio o mayor de 2 GB            CloseHandle h            m_LastError = IIf(sizeLo = 0 And sizeHi = 0, FPDF_ERR_FORMAT, FPDF_ERR_FILE)            Exit Function        End If        p = HeapAlloc(GetProcessHeap(), 0, sizeLo)        If p = 0 Then            CloseHandle h            m_LastError = FPDF_ERR_FILE            Exit Function        End If        If ReadFile(h, p, sizeLo, got, 0) = 0 Or got <> sizeLo Then            CloseHandle h            HeapFree GetProcessHeap(), 0, p            m_LastError = FPDF_ERR_FILE            Exit Function        End If        CloseHandle h        If OpenBuffer(p, sizeLo, Password, PdfiumPath) Then            m_FileName = FileName            OpenFile = True        End If    End Function    Public Function OpenBytes(ByRef Data() As Byte, Optional ByVal Password As String, Optional ByVal PdfiumPath As String) As Boolean        Dim lb As Long, ub As Long, p As LongPtr        CloseDocument        On Error GoTo BadArray        lb = LBound(Data)        ub = UBound(Data)        On Error GoTo 0        If ub < lb Then            m_LastError = FPDF_ERR_FORMAT            Exit Function        End If        p = HeapAlloc(GetProcessHeap(), 0, ub - lb + 1)        If p = 0 Then            m_LastError = FPDF_ERR_FILE            Exit Function        End If        CopyMemory ByVal p, Data(lb), ub - lb + 1        OpenBytes = OpenBuffer(p, ub - lb + 1, Password, PdfiumPath)        Exit Function    BadArray:        m_LastError = FPDF_ERR_FORMAT    End Function    ' Abre el documento sobre un bufer de HeapAlloc. El bufer pasa a ser de    ' esta clase (se libera aqui si falla, o en CloseDocument).    Private Function OpenBuffer(ByVal pData As LongPtr, ByVal cbData As Long, ByVal Password As String, ByVal PdfiumPath As String) As Boolean        Dim pwd() As Byte, pPwd As LongPtr, i As Long, n As Long, pw As Double, ph As Double        If Not m_Acquired Then            m_Acquired = PdfiumAcquire(PdfiumPath)            If Not m_Acquired Then                HeapFree GetProcessHeap(), 0, pData                m_LastError = FPDF_ERR_NOLIBRARY                Exit Function            End If        End If        m_pData = pData        m_cbData = cbData        m_Password = Password        If Len(Password) > 0 Then            pwd = Utf8z(Password)            pPwd = VarPtr(pwd(0))        End If        m_Doc = FPDF_LoadMemDocument(m_pData, m_cbData, pPwd)        If m_Doc = 0 Then            m_LastError = FPDF_GetLastError()            FreeBuffer            Exit Function        End If        ' Numero de paginas validado antes de dimensionar las matrices.        n = FPDF_GetPageCount(m_Doc)        If n <= 0 Or n > 1000000 Then            FPDF_CloseDocument m_Doc            m_Doc = 0            FreeBuffer            m_LastError = FPDF_ERR_PAGE            Exit Function        End If        m_Count = n        ReDim m_W(0 To n - 1) As Double        ReDim m_H(0 To n - 1) As Double        ReDim m_Page(0 To n - 1) As LongPtr        ReDim m_Text(0 To n - 1) As LongPtr        For i = 0 To n - 1            ' Se usan variables locales: no se pasan elementos de la matriz ByRef a la DLL.            pw = 0            ph = 0            If FPDF_GetPageSizeByIndex(m_Doc, i, pw, ph) = 0 Then                pw = 612                ph = 792            End If            If pw < 1 Then pw = 1            If ph < 1 Then ph = 1            m_W(i) = pw            m_H(i) = ph        Next        ReDim m_FormDirty(0 To n - 1) As Boolean        InitForms        m_LastError = FPDF_ERR_SUCCESS        m_FileName = ""        OpenBuffer = True    End Function    Private Sub FreeBuffer()        If m_pData <> 0 Then HeapFree GetProcessHeap(), 0, m_pData        m_pData = 0        m_cbData = 0    End Sub    Public Sub CloseDocument()        Dim i As Long        If m_Doc <> 0 Then            For i = 0 To m_Count - 1                ReleasePage i            Next            ExitForms            FPDF_CloseDocument m_Doc            m_Doc = 0        End If        m_Count = 0        m_FileName = ""        m_Edited = False        ' Despues de FPDF_CloseDocument: PDFium ya no lee el bufer        FreeBuffer        Erase m_W        Erase m_H        Erase m_Page        Erase m_Text        Erase m_FormDirty        m_BmValid = False        m_BmCount = 0        m_FormAnyDirty = False        m_FormChanged = False        InvalidateFields    End Sub    ' Guarda una copia exacta del PDF abierto (los bytes originales que se    ' mantienen en memoria), por lo que tambien puede sobrescribir el archivo    ' del que se abrio. Admite rutas Unicode.    Public Function SaveCopy(ByVal FileName As String) As Boolean        Dim outData() As Byte        If m_Doc = 0 Or Len(FileName) = 0 Then Exit Function        CommitForm        ' Con cambios (paginas reordenadas o campos rellenados) PDFium genera un PDF nuevo.        If m_Edited Then            If Not PdfiumSaveToBytes(m_Doc, outData) Then Exit Function            SaveCopy = WriteAllBytes(FileName, VarPtr(outData(0)), UBound(outData) + 1)            If SaveCopy Then m_FileName = FileName            Exit Function        End If        If m_pData = 0 Or m_cbData <= 0 Then Exit Function        SaveCopy = WriteAllBytes(FileName, m_pData, m_cbData)        If SaveCopy Then m_FileName = FileName    End Function    ' Mueve una pagina (base 0) para que quede en la posicion ToIndex.    ' Las paginas cargadas se liberan antes: sus indices cambian.    Public Function MovePage(ByVal FromIndex As Long, ByVal ToIndex As Long) As Boolean        Dim idx(0 To 0) As Long, i As Long, w As Double, h As Double, tw As Double, th As Double        If m_Doc = 0 Then Exit Function        If FromIndex < 0 Or FromIndex >= m_Count Or ToIndex < 0 Or ToIndex >= m_Count Then Exit Function        If FromIndex = ToIndex Then            MovePage = True            Exit Function        End If        For i = 0 To m_Count - 1            ReleasePage i        Next        idx(0) = FromIndex        On Error GoTo NotSupported        If FPDF_MovePages(m_Doc, VarPtr(idx(0)), 1, ToIndex) = 0 Then Exit Function        On Error GoTo 0        ' Reordenar tambien la cache de tamanos        tw = m_W(FromIndex)        th = m_H(FromIndex)        If FromIndex < ToIndex Then            For i = FromIndex To ToIndex - 1                m_W(i) = m_W(i + 1)                m_H(i) = m_H(i + 1)            Next        Else            For i = FromIndex To ToIndex + 1 Step -1                m_W(i) = m_W(i - 1)                m_H(i) = m_H(i - 1)            Next        End If        m_W(ToIndex) = tw        m_H(ToIndex) = th        InvalidateFields        m_BmValid = False        m_Edited = True        MovePage = True        Exit Function    NotSupported:        ' pdfium.dll antigua sin FPDF_MovePages        m_LastError = FPDF_ERR_UNKNOWN    End Function    ' Vuelve a leer el numero de paginas y sus tamanos tras editar la estructura.    Public Sub RefreshStructure()        Dim i As Long, n As Long, pw As Double, ph As Double        If m_Doc = 0 Then Exit Sub        For i = 0 To m_Count - 1            ReleasePage i        Next        n = FPDF_GetPageCount(m_Doc)        If n < 0 Then n = 0        m_Count = n        ReDim m_W(0 To IMax(n - 1, 0)) As Double        ReDim m_H(0 To IMax(n - 1, 0)) As Double        ReDim m_Page(0 To IMax(n - 1, 0)) As LongPtr        ReDim m_Text(0 To IMax(n - 1, 0)) As LongPtr        ReDim m_FormDirty(0 To IMax(n - 1, 0)) As Boolean        InvalidateFields        m_BmValid = False        For i = 0 To n - 1            pw = 0            ph = 0            If FPDF_GetPageSizeByIndex(m_Doc, i, pw, ph) = 0 Then                pw = 612                ph = 792            End If            m_W(i) = DMax(1, pw)            m_H(i) = DMax(1, ph)        Next    End Sub    Private Sub ReleaseAll()        Dim i As Long        For i = 0 To m_Count - 1            ReleasePage i        Next    End Sub    ' Gira las paginas indicadas (base 0) en pasos de 90 grados (+1 = derecha).    Public Function RotatePages(ByRef Indices() As Long, ByVal Count As Long, ByVal Delta As Long) As Boolean        Dim k As Long, pg As LongPtr        If m_Doc = 0 Or Count <= 0 Then Exit Function        ReleaseAll        For k = 0 To Count - 1            pg = FPDF_LoadPage(m_Doc, Indices(k))            If pg <> 0 Then                FPDFPage_SetRotation pg, (FPDFPage_GetRotation(pg) + Delta + 4) Mod 4                FPDF_ClosePage pg            End If        Next        m_Edited = True        RefreshStructure        RotatePages = True    End Function    ' Elimina las paginas indicadas (siempre debe quedar al menos una).    Public Function DeletePages(ByRef Indices() As Long, ByVal Count As Long) As Boolean        Dim k As Long        If m_Doc = 0 Or Count <= 0 Or Count >= m_Count Then Exit Function        ReleaseAll        ' De mayor a menor para no alterar los indices pendientes        For k = Count - 1 To 0 Step -1            FPDFPage_Delete m_Doc, Indices(k)        Next        m_Edited = True        RefreshStructure        DeletePages = True    End Function    ' Inserta una pagina en blanco de Width x Height puntos en la posicion Index.    Public Function InsertBlankPage(ByVal Index As Long, ByVal Width As Double, ByVal Height As Double) As Boolean        Dim pg As LongPtr        If m_Doc = 0 Then Exit Function        ReleaseAll        pg = FPDFPage_New(m_Doc, Index, Width, Height)        If pg = 0 Then Exit Function        FPDF_ClosePage pg        m_Edited = True        RefreshStructure        InsertBlankPage = True    End Function    ' Inserta todas las paginas de Source en la posicion Index. Devuelve cuantas.    Public Function ImportAllPages(ByVal Source As PdfDocument, ByVal Index As Long) As Long        Dim before As Long        If m_Doc = 0 Or Source Is Nothing Then Exit Function        If Not Source.IsOpen Then Exit Function        ReleaseAll        before = FPDF_GetPageCount(m_Doc)        If FPDF_ImportPagesByIndex(m_Doc, Source.Handle, 0, 0, Index) = 0 Then Exit Function        m_Edited = True        RefreshStructure        ImportAllPages = m_Count - before    End Function    ' Sustituye las paginas indicadas por las primeras paginas de Source    ' (la k-esima seleccionada por la pagina k del archivo). Devuelve cuantas.    Public Function ReplacePages(ByRef Indices() As Long, ByVal Count As Long, ByVal Source As PdfDocument) As Long        Dim k As Long, n As Long, srcIdx(0 To 0) As Long        If m_Doc = 0 Or Source Is Nothing Or Count <= 0 Then Exit Function        If Not Source.IsOpen Then Exit Function        n = IMin(Count, Source.PageCount)        ReleaseAll        For k = 0 To n - 1            srcIdx(0) = k            If FPDF_ImportPagesByIndex(m_Doc, Source.Handle, VarPtr(srcIdx(0)), 1, Indices(k)) <> 0 Then                FPDFPage_Delete m_Doc, Indices(k) + 1                ReplacePages = ReplacePages + 1            End If        Next        If ReplacePages > 0 Then m_Edited = True        RefreshStructure    End Function    ' Guarda las paginas indicadas en un PDF nuevo (el documento no cambia).    Public Function ExtractPages(ByRef Indices() As Long, ByVal Count As Long, ByVal FileName As String) As Boolean        Dim nd As LongPtr, outData() As Byte        If m_Doc = 0 Or Count <= 0 Then Exit Function        nd = FPDF_CreateNewDocument()        If nd = 0 Then Exit Function        If FPDF_ImportPagesByIndex(nd, m_Doc, VarPtr(Indices(0)), Count, 0) <> 0 Then            If PdfiumSaveToBytes(nd, outData) Then                ExtractPages = WriteAllBytes(FileName, VarPtr(outData(0)), UBound(outData) + 1)            End If        End If        FPDF_CloseDocument nd    End Function    ' Caja del contenido visible de la pagina como fracciones (0..1) de la    ' pagina mostrada (izquierda, arriba, derecha, abajo; arriba = 0).    ' False si la pagina esta en blanco.    Public Function ContentBounds(ByVal Index As Long, ByRef fl As Double, ByRef ft As Double, ByRef fr As Double, ByRef fb As Double) As Boolean        Dim dib As PdfDib, bw As Long, bh As Long, s As Double, px() As Long, v As Long        Dim x As Long, y As Long, x0 As Long, y0 As Long, x1 As Long, y1 As Long, found As Boolean        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        s = DMin(1.5, 1000# / DMax(m_W(Index), m_H(Index)))        bw = IMax(1, CLng(m_W(Index) * s))        bh = IMax(1, CLng(m_H(Index) * s))        Set dib = New PdfDib        If Not dib.Create(bw, bh) Then Exit Function        If Not RenderTo(Index, dib, 0, 0, bw, bh, 0, FPDF_ANNOT Or FPDF_PRINTING) Then Exit Function        ReDim px(0 To bw * bh - 1)        CopyMemory px(0), ByVal dib.Bits, CLngPtr(bw) * bh * 4        x0 = bw: y0 = bh: x1 = -1: y1 = -1        For y = 0 To bh - 1            For x = 0 To bw - 1                v = px(y * bw + x)                ' contenido = algun canal claramente no blanco                If (v And &HFF&) < 240 Or ((v And &HFF00&) \ &H100&) < 240 Or ((v And &HFF0000) \ &H10000) < 240 Then                    If x < x0 Then x0 = x                    If x > x1 Then x1 = x                    If y < y0 Then y0 = y                    y1 = y                    found = True                End If            Next        Next        If Not found Then Exit Function        fl = x0 / bw        ft = y0 / bh        fr = (x1 + 1) / bw        fb = (y1 + 1) / bh        ContentBounds = True    End Function    ' Recorta la pagina al rectangulo dado en fracciones (0..1) de la pagina    ' mostrada, con el origen arriba a la izquierda. Tiene en cuenta el giro y    ' cualquier recorte anterior (se convierte con FPDF_DeviceToPage).    Public Function CropPageFraction(ByVal Index As Long, ByVal fl As Double, ByVal ft As Double, ByVal fr As Double, ByVal fb As Double) As Boolean        Dim pg As LongPtr, bw As Long, bh As Long, ax As Double, ay As Double, bx As Double, by As Double        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        fl = DMax(0, DMin(1, fl)): fr = DMax(0, DMin(1, fr))        ft = DMax(0, DMin(1, ft)): fb = DMax(0, DMin(1, fb))        If fr - fl < 0.01 Or fb - ft < 0.01 Then Exit Function        pg = PageHandle(Index)        If pg = 0 Then Exit Function        ' Dispositivo virtual de 10000 unidades de ancho: precision de sobra        bw = 10000        bh = IMax(1, CLng(10000# * m_H(Index) / m_W(Index)))        If FPDF_DeviceToPage(pg, 0, 0, bw, bh, 0, CLng(fl * bw), CLng(ft * bh), ax, ay) = 0 Then Exit Function        If FPDF_DeviceToPage(pg, 0, 0, bw, bh, 0, CLng(fr * bw), CLng(fb * bh), bx, by) = 0 Then Exit Function        FPDFPage_SetCropBox pg, CSng(DMin(ax, bx)), CSng(DMin(ay, by)), CSng(DMax(ax, bx)), CSng(DMax(ay, by))        ReleasePage Index        m_Edited = True        CropPageFraction = True    End Function    ' Recorte automatico: contenido + MarginPt puntos de margen.    Public Function CropToContent(ByVal Index As Long, Optional ByVal MarginPt As Double = 8) As Boolean        Dim fl As Double, ft As Double, fr As Double, fb As Double, mx As Double, my As Double        If Not ContentBounds(Index, fl, ft, fr, fb) Then Exit Function        mx = MarginPt / m_W(Index)        my = MarginPt / m_H(Index)        CropToContent = CropPageFraction(Index, fl - mx, ft - my, fr + mx, fb + my)    End Function    ' --- Texto por coordenadas y metadatos -----------------------------------    ' Convierte un rectangulo en puntos medido desde la esquina superior    ' izquierda de la pagina mostrada (como lo ve el usuario, con giro y    ' recorte) a coordenadas de pagina de PDF (origen abajo a la izquierda).    Public Function TopLeftRectToPage(ByVal Index As Long, ByVal L As Double, ByVal T As Double, ByVal R As Double, ByVal B As Double, ByRef pl As Double, ByRef pt As Double, ByRef pr As Double, ByRef pb As Double) As Boolean        Dim pg As LongPtr, bw As Long, bh As Long, ax As Double, ay As Double, bx As Double, by As Double        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        pg = PageHandle(Index)        If pg = 0 Then Exit Function        ' Dispositivo virtual de 10 unidades por punto        bw = IMax(1, CLng(m_W(Index) * 10))        bh = IMax(1, CLng(m_H(Index) * 10))        If FPDF_DeviceToPage(pg, 0, 0, bw, bh, 0, CLng(L * 10), CLng(T * 10), ax, ay) = 0 Then Exit Function        If FPDF_DeviceToPage(pg, 0, 0, bw, bh, 0, CLng(R * 10), CLng(B * 10), bx, by) = 0 Then Exit Function        pl = DMin(ax, bx): pr = DMax(ax, bx)        pb = DMin(ay, by): pt = DMax(ay, by)        TopLeftRectToPage = True    End Function    ' Texto contenido en un rectangulo (puntos desde arriba a la izquierda).    Public Function GetTextInRect(ByVal Index As Long, ByVal L As Double, ByVal T As Double, ByVal R As Double, ByVal B As Double) As String        Dim tp As LongPtr, pl As Double, pt As Double, pr As Double, pb As Double, n As Long, buf As String        If Not TopLeftRectToPage(Index, L, T, R, B, pl, pt, pr, pb) Then Exit Function        tp = TextPageHandle(Index)        If tp = 0 Then Exit Function        n = FPDFText_GetBoundedText(tp, pl, pt, pr, pb, 0, 0)        If n <= 0 Then Exit Function        buf = String$(n + 1, vbNullChar)        FPDFText_GetBoundedText tp, pl, pt, pr, pb, StrPtr(buf), n + 1        GetTextInRect = Left$(buf, n)    End Function    ' Metadato del documento: Title, Author, Subject, Keywords, Creator,    ' Producer, CreationDate, ModDate.    Public Function MetaText(ByVal Tag As String) As String        Dim t() As Byte, i As Long, n As Long, buf() As Byte, s As String        If m_Doc = 0 Or Len(Tag) = 0 Then Exit Function        ReDim t(0 To Len(Tag))        For i = 1 To Len(Tag)            t(i - 1) = AscW(Mid$(Tag, i, 1)) And &HFF        Next        n = FPDF_GetMetaText(m_Doc, VarPtr(t(0)), 0, 0)        If n <= 2 Then Exit Function        ReDim buf(0 To n - 1)        FPDF_GetMetaText m_Doc, VarPtr(t(0)), VarPtr(buf(0)), n        s = String$((n - 2) \ 2, vbNullChar)        CopyMemory ByVal StrPtr(s), buf(0), n - 2        MetaText = s    End Function    ' Version del formato (14 = PDF 1.4). 0 si no se conoce.    Public Property Get FileVersion() As Long        Dim v As Long        If m_Doc = 0 Then Exit Property        If FPDF_GetFileVersion(m_Doc, v) <> 0 Then FileVersion = v    End Property    ' --- Instantaneas para deshacer / rehacer ---------------------------------    ' Escribe el estado actual completo en un archivo (no cambia FileName).    Public Function SaveSnapshot(ByVal FileName As String) As Boolean        Dim outData() As Byte        If m_Doc = 0 Then Exit Function        ' Sin CommitForm: el campo con el foco lo conserva (Tab entre campos)        If m_Edited Then            If Not PdfiumSaveToBytes(m_Doc, outData) Then Exit Function            SaveSnapshot = WriteAllBytes(FileName, VarPtr(outData(0)), UBound(outData) + 1)        ElseIf m_pData <> 0 And m_cbData > 0 Then            SaveSnapshot = WriteAllBytes(FileName, m_pData, m_cbData)        End If    End Function    ' Sustituye el documento por una instantanea, conservando FileName.    Public Function LoadSnapshot(ByVal FileName As String) As Boolean        Dim fn As String, pwd As String        fn = m_FileName        pwd = m_Password        If Not OpenFile(FileName, pwd) Then Exit Function        m_FileName = fn        m_Edited = True        LoadSnapshot = True    End Function    Public Property Get Edited() As Boolean        Edited = m_Edited    End Property    ' --- Informacion --------------------------------------------------------    Public Property Get IsOpen() As Boolean        IsOpen = (m_Doc <> 0)    End Property    Public Property Get Handle() As LongPtr        Handle = m_Doc    End Property    Public Property Get PageCount() As Long        PageCount = m_Count    End Property    Public Property Get FileName() As String        FileName = m_FileName    End Property    Public Property Get LastError() As Long        LastError = m_LastError    End Property    Public Property Get LastErrorText() As String        LastErrorText = PdfiumErrorText(m_LastError)    End Property    ' Tamano de la pagina en puntos (1/72 pulgadas), sin rotacion.    Public Property Get PageWidth(ByVal Index As Long) As Double        If Index >= 0 And Index < m_Count Then PageWidth = m_W(Index)    End Property    Public Property Get PageHeight(ByVal Index As Long) As Double        If Index >= 0 And Index < m_Count Then PageHeight = m_H(Index)    End Property    ' --- Paginas (carga diferida) -------------------------------------------    Public Function PageHandle(ByVal Index As Long) As LongPtr        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        If m_Page(Index) = 0 Then            m_Page(Index) = FPDF_LoadPage(m_Doc, Index)            If m_Page(Index) <> 0 And m_Form <> 0 Then FORM_OnAfterLoadPage m_Page(Index), m_Form        End If        PageHandle = m_Page(Index)    End Function    Public Function TextPageHandle(ByVal Index As Long) As LongPtr        Dim pg As LongPtr        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        If m_Text(Index) = 0 Then            pg = PageHandle(Index)            If pg <> 0 Then m_Text(Index) = FPDFText_LoadPage(pg)        End If        TextPageHandle = m_Text(Index)    End Function    Public Sub ReleasePage(ByVal Index As Long)        If Index < 0 Or Index >= m_Count Then Exit Sub        If m_Text(Index) <> 0 Then            FPDFText_ClosePage m_Text(Index)            m_Text(Index) = 0        End If        If m_Page(Index) <> 0 Then            If m_Form <> 0 Then                ' El campo que se esta editando se confirma antes: al cerrar la                ' pagina con el foco dentro, PDFium descarta lo escrito                If FormFocusPage() = Index Then FORM_ForceToKillFocus m_Form                FORM_OnBeforeClosePage m_Page(Index), m_Form            End If            FPDF_ClosePage m_Page(Index)            m_Page(Index) = 0        End If    End Sub    ' Libera todas las paginas cargadas fuera de los dos rangos indicados    ' (por ejemplo, paginas visibles y miniaturas visibles).    Public Sub ReleasePagesExcept(ByVal First1 As Long, ByVal Last1 As Long, Optional ByVal First2 As Long = -1, Optional ByVal Last2 As Long = -2)        Dim i As Long        For i = 0 To m_Count - 1            If m_Page(i) <> 0 Then                If Not ((i >= First1 And i <= Last1) Or (i >= First2 And i <= Last2)) Then ReleasePage i            End If        Next    End Sub    ' --- Marcadores ----------------------------------------------------------------    ' El arbol se lee una vez y se guarda aplanado (padre antes que sus hijos,    ' con su nivel). Se limita la profundidad y el total por si el esquema    ' esta danado y tiene ciclos.    Private Const BM_MAX As Long = 20000    Private Const BM_MAXDEPTH As Long = 64    Private Sub EnsureBookmarks()        If m_BmValid Then Exit Sub        m_BmValid = True        m_BmCount = 0        If m_Doc = 0 Then Exit Sub        On Error GoTo NoApi        ReadBookmarkLevel 0, 0        Exit Sub    NoApi:        ' pdfium.dll sin la API de marcadores    End Sub    Private Sub ReadBookmarkLevel(ByVal Parent As LongPtr, ByVal Level As Long)        Dim bm As LongPtr, k As Long, n As Long, buf() As Byte, t As String, dest As LongPtr, act As LongPtr        Dim hx As Long, hy As Long, hz As Long, x As Single, y As Single, z As Single, cnt As Long        If Level > BM_MAXDEPTH Then Exit Sub        bm = FPDFBookmark_GetFirstChild(m_Doc, Parent)        Do While bm <> 0 And m_BmCount < BM_MAX            k = m_BmCount            m_BmCount = m_BmCount + 1            ReDim Preserve m_BmTitle(0 To k): ReDim Preserve m_BmLevel(0 To k): ReDim Preserve m_BmPage(0 To k)            ReDim Preserve m_BmHasY(0 To k): ReDim Preserve m_BmX(0 To k): ReDim Preserve m_BmY(0 To k)            ReDim Preserve m_BmKids(0 To k): ReDim Preserve m_BmOpen(0 To k): ReDim Preserve m_BmUri(0 To k)            ' Titulo            t = ""            n = FPDFBookmark_GetTitle(bm, 0, 0)            If n > 2 Then                ReDim buf(0 To n - 1)                FPDFBookmark_GetTitle bm, VarPtr(buf(0)), n                t = String$((n - 2) \ 2, vbNullChar)                CopyMemory ByVal StrPtr(t), buf(0), n - 2            End If            m_BmTitle(k) = Replace$(Replace$(Replace$(t, vbCrLf, " "), vbCr, " "), vbLf, " ")            m_BmLevel(k) = Level            m_BmPage(k) = -1            ' Destino: directo o por una accion GoTo; enlaces web por una accion URI            dest = FPDFBookmark_GetDest(m_Doc, bm)            act = FPDFBookmark_GetAction(bm)            If dest = 0 And act <> 0 Then                Select Case FPDFAction_GetType(act)                    Case PDFACTION_GOTO: dest = FPDFAction_GetDest(m_Doc, act)                    Case PDFACTION_URI: m_BmUri(k) = ActionUri(act)                End Select            End If            If dest <> 0 Then                m_BmPage(k) = FPDFDest_GetDestPageIndex(m_Doc, dest)                If m_BmPage(k) >= m_Count Then m_BmPage(k) = -1                hx = 0: hy = 0: hz = 0                If FPDFDest_GetLocationInPage(dest, hx, hy, hz, x, y, z) <> 0 Then                    If hy <> 0 Then                        m_BmHasY(k) = True                        m_BmY(k) = y                        If hx <> 0 Then m_BmX(k) = x                    End If                End If            End If            ' Hijos (el signo de GetCount indica si el nodo esta abierto)            m_BmKids(k) = (FPDFBookmark_GetFirstChild(m_Doc, bm) <> 0)            m_BmOpen(k) = False            If m_BmKids(k) Then                cnt = 1                On Error Resume Next                cnt = FPDFBookmark_GetCount(bm)                On Error GoTo 0                m_BmOpen(k) = (cnt > 0)                ReadBookmarkLevel bm, Level + 1            End If            bm = FPDFBookmark_GetNextSibling(m_Doc, bm)        Loop    End Sub    Private Function ActionUri(ByVal act As LongPtr) As String        Dim n As Long, buf() As Byte, i As Long, t As String        n = FPDFAction_GetURIPath(m_Doc, act, 0, 0)        If n <= 1 Then Exit Function        ReDim buf(0 To n - 1)        FPDFAction_GetURIPath m_Doc, act, VarPtr(buf(0)), n        For i = 0 To n - 2            t = t & ChrW$(buf(i))        Next        ActionUri = t    End Function    Public Property Get BookmarkCount() As Long        EnsureBookmarks        BookmarkCount = m_BmCount    End Property    Private Function ValidBookmark(ByVal Index As Long) As Boolean        EnsureBookmarks        ValidBookmark = (Index >= 0 And Index < m_BmCount)    End Function    Public Property Get BookmarkTitle(ByVal Index As Long) As String        If ValidBookmark(Index) Then BookmarkTitle = m_BmTitle(Index)    End Property    ' 0 = nivel superior    Public Property Get BookmarkLevel(ByVal Index As Long) As Long        If ValidBookmark(Index) Then BookmarkLevel = m_BmLevel(Index)    End Property    ' Pagina de destino (base 0) o -1 (sin destino, o enlace web).    Public Property Get BookmarkPage(ByVal Index As Long) As Long        BookmarkPage = -1        If ValidBookmark(Index) Then BookmarkPage = m_BmPage(Index)    End Property    Public Property Get BookmarkHasChildren(ByVal Index As Long) As Boolean        If ValidBookmark(Index) Then BookmarkHasChildren = m_BmKids(Index)    End Property    ' True si el documento lo guarda desplegado.    Public Property Get BookmarkInitiallyOpen(ByVal Index As Long) As Boolean        If ValidBookmark(Index) Then BookmarkInitiallyOpen = m_BmOpen(Index)    End Property    ' Direccion web de un marcador con accion URI ("" si no la tiene).    Public Property Get BookmarkUri(ByVal Index As Long) As String        If ValidBookmark(Index) Then BookmarkUri = m_BmUri(Index)    End Property    ' Posicion de destino en coordenadas de pagina de PDF (origen abajo).    ' False si el destino es solo la pagina.    Public Function BookmarkTarget(ByVal Index As Long, ByRef PdfX As Double, ByRef PdfY As Double) As Boolean        If Not ValidBookmark(Index) Then Exit Function        If Not m_BmHasY(Index) Then Exit Function        PdfX = m_BmX(Index)        PdfY = m_BmY(Index)        BookmarkTarget = True    End Function    ' Posicion de destino en puntos desde la esquina superior izquierda de la    ' pagina mostrada (como GetTextInRect). False si el destino es solo la pagina.    Public Function BookmarkTopPt(ByVal Index As Long, ByRef TopPt As Double) As Boolean        Dim pg As LongPtr, dx As Long, dy As Long, p As Long        If Not ValidBookmark(Index) Then Exit Function        p = m_BmPage(Index)        If p < 0 Or Not m_BmHasY(Index) Then Exit Function        pg = PageHandle(p)        If pg = 0 Then Exit Function        ' Dispositivo virtual de 10 unidades por punto        If FPDF_PageToDevice(pg, 0, 0, IMax(1, CLng(m_W(p) * 10)), IMax(1, CLng(m_H(p) * 10)), 0, m_BmX(Index), m_BmY(Index), dx, dy) = 0 Then Exit Function        TopPt = DMax(0, DMin(m_H(p), dy / 10#))        BookmarkTopPt = True    End Function    ' --- Formularios (AcroForm) ------------------------------------------------    ' Con un formulario se crea el entorno de PDFium al abrir: sin el, PDFium no    ' dibuja los campos. Los valores se leen y escriben con la propia logica de    ' PDFium (foco + reemplazar texto, clic en casillas, seleccionar opciones),    ' que regenera la apariencia de cada campo y se guarda con SaveCopy.    ' Activar antes de abrir (por defecto True). Sin formularios no se dibujan los campos.    Public Property Get EnableForms() As Boolean        EnableForms = m_EnableForms    End Property    Public Property Let EnableForms(ByVal Value As Boolean)        m_EnableForms = Value    End Property    Private Sub InitForms()        m_FormType = 0        If m_Doc = 0 Or Not m_EnableForms Then Exit Sub        On Error GoTo NoForms        m_FormType = FPDF_GetFormType(m_Doc)        If m_FormType <> FORMTYPE_ACRO_FORM Then Exit Sub        m_FormInfo = PdfFormInfoCreate(ObjPtr(Me))        If m_FormInfo = 0 Then Exit Sub        m_Form = FPDFDOC_InitFormFillEnvironment(m_Doc, m_FormInfo)        If m_Form = 0 Then            PdfFormInfoFree m_FormInfo            m_FormInfo = 0            Exit Sub        End If        ApplyHighlight        Exit Sub    NoForms:        ' pdfium.dll sin la API de formularios: se ve igual que antes        m_Form = 0    End Sub    Private Sub ExitForms()        If m_Form <> 0 Then            ' Sin propietario: lo que PDFium notifique al cerrar se ignora            PdfFormInfoDetach m_FormInfo            FPDFDOC_ExitFormFillEnvironment m_Form            m_Form = 0        End If        If m_FormInfo <> 0 Then            PdfFormInfoFree m_FormInfo            m_FormInfo = 0        End If        InvalidateFields    End Sub    Private Sub ApplyHighlight()        If m_Form = 0 Then Exit Sub        FPDF_SetFormFieldHighlightColor m_Form, 0, m_FormHlColor        If m_FormHlOn Then FPDF_SetFormFieldHighlightAlpha m_Form, m_FormHlAlpha Else FPDF_SetFormFieldHighlightAlpha m_Form, 0    End Sub    ' Resaltado de los campos en pantalla (no se imprime). Color COLORREF, Alpha 0..255.    Public Sub SetFormHighlight(ByVal Enabled As Boolean, Optional ByVal Color As Long = -1, Optional ByVal Alpha As Long = -1)        m_FormHlOn = Enabled        If Color >= 0 Then m_FormHlColor = Color And &HFFFFFF        If Alpha >= 0 Then m_FormHlAlpha = Alpha And &HFF        ApplyHighlight    End Sub    ' True si el documento tiene un formulario AcroForm activo.    Public Property Get HasForm() As Boolean        HasForm = (m_Form <> 0)    End Property    ' 0 ninguno, 1 AcroForm, 2/3 XFA (no soportado: se muestra la version estatica)    Public Property Get FormType() As Long        FormType = m_FormType    End Property    Public Property Get FormHandle() As LongPtr        FormHandle = m_Form    End Property    ' Confirma el campo que se esta editando (como pulsar fuera de el).    Public Sub CommitForm()        If m_Form <> 0 Then FORM_ForceToKillFocus m_Form    End Sub    ' --- Notificaciones de PDFium (desde los callbacks de PdfiumApi) ---    Friend Sub zFormInvalidate(ByVal Page As LongPtr)        Dim i As Long        If Page = 0 Then Exit Sub        For i = 0 To m_Count - 1            If m_Page(i) = Page Then                m_FormDirty(i) = True                m_FormAnyDirty = True                Exit Sub            End If        Next    End Sub    Friend Sub zFormChanged()        m_FormChanged = True        m_Edited = True    End Sub    ' Paginas que hay que volver a dibujar tras una accion sobre el formulario.    Public Property Get FormAnyDirty() As Boolean        FormAnyDirty = m_FormAnyDirty    End Property    Public Function TakeFormDirty(ByVal Index As Long) As Boolean        If Index < 0 Or Index >= m_Count Then Exit Function        TakeFormDirty = m_FormDirty(Index)        m_FormDirty(Index) = False    End Function    Public Sub ClearFormDirty()        Dim i As Long        For i = 0 To m_Count - 1            m_FormDirty(i) = False        Next        m_FormAnyDirty = False    End Sub    ' True (una vez) si algun valor ha cambiado desde la ultima consulta.    Public Function TakeFormChanged() As Boolean        TakeFormChanged = m_FormChanged        m_FormChanged = False    End Function    ' --- Cadenas UTF-16 de las anotaciones ---    ' Kind: 0 nombre, 1 nombre alternativo, 2 valor, 3 valor de exportacion, 4 etiqueta de opcion    Private Function AnnotText(ByVal Kind As Long, ByVal annot As LongPtr, Optional ByVal Index As Long) As String        Dim n As Long, buf() As Byte, t As String        If m_Form = 0 Or annot = 0 Then Exit Function        Select Case Kind            Case 0: n = FPDFAnnot_GetFormFieldName(m_Form, annot, 0, 0)            Case 1: n = FPDFAnnot_GetFormFieldAlternateName(m_Form, annot, 0, 0)            Case 2: n = FPDFAnnot_GetFormFieldValue(m_Form, annot, 0, 0)            Case 3: n = FPDFAnnot_GetFormFieldExportValue(m_Form, annot, 0, 0)            Case 4: n = FPDFAnnot_GetOptionLabel(m_Form, annot, Index, 0, 0)        End Select        If n <= 2 Then Exit Function        ReDim buf(0 To n - 1)        Select Case Kind            Case 0: FPDFAnnot_GetFormFieldName m_Form, annot, VarPtr(buf(0)), n            Case 1: FPDFAnnot_GetFormFieldAlternateName m_Form, annot, VarPtr(buf(0)), n            Case 2: FPDFAnnot_GetFormFieldValue m_Form, annot, VarPtr(buf(0)), n            Case 3: FPDFAnnot_GetFormFieldExportValue m_Form, annot, VarPtr(buf(0)), n            Case 4: FPDFAnnot_GetOptionLabel m_Form, annot, Index, VarPtr(buf(0)), n        End Select        t = String$((n - 2) \ 2, vbNullChar)        CopyMemory ByVal StrPtr(t), buf(0), n - 2        AnnotText = t    End Function    Private Function FormBufferText(ByVal Kind As Long, ByVal pg As LongPtr) As String        Dim n As Long, buf() As Byte, t As String        If m_Form = 0 Or pg = 0 Then Exit Function        If Kind = 0 Then n = FORM_GetSelectedText(m_Form, pg, 0, 0) Else n = FORM_GetFocusedText(m_Form, pg, 0, 0)        If n <= 2 Then Exit Function        ReDim buf(0 To n - 1)        If Kind = 0 Then FORM_GetSelectedText m_Form, pg, VarPtr(buf(0)), n Else FORM_GetFocusedText m_Form, pg, VarPtr(buf(0)), n        t = String$((n - 2) \ 2, vbNullChar)        CopyMemory ByVal StrPtr(t), buf(0), n - 2        FormBufferText = t    End Function    ' --- Lista de campos (uno por nombre completo; un campo puede tener varios widgets) ---    Private Sub InvalidateFields()        m_FieldsValid = False        m_FldCount = 0        m_WgCount = 0    End Sub    Private Sub EnsureFields()        Dim i As Long, k As Long, n As Long, pg As LongPtr, a As LongPtr, wasLoaded As Boolean, nm As String, fi As Long, j As Long        If m_FieldsValid Then Exit Sub        m_FieldsValid = True        m_FldCount = 0        m_WgCount = 0        If m_Form = 0 Then Exit Sub        For i = 0 To m_Count - 1            wasLoaded = (m_Page(i) <> 0)            pg = PageHandle(i)            If pg <> 0 Then                n = FPDFPage_GetAnnotCount(pg)                For k = 0 To n - 1                    a = FPDFPage_GetAnnot(pg, k)                    If a <> 0 Then                        If FPDFAnnot_GetSubtype(a) = FPDF_ANNOT_WIDGET Then                            nm = AnnotText(0, a)                            If Len(nm) > 0 Then                                fi = -1                                For j = 0 To m_FldCount - 1                                    If m_FldName(j) = nm Then fi = j: Exit For                                Next                                If fi < 0 Then                                    fi = m_FldCount                                    m_FldCount = m_FldCount + 1                                    ReDim Preserve m_FldName(0 To fi): ReDim Preserve m_FldType(0 To fi): ReDim Preserve m_FldFlags(0 To fi)                                    ReDim Preserve m_FldFirst(0 To fi): ReDim Preserve m_FldAlt(0 To fi)                                    m_FldName(fi) = nm                                    m_FldType(fi) = FPDFAnnot_GetFormFieldType(m_Form, a)                                    m_FldFlags(fi) = FPDFAnnot_GetFormFieldFlags(m_Form, a)                                    m_FldFirst(fi) = m_WgCount                                    m_FldAlt(fi) = AnnotText(1, a)                                End If                                ReDim Preserve m_WgField(0 To m_WgCount): ReDim Preserve m_WgPage(0 To m_WgCount)                                ReDim Preserve m_WgIndex(0 To m_WgCount): ReDim Preserve m_WgExport(0 To m_WgCount)                                m_WgField(m_WgCount) = fi                                m_WgPage(m_WgCount) = i                                m_WgIndex(m_WgCount) = k                                If m_FldType(fi) = FPDF_FORMFIELD_CHECKBOX Or m_FldType(fi) = FPDF_FORMFIELD_RADIOBUTTON Then m_WgExport(m_WgCount) = AnnotText(3, a)                                m_WgCount = m_WgCount + 1                            End If                        End If                        FPDFPage_CloseAnnot a                    End If                Next                If Not wasLoaded Then ReleasePage i            End If        Next    End Sub    ' Vuelve a leer la lista de campos (p. ej. tras cambiar paginas).    Public Sub RefreshFields()        InvalidateFields        EnsureFields    End Sub    Public Property Get FieldCount() As Long        EnsureFields        FieldCount = m_FldCount    End Property    Private Function ValidField(ByVal Index As Long) As Boolean        EnsureFields        ValidField = (Index >= 0 And Index < m_FldCount)    End Function    Public Property Get FieldName(ByVal Index As Long) As String        If ValidField(Index) Then FieldName = m_FldName(Index)    End Property    ' Nombre alternativo (/TU, texto de ayuda del campo).    Public Property Get FieldAltName(ByVal Index As Long) As String        If ValidField(Index) Then FieldAltName = m_FldAlt(Index)    End Property    ' FPDF_FORMFIELD_* (1 boton, 2 casilla, 3 radio, 4 combo, 5 lista, 6 texto, 7 firma)    Public Property Get FieldType(ByVal Index As Long) As Long        If ValidField(Index) Then FieldType = m_FldType(Index)    End Property    Public Property Get FieldFlags(ByVal Index As Long) As Long        If ValidField(Index) Then FieldFlags = m_FldFlags(Index)    End Property    Public Property Get FieldReadOnly(ByVal Index As Long) As Boolean        If ValidField(Index) Then FieldReadOnly = ((m_FldFlags(Index) And FPDF_FORMFLAG_READONLY) <> 0)    End Property    Public Property Get FieldRequired(ByVal Index As Long) As Boolean        If ValidField(Index) Then FieldRequired = ((m_FldFlags(Index) And FPDF_FORMFLAG_REQUIRED) <> 0)    End Property    ' True si el campo guarda un valor (no botones ni firmas).    Public Property Get FieldHasValue(ByVal Index As Long) As Boolean        If ValidField(Index) Then FieldHasValue = (m_FldType(Index) >= FPDF_FORMFIELD_CHECKBOX And m_FldType(Index) <= FPDF_FORMFIELD_TEXTFIELD)    End Property    Public Property Get FieldTypeName(ByVal Index As Long) As String        If Not ValidField(Index) Then Exit Property        Select Case m_FldType(Index)            Case FPDF_FORMFIELD_PUSHBUTTON: FieldTypeName = "boton"            Case FPDF_FORMFIELD_CHECKBOX: FieldTypeName = "casilla"            Case FPDF_FORMFIELD_RADIOBUTTON: FieldTypeName = "radio"            Case FPDF_FORMFIELD_COMBOBOX: FieldTypeName = "combo"            Case FPDF_FORMFIELD_LISTBOX: FieldTypeName = "lista"            Case FPDF_FORMFIELD_TEXTFIELD: FieldTypeName = "texto"            Case FPDF_FORMFIELD_SIGNATURE: FieldTypeName = "firma"            Case Else: FieldTypeName = "otro"        End Select    End Property    ' Pagina (base 0) del primer widget del campo.    Public Property Get FieldPage(ByVal Index As Long) As Long        If ValidField(Index) Then FieldPage = m_WgPage(m_FldFirst(Index)) Else FieldPage = -1    End Property    ' Indice del campo por nombre (exacto y, si no, sin distinguir mayusculas). -1 si no existe.    Public Function FindField(ByVal FieldNameText As String) As Long        Dim k As Long        EnsureFields        FindField = -1        For k = 0 To m_FldCount - 1            If m_FldName(k) = FieldNameText Then FindField = k: Exit Function        Next        For k = 0 To m_FldCount - 1            If StrComp(m_FldName(k), FieldNameText, vbTextCompare) = 0 Then FindField = k: Exit Function        Next    End Function    Private Function WidgetAnnot(ByVal w As Long, ByRef pg As LongPtr) As LongPtr        pg = PageHandle(m_WgPage(w))        If pg = 0 Then Exit Function        WidgetAnnot = FPDFPage_GetAnnot(pg, m_WgIndex(w))    End Function    ' Rectangulo del primer widget en coordenadas de pagina de PDF (origen abajo).    Public Function FieldRect(ByVal Index As Long, ByRef LeftPt As Double, ByRef TopPt As Double, ByRef RightPt As Double, ByRef BottomPt As Double) As Boolean        Dim a As LongPtr, pg As LongPtr, rc As FS_RECTF        If Not ValidField(Index) Then Exit Function        a = WidgetAnnot(m_FldFirst(Index), pg)        If a = 0 Then Exit Function        If FPDFAnnot_GetRect(a, rc) <> 0 Then            LeftPt = DMin(rc.rLeft, rc.rRight): RightPt = DMax(rc.rLeft, rc.rRight)            BottomPt = DMin(rc.rTop, rc.rBottom): TopPt = DMax(rc.rTop, rc.rBottom)            FieldRect = True        End If        FPDFPage_CloseAnnot a    End Function    ' Opciones del campo separadas por "|": etiquetas (combo/lista) o valores    ' de exportacion de sus widgets (casillas y radios, con "Off").    Public Function FieldOptions(ByVal Index As Long) As String        Dim a As LongPtr, pg As LongPtr, n As Long, j As Long, r As String, w As Long        If Not ValidField(Index) Then Exit Function        Select Case m_FldType(Index)            Case FPDF_FORMFIELD_COMBOBOX, FPDF_FORMFIELD_LISTBOX                a = WidgetAnnot(m_FldFirst(Index), pg)                If a = 0 Then Exit Function                n = FPDFAnnot_GetOptionCount(m_Form, a)                For j = 0 To n - 1                    If j > 0 Then r = r & "|"                    r = r & AnnotText(4, a, j)                Next                FPDFPage_CloseAnnot a            Case FPDF_FORMFIELD_CHECKBOX, FPDF_FORMFIELD_RADIOBUTTON                r = "Off"                For w = m_FldFirst(Index) To m_WgCount - 1                    If m_WgField(w) = Index And Len(m_WgExport(w)) > 0 Then                        If InStr(1, "|" & r & "|", "|" & m_WgExport(w) & "|", vbBinaryCompare) = 0 Then r = r & "|" & m_WgExport(w)                    End If                Next        End Select        FieldOptions = r    End Function    ' Valor actual. Casillas y radios: valor de exportacion u "Off".    ' Listas de seleccion multiple: etiquetas separadas por "|".    Public Function FieldValue(ByVal Index As Long) As String        Dim a As LongPtr, pg As LongPtr, n As Long, j As Long, r As String        If Not ValidField(Index) Then Exit Function        a = WidgetAnnot(m_FldFirst(Index), pg)        If a = 0 Then Exit Function        If m_FldType(Index) = FPDF_FORMFIELD_LISTBOX Then            n = FPDFAnnot_GetOptionCount(m_Form, a)            For j = 0 To n - 1                If FPDFAnnot_IsOptionSelected(m_Form, a, j) <> 0 Then                    If Len(r) > 0 Then r = r & "|"                    r = r & AnnotText(4, a, j)                End If            Next            FieldValue = r        ElseIf FieldHasValue(Index) Then            FieldValue = AnnotText(2, a)        End If        FPDFPage_CloseAnnot a    End Function    ' Asigna el valor de un campo como lo haria el usuario. False si el campo    ' es de solo lectura, no admite valor o el valor no es una opcion valida.    Public Function SetFieldValue(ByVal Index As Long, ByVal Value As String) As Boolean        Dim a As LongPtr, pg As LongPtr, n As Long, j As Long, w As Long, target As Long, isOn As Boolean, v As String, ok As Boolean        If Not ValidField(Index) Then Exit Function        If (m_FldFlags(Index) And FPDF_FORMFLAG_READONLY) <> 0 Then Exit Function        CommitForm        Select Case m_FldType(Index)            Case FPDF_FORMFIELD_TEXTFIELD                ok = SetWidgetText(m_FldFirst(Index), Value)            Case FPDF_FORMFIELD_COMBOBOX                j = OptionIndex(m_FldFirst(Index), Value)                If j >= 0 Then                    ok = SelectOptions(m_FldFirst(Index), "|" & CStr(j) & "|", False)                ElseIf (m_FldFlags(Index) And FPDF_FORMFLAG_CHOICE_EDIT) <> 0 Or Len(Value) = 0 Then                    ok = SetWidgetText(m_FldFirst(Index), Value)                End If            Case FPDF_FORMFIELD_LISTBOX                ' Valores separados por "|" (en seleccion simple, el primero)                Dim parts() As String, sel As String                If Len(Value) > 0 Then                    parts = Split(Value, "|")                    For j = 0 To UBound(parts)                        n = OptionIndex(m_FldFirst(Index), Trim$(parts(j)))                        If n >= 0 Then                            If InStr(1, sel, "|" & CStr(n) & "|") = 0 Then sel = sel & "|" & CStr(n) & "|"                            If (m_FldFlags(Index) And FPDF_FORMFLAG_CHOICE_MULTI_SELECT) = 0 Then Exit For                        End If                    Next                    If Len(sel) = 0 Then Exit Function                End If                ok = SelectOptions(m_FldFirst(Index), sel, True)            Case FPDF_FORMFIELD_CHECKBOX, FPDF_FORMFIELD_RADIOBUTTON                v = LCase$(Trim$(Value))                isOn = Not (v = "" Or v = "off" Or v = "0" Or v = "false" Or v = "falso" Or v = "no" Or v = "n")                target = -1                If isOn Then                    ' Widget cuyo valor de exportacion coincide; si no, "si/yes/1" marca el primero                    For w = m_FldFirst(Index) To m_WgCount - 1                        If m_WgField(w) = Index Then                            If StrComp(m_WgExport(w), Trim$(Value), vbTextCompare) = 0 Then target = w: Exit For                        End If                    Next                    If target < 0 And m_FldType(Index) = FPDF_FORMFIELD_CHECKBOX Then                        If v = "yes" Or v = "on" Or v = "1" Or v = "true" Or v = "si" Or v = "s" Or v = "x" Or v = "verdadero" Or v = "y" Or v = "s" & ChrW$(237) Then target = m_FldFirst(Index)                    End If                    If target < 0 Then Exit Function                End If                ok = True                For w = m_FldFirst(Index) To m_WgCount - 1                    If m_WgField(w) = Index Then                        If (WidgetChecked(w) <> (w = target)) Then                            ' Un radio marcado no siempre se puede desmarcar (NoToggleToOff)                            If w = target Or m_FldType(Index) = FPDF_FORMFIELD_CHECKBOX Or target < 0 Then ClickWidget w                        End If                    End If                Next                If target >= 0 Then ok = WidgetChecked(target)        End Select        If ok Then            m_Edited = True            m_FormChanged = True        End If        SetFieldValue = ok    End Function    Private Function WidgetChecked(ByVal w As Long) As Boolean        Dim a As LongPtr, pg As LongPtr        a = WidgetAnnot(w, pg)        If a = 0 Then Exit Function        WidgetChecked = (FPDFAnnot_IsChecked(m_Form, a) <> 0)        FPDFPage_CloseAnnot a    End Function    Private Function ClickWidget(ByVal w As Long) As Boolean        Dim a As LongPtr, pg As LongPtr, rc As FS_RECTF, x As Double, y As Double        a = WidgetAnnot(w, pg)        If a = 0 Then Exit Function        FPDFAnnot_GetRect a, rc        FPDFPage_CloseAnnot a        x = (CDbl(rc.rLeft) + rc.rRight) / 2        y = (CDbl(rc.rTop) + rc.rBottom) / 2        FORM_OnMouseMove m_Form, pg, 0, x, y        FORM_OnLButtonDown m_Form, pg, 0, x, y        FORM_OnLButtonUp m_Form, pg, 0, x, y        FORM_ForceToKillFocus m_Form        ClickWidget = True    End Function    Private Function SetWidgetText(ByVal w As Long, ByVal Value As String) As Boolean        Dim a As LongPtr, pg As LongPtr, buf As String        a = WidgetAnnot(w, pg)        If a = 0 Then Exit Function        If FORM_SetFocusedAnnot(m_Form, a) <> 0 Then            FORM_SelectAllText m_Form, pg            buf = Replace$(Replace$(Value, vbCrLf, vbLf), vbCr, vbLf) & vbNullChar            FORM_ReplaceSelection m_Form, pg, StrPtr(buf)            SetWidgetText = True        End If        FORM_ForceToKillFocus m_Form        FPDFPage_CloseAnnot a    End Function    ' Indice de la opcion con esa etiqueta (sin distinguir mayusculas) o -1.    Private Function OptionIndex(ByVal w As Long, ByVal Label As String) As Long        Dim a As LongPtr, pg As LongPtr, n As Long, j As Long        OptionIndex = -1        a = WidgetAnnot(w, pg)        If a = 0 Then Exit Function        n = FPDFAnnot_GetOptionCount(m_Form, a)        For j = 0 To n - 1            If AnnotText(4, a, j) = Label Then OptionIndex = j: Exit For        Next        If OptionIndex < 0 Then            For j = 0 To n - 1                If StrComp(AnnotText(4, a, j), Label, vbTextCompare) = 0 Then OptionIndex = j: Exit For            Next        End If        FPDFPage_CloseAnnot a    End Function    ' Selecciona las opciones cuyo indice aparece en Sel ("|0||3|"). Con    ' Deselect, desmarca el resto (listas).    Private Function SelectOptions(ByVal w As Long, ByVal Sel As String, ByVal Deselect As Boolean) As Boolean        Dim a As LongPtr, pg As LongPtr, n As Long, j As Long, want As Boolean        a = WidgetAnnot(w, pg)        If a = 0 Then Exit Function        If FORM_SetFocusedAnnot(m_Form, a) <> 0 Then            n = FPDFAnnot_GetOptionCount(m_Form, a)            SelectOptions = True            For j = 0 To n - 1                want = (InStr(1, Sel, "|" & CStr(j) & "|") > 0)                If want Or Deselect Then                    If want <> (FPDFAnnot_IsOptionSelected(m_Form, a, j) <> 0) Or want Then                        If FORM_SetIndexSelected(m_Form, pg, j, IIf(want, 1, 0)) = 0 And want Then SelectOptions = False                    End If                End If            Next        End If        FORM_ForceToKillFocus m_Form        FPDFPage_CloseAnnot a    End Function    ' Lleva el foco del teclado al campo (primer widget).    Public Function FocusField(ByVal Index As Long) As Boolean        Dim a As LongPtr, pg As LongPtr        If Not ValidField(Index) Then Exit Function        CommitForm        a = WidgetAnnot(m_FldFirst(Index), pg)        If a = 0 Then Exit Function        FocusField = (FORM_SetFocusedAnnot(m_Form, a) <> 0)        FPDFPage_CloseAnnot a    End Function    ' Aplana los campos: su apariencia pasa a ser contenido de la pagina y    ' dejan de ser editables. Devuelve el numero de paginas modificadas.    Public Function FlattenForms() As Long        Dim i As Long, pg As LongPtr        If m_Doc = 0 Then Exit Function        CommitForm        ReleaseAll        ExitForms        For i = 0 To m_Count - 1            pg = FPDF_LoadPage(m_Doc, i)            If pg <> 0 Then                If FPDFPage_Flatten(pg, FLAT_NORMALDISPLAY) = 1 Then FlattenForms = FlattenForms + 1                FPDF_ClosePage pg            End If        Next        If FlattenForms > 0 Then m_Edited = True        InitForms    End Function    ' --- Interaccion (coordenadas de pagina de PDF) ---    ' Tipo de campo bajo el punto (FPDF_FORMFIELD_*) o -1.    Public Function FormFieldAtPoint(ByVal Index As Long, ByVal PdfX As Double, ByVal PdfY As Double) As Long        Dim pg As LongPtr        FormFieldAtPoint = -1        If m_Form = 0 Then Exit Function        pg = PageHandle(Index)        If pg <> 0 Then FormFieldAtPoint = FPDFPage_HasFormFieldAtPoint(m_Form, pg, PdfX, PdfY)    End Function    ' Evento de raton: 0 mover, 1 pulsar, 2 soltar, 3 doble clic.    Public Function FormMouse(ByVal Index As Long, ByVal Action As Long, ByVal Modifiers As Long, ByVal PdfX As Double, ByVal PdfY As Double) As Boolean        Dim pg As LongPtr        If m_Form = 0 Then Exit Function        pg = PageHandle(Index)        If pg = 0 Then Exit Function        Select Case Action            Case 0: FormMouse = (FORM_OnMouseMove(m_Form, pg, Modifiers, PdfX, PdfY) <> 0)            Case 1: FormMouse = (FORM_OnLButtonDown(m_Form, pg, Modifiers, PdfX, PdfY) <> 0)            Case 2: FormMouse = (FORM_OnLButtonUp(m_Form, pg, Modifiers, PdfX, PdfY) <> 0)            Case 3: FormMouse = (FORM_OnLButtonDoubleClick(m_Form, pg, Modifiers, PdfX, PdfY) <> 0)        End Select    End Function    Public Function FormKeyDown(ByVal Index As Long, ByVal KeyCode As Long, ByVal Modifiers As Long) As Boolean        Dim pg As LongPtr        If m_Form = 0 Then Exit Function        pg = PageHandle(Index)        If pg <> 0 Then FormKeyDown = (FORM_OnKeyDown(m_Form, pg, KeyCode, Modifiers) <> 0)    End Function    Public Function FormChar(ByVal Index As Long, ByVal CharCode As Long, ByVal Modifiers As Long) As Boolean        Dim pg As LongPtr        If m_Form = 0 Then Exit Function        pg = PageHandle(Index)        If pg <> 0 Then FormChar = (FORM_OnChar(m_Form, pg, CharCode, Modifiers) <> 0)    End Function    ' Pagina (base 0) del campo con el foco, o -1. Type/Flags del campo.    Public Function FormFocusPage(Optional ByRef FieldTypeOut As Long, Optional ByRef FieldFlagsOut As Long) As Long        Dim pi As Long, a As LongPtr        FormFocusPage = -1        If m_Form = 0 Then Exit Function        On Error GoTo NoApi        If FORM_GetFocusedAnnot(m_Form, pi, a) <> 0 Then            If a <> 0 Then                FieldTypeOut = FPDFAnnot_GetFormFieldType(m_Form, a)                FieldFlagsOut = FPDFAnnot_GetFormFieldFlags(m_Form, a)                FPDFPage_CloseAnnot a                If pi >= 0 And pi < m_Count Then FormFocusPage = pi            End If        End If    NoApi:    End Function    Public Function FormSelectedText(ByVal Index As Long) As String        FormSelectedText = FormBufferText(0, PageHandle(Index))    End Function    Public Function FormFocusedText(ByVal Index As Long) As String        FormFocusedText = FormBufferText(1, PageHandle(Index))    End Function    Public Sub FormSelectAll(ByVal Index As Long)        If m_Form <> 0 Then FORM_SelectAllText m_Form, PageHandle(Index)    End Sub    Public Sub FormReplaceSelection(ByVal Index As Long, ByVal Text As String)        Dim buf As String        If m_Form = 0 Then Exit Sub        buf = Text & vbNullChar        FORM_ReplaceSelection m_Form, PageHandle(Index), StrPtr(buf)    End Sub    ' Action: 0 deshacer, 1 rehacer. Devuelve True si se ha hecho.    Public Function FormUndoRedo(ByVal Index As Long, ByVal Action As Long) As Boolean        Dim pg As LongPtr        If m_Form = 0 Then Exit Function        pg = PageHandle(Index)        If pg = 0 Then Exit Function        If Action = 0 Then            If FORM_CanUndo(m_Form, pg) <> 0 Then FormUndoRedo = (FORM_Undo(m_Form, pg) <> 0)        Else            If FORM_CanRedo(m_Form, pg) <> 0 Then FormUndoRedo = (FORM_Redo(m_Form, pg) <> 0)        End If    End Function    ' --- Renderizado --------------------------------------------------------    ' Renderiza la pagina sobre el DIB. StartX/StartY/SizeX/SizeY siguen la    ' convencion de FPDF_RenderPageBitmap: la pagina completa mide SizeX x SizeY    ' pixeles y su origen esta en (StartX, StartY) respecto al DIB, de modo que    ' se puede renderizar solo una porcion (mosaico) de una pagina muy ampliada.    Public Function RenderTo(ByVal Index As Long, ByVal Dib As PdfDib, ByVal StartX As Long, ByVal StartY As Long, ByVal SizeX As Long, ByVal SizeY As Long, ByVal Rotation As Long, ByVal Flags As Long) As Boolean        Dim pg As LongPtr, bmp As LongPtr        If Dib Is Nothing Then Exit Function        If Not Dib.IsValid Then Exit Function        pg = PageHandle(Index)        If pg = 0 Then Exit Function        bmp = FPDFBitmap_CreateEx(Dib.Width, Dib.Height, FPDFBitmap_BGRx, Dib.Bits, Dib.Stride)        If bmp = 0 Then Exit Function        FPDFBitmap_FillRect bmp, 0, 0, Dib.Width, Dib.Height, &HFFFFFFFF        FPDF_RenderPageBitmap bmp, pg, StartX, StartY, SizeX, SizeY, Rotation And 3, Flags        ' Los campos de formulario solo se dibujan con FPDF_FFLDraw. Al imprimir        ' (FPDF_PRINTING) no se dibuja el resaltado de los campos.        If m_Form <> 0 And (Flags And FPDF_ANNOT) <> 0 Then            If m_FormHlOn And (Flags And FPDF_PRINTING) <> 0 Then FPDF_SetFormFieldHighlightAlpha m_Form, 0            FPDF_FFLDraw m_Form, bmp, pg, StartX, StartY, SizeX, SizeY, Rotation And 3, Flags            If m_FormHlOn And (Flags And FPDF_PRINTING) <> 0 Then FPDF_SetFormFieldHighlightAlpha m_Form, m_FormHlAlpha        End If        FPDFBitmap_Destroy bmp        RenderTo = True    End Function    ' --- Texto --------------------------------------------------------------    Public Function CharCount(ByVal Index As Long) As Long        Dim tp As LongPtr        tp = TextPageHandle(Index)        If tp <> 0 Then CharCount = FPDFText_CountChars(tp)    End Function    Public Function GetText(ByVal Index As Long, Optional ByVal StartChar As Long = 0, Optional ByVal Count As Long = -1) As String        Dim tp As LongPtr, n As Long, buf As String, r As Long        tp = TextPageHandle(Index)        If tp = 0 Then Exit Function        n = FPDFText_CountChars(tp)        If StartChar < 0 Then StartChar = 0        If StartChar >= n Then Exit Function        If Count < 0 Or StartChar + Count > n Then Count = n - StartChar        If Count <= 0 Then Exit Function        buf = String$(Count + 1, vbNullChar)        r = FPDFText_GetText(tp, StartChar, Count, StrPtr(buf))        If r > 1 Then GetText = Left$(buf, r - 1)    End Function    Private Sub Class_Initialize()        m_EnableForms = True        m_FormHlColor = &HFFD7CC        ' azul claro (COLORREF)        m_FormHlAlpha = 64    End Sub    Private Sub Class_Terminate()        CloseDocument        If m_Acquired Then            PdfiumRelease            m_Acquired = False        End If    End SubEnd Class