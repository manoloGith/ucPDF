' ============================================================================'  PdfDocument.twin'  Apartado 1 - Base funcional: documento PDFium con caches de paginas y texto.''  El archivo se lee completo en memoria y se abre con FPDF_LoadMemDocument,'  lo que permite rutas Unicode. El bufer se conserva mientras el documento'  esta abierto, tal como exige PDFium.' ============================================================================[Description("Documento PDF abierto con PDFium")]Class PdfDocument    Private m_Doc As LongPtr    Private m_Data() As Byte    Private m_Count As Long    Private m_W() As Double    Private m_H() As Double    Private m_Page() As LongPtr    Private m_Text() As LongPtr    Private m_LastError As Long    Private m_Acquired As Boolean    Private m_FileName As String    Private m_Edited As Boolean         ' la estructura ha cambiado desde que se abrio    ' --- Apertura / cierre --------------------------------------------------    Public Function OpenFile(ByVal FileName As String, Optional ByVal Password As String, Optional ByVal PdfiumPath As String) As Boolean        Dim ff As Integer, b() As Byte, n As Long        CloseDocument        If Not FileExists(FileName) Then            m_LastError = FPDF_ERR_FILE            Exit Function        End If        On Error GoTo ReadFailed        ff = FreeFile        Open FileName For Binary Access Read Shared As #ff        n = LOF(ff)        If n > 0 Then            ReDim b(0 To n - 1)            Get #ff, , b        End If        Close #ff        On Error GoTo 0        If n = 0 Then            m_LastError = FPDF_ERR_FORMAT            Exit Function        End If        If OpenBytes(b, Password, PdfiumPath) Then            m_FileName = FileName            OpenFile = True        End If        Exit Function    ReadFailed:        If ff <> 0 Then Close #ff        m_LastError = FPDF_ERR_FILE    End Function    Public Function OpenBytes(ByRef Data() As Byte, Optional ByVal Password As String, Optional ByVal PdfiumPath As String) As Boolean        Dim pwd() As Byte, pPwd As LongPtr, i As Long, lb As Long, ub As Long, n As Long, pw As Double, ph As Double        CloseDocument        If Not m_Acquired Then            m_Acquired = PdfiumAcquire(PdfiumPath)            If Not m_Acquired Then                m_LastError = FPDF_ERR_NOLIBRARY                Exit Function            End If        End If        On Error GoTo BadArray        lb = LBound(Data)        ub = UBound(Data)        On Error GoTo 0        If ub < lb Then            m_LastError = FPDF_ERR_FORMAT            Exit Function        End If        m_Data = Data        If Len(Password) > 0 Then            pwd = Utf8z(Password)            pPwd = VarPtr(pwd(0))        End If        m_Doc = FPDF_LoadMemDocument(VarPtr(m_Data(LBound(m_Data))), ub - lb + 1, pPwd)        If m_Doc = 0 Then            m_LastError = FPDF_GetLastError()            Erase m_Data            Exit Function        End If        ' Numero de paginas validado antes de dimensionar las matrices.        n = FPDF_GetPageCount(m_Doc)        If n <= 0 Or n > 1000000 Then            FPDF_CloseDocument m_Doc            m_Doc = 0            Erase m_Data            m_LastError = FPDF_ERR_PAGE            Exit Function        End If        m_Count = n        ReDim m_W(0 To n - 1) As Double        ReDim m_H(0 To n - 1) As Double        ReDim m_Page(0 To n - 1) As LongPtr        ReDim m_Text(0 To n - 1) As LongPtr        For i = 0 To n - 1            ' Se usan variables locales: no se pasan elementos de la matriz ByRef a la DLL.            pw = 0            ph = 0            If FPDF_GetPageSizeByIndex(m_Doc, i, pw, ph) = 0 Then                pw = 612                ph = 792            End If            If pw < 1 Then pw = 1            If ph < 1 Then ph = 1            m_W(i) = pw            m_H(i) = ph        Next        m_LastError = FPDF_ERR_SUCCESS        m_FileName = ""        OpenBytes = True        Exit Function    BadArray:        m_LastError = FPDF_ERR_FORMAT    End Function    Public Sub CloseDocument()        Dim i As Long        If m_Doc <> 0 Then            For i = 0 To m_Count - 1                ReleasePage i            Next            FPDF_CloseDocument m_Doc            m_Doc = 0        End If        m_Count = 0        m_FileName = ""        m_Edited = False        Erase m_Data        Erase m_W        Erase m_H        Erase m_Page        Erase m_Text    End Sub    ' Guarda una copia exacta del PDF abierto (los bytes originales que se    ' mantienen en memoria), por lo que tambien puede sobrescribir el archivo    ' del que se abrio. Admite rutas Unicode.    Public Function SaveCopy(ByVal FileName As String) As Boolean        Dim lb As Long, ub As Long, outData() As Byte        If m_Doc = 0 Or Len(FileName) = 0 Then Exit Function        ' Con cambios (paginas reordenadas) PDFium genera un PDF nuevo.        If m_Edited Then            If Not PdfiumSaveToBytes(m_Doc, outData) Then Exit Function            SaveCopy = WriteAllBytes(FileName, VarPtr(outData(0)), UBound(outData) + 1)            If SaveCopy Then m_FileName = FileName            Exit Function        End If        On Error GoTo NoData        lb = LBound(m_Data)        ub = UBound(m_Data)        On Error GoTo 0        If ub < lb Then Exit Function        SaveCopy = WriteAllBytes(FileName, VarPtr(m_Data(lb)), ub - lb + 1)        If SaveCopy Then m_FileName = FileName        Exit Function    NoData:    End Function    ' Mueve una pagina (base 0) para que quede en la posicion ToIndex.    ' Las paginas cargadas se liberan antes: sus indices cambian.    Public Function MovePage(ByVal FromIndex As Long, ByVal ToIndex As Long) As Boolean        Dim idx(0 To 0) As Long, i As Long, w As Double, h As Double, tw As Double, th As Double        If m_Doc = 0 Then Exit Function        If FromIndex < 0 Or FromIndex >= m_Count Or ToIndex < 0 Or ToIndex >= m_Count Then Exit Function        If FromIndex = ToIndex Then            MovePage = True            Exit Function        End If        For i = 0 To m_Count - 1            ReleasePage i        Next        idx(0) = FromIndex        On Error GoTo NotSupported        If FPDF_MovePages(m_Doc, VarPtr(idx(0)), 1, ToIndex) = 0 Then Exit Function        On Error GoTo 0        ' Reordenar tambien la cache de tamanos        tw = m_W(FromIndex)        th = m_H(FromIndex)        If FromIndex < ToIndex Then            For i = FromIndex To ToIndex - 1                m_W(i) = m_W(i + 1)                m_H(i) = m_H(i + 1)            Next        Else            For i = FromIndex To ToIndex + 1 Step -1                m_W(i) = m_W(i - 1)                m_H(i) = m_H(i - 1)            Next        End If        m_W(ToIndex) = tw        m_H(ToIndex) = th        m_Edited = True        MovePage = True        Exit Function    NotSupported:        ' pdfium.dll antigua sin FPDF_MovePages        m_LastError = FPDF_ERR_UNKNOWN    End Function    ' Vuelve a leer el numero de paginas y sus tamanos tras editar la estructura.    Public Sub RefreshStructure()        Dim i As Long, n As Long, pw As Double, ph As Double        If m_Doc = 0 Then Exit Sub        For i = 0 To m_Count - 1            ReleasePage i        Next        n = FPDF_GetPageCount(m_Doc)        If n < 0 Then n = 0        m_Count = n        ReDim m_W(0 To IMax(n - 1, 0)) As Double        ReDim m_H(0 To IMax(n - 1, 0)) As Double        ReDim m_Page(0 To IMax(n - 1, 0)) As LongPtr        ReDim m_Text(0 To IMax(n - 1, 0)) As LongPtr        For i = 0 To n - 1            pw = 0            ph = 0            If FPDF_GetPageSizeByIndex(m_Doc, i, pw, ph) = 0 Then                pw = 612                ph = 792            End If            m_W(i) = DMax(1, pw)            m_H(i) = DMax(1, ph)        Next    End Sub    Private Sub ReleaseAll()        Dim i As Long        For i = 0 To m_Count - 1            ReleasePage i        Next    End Sub    ' Gira las paginas indicadas (base 0) en pasos de 90 grados (+1 = derecha).    Public Function RotatePages(ByRef Indices() As Long, ByVal Count As Long, ByVal Delta As Long) As Boolean        Dim k As Long, pg As LongPtr        If m_Doc = 0 Or Count <= 0 Then Exit Function        ReleaseAll        For k = 0 To Count - 1            pg = FPDF_LoadPage(m_Doc, Indices(k))            If pg <> 0 Then                FPDFPage_SetRotation pg, (FPDFPage_GetRotation(pg) + Delta + 4) Mod 4                FPDF_ClosePage pg            End If        Next        m_Edited = True        RefreshStructure        RotatePages = True    End Function    ' Elimina las paginas indicadas (siempre debe quedar al menos una).    Public Function DeletePages(ByRef Indices() As Long, ByVal Count As Long) As Boolean        Dim k As Long        If m_Doc = 0 Or Count <= 0 Or Count >= m_Count Then Exit Function        ReleaseAll        ' De mayor a menor para no alterar los indices pendientes        For k = Count - 1 To 0 Step -1            FPDFPage_Delete m_Doc, Indices(k)        Next        m_Edited = True        RefreshStructure        DeletePages = True    End Function    ' Inserta una pagina en blanco de Width x Height puntos en la posicion Index.    Public Function InsertBlankPage(ByVal Index As Long, ByVal Width As Double, ByVal Height As Double) As Boolean        Dim pg As LongPtr        If m_Doc = 0 Then Exit Function        ReleaseAll        pg = FPDFPage_New(m_Doc, Index, Width, Height)        If pg = 0 Then Exit Function        FPDF_ClosePage pg        m_Edited = True        RefreshStructure        InsertBlankPage = True    End Function    ' Inserta todas las paginas de Source en la posicion Index. Devuelve cuantas.    Public Function ImportAllPages(ByVal Source As PdfDocument, ByVal Index As Long) As Long        Dim before As Long        If m_Doc = 0 Or Source Is Nothing Then Exit Function        If Not Source.IsOpen Then Exit Function        ReleaseAll        before = FPDF_GetPageCount(m_Doc)        If FPDF_ImportPagesByIndex(m_Doc, Source.Handle, 0, 0, Index) = 0 Then Exit Function        m_Edited = True        RefreshStructure        ImportAllPages = m_Count - before    End Function    ' Sustituye las paginas indicadas por las primeras paginas de Source    ' (la k-esima seleccionada por la pagina k del archivo). Devuelve cuantas.    Public Function ReplacePages(ByRef Indices() As Long, ByVal Count As Long, ByVal Source As PdfDocument) As Long        Dim k As Long, n As Long, srcIdx(0 To 0) As Long        If m_Doc = 0 Or Source Is Nothing Or Count <= 0 Then Exit Function        If Not Source.IsOpen Then Exit Function        n = IMin(Count, Source.PageCount)        ReleaseAll        For k = 0 To n - 1            srcIdx(0) = k            If FPDF_ImportPagesByIndex(m_Doc, Source.Handle, VarPtr(srcIdx(0)), 1, Indices(k)) <> 0 Then                FPDFPage_Delete m_Doc, Indices(k) + 1                ReplacePages = ReplacePages + 1            End If        Next        If ReplacePages > 0 Then m_Edited = True        RefreshStructure    End Function    ' Guarda las paginas indicadas en un PDF nuevo (el documento no cambia).    Public Function ExtractPages(ByRef Indices() As Long, ByVal Count As Long, ByVal FileName As String) As Boolean        Dim nd As LongPtr, outData() As Byte        If m_Doc = 0 Or Count <= 0 Then Exit Function        nd = FPDF_CreateNewDocument()        If nd = 0 Then Exit Function        If FPDF_ImportPagesByIndex(nd, m_Doc, VarPtr(Indices(0)), Count, 0) <> 0 Then            If PdfiumSaveToBytes(nd, outData) Then                ExtractPages = WriteAllBytes(FileName, VarPtr(outData(0)), UBound(outData) + 1)            End If        End If        FPDF_CloseDocument nd    End Function    ' Caja del contenido visible de la pagina como fracciones (0..1) de la    ' pagina mostrada (izquierda, arriba, derecha, abajo; arriba = 0).    ' False si la pagina esta en blanco.    Public Function ContentBounds(ByVal Index As Long, ByRef fl As Double, ByRef ft As Double, ByRef fr As Double, ByRef fb As Double) As Boolean        Dim dib As PdfDib, bw As Long, bh As Long, s As Double, px() As Long, v As Long        Dim x As Long, y As Long, x0 As Long, y0 As Long, x1 As Long, y1 As Long, found As Boolean        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        s = DMin(1.5, 1000# / DMax(m_W(Index), m_H(Index)))        bw = IMax(1, CLng(m_W(Index) * s))        bh = IMax(1, CLng(m_H(Index) * s))        Set dib = New PdfDib        If Not dib.Create(bw, bh) Then Exit Function        If Not RenderTo(Index, dib, 0, 0, bw, bh, 0, FPDF_ANNOT) Then Exit Function        ReDim px(0 To bw * bh - 1)        CopyMemory px(0), ByVal dib.Bits, CLngPtr(bw) * bh * 4        x0 = bw: y0 = bh: x1 = -1: y1 = -1        For y = 0 To bh - 1            For x = 0 To bw - 1                v = px(y * bw + x)                ' contenido = algun canal claramente no blanco                If (v And &HFF&) < 240 Or ((v And &HFF00&) \ &H100&) < 240 Or ((v And &HFF0000) \ &H10000) < 240 Then                    If x < x0 Then x0 = x                    If x > x1 Then x1 = x                    If y < y0 Then y0 = y                    y1 = y                    found = True                End If            Next        Next        If Not found Then Exit Function        fl = x0 / bw        ft = y0 / bh        fr = (x1 + 1) / bw        fb = (y1 + 1) / bh        ContentBounds = True    End Function    ' Recorta la pagina al rectangulo dado en fracciones (0..1) de la pagina    ' mostrada, con el origen arriba a la izquierda. Tiene en cuenta el giro y    ' cualquier recorte anterior (se convierte con FPDF_DeviceToPage).    Public Function CropPageFraction(ByVal Index As Long, ByVal fl As Double, ByVal ft As Double, ByVal fr As Double, ByVal fb As Double) As Boolean        Dim pg As LongPtr, bw As Long, bh As Long, ax As Double, ay As Double, bx As Double, by As Double        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        fl = DMax(0, DMin(1, fl)): fr = DMax(0, DMin(1, fr))        ft = DMax(0, DMin(1, ft)): fb = DMax(0, DMin(1, fb))        If fr - fl < 0.01 Or fb - ft < 0.01 Then Exit Function        pg = PageHandle(Index)        If pg = 0 Then Exit Function        ' Dispositivo virtual de 10000 unidades de ancho: precision de sobra        bw = 10000        bh = IMax(1, CLng(10000# * m_H(Index) / m_W(Index)))        If FPDF_DeviceToPage(pg, 0, 0, bw, bh, 0, CLng(fl * bw), CLng(ft * bh), ax, ay) = 0 Then Exit Function        If FPDF_DeviceToPage(pg, 0, 0, bw, bh, 0, CLng(fr * bw), CLng(fb * bh), bx, by) = 0 Then Exit Function        FPDFPage_SetCropBox pg, CSng(DMin(ax, bx)), CSng(DMin(ay, by)), CSng(DMax(ax, bx)), CSng(DMax(ay, by))        ReleasePage Index        m_Edited = True        CropPageFraction = True    End Function    ' Recorte automatico: contenido + MarginPt puntos de margen.    Public Function CropToContent(ByVal Index As Long, Optional ByVal MarginPt As Double = 8) As Boolean        Dim fl As Double, ft As Double, fr As Double, fb As Double, mx As Double, my As Double        If Not ContentBounds(Index, fl, ft, fr, fb) Then Exit Function        mx = MarginPt / m_W(Index)        my = MarginPt / m_H(Index)        CropToContent = CropPageFraction(Index, fl - mx, ft - my, fr + mx, fb + my)    End Function    Public Property Get Edited() As Boolean        Edited = m_Edited    End Property    ' --- Informacion --------------------------------------------------------    Public Property Get IsOpen() As Boolean        IsOpen = (m_Doc <> 0)    End Property    Public Property Get Handle() As LongPtr        Handle = m_Doc    End Property    Public Property Get PageCount() As Long        PageCount = m_Count    End Property    Public Property Get FileName() As String        FileName = m_FileName    End Property    Public Property Get LastError() As Long        LastError = m_LastError    End Property    Public Property Get LastErrorText() As String        LastErrorText = PdfiumErrorText(m_LastError)    End Property    ' Tamano de la pagina en puntos (1/72 pulgadas), sin rotacion.    Public Property Get PageWidth(ByVal Index As Long) As Double        If Index >= 0 And Index < m_Count Then PageWidth = m_W(Index)    End Property    Public Property Get PageHeight(ByVal Index As Long) As Double        If Index >= 0 And Index < m_Count Then PageHeight = m_H(Index)    End Property    ' --- Paginas (carga diferida) -------------------------------------------    Public Function PageHandle(ByVal Index As Long) As LongPtr        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        If m_Page(Index) = 0 Then m_Page(Index) = FPDF_LoadPage(m_Doc, Index)        PageHandle = m_Page(Index)    End Function    Public Function TextPageHandle(ByVal Index As Long) As LongPtr        Dim pg As LongPtr        If m_Doc = 0 Or Index < 0 Or Index >= m_Count Then Exit Function        If m_Text(Index) = 0 Then            pg = PageHandle(Index)            If pg <> 0 Then m_Text(Index) = FPDFText_LoadPage(pg)        End If        TextPageHandle = m_Text(Index)    End Function    Public Sub ReleasePage(ByVal Index As Long)        If Index < 0 Or Index >= m_Count Then Exit Sub        If m_Text(Index) <> 0 Then            FPDFText_ClosePage m_Text(Index)            m_Text(Index) = 0        End If        If m_Page(Index) <> 0 Then            FPDF_ClosePage m_Page(Index)            m_Page(Index) = 0        End If    End Sub    ' Libera todas las paginas cargadas fuera de los dos rangos indicados    ' (por ejemplo, paginas visibles y miniaturas visibles).    Public Sub ReleasePagesExcept(ByVal First1 As Long, ByVal Last1 As Long, Optional ByVal First2 As Long = -1, Optional ByVal Last2 As Long = -2)        Dim i As Long        For i = 0 To m_Count - 1            If m_Page(i) <> 0 Then                If Not ((i >= First1 And i <= Last1) Or (i >= First2 And i <= Last2)) Then ReleasePage i            End If        Next    End Sub    ' --- Renderizado --------------------------------------------------------    ' Renderiza la pagina sobre el DIB. StartX/StartY/SizeX/SizeY siguen la    ' convencion de FPDF_RenderPageBitmap: la pagina completa mide SizeX x SizeY    ' pixeles y su origen esta en (StartX, StartY) respecto al DIB, de modo que    ' se puede renderizar solo una porcion (mosaico) de una pagina muy ampliada.    Public Function RenderTo(ByVal Index As Long, ByVal Dib As PdfDib, ByVal StartX As Long, ByVal StartY As Long, ByVal SizeX As Long, ByVal SizeY As Long, ByVal Rotation As Long, ByVal Flags As Long) As Boolean        Dim pg As LongPtr, bmp As LongPtr        If Dib Is Nothing Then Exit Function        If Not Dib.IsValid Then Exit Function        pg = PageHandle(Index)        If pg = 0 Then Exit Function        bmp = FPDFBitmap_CreateEx(Dib.Width, Dib.Height, FPDFBitmap_BGRx, Dib.Bits, Dib.Stride)        If bmp = 0 Then Exit Function        FPDFBitmap_FillRect bmp, 0, 0, Dib.Width, Dib.Height, &HFFFFFFFF        FPDF_RenderPageBitmap bmp, pg, StartX, StartY, SizeX, SizeY, Rotation And 3, Flags        FPDFBitmap_Destroy bmp        RenderTo = True    End Function    ' --- Texto --------------------------------------------------------------    Public Function CharCount(ByVal Index As Long) As Long        Dim tp As LongPtr        tp = TextPageHandle(Index)        If tp <> 0 Then CharCount = FPDFText_CountChars(tp)    End Function    Public Function GetText(ByVal Index As Long, Optional ByVal StartChar As Long = 0, Optional ByVal Count As Long = -1) As String        Dim tp As LongPtr, n As Long, buf As String, r As Long        tp = TextPageHandle(Index)        If tp = 0 Then Exit Function        n = FPDFText_CountChars(tp)        If StartChar < 0 Then StartChar = 0        If StartChar >= n Then Exit Function        If Count < 0 Or StartChar + Count > n Then Count = n - StartChar        If Count <= 0 Then Exit Function        buf = String$(Count + 1, vbNullChar)        r = FPDFText_GetText(tp, StartChar, Count, StrPtr(buf))        If r > 1 Then GetText = Left$(buf, r - 1)    End Function    Private Sub Class_Terminate()        CloseDocument        If m_Acquired Then            PdfiumRelease            m_Acquired = False        End If    End SubEnd Class