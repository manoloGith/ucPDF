' ============================================================================'  PdfFormData.twin'  Datos de formularios: exportar e importar los valores de los campos.''  Formatos:'    xfdf  XML de Adobe (XFDF 3.0). Lo importa y exporta Acrobat.'    fdf   Forms Data Format de Adobe (PDF de solo datos).'    ini   [Campos] Nombre=Valor, legible y facil de generar desde otro'          programa. Saltos de linea como \n y "\" como \\.'  Valores: casillas y radios con su valor de exportacion u "Off"; listas de'  seleccion multiple con las opciones separadas por "|".' ============================================================================[Description("Exportacion e importacion de datos de formularios PDF")]Module PdfFormData    ' Formato a partir de la extension (xfdf por defecto).    Public Function FormDataFormat(ByVal Path As String, Optional ByVal DataFormat As String) As String        Dim ext As String, p As Long        DataFormat = LCase$(Trim$(DataFormat))        If Len(DataFormat) > 0 Then            If DataFormat = "xml" Then DataFormat = "xfdf"            If DataFormat = "txt" Then DataFormat = "ini"            FormDataFormat = DataFormat            Exit Function        End If        p = InStrRev(Path, ".")        If p > 0 Then ext = LCase$(Mid$(Path, p + 1))        Select Case ext            Case "fdf": FormDataFormat = "fdf"            Case "ini", "txt": FormDataFormat = "ini"            Case Else: FormDataFormat = "xfdf"        End Select    End Function    ' Nombres y valores de los campos con valor (sin botones ni firmas).    Public Function CollectFormData(ByVal Doc As PdfDocument, ByRef Names() As String, ByRef Values() As String, ByRef Types() As Long) As Long        Dim k As Long, n As Long, total As Long        total = Doc.FieldCount        If total = 0 Then Exit Function        ReDim Names(0 To total - 1)        ReDim Values(0 To total - 1)        ReDim Types(0 To total - 1)        For k = 0 To total - 1            If Doc.FieldHasValue(k) Then                Names(n) = Doc.FieldName(k)                Values(n) = Doc.FieldValue(k)                Types(n) = Doc.FieldType(k)                n = n + 1            End If        Next        CollectFormData = n    End Function    ' Texto del archivo de datos en el formato indicado.    Public Function FormDataText(ByVal Doc As PdfDocument, Optional ByVal DataFormat As String = "xfdf", Optional ByRef Count As Long) As String        Dim names() As String, values() As String, types() As Long, n As Long        n = CollectFormData(Doc, names, values, types)        Count = n        Select Case LCase$(DataFormat)            Case "fdf": FormDataText = BuildFdf(names, values, types, n, PathFileName(Doc.FileName))            Case "ini": FormDataText = BuildIni(names, values, n, PathFileName(Doc.FileName))            Case Else: FormDataText = BuildXfdf(names, values, types, n, PathFileName(Doc.FileName))        End Select    End Function    ' Guarda los valores del formulario. Devuelve cuantos campos (-1 si falla).    Public Function ExportFormData(ByVal Doc As PdfDocument, ByVal Path As String, Optional ByVal DataFormat As String) As Long        Dim t As String, n As Long, fmt As String, ok As Boolean        ExportFormData = -1        If Doc Is Nothing Then Exit Function        If Not Doc.IsOpen Then Exit Function        Doc.CommitForm        fmt = FormDataFormat(Path, DataFormat)        t = FormDataText(Doc, fmt, n)        Select Case fmt            Case "fdf": ok = WriteTextFile(Path, t, "utf8nobom")     ' solo ASCII            Case "ini": ok = WriteTextFile(Path, t, "utf16")            Case Else: ok = WriteTextFile(Path, t, "utf8")        End Select        If ok Then ExportFormData = n    End Function    ' Lee un archivo de datos. Devuelve cuantos pares nombre/valor (-1 si no se pudo leer).    Public Function ReadFormData(ByVal Path As String, ByRef Names() As String, ByRef Values() As String, Optional ByVal DataFormat As String) As Long        Select Case FormDataFormat(Path, DataFormat)            Case "fdf": ReadFormData = ReadFdf(Path, Names, Values)            Case "ini": ReadFormData = ReadIniData(Path, Names, Values)            Case Else: ReadFormData = ReadXfdf(Path, Names, Values)        End Select    End Function    ' Aplica un archivo de datos al documento. Devuelve los campos asignados    ' (-1 si no se pudo leer). Missing: nombres que no existen; Failed: valores    ' no aplicables (solo lectura, opcion inexistente...). Report: detalle.    Public Function ImportFormData(ByVal Doc As PdfDocument, ByVal Path As String, Optional ByVal DataFormat As String, Optional ByRef Missing As Long, Optional ByRef Failed As Long, Optional ByRef Report As String) As Long        Dim names() As String, values() As String, n As Long        Missing = 0: Failed = 0: Report = ""        ImportFormData = -1        If Doc Is Nothing Then Exit Function        If Not Doc.IsOpen Then Exit Function        n = ReadFormData(Path, names, values, DataFormat)        If n < 0 Then Exit Function        ImportFormData = ApplyFormValues(Doc, names, values, n, Missing, Failed, Report)    End Function    Public Function ApplyFormValues(ByVal Doc As PdfDocument, ByRef Names() As String, ByRef Values() As String, ByVal Count As Long, Optional ByRef Missing As Long, Optional ByRef Failed As Long, Optional ByRef Report As String) As Long        Dim k As Long, idx As Long, applied As Long        Missing = 0: Failed = 0: Report = ""        For k = 0 To Count - 1            idx = Doc.FindField(Names(k))            If idx < 0 Then                Missing = Missing + 1                Report = Report & "No existe el campo: " & Names(k) & vbCrLf            ElseIf Not Doc.FieldHasValue(idx) Then                ' botones y firmas: se ignoran            ElseIf SameValue(Doc.FieldValue(idx), Values(k)) Then                ' ya tiene ese valor (tambien los de solo lectura)                applied = applied + 1            ElseIf Doc.SetFieldValue(idx, Values(k)) Then                applied = applied + 1            Else                Failed = Failed + 1                Report = Report & "No se pudo asignar " & Names(k) & " = " & Values(k) & vbCrLf            End If        Next        ApplyFormValues = applied    End Function    Private Function SameValue(ByVal a As String, ByVal b As String) As Boolean        a = Replace$(Replace$(a, vbCrLf, vbLf), vbCr, vbLf)        b = Replace$(Replace$(b, vbCrLf, vbLf), vbCr, vbLf)        SameValue = (a = b)    End Function    ' Lista de campos: Nombre<TAB>Tipo<TAB>Pagina<TAB>Valor<TAB>Opciones<TAB>Indicadores    Public Function FormFieldsReport(ByVal Doc As PdfDocument) As String        Dim k As Long, r As String, fl As String        For k = 0 To Doc.FieldCount - 1            fl = ""            If Doc.FieldReadOnly(k) Then fl = fl & "solo-lectura "            If Doc.FieldRequired(k) Then fl = fl & "obligatorio "            If (Doc.FieldFlags(k) And FPDF_FORMFLAG_TEXT_MULTILINE) <> 0 And Doc.FieldType(k) = FPDF_FORMFIELD_TEXTFIELD Then fl = fl & "multilinea "            If (Doc.FieldFlags(k) And FPDF_FORMFLAG_CHOICE_MULTI_SELECT) <> 0 And Doc.FieldType(k) = FPDF_FORMFIELD_LISTBOX Then fl = fl & "multiple "            r = r & Doc.FieldName(k) & vbTab & Doc.FieldTypeName(k) & vbTab & CStr(Doc.FieldPage(k) + 1) & vbTab & EscapeValue(Doc.FieldValue(k)) & vbTab & Doc.FieldOptions(k) & vbTab & Trim$(fl) & vbCrLf        Next        FormFieldsReport = r    End Function    ' ------------------------------------------------------------------------    '  INI    ' ------------------------------------------------------------------------    Public Function EscapeValue(ByVal v As String) As String        v = Replace$(v, "\", "\\")        v = Replace$(v, vbCrLf, "\n")        v = Replace$(v, vbCr, "\n")        v = Replace$(v, vbLf, "\n")        v = Replace$(v, vbTab, "\t")        EscapeValue = v    End Function    Public Function UnescapeValue(ByVal v As String) As String        Dim i As Long, c As String, r As String        If InStr(1, v, "\") = 0 Then UnescapeValue = v: Exit Function        i = 1        Do While i <= Len(v)            c = Mid$(v, i, 1)            If c = "\" And i < Len(v) Then                i = i + 1                Select Case Mid$(v, i, 1)                    Case "n": r = r & vbLf                    Case "t": r = r & vbTab                    Case "r": r = r & vbCr                    Case Else: r = r & Mid$(v, i, 1)                End Select            Else                r = r & c            End If            i = i + 1        Loop        UnescapeValue = r    End Function    Private Function BuildIni(ByRef Names() As String, ByRef Values() As String, ByVal n As Long, ByVal DocName As String) As String        Dim k As Long, r As String        r = "; Datos de formulario de ucPDF" & vbCrLf & _            "; Nombre=Valor. Casillas y radios: valor de exportacion u Off." & vbCrLf & _            "; Listas multiples: opciones separadas por |. Saltos de linea: \n" & vbCrLf & _            "[Info]" & vbCrLf        If Len(DocName) > 0 Then r = r & "Documento=" & DocName & vbCrLf        r = r & "Total=" & CStr(n) & vbCrLf & vbCrLf & "[Campos]" & vbCrLf        For k = 0 To n - 1            r = r & Names(k) & "=" & EscapeValue(Values(k)) & vbCrLf        Next        BuildIni = r    End Function    ' Lee [Campos] (o [Fields]); sin secciones, todas las claves.    Private Function ReadIniData(ByVal Path As String, ByRef Names() As String, ByRef Values() As String) As Long        Dim text As String, ok As Boolean, lines() As String, k As Long, ln As String, sect As String, eq As Long, n As Long, hasSections As Boolean, lt As String        text = ReadAllText(Path, ok)        If Not ok Then ReadIniData = -1: Exit Function        lines = Split(Replace$(Replace$(text, vbCrLf, vbLf), vbCr, vbLf), vbLf)        For k = 0 To UBound(lines)            lt = Trim$(lines(k))            If Left$(lt, 1) = "[" And Right$(lt, 1) = "]" Then hasSections = True: Exit For        Next        For k = 0 To UBound(lines)            ln = lines(k)            lt = Trim$(ln)            If Len(lt) = 0 Or Left$(lt, 1) = ";" Or Left$(lt, 1) = "#" Then                ' vacia o comentario            ElseIf Left$(lt, 1) = "[" And Right$(lt, 1) = "]" Then                sect = LCase$(Trim$(Mid$(lt, 2, Len(lt) - 2)))            ElseIf sect = "campos" Or sect = "fields" Or Not hasSections Then                eq = InStr(1, ln, "=")                If eq > 1 Then                    ReDim Preserve Names(0 To n)                    ReDim Preserve Values(0 To n)                    Names(n) = Trim$(Left$(ln, eq - 1))                    Values(n) = UnescapeValue(Mid$(ln, eq + 1))                    n = n + 1                End If            End If        Next        ReadIniData = n    End Function    ' ------------------------------------------------------------------------    '  Arbol de nombres "a.b.c" (comun a XFDF y FDF)    '  Los campos se ordenan por nombre y se abren/cierran los niveles    '  intermedios. Emit recibe: 0 abrir nivel, 1 cerrar nivel, 2 hoja.    ' ------------------------------------------------------------------------    Private Function SortedOrder(ByRef Names() As String, ByVal n As Long) As Long()        Dim o() As Long, i As Long, j As Long, t As Long        If n <= 0 Then Exit Function        ReDim o(0 To n - 1)        For i = 0 To n - 1            o(i) = i        Next        ' Insercion estable (n pequeno)        For i = 1 To n - 1            t = o(i)            j = i - 1            Do While j >= 0                If StrComp(Names(o(j)), Names(t), vbBinaryCompare) <= 0 Then Exit Do                o(j + 1) = o(j)                j = j - 1            Loop            o(j + 1) = t        Next        SortedOrder = o    End Function    ' ------------------------------------------------------------------------    '  XFDF    ' ------------------------------------------------------------------------    Private Function XmlEsc(ByVal s As String) As String        s = Replace$(s, "&", "&amp;")        s = Replace$(s, "<", "&lt;")        s = Replace$(s, ">", "&gt;")        s = Replace$(s, """", "&quot;")        s = Replace$(s, vbCrLf, vbLf)        s = Replace$(s, vbCr, vbLf)        s = Replace$(s, vbLf, "&#10;")        s = Replace$(s, vbTab, "&#9;")        XmlEsc = s    End Function    Private Function BuildXfdf(ByRef Names() As String, ByRef Values() As String, ByRef Types() As Long, ByVal n As Long, ByVal DocName As String) As String        Dim o() As Long, k As Long, parts() As String, stk() As String, depth As Long, common As Long, j As Long, r As String, ind As String, vals() As String, i As Long        r = "<?xml version=""1.0"" encoding=""UTF-8""?>" & vbCrLf & _            "<xfdf xmlns=""http://ns.adobe.com/xfdf/"" xml:space=""preserve"">" & vbCrLf        If Len(DocName) > 0 Then r = r & "  <f href=""" & XmlEsc(DocName) & """/>" & vbCrLf        r = r & "  <fields>" & vbCrLf        ReDim stk(0 To 0)        If n > 0 Then            o = SortedOrder(Names, n)            For k = 0 To n - 1                parts = Split(Names(o(k)), ".")                ' Niveles comunes con el campo anterior                common = 0                Do While common < depth And common < UBound(parts)                    If stk(common) <> parts(common) Then Exit Do                    common = common + 1                Loop                Do While depth > common                    depth = depth - 1                    r = r & Space$(4 + depth * 2) & "</field>" & vbCrLf                Loop                For j = common To UBound(parts) - 1                    If depth > UBound(stk) Then ReDim Preserve stk(0 To depth)                    stk(depth) = parts(j)                    r = r & Space$(4 + depth * 2) & "<field name=""" & XmlEsc(parts(j)) & """>" & vbCrLf                    depth = depth + 1                Next                ind = Space$(4 + depth * 2)                r = r & ind & "<field name=""" & XmlEsc(parts(UBound(parts))) & """>"                If InStr(1, Values(o(k)), "|") > 0 And Types(o(k)) = FPDF_FORMFIELD_LISTBOX Then                    vals = Split(Values(o(k)), "|")                    For i = 0 To UBound(vals)                        r = r & "<value>" & XmlEsc(vals(i)) & "</value>"                    Next                Else                    r = r & "<value>" & XmlEsc(Values(o(k))) & "</value>"                End If                r = r & "</field>" & vbCrLf            Next            Do While depth > 0                depth = depth - 1                r = r & Space$(4 + depth * 2) & "</field>" & vbCrLf            Loop        End If        r = r & "  </fields>" & vbCrLf & "</xfdf>" & vbCrLf        BuildXfdf = r    End Function    ' XFDF con MSXML (incluido en Windows). Los <field> anidados forman    ' nombres "padre.hijo"; varios <value> se unen con "|".    Private Function ReadXfdf(ByVal Path As String, ByRef Names() As String, ByRef Values() As String) As Long        Dim dom As Object, n As Long        ReadXfdf = -1        On Error Resume Next        Set dom = CreateObject("MSXML2.DOMDocument.6.0")        If dom Is Nothing Then Set dom = CreateObject("MSXML2.DOMDocument")        On Error GoTo Failed        If dom Is Nothing Then Exit Function        dom.async = False        dom.validateOnParse = False        dom.resolveExternals = False        dom.preserveWhiteSpace = True        If Not dom.Load(Path) Then Exit Function        If dom.documentElement Is Nothing Then Exit Function        XfdfWalk dom.documentElement, "", Names, Values, n        ReadXfdf = n        Exit Function    Failed:        ReadXfdf = -1    End Function    Private Sub XfdfWalk(ByVal Node As Object, ByVal Prefix As String, ByRef Names() As String, ByRef Values() As String, ByRef n As Long)        Dim i As Long, j As Long, nd As Object, vn As Object, nm As String, full As String, v As String, hasVal As Boolean        For i = 0 To Node.childNodes.length - 1            Set nd = Node.childNodes.Item(i)            If nd.nodeType = 1 Then                If LCase$(nd.baseName) = "field" Then                    nm = ""                    If Not IsNull(nd.getAttribute("name")) Then nm = nd.getAttribute("name")                    If Len(Prefix) > 0 Then full = Prefix & "." & nm Else full = nm                    v = ""                    hasVal = False                    For j = 0 To nd.childNodes.length - 1                        Set vn = nd.childNodes.Item(j)                        If vn.nodeType = 1 Then                            If LCase$(vn.baseName) = "value" Or LCase$(vn.baseName) = "value-richtext" Then                                If hasVal Then v = v & "|"                                v = v & vn.Text                                hasVal = True                            End If                        End If                    Next                    If hasVal And Len(full) > 0 Then                        ReDim Preserve Names(0 To n)                        ReDim Preserve Values(0 To n)                        Names(n) = full                        Values(n) = v                        n = n + 1                    End If                    XfdfWalk nd, full, Names, Values, n                ElseIf LCase$(nd.baseName) <> "value" And LCase$(nd.baseName) <> "value-richtext" Then                    XfdfWalk nd, Prefix, Names, Values, n                End If            End If        Next    End Sub    ' ------------------------------------------------------------------------    '  FDF    ' ------------------------------------------------------------------------    ' Cadena PDF en hexadecimal UTF-16BE con BOM: <FEFF...>    Private Function PdfHexString(ByVal s As String) As String        Dim i As Long, r As String, c As Long        r = "<FEFF"        For i = 1 To Len(s)            c = AscW(Mid$(s, i, 1)) And &HFFFF&            r = r & Right$("000" & Hex$(c), 4)        Next        PdfHexString = r & ">"    End Function    ' Nombre PDF (/Valor) con #XX para lo que no es ASCII imprimible.    Private Function PdfName(ByVal s As String) As String        Dim b() As Byte, i As Long, r As String, c As Long        r = "/"        If Len(s) = 0 Then PdfName = r: Exit Function        b = Utf8z(s)        For i = 0 To UBound(b) - 1            c = b(i)            If c < &H21 Or c > &H7E Or InStr(1, "()<>[]{}/%#", Chr$(c)) > 0 Then                r = r & "#" & Right$("0" & Hex$(c), 2)            Else                r = r & Chr$(c)            End If        Next        PdfName = r    End Function    Private Function FdfValue(ByVal v As String, ByVal FieldTypeValue As Long) As String        Dim parts() As String, i As Long, r As String        Select Case FieldTypeValue            Case FPDF_FORMFIELD_CHECKBOX, FPDF_FORMFIELD_RADIOBUTTON                If Len(v) = 0 Then v = "Off"                FdfValue = PdfName(v)            Case FPDF_FORMFIELD_LISTBOX                If InStr(1, v, "|") > 0 Then                    parts = Split(v, "|")                    r = "["                    For i = 0 To UBound(parts)                        r = r & PdfHexString(parts(i)) & " "                    Next                    FdfValue = RTrim$(r) & "]"                Else                    FdfValue = PdfHexString(v)                End If            Case Else                FdfValue = PdfHexString(Replace$(Replace$(v, vbCrLf, vbCr), vbLf, vbCr))        End Select    End Function    Private Function BuildFdf(ByRef Names() As String, ByRef Values() As String, ByRef Types() As Long, ByVal n As Long, ByVal DocName As String) As String        Dim o() As Long, k As Long, parts() As String, stk() As String, depth As Long, common As Long, j As Long, r As String        r = "%FDF-1.2" & vbCrLf & "1 0 obj" & vbCrLf & "<< /FDF << "        If Len(DocName) > 0 Then r = r & "/F " & PdfHexString(DocName) & " "        r = r & "/Fields [" & vbCrLf        ReDim stk(0 To 0)        If n > 0 Then            o = SortedOrder(Names, n)            For k = 0 To n - 1                parts = Split(Names(o(k)), ".")                common = 0                Do While common < depth And common < UBound(parts)                    If stk(common) <> parts(common) Then Exit Do                    common = common + 1                Loop                Do While depth > common                    depth = depth - 1                    r = r & "] >>" & vbCrLf                Loop                For j = common To UBound(parts) - 1                    If depth > UBound(stk) Then ReDim Preserve stk(0 To depth)                    stk(depth) = parts(j)                    r = r & "<< /T " & PdfHexString(parts(j)) & " /Kids [" & vbCrLf                    depth = depth + 1                Next                r = r & "<< /T " & PdfHexString(parts(UBound(parts))) & " /V " & FdfValue(Values(o(k)), Types(o(k))) & " >>" & vbCrLf            Next            Do While depth > 0                depth = depth - 1                r = r & "] >>" & vbCrLf            Loop        End If        r = r & "] >> >>" & vbCrLf & "endobj" & vbCrLf & "trailer" & vbCrLf & "<< /Root 1 0 R >>" & vbCrLf & "%%EOF" & vbCrLf        BuildFdf = r    End Function    ' --- Lectura de FDF: analizador minimo de objetos PDF ---    ' El archivo se carga como cadena de "bytes" (un caracter por byte).    Private m_F As String    Private m_P As Long    Private m_FN() As String    Private m_FV() As String    Private m_FCount As Long    Private Function ReadFdf(ByVal Path As String, ByRef Names() As String, ByRef Values() As String) As Long        Dim p As Long        ReadFdf = -1        If Not LoadByteString(Path, m_F) Then Exit Function        m_FCount = 0        Erase m_FN        Erase m_FV        On Error GoTo Failed        p = InStr(1, m_F, "/Fields", vbBinaryCompare)        If p > 0 Then            m_P = p + 7            ParseFieldArray ""        End If        If m_FCount > 0 Then            Names = m_FN            Values = m_FV        End If        ReadFdf = m_FCount    Failed:        m_F = ""    End Function    Private Function LoadByteString(ByVal Path As String, ByRef Result As String) As Boolean        Dim h As LongPtr, n As Long, hi As Long, b() As Byte, got As Long, w() As Integer, i As Long        h = CreateFileW(StrPtr(Path), GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)        If h = -1 Or h = 0 Then Exit Function        n = GetFileSize(h, hi)        If hi <> 0 Or n <= 0 Then CloseHandle h: Exit Function        ReDim b(0 To n - 1)        If ReadFile(h, VarPtr(b(0)), n, got, 0) = 0 Or got <> n Then CloseHandle h: Exit Function        CloseHandle h        ReDim w(0 To n - 1)        For i = 0 To n - 1            w(i) = b(i)        Next        Result = String$(n, vbNullChar)        CopyMemory ByVal StrPtr(Result), w(0), CLngPtr(n) * 2        LoadByteString = True    End Function    Private Function Ch(ByVal Pos As Long) As Long        If Pos >= 1 And Pos <= Len(m_F) Then Ch = AscW(Mid$(m_F, Pos, 1)) Else Ch = -1    End Function    Private Function IsWs(ByVal c As Long) As Boolean        IsWs = (c = 32 Or c = 9 Or c = 10 Or c = 13 Or c = 12 Or c = 0)    End Function    Private Function IsDelim(ByVal c As Long) As Boolean        IsDelim = IsWs(c) Or c = 40 Or c = 41 Or c = 60 Or c = 62 Or c = 91 Or c = 93 Or c = 123 Or c = 125 Or c = 47 Or c = 37 Or c = -1    End Function    Private Sub SkipWs()        Dim c As Long        Do            c = Ch(m_P)            If IsWs(c) Then                m_P = m_P + 1            ElseIf c = 37 Then                      ' % comentario                Do While m_P <= Len(m_F)                    c = Ch(m_P)                    If c = 10 Or c = 13 Then Exit Do                    m_P = m_P + 1                Loop            Else                Exit Do            End If        Loop    End Sub    ' [ << ... >> << ... >> ]    Private Sub ParseFieldArray(ByVal Prefix As String)        SkipWs        If Ch(m_P) <> 91 Then Exit Sub              ' [        m_P = m_P + 1        Do            SkipWs            If m_P > Len(m_F) Then Exit Sub            If Ch(m_P) = 93 Then m_P = m_P + 1: Exit Sub            If Ch(m_P) = 60 And Ch(m_P + 1) = 60 Then                ParseFieldDict Prefix            Else                SkipValue                            ' referencias "n 0 R" u otros: se ignoran            End If        Loop    End Sub    Private Sub ParseFieldDict(ByVal Prefix As String)        Dim key As String, t As String, hasT As Boolean, v As String, hasV As Boolean, kids As Long, save As Long, full As String        m_P = m_P + 2                                ' <<        Do            SkipWs            If m_P > Len(m_F) Then Exit Do            If Ch(m_P) = 62 And Ch(m_P + 1) = 62 Then m_P = m_P + 2: Exit Do            If Ch(m_P) = 47 Then                key = ReadName()                SkipWs                Select Case key                    Case "T"                        t = ReadValueText(): hasT = True                    Case "V"                        v = ReadValueText(): hasV = True                    Case "Kids"                        kids = m_P                        SkipValue                    Case Else                        SkipValue                End Select            Else                SkipValue            End If        Loop        If hasT Then            If Len(Prefix) > 0 Then full = Prefix & "." & t Else full = t        Else            full = Prefix        End If        If hasV And Len(full) > 0 Then            ReDim Preserve m_FN(0 To m_FCount)            ReDim Preserve m_FV(0 To m_FCount)            m_FN(m_FCount) = full            m_FV(m_FCount) = v            m_FCount = m_FCount + 1        End If        If kids > 0 Then            save = m_P            m_P = kids            ParseFieldArray full            m_P = save        End If    End Sub    ' Valor como texto: cadena, nombre o array (elementos unidos con "|").    Private Function ReadValueText() As String        Dim c As Long, r As String, first As Boolean, st As Long        SkipWs        c = Ch(m_P)        If c = 40 Then            ReadValueText = DecodePdfString(ReadLiteral())        ElseIf c = 60 And Ch(m_P + 1) <> 60 Then            ReadValueText = DecodePdfString(ReadHex())        ElseIf c = 47 Then            ReadValueText = ReadName()        ElseIf c = 91 Then            m_P = m_P + 1            first = True            Do                SkipWs                If m_P > Len(m_F) Then Exit Do                If Ch(m_P) = 93 Then m_P = m_P + 1: Exit Do                If Not first Then r = r & "|"                r = r & ReadValueText()                first = False            Loop            ReadValueText = r        Else            ' numero, true/false...: el texto del token            st = m_P            SkipValue            ReadValueText = Trim$(Mid$(m_F, st, m_P - st))        End If    End Function    Private Sub SkipValue()        Dim c As Long, lvl As Long        SkipWs        c = Ch(m_P)        If c = 40 Then            ReadLiteral        ElseIf c = 60 And Ch(m_P + 1) = 60 Then            m_P = m_P + 2            Do                SkipWs                If m_P > Len(m_F) Then Exit Do                If Ch(m_P) = 62 And Ch(m_P + 1) = 62 Then m_P = m_P + 2: Exit Do                SkipValue            Loop        ElseIf c = 60 Then            ReadHex        ElseIf c = 91 Then            m_P = m_P + 1            Do                SkipWs                If m_P > Len(m_F) Then Exit Do                If Ch(m_P) = 93 Then m_P = m_P + 1: Exit Do                SkipValue            Loop        ElseIf c = 47 Then            ReadName        ElseIf c = 41 Or c = 62 Or c = 93 Or c = 125 Or c = 123 Then            m_P = m_P + 1                            ' delimitador suelto        Else            ' numero, true/false/null, R...            m_P = m_P + 1            Do While Not IsDelim(Ch(m_P))                m_P = m_P + 1            Loop        End If    End Sub    Private Function ReadName() As String        Dim r As String, c As Long, b() As Byte, n As Long, hx As String        m_P = m_P + 1                                ' /        ReDim b(0 To 63)        Do While Not IsDelim(Ch(m_P))            c = Ch(m_P)            If c = 35 And m_P + 2 <= Len(m_F) Then   ' #XX                hx = Mid$(m_F, m_P + 1, 2)                c = CLng("&H" & hx)                m_P = m_P + 3            Else                m_P = m_P + 1            End If            If n > UBound(b) Then ReDim Preserve b(0 To n * 2)            b(n) = c And &HFF            n = n + 1        Loop        If n = 0 Then Exit Function        ReadName = DecodeUtf8OrLatin1(b, n)    End Function    ' Cadena literal ( ... ) con escapes; devuelve los bytes como caracteres.    Private Function ReadLiteral() As String        Dim r As String, c As Long, lvl As Long, d As Long, k As Long        m_P = m_P + 1        lvl = 1        Do While m_P <= Len(m_F)            c = Ch(m_P)            If c = 92 Then                           ' \                m_P = m_P + 1                c = Ch(m_P)                Select Case c                    Case 110: r = r & Chr$(10): m_P = m_P + 1          ' n                    Case 114: r = r & Chr$(13): m_P = m_P + 1          ' r                    Case 116: r = r & Chr$(9): m_P = m_P + 1           ' t                    Case 98: r = r & Chr$(8): m_P = m_P + 1            ' b                    Case 102: r = r & Chr$(12): m_P = m_P + 1          ' f                    Case 13                                             ' continuacion de linea                        m_P = m_P + 1                        If Ch(m_P) = 10 Then m_P = m_P + 1                    Case 10                        m_P = m_P + 1                    Case 48 To 55                                       ' octal \ddd                        d = 0                        For k = 1 To 3                            c = Ch(m_P)                            If c < 48 Or c > 55 Then Exit For                            d = d * 8 + (c - 48)                            m_P = m_P + 1                        Next                        r = r & ChrW$(d And &HFF)                    Case -1                        Exit Do                    Case Else                                           ' \( \) \\ y otros                        r = r & ChrW$(c)                        m_P = m_P + 1                End Select            Else                If c = 40 Then lvl = lvl + 1                If c = 41 Then                    lvl = lvl - 1                    If lvl = 0 Then m_P = m_P + 1: Exit Do                End If                r = r & ChrW$(c)                m_P = m_P + 1            End If        Loop        ReadLiteral = r    End Function    Private Function ReadHex() As String        Dim r As String, c As Long, hx As String        m_P = m_P + 1        Do While m_P <= Len(m_F)            c = Ch(m_P)            m_P = m_P + 1            If c = 62 Then Exit Do            If (c >= 48 And c <= 57) Or (c >= 65 And c <= 70) Or (c >= 97 And c <= 102) Then                hx = hx & ChrW$(c)                If Len(hx) = 2 Then                    r = r & ChrW$(CLng("&H" & hx))                    hx = ""                End If            End If        Loop        If Len(hx) = 1 Then r = r & ChrW$(CLng("&H" & hx & "0"))        ReadHex = r    End Function    ' Bytes de una cadena PDF -> texto: UTF-16BE (BOM FE FF), UTF-8 (BOM) o PDFDocEncoding (~Latin-1).    Private Function DecodePdfString(ByVal Raw As String) As String        Dim i As Long, r As String, b() As Byte, n As Long        If Len(Raw) >= 2 Then            If AscW(Mid$(Raw, 1, 1)) = &HFE And AscW(Mid$(Raw, 2, 1)) = &HFF Then                For i = 3 To Len(Raw) - 1 Step 2                    r = r & ChrW$(AscW(Mid$(Raw, i, 1)) * 256& + AscW(Mid$(Raw, i + 1, 1)))                Next                DecodePdfString = r                Exit Function            End If        End If        If Len(Raw) >= 3 Then            If AscW(Mid$(Raw, 1, 1)) = &HEF And AscW(Mid$(Raw, 2, 1)) = &HBB And AscW(Mid$(Raw, 3, 1)) = &HBF Then                n = Len(Raw) - 3                If n = 0 Then Exit Function                ReDim b(0 To n - 1)                For i = 0 To n - 1                    b(i) = AscW(Mid$(Raw, i + 4, 1)) And &HFF                Next                DecodePdfString = DecodeUtf8OrLatin1(b, n)                Exit Function            End If        End If        DecodePdfString = Raw    End Function    Private Function DecodeUtf8OrLatin1(ByRef b() As Byte, ByVal n As Long) As String        Dim cch As Long, s As String, i As Long        cch = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, VarPtr(b(0)), n, 0, 0)        If cch > 0 Then            s = String$(cch, vbNullChar)            MultiByteToWideChar CP_UTF8, 0, VarPtr(b(0)), n, StrPtr(s), cch        Else            For i = 0 To n - 1                s = s & ChrW$(b(i))            Next        End If        DecodeUtf8OrLatin1 = s    End FunctionEnd Module