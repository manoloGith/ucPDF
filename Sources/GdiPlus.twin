' ============================================================================'  GdiPlus.twin'  API plana de GDI+ (gdiplus.dll, incluida en Windows) para dibujar la barra'  de herramientas: iconos vectoriales con antialias, fondos redondeados y'  texto. Sin dependencias de terceros. Valido para Win32 y Win64.' ============================================================================[Description("API plana de GDI+ y utilidades de dibujo")]Module GdiPlus    Public Type GdiplusStartupInput        GdiplusVersion As Long        DebugEventCallback As LongPtr        SuppressBackgroundThread As Long        SuppressExternalCodecs As Long    End Type    Public Type POINTF        X As Single        Y As Single    End Type    Public Type RECTF        Left As Single        Top As Single        Width As Single        Height As Single    End Type    Public Const GP_OK As Long = 0    Public Const UnitPixel As Long = 2    Public Const SmoothingModeAntiAlias As Long = 4    Public Const PixelOffsetModeHalf As Long = 4    Public Const TextRenderingHintClearTypeGridFit As Long = 5    Public Const LineCapRound As Long = 2    Public Const LineJoinRound As Long = 2    Public Const FillModeAlternate As Long = 0    Public Const StringAlignmentNear As Long = 0    Public Const StringAlignmentCenter As Long = 1    Public Const StringFormatFlagsNoWrap As Long = &H1000    Public Const StringTrimmingEllipsisCharacter As Long = 3    Public Const FontStyleRegular As Long = 0    Public Const FontStyleBold As Long = 1    Public Const StringFormatFlagsMeasureTrailingSpaces As Long = &H800    Public Const CombineModeReplace As Long = 0    Public Const DashStyleDash As Long = 1    Public Declare PtrSafe Function GdiplusStartup Lib "gdiplus" (ByRef token As LongPtr, ByRef inputbuf As GdiplusStartupInput, ByVal outputbuf As LongPtr) As Long    Public Declare PtrSafe Sub GdiplusShutdown Lib "gdiplus" (ByVal token As LongPtr)    Public Declare PtrSafe Function GdipCreateFromHDC Lib "gdiplus" (ByVal hdc As LongPtr, ByRef graphics As LongPtr) As Long    Public Declare PtrSafe Function GdipDeleteGraphics Lib "gdiplus" (ByVal graphics As LongPtr) As Long    Public Declare PtrSafe Function GdipSetSmoothingMode Lib "gdiplus" (ByVal graphics As LongPtr, ByVal mode As Long) As Long    Public Declare PtrSafe Function GdipSetPixelOffsetMode Lib "gdiplus" (ByVal graphics As LongPtr, ByVal mode As Long) As Long    Public Declare PtrSafe Function GdipSetTextRenderingHint Lib "gdiplus" (ByVal graphics As LongPtr, ByVal mode As Long) As Long    Public Declare PtrSafe Function GdipCreatePen1 Lib "gdiplus" (ByVal argb As Long, ByVal penWidth As Single, ByVal unit As Long, ByRef pen As LongPtr) As Long    Public Declare PtrSafe Function GdipSetPenStartCap Lib "gdiplus" (ByVal pen As LongPtr, ByVal cap As Long) As Long    Public Declare PtrSafe Function GdipSetPenEndCap Lib "gdiplus" (ByVal pen As LongPtr, ByVal cap As Long) As Long    Public Declare PtrSafe Function GdipSetPenLineJoin Lib "gdiplus" (ByVal pen As LongPtr, ByVal lineJoin As Long) As Long    Public Declare PtrSafe Function GdipDeletePen Lib "gdiplus" (ByVal pen As LongPtr) As Long    Public Declare PtrSafe Function GdipCreateSolidFill Lib "gdiplus" (ByVal argb As Long, ByRef brush As LongPtr) As Long    Public Declare PtrSafe Function GdipDeleteBrush Lib "gdiplus" (ByVal brush As LongPtr) As Long    Public Declare PtrSafe Function GdipDrawLine Lib "gdiplus" (ByVal graphics As LongPtr, ByVal pen As LongPtr, ByVal x1 As Single, ByVal y1 As Single, ByVal x2 As Single, ByVal y2 As Single) As Long    Public Declare PtrSafe Function GdipDrawRectangle Lib "gdiplus" (ByVal graphics As LongPtr, ByVal pen As LongPtr, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single) As Long    Public Declare PtrSafe Function GdipFillRectangle Lib "gdiplus" (ByVal graphics As LongPtr, ByVal brush As LongPtr, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single) As Long    Public Declare PtrSafe Function GdipDrawEllipse Lib "gdiplus" (ByVal graphics As LongPtr, ByVal pen As LongPtr, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single) As Long    Public Declare PtrSafe Function GdipDrawArc Lib "gdiplus" (ByVal graphics As LongPtr, ByVal pen As LongPtr, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal startAngle As Single, ByVal sweepAngle As Single) As Long    Public Declare PtrSafe Function GdipFillEllipse Lib "gdiplus" (ByVal graphics As LongPtr, ByVal brush As LongPtr, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single) As Long    Public Declare PtrSafe Function GdipSetPenDashStyle Lib "gdiplus" (ByVal pen As LongPtr, ByVal dashStyle As Long) As Long    ' Acceso GDI al DC mientras existe el objeto Graphics (vacia lo pendiente de GDI+)    Public Declare PtrSafe Function GdipGetDC Lib "gdiplus" (ByVal graphics As LongPtr, ByRef hdc As LongPtr) As Long    Public Declare PtrSafe Function GdipReleaseDC Lib "gdiplus" (ByVal graphics As LongPtr, ByVal hdc As LongPtr) As Long    Public Declare PtrSafe Function GdipFillPolygon Lib "gdiplus" (ByVal graphics As LongPtr, ByVal brush As LongPtr, ByRef points As POINTF, ByVal count As Long, ByVal fillMode As Long) As Long    Public Declare PtrSafe Function GdipDrawLines Lib "gdiplus" (ByVal graphics As LongPtr, ByVal pen As LongPtr, ByRef points As POINTF, ByVal count As Long) As Long    Public Declare PtrSafe Function GdipCreatePath Lib "gdiplus" (ByVal brushMode As Long, ByRef path As LongPtr) As Long    Public Declare PtrSafe Function GdipAddPathArc Lib "gdiplus" (ByVal path As LongPtr, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal startAngle As Single, ByVal sweepAngle As Single) As Long    Public Declare PtrSafe Function GdipClosePathFigure Lib "gdiplus" (ByVal path As LongPtr) As Long    Public Declare PtrSafe Function GdipFillPath Lib "gdiplus" (ByVal graphics As LongPtr, ByVal brush As LongPtr, ByVal path As LongPtr) As Long    Public Declare PtrSafe Function GdipDrawPath Lib "gdiplus" (ByVal graphics As LongPtr, ByVal pen As LongPtr, ByVal path As LongPtr) As Long    Public Declare PtrSafe Function GdipDeletePath Lib "gdiplus" (ByVal path As LongPtr) As Long    Public Declare PtrSafe Function GdipCreateFontFamilyFromName Lib "gdiplus" (ByVal name As LongPtr, ByVal fontCollection As LongPtr, ByRef fontFamily As LongPtr) As Long    Public Declare PtrSafe Function GdipDeleteFontFamily Lib "gdiplus" (ByVal fontFamily As LongPtr) As Long    Public Declare PtrSafe Function GdipCreateFont Lib "gdiplus" (ByVal fontFamily As LongPtr, ByVal emSize As Single, ByVal style As Long, ByVal unit As Long, ByRef font As LongPtr) As Long    Public Declare PtrSafe Function GdipDeleteFont Lib "gdiplus" (ByVal font As LongPtr) As Long    Public Declare PtrSafe Function GdipCreateStringFormat Lib "gdiplus" (ByVal formatAttributes As Long, ByVal language As Integer, ByRef format As LongPtr) As Long    Public Declare PtrSafe Function GdipSetStringFormatAlign Lib "gdiplus" (ByVal format As LongPtr, ByVal align As Long) As Long    Public Declare PtrSafe Function GdipSetStringFormatLineAlign Lib "gdiplus" (ByVal format As LongPtr, ByVal align As Long) As Long    Public Declare PtrSafe Function GdipSetStringFormatTrimming Lib "gdiplus" (ByVal format As LongPtr, ByVal trimming As Long) As Long    Public Declare PtrSafe Function GdipDeleteStringFormat Lib "gdiplus" (ByVal format As LongPtr) As Long    Public Declare PtrSafe Function GdipMeasureString Lib "gdiplus" (ByVal graphics As LongPtr, ByVal str As LongPtr, ByVal length As Long, ByVal font As LongPtr, ByRef layoutRect As RECTF, ByVal stringFormat As LongPtr, ByRef boundingBox As RECTF, ByVal codepointsFitted As LongPtr, ByVal linesFilled As LongPtr) As Long    Public Declare PtrSafe Function GdipStringFormatGetGenericTypographic Lib "gdiplus" (ByRef format As LongPtr) As Long    Public Declare PtrSafe Function GdipCloneStringFormat Lib "gdiplus" (ByVal format As LongPtr, ByRef newFormat As LongPtr) As Long    Public Declare PtrSafe Function GdipSetStringFormatFlags Lib "gdiplus" (ByVal format As LongPtr, ByVal flags As Long) As Long    Public Declare PtrSafe Function GdipSetClipRect Lib "gdiplus" (ByVal graphics As LongPtr, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal combineMode As Long) As Long    Public Declare PtrSafe Function GdipResetClip Lib "gdiplus" (ByVal graphics As LongPtr) As Long    Public Declare PtrSafe Function GdipDrawString Lib "gdiplus" (ByVal graphics As LongPtr, ByVal str As LongPtr, ByVal length As Long, ByVal font As LongPtr, ByRef layoutRect As RECTF, ByVal stringFormat As LongPtr, ByVal brush As LongPtr) As Long    ' --- Arranque con recuento de referencias -------------------------------    Private m_Token As LongPtr    Private m_Refs As Long    Public Function GdipAcquire() As Boolean        Dim si As GdiplusStartupInput        If m_Refs > 0 Then            m_Refs = m_Refs + 1            GdipAcquire = True            Exit Function        End If        On Error GoTo Failed        si.GdiplusVersion = 1        If GdiplusStartup(m_Token, si, 0) = GP_OK Then            m_Refs = 1            GdipAcquire = True        End If        Exit Function    Failed:        m_Token = 0    End Function    Public Sub GdipRelease()        If m_Refs <= 0 Then Exit Sub        m_Refs = m_Refs - 1        If m_Refs = 0 Then            GdiplusShutdown m_Token            m_Token = 0        End If    End Sub    ' --- Utilidades ---------------------------------------------------------    ' ARGB a partir de un COLORREF (&H00BBGGRR) y un alfa 0..255.    Public Function ArgbFromColorRef(ByVal ColorRef As Long, Optional ByVal Alpha As Long = 255) As Long        Dim a As Long        a = Alpha And &HFF&        If a >= &H80& Then            ArgbFromColorRef = ((a - &H100&) * &H1000000)        Else            ArgbFromColorRef = a * &H1000000        End If        ArgbFromColorRef = ArgbFromColorRef Or ((ColorRef And &HFF&) * &H10000) Or (ColorRef And &HFF00&) Or ((ColorRef And &HFF0000) \ &H10000)    End Function    Public Function PtF(ByVal X As Single, ByVal Y As Single) As POINTF        PtF.X = X        PtF.Y = Y    End Function    Public Function GpPen(ByVal Argb As Long, ByVal PenWidth As Single) As LongPtr        Dim p As LongPtr        GdipCreatePen1 Argb, PenWidth, UnitPixel, p        If p <> 0 Then            GdipSetPenStartCap p, LineCapRound            GdipSetPenEndCap p, LineCapRound            GdipSetPenLineJoin p, LineJoinRound        End If        GpPen = p    End Function    Public Function GpBrush(ByVal Argb As Long) As LongPtr        Dim b As LongPtr        GdipCreateSolidFill Argb, b        GpBrush = b    End Function    ' Trayecto de rectangulo con esquinas redondeadas (eliminar con GdipDeletePath).    Public Function GpRoundRect(ByVal X As Single, ByVal Y As Single, ByVal W As Single, ByVal H As Single, ByVal R As Single) As LongPtr        Dim p As LongPtr, d As Single        GdipCreatePath FillModeAlternate, p        If p = 0 Then Exit Function        d = R * 2        If d > W Then d = W        If d > H Then d = H        GdipAddPathArc p, X, Y, d, d, 180, 90        GdipAddPathArc p, X + W - d, Y, d, d, 270, 90        GdipAddPathArc p, X + W - d, Y + H - d, d, d, 0, 90        GdipAddPathArc p, X, Y + H - d, d, d, 90, 90        GdipClosePathFigure p        GpRoundRect = p    End Function    Public Sub GpFillRoundRect(ByVal g As LongPtr, ByVal X As Single, ByVal Y As Single, ByVal W As Single, ByVal H As Single, ByVal R As Single, ByVal FillArgb As Long, Optional ByVal BorderArgb As Long = 0, Optional ByVal BorderWidth As Single = 1)        Dim p As LongPtr, b As LongPtr, pn As LongPtr        p = GpRoundRect(X, Y, W, H, R)        If p = 0 Then Exit Sub        If FillArgb <> 0 Then            b = GpBrush(FillArgb)            GdipFillPath g, b, p            GdipDeleteBrush b        End If        If BorderArgb <> 0 Then            pn = GpPen(BorderArgb, BorderWidth)            GdipDrawPath g, pn, p            GdipDeletePen pn        End If        GdipDeletePath p    End Sub    ' Punta de flecha rellena en (x, y) apuntando en la direccion (dx, dy).    Public Sub GpArrowHead(ByVal g As LongPtr, ByVal Brush As LongPtr, ByVal x As Single, ByVal y As Single, ByVal dx As Single, ByVal dy As Single, ByVal Size As Single)        Dim l As Single, bx As Single, by As Single, nx As Single, ny As Single        l = Sqr(dx * dx + dy * dy)        If l = 0 Then Exit Sub        dx = dx / l        dy = dy / l        bx = x - dx * Size        by = y - dy * Size        nx = -dy * Size * 0.6        ny = dx * Size * 0.6        GpFillTriangle g, Brush, x, y, bx + nx, by + ny, bx - nx, by - ny    End Sub    ' Arco con flecha al final (iconos de girar). Angulos en grados, sentido    ' horario positivo como en GDI+.    Public Sub GpArcArrow(ByVal g As LongPtr, ByVal Pen As LongPtr, ByVal Brush As LongPtr, ByVal cx As Single, ByVal cy As Single, ByVal r As Single, ByVal StartAngle As Single, ByVal Sweep As Single, ByVal HeadSize As Single)        Dim a As Double, ex As Single, ey As Single, dirX As Single, dirY As Single        Const PI As Double = 3.14159265358979        GdipDrawArc g, Pen, cx - r, cy - r, 2 * r, 2 * r, StartAngle, Sweep        a = (StartAngle + Sweep) * PI / 180        ex = cx + r * Cos(a)        ey = cy + r * Sin(a)        If Sweep >= 0 Then            dirX = -Sin(a): dirY = Cos(a)        Else            dirX = Sin(a): dirY = -Cos(a)        End If        GpArrowHead g, Brush, ex + dirX * HeadSize * 0.5, ey + dirY * HeadSize * 0.5, dirX, dirY, HeadSize    End Sub    Public Sub GpFillTriangle(ByVal g As LongPtr, ByVal Brush As LongPtr, ByVal x1 As Single, ByVal y1 As Single, ByVal x2 As Single, ByVal y2 As Single, ByVal x3 As Single, ByVal y3 As Single)        Dim pts(0 To 2) As POINTF        pts(0) = PtF(x1, y1)        pts(1) = PtF(x2, y2)        pts(2) = PtF(x3, y3)        GdipFillPolygon g, Brush, pts(0), 3, FillModeAlternate    End SubEnd Module