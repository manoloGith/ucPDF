' ============================================================================'  PdfDib.twin'  Mapa de bits DIB de 32 bpp (top-down) con su propio DC en memoria.'  PDFium escribe directamente sobre los bits (FPDFBitmap_CreateEx), sin copias.' ============================================================================[Description("Mapa de bits DIB de 32 bpp para renderizado")]Class PdfDib    Private m_hDC As LongPtr    Private m_hBmp As LongPtr    Private m_hOld As LongPtr    Private m_Bits As LongPtr    Private m_W As Long    Private m_H As Long    Private m_Bmi As BITMAPINFOHEADER    Public Function Create(ByVal Width As Long, ByVal Height As Long) As Boolean        Destroy        If Width <= 0 Or Height <= 0 Then Exit Function        With m_Bmi            .biSize = LenB(m_Bmi)            .biWidth = Width            .biHeight = -Height            .biPlanes = 1            .biBitCount = 32            .biCompression = BI_RGB            .biSizeImage = Width * 4 * Height        End With        m_hDC = CreateCompatibleDC(0)        If m_hDC = 0 Then Exit Function        m_hBmp = CreateDIBSection(m_hDC, m_Bmi, DIB_RGB_COLORS, m_Bits, 0, 0)        If m_hBmp = 0 Or m_Bits = 0 Then            DeleteDC m_hDC            m_hDC = 0            m_hBmp = 0            m_Bits = 0            Exit Function        End If        m_hOld = SelectObject(m_hDC, m_hBmp)        m_W = Width        m_H = Height        Create = True    End Function    ' Reutiliza el DIB si ya tiene el tamano pedido.    Public Function EnsureSize(ByVal Width As Long, ByVal Height As Long) As Boolean        If m_hDC <> 0 And m_W = Width And m_H = Height Then            EnsureSize = True        Else            EnsureSize = Create(Width, Height)        End If    End Function    Public Sub Destroy()        If m_hDC <> 0 Then            If m_hOld <> 0 Then SelectObject m_hDC, m_hOld            If m_hBmp <> 0 Then DeleteObject m_hBmp            DeleteDC m_hDC        End If        m_hDC = 0        m_hBmp = 0        m_hOld = 0        m_Bits = 0        m_W = 0        m_H = 0    End Sub    Public Property Get hDC() As LongPtr        hDC = m_hDC    End Property    Public Property Get Bits() As LongPtr        Bits = m_Bits    End Property    Public Property Get Width() As Long        Width = m_W    End Property    Public Property Get Height() As Long        Height = m_H    End Property    Public Property Get Stride() As Long        Stride = m_W * 4    End Property    Public Property Get IsValid() As Boolean        IsValid = (m_hDC <> 0)    End Property    ' Valor BGRA de un pixel (para pruebas).    Public Function PixelAt(ByVal x As Long, ByVal y As Long) As Long        Dim v As Long        If m_Bits = 0 Then Exit Function        If x < 0 Or y < 0 Or x >= m_W Or y >= m_H Then Exit Function        CopyMemory v, ByVal (m_Bits + CLngPtr(y) * m_W * 4 + CLngPtr(x) * 4), 4        PixelAt = v    End Function    Public Sub SetPixel(ByVal x As Long, ByVal y As Long, ByVal Bgra As Long)        If m_Bits = 0 Then Exit Sub        If x < 0 Or y < 0 Or x >= m_W Or y >= m_H Then Exit Sub        CopyMemory ByVal (m_Bits + CLngPtr(y) * m_W * 4 + CLngPtr(x) * 4), Bgra, 4    End Sub    ' Copia escalada a otro DC (impresora, por ejemplo).    Public Function StretchToDC(ByVal hdcDest As LongPtr, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long) As Boolean        If m_Bits = 0 Then Exit Function        StretchToDC = (StretchDIBits(hdcDest, x, y, w, h, 0, 0, m_W, m_H, m_Bits, m_Bmi, DIB_RGB_COLORS, SRCCOPY) <> 0)    End Function    Private Sub Class_Terminate()        Destroy    End SubEnd Class