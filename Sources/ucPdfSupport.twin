' ============================================================================'  ucPdfSupport.twin'  Enumeraciones publicas del control, procedimiento de subclasificacion y'  dialogo de impresion (PRINTDLGW construido a mano para Win32 y Win64).' ============================================================================[Description("Tipos y utilidades de soporte del control ucPDF")]Module ucPdfSupport    Public Enum ucPdfZoomMode        pdfZoomCustom = 0        pdfZoomFitWidth = 1        pdfZoomFitPage = 2    End Enum    Public Enum ucPdfCursorMode        pdfCursorSelect = 0        pdfCursorPan = 1    End Enum    Public Enum ucPdfRotation        pdfRotate0 = 0        pdfRotate90 = 1        pdfRotate180 = 2        pdfRotate270 = 3    End Enum    Public Enum ucPdfToolbarCommand        pdfCmdFirstPage = 1        pdfCmdPreviousPage = 2        pdfCmdNextPage = 4        pdfCmdLastPage = 5        pdfCmdZoomOut = 6        pdfCmdZoomIn = 8        pdfCmdFind = 11        pdfCmdFindNext = 12        pdfCmdThumbnails = 13        pdfCmdPrint = 14    End Enum    Public Enum ucPdfBorderStyle        pdfBorderNone = 0        pdfBorderSingle = 1    End Enum    ' ------------------------------------------------------------------------    '  Subclasificacion    '  dwRefData contiene ObjPtr del control. Se obtiene una referencia    '  "prestada" (sin AddRef) que se anula antes de salir, de modo que no se    '  crean referencias circulares y Terminate se ejecuta con normalidad.    ' ------------------------------------------------------------------------    Public Function ucPdfSubclassProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr, ByVal uIdSubclass As LongPtr, ByVal dwRefData As LongPtr) As LongPtr        Dim ctl As ucPDF, z As LongPtr        If dwRefData = 0 Then            ucPdfSubclassProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)            Exit Function        End If        CopyMemory ByVal VarPtr(ctl), dwRefData, LenB(dwRefData)        ucPdfSubclassProc = ctl.zWindowProc(hWnd, uMsg, wParam, lParam)        CopyMemory ByVal VarPtr(ctl), z, LenB(z)    End Function    Public Function ucPdfSubclassAddress() As LongPtr        ucPdfSubclassAddress = AddressOf ucPdfSubclassProc    End Function    ' ------------------------------------------------------------------------    '  Dialogo de impresion    '  PRINTDLGW esta empaquetada a 1 byte en Win32 (66 bytes) y con    '  alineacion natural en Win64 (120 bytes); por eso se usa un bufer.    ' ------------------------------------------------------------------------    Private Const PD_PAGENUMS As Long = &H2    Private Const PD_NOSELECTION As Long = &H4    Private Const PD_RETURNDC As Long = &H100    Private Const PD_RETURNDEFAULT As Long = &H400    Private Const PD_USEDEVMODECOPIESANDCOLLATE As Long = &H40000    Private Sub PutLong(ByRef b() As Byte, ByVal Offset As Long, ByVal Value As Long)        CopyMemory b(Offset), Value, 4    End Sub    Private Sub PutWord(ByRef b() As Byte, ByVal Offset As Long, ByVal Value As Long)        Dim w As Integer        If Value > 32767 Then Value = 32767        w = CInt(Value)        CopyMemory b(Offset), w, 2    End Sub    Private Function GetWord(ByRef b() As Byte, ByVal Offset As Long) As Long        Dim w As Integer        CopyMemory w, b(Offset), 2        GetWord = CLng(w) And &HFFFF&    End Function    Private Sub PutPtr(ByRef b() As Byte, ByVal Offset As Long, ByVal Value As LongPtr)        CopyMemory b(Offset), Value, LenB(Value)    End Sub    Private Function GetPtr(ByRef b() As Byte, ByVal Offset As Long) As LongPtr        Dim v As LongPtr        CopyMemory v, b(Offset), LenB(v)        GetPtr = v    End Function    ' Devuelve el hDC de la impresora elegida (0 si se cancela).    ' Con ShowDialog = False usa la impresora predeterminada sin preguntar.    ' FromPage/ToPage son de entrada/salida (base 1).    Public Function PdfPrintDialog(ByVal hWndOwner As LongPtr, ByVal ShowDialog As Boolean, ByVal MinPage As Long, ByVal MaxPage As Long, ByRef FromPage As Long, ByRef ToPage As Long) As LongPtr        Dim b() As Byte, sz As Long, flags As Long        Dim oHwnd As Long, oDevMode As Long, oDevNames As Long, oHdc As Long, oFlags As Long        Dim oFrom As Long, oTo As Long, oMin As Long, oMax As Long, oCopies As Long        #If Win64 Then            sz = 120: oHwnd = 8: oDevMode = 16: oDevNames = 24: oHdc = 32: oFlags = 40            oFrom = 44: oTo = 46: oMin = 48: oMax = 50: oCopies = 52        #Else            sz = 66: oHwnd = 4: oDevMode = 8: oDevNames = 12: oHdc = 16: oFlags = 20            oFrom = 24: oTo = 26: oMin = 28: oMax = 30: oCopies = 32        #End If        ReDim b(0 To sz - 1)        PutLong b, 0, sz        PutPtr b, oHwnd, hWndOwner        flags = PD_RETURNDC Or PD_NOSELECTION Or PD_USEDEVMODECOPIESANDCOLLATE        If Not ShowDialog Then flags = flags Or PD_RETURNDEFAULT        If FromPage <> MinPage Or ToPage <> MaxPage Then flags = flags Or PD_PAGENUMS        PutLong b, oFlags, flags        PutWord b, oFrom, FromPage        PutWord b, oTo, ToPage        PutWord b, oMin, MinPage        PutWord b, oMax, MaxPage        PutWord b, oCopies, 1        If PrintDlgW(VarPtr(b(0))) = 0 Then Exit Function        flags = 0        CopyMemory flags, b(oFlags), 4        If ShowDialog Then            If (flags And PD_PAGENUMS) <> 0 Then                FromPage = GetWord(b, oFrom)                ToPage = GetWord(b, oTo)            Else                FromPage = MinPage                ToPage = MaxPage            End If        End If        If GetPtr(b, oDevMode) <> 0 Then GlobalFree GetPtr(b, oDevMode)        If GetPtr(b, oDevNames) <> 0 Then GlobalFree GetPtr(b, oDevNames)        PdfPrintDialog = GetPtr(b, oHdc)    End FunctionEnd Module