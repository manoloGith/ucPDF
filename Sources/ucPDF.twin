' ============================================================================'  ucPDF.twin  -  Control de usuario visor de PDF (PDFium)''  IMPORTANTE: crea en el IDE un UserControl llamado "ucPDF" (Project > Add >'  UserControl), conserva los atributos que genera el IDE ([FormDesignerId],'  [ClassId], ...) y sustituye el resto del codigo por este archivo. El'  control no necesita controles hijos: todo se dibuja con GDI.''  Apartados:'   1. Base funcional  -> PdfiumApi.twin, PdfDocument.twin, PdfDib.twin'   2. Visor           -> navegacion, zoom, desplazamiento y redimensionado'                         con doble bufer y mosaicos (sin parpadeo ni artefactos)'   3. Herramientas    -> seleccion y busqueda de texto, miniaturas, impresion'   4. Integracion     -> eventos, propiedades de diseno, DPI, Win32/Win64' ============================================================================[Description("Visor de documentos PDF basado en PDFium")]Class ucPDF    ' ========================================================================    '  Eventos    ' ========================================================================    Public Event DocumentLoaded(ByVal PageCount As Long)    Public Event DocumentClosed()    Public Event LoadFailed(ByVal ErrorCode As Long, ByVal Description As String)    Public Event PageChanged(ByVal Page As Long)    Public Event ZoomChanged(ByVal Zoom As Double)    Public Event SelectionChanged()    Public Event SearchCompleted(ByVal Found As Boolean, ByVal Page As Long)    Public Event PageClick(ByVal Page As Long, ByVal PdfX As Double, ByVal PdfY As Double, ByVal Button As Long)    Public Event PrintProgress(ByVal Page As Long, ByVal PagesPrinted As Long, ByVal PagesTotal As Long, ByRef Cancel As Boolean)    Public Event ToolbarClick(ByVal Command As ucPdfToolbarCommand, ByRef Cancel As Boolean)    Public Event DocumentSaved(ByVal FileName As String)    Public Event PagesReordered(ByVal FromPage As Long, ByVal ToPage As Long)    Public Event PagesEdited(ByVal Operation As ucPdfPageOperation, ByVal FirstPage As Long, ByVal Count As Long)    Public Event PagesExtracted(ByVal FileName As String, ByVal Count As Long)    ' ========================================================================    '  Constantes    ' ========================================================================    Private Const DEF_BACKCOLOR As Long = &H8000000C        ' vbApplicationWorkspace    Private Const DEF_THUMBBACKCOLOR As Long = &H8000000F   ' vbButtonFace    Private Const DEF_SELCOLOR As Long = &HD77800           ' azul (BGR)    Private Const DEF_FINDCOLOR As Long = &HFFFF&           ' amarillo (BGR)    Private Const DEF_ZOOM As Double = 100    Private Const DEF_PAGEGAP As Long = 12    Private Const DEF_THUMBWIDTH As Long = 160    Private Const DEF_EMPTYTEXT As String = "Sin documento"    Private Const MIN_ZOOM As Double = 5    Private Const MAX_ZOOM As Double = 6400    Private Const RENDER_FLAGS As Long = FPDF_ANNOT Or FPDF_LCD_TEXT    Private Const COLOR_BTNTEXT As Long = 18    Private Const ZOOM_STEP As Double = 25    ' Barra de herramientas: tipos de elemento y comandos    Private Const TB_HEIGHT As Long = 36    Private Const TBK_BUTTON As Long = 0    Private Const TBK_LABEL As Long = 1    Private Const TBK_EDIT As Long = 2    Private Const TBK_SEP As Long = 3    Private Const CMD_FIRST As Long = 1    Private Const CMD_PREV As Long = 2    Private Const CMD_PAGELABEL As Long = 3    Private Const CMD_NEXT As Long = 4    Private Const CMD_LAST As Long = 5    Private Const CMD_ZOOMOUT As Long = 6    Private Const CMD_ZOOMLABEL As Long = 7    Private Const CMD_ZOOMIN As Long = 8    Private Const CMD_SEARCHEDIT As Long = 9    Private Const CMD_FINDCOUNT As Long = 10    Private Const CMD_FINDNEXT As Long = 12    Private Const CMD_THUMBS As Long = 13    Private Const CMD_PRINT As Long = 14    Private Const CMD_FITWIDTH As Long = 15    Private Const CMD_FITPAGE As Long = 16    Private Const CMD_SEARCHPANEL As Long = 17    Private Const CMD_FINDPREV As Long = 18    Private Const CMD_OPEN As Long = 19    Private Const CMD_SAVE As Long = 20    Private Const CMD_ORGANIZE As Long = 21    Private Const CMD_ORG_ROTL As Long = 22    Private Const CMD_ORG_ROTR As Long = 23    Private Const CMD_ORG_DELETE As Long = 24    Private Const CMD_ORG_INSBLANK As Long = 25    Private Const CMD_ORG_INSFILE As Long = 26    Private Const CMD_ORG_REPLACE As Long = 27    Private Const CMD_ORG_EXTRACT As Long = 28    Private Const CMD_ORG_CROP As Long = 29    Private Const TIP_TIMER_ID As Long = 7002    Private Const CMD_ORG_UNDO As Long = 30    Private Const CMD_ORG_REDO As Long = 31    Private Const CMD_SEPFILE As Long = 99      ' separador tras abrir/guardar (se oculta con ellos)    Private Const SEARCH_PANEL_MINWIDTH As Long = 260    ' Organizar paginas    Private Const ORG_HEADER_H As Long = 44     ' cabecera con titulo y control de tamano    Private Const ORG_MIN As Long = 80          ' ancho logico minimo de miniatura    Private Const ORG_MAX As Long = 360    Private Const ORG_DEF As Long = 150    Private Const ORG_GAP As Long = 18    Private Const ORG_LABEL_H As Long = 20    Private Const ANIM_TIMER_ID As Long = 7001    Private Const ANIM_MS As Long = 15    Private Const RES_ITEM_H As Long = 46       ' alto logico de cada resultado    Private Const SNIP_BEFORE As Long = 24      ' caracteres de contexto antes    Private Const SNIP_AFTER As Long = 70       ' caracteres de contexto despues    Private Const CMD_SEP As Long = 0    ' ========================================================================    '  Propiedades persistentes    ' ========================================================================    Private m_BackColor As Long    Private m_ThumbBackColor As Long    Private m_SelColor As Long    Private m_FindColor As Long    Private m_BorderStyle As ucPdfBorderStyle    Private m_PageGap As Long    Private m_Zoom As Double    Private m_ZoomMode As ucPdfZoomMode    Private m_Rotation As ucPdfRotation    Private m_ShowThumbs As Boolean    Private m_ShowSearch As Boolean         ' panel de busqueda (excluyente con las miniaturas)    Private m_ThumbWidth As Long    Private m_CursorMode As ucPdfCursorMode    Private m_PdfiumPath As String    Private m_FileName As String    Private m_EmptyText As String    ' ========================================================================    '  Estado de ejecucion    ' ========================================================================    Private m_Doc As PdfDocument    Private m_Back As PdfDib    Private m_Solid As PdfDib    Private m_hWnd As LongPtr    Private m_UserMode As Boolean    Private m_Subclassed As Boolean    Private m_Dpi As Long    Private m_hFont As LongPtr    Private m_InLayout As Boolean    Private m_LockPage As Boolean    Private m_ZoomNotified As Double    ' Disposicion (coordenadas del documento en pixeles de dispositivo)    Private m_Count As Long    Private m_PX() As Long    Private m_PY() As Long    Private m_PW() As Long    Private m_PH() As Long    Private m_DocW As Long    Private m_DocH As Long    Private m_ScrollX As Long    Private m_ScrollY As Long    Private m_ClientW As Long    Private m_ClientH As Long    Private m_ViewX As Long    Private m_CurPage As Long    Private m_VisFirst As Long    Private m_VisLast As Long    ' Mosaicos renderizados (uno por pagina visible)    Private m_Tile() As PdfDib    Private m_TileX() As Long    Private m_TileY() As Long    Private m_TileKW() As Long    Private m_TileKH() As Long    Private m_TileRot() As Long    ' Miniaturas    Private m_Thumb() As PdfDib    Private m_ThumbRot() As Long    Private m_ThumbY() As Long    Private m_ThumbW() As Long    Private m_ThumbH() As Long    Private m_ThumbsH As Long    Private m_ThumbScroll As Long    Private m_ThumbVisFirst As Long    Private m_ThumbVisLast As Long    ' Ancla para conservar la posicion al hacer zoom / redimensionar    Private m_AnchorPage As Long    Private m_AnchorFX As Double    Private m_AnchorFY As Double    Private m_AnchorSX As Long    Private m_AnchorSY As Long    ' Seleccion de texto (A = inicio del arrastre, B = posicion actual)    Private m_HasSel As Boolean    Private m_Selecting As Boolean    Private m_SelAPage As Long    Private m_SelAChar As Long    Private m_SelBPage As Long    Private m_SelBChar As Long    ' Desplazamiento con la mano    Private m_Panning As Boolean    Private m_PanX As Long    Private m_PanY As Long    Private m_PanSX As Long    Private m_PanSY As Long    ' Busqueda (lista de todas las coincidencias del documento)    Private m_FindText As String    Private m_FindFlags As Long    Private m_FindPage As Long    Private m_FindIdx As Long    Private m_FindLen As Long    Private m_Searched As Boolean    Private m_MatchCount As Long    Private m_MatchPos As Long    Private m_MatchPage() As Long    Private m_MatchIdx() As Long    Private m_MatchLen() As Long    Private m_MatchPre() As String          ' extracto: texto anterior a la coincidencia    Private m_MatchHit() As String          ' extracto: texto encontrado    Private m_MatchPost() As String         ' extracto: texto posterior    Private m_ResRect As RECT               ' lista de resultados del panel de busqueda    Private m_ResScroll As Long    Private m_ResHot As Long    ' Barra de herramientas (dibujada con GDI+)    Private m_ShowToolbar As Boolean    Private m_ShowOpenBtn As Boolean    Private m_ShowSaveBtn As Boolean    Private m_LastDir As String             ' ultima carpeta usada en abrir/guardar    ' Organizar paginas (vista de miniaturas con arrastrar y soltar)    Private m_Organize As Boolean    Private m_Modified As Boolean           ' cambios sin guardar    Private m_ConfirmClose As Boolean    Private m_OrgSize As Long               ' ancho logico de cada miniatura    Private m_OrgScroll As Long    Private m_OrgContentH As Long    Private m_OrgCols As Long    Private m_OrgCellW As Long    Private m_OrgBoxH As Long    Private m_OrgPitchX As Long    Private m_OrgPitchY As Long    Private m_OrgLeft As Long    Private m_OrgThumb() As PdfDib    Private m_OrgCurX() As Double           ' posicion animada (coordenadas de contenido)    Private m_OrgCurY() As Double    Private m_OrgSel As Long                ' pagina activa (ancla de la seleccion)    Private m_OrgSelected() As Boolean      ' seleccion multiple    Private m_OrgClickReset As Long         ' al soltar sin arrastrar: dejar solo esta pagina    Private m_TipShow As Boolean            ' informacion sobre herramientas visible    ' Deshacer / rehacer sin limite: cada estado del documento se guarda en un    ' archivo temporal; cada pagina lleva un identificador para poder animar    ' las miniaturas de vuelta a su sitio y reutilizarlas.    Private m_PageId() As Long    Private m_NextPageId As Long    Private m_StateFile() As String    Private m_StateIds() As Variant    Private m_StateCount As Long    Private m_StatePos As Long              ' estado actual (-1 = sin historial)    Private m_SavedPos As Long              ' estado guardado en disco (-1 = ninguno)    Private m_StateSerial As Long    ' Editor de recorte (rectangulo sobre la primera pagina seleccionada)    Private m_CropMode As Boolean    Private m_CropPage As Long    Private m_CropL As Double               ' rectangulo en fracciones 0..1 de la pagina    Private m_CropT As Double    Private m_CropR As Double    Private m_CropB As Double    Private m_CropPgRect As RECT            ' pagina en pantalla    Private m_CropDib As PdfDib             ' vista previa renderizada    Private m_CropDrag As Long              ' 0 nada, 1 nuevo, 2 mover, 11..18 tiradores    Private m_CropAX As Double              ' ancla del arrastre (fracciones)    Private m_CropAY As Double    Private m_CropGrabL As Double    Private m_CropGrabT As Double    Private m_CropBtnApply As RECT    Private m_CropBtnCancel As RECT    Private m_CropBtnAuto As RECT    Private m_CropHotBtn As Long             ' 0 ninguno, 1 aplicar, 2 cancelar, 3 auto    Private m_OrgHot As Long    Private m_OrgPress As Long    Private m_OrgPressX As Long    Private m_OrgPressY As Long    Private m_OrgDragging As Boolean    Private m_OrgDragPage As Long    Private m_OrgDropIdx As Long    Private m_OrgGrabDX As Long    Private m_OrgGrabDY As Long    Private m_OrgMouseX As Long    Private m_OrgMouseY As Long    Private m_OrgFlashPage As Long          ' pagina recien soltada (destello)    Private m_OrgFlash As Long              ' intensidad del destello 0..255    Private m_AnimOn As Boolean    Private m_SliderRect As RECT    Private m_SliderDrag As Boolean    Private m_hRoot As LongPtr              ' ventana principal (para avisar al cerrar)    Private m_RootSubclassed As Boolean    Private m_ViewY As Long                 ' alto de la barra = inicio vertical de la vista    Private m_FullH As Long                 ' alto total del area cliente    Private m_GdipOK As Boolean    Private m_gpFamily As LongPtr    Private m_gpFont As LongPtr    Private m_gpFormat As LongPtr    Private m_gpFormatLeft As LongPtr    Private m_gpFormatTypo As LongPtr       ' tipografico: mide y dibuja tramos sin relleno    Private m_gpFontBold As LongPtr    Private m_gpFontSmall As LongPtr    Private m_TbCount As Long    Private m_TbKind() As Long    Private m_TbCmd() As Long    Private m_TbW() As Long                 ' ancho logico (96 ppp)    Private m_TbRect() As RECT    Private m_TbPanel() As Boolean          ' True = elemento del panel de busqueda    Private m_TbOrg() As Boolean            ' True = boton de la cabecera de organizar    Private m_TbHot As Long    Private m_TbDown As Long    Private m_TrackingLeave As Boolean    Private m_hEdit As LongPtr    Private m_EditIdx As Long               ' elemento del cuadro de busqueda    Private m_CountIdx As Long              ' elemento "Resultados de la busqueda"    Private m_EditSubclassed As Boolean    ' ========================================================================    '  Ciclo de vida del UserControl    ' ========================================================================    Private Sub UserControl_Initialize()        Set m_Doc = New PdfDocument        Set m_Back = New PdfDib        Set m_Solid = New PdfDib        m_Dpi = 96        m_FindPage = -1        m_VisLast = -2        m_ThumbVisLast = -2        m_TbHot = -1        m_TbDown = -1        m_MatchPos = -1        m_ResHot = -1        m_OrgSize = ORG_DEF        m_OrgSel = -1        m_OrgHot = -1        m_OrgPress = -1        m_OrgClickReset = -1        m_OrgFlashPage = -1        m_ConfirmClose = True        BuildToolbar        ApplyDefaults    End Sub    Private Sub ApplyDefaults()        m_BackColor = DEF_BACKCOLOR        m_ThumbBackColor = DEF_THUMBBACKCOLOR        m_SelColor = DEF_SELCOLOR        m_FindColor = DEF_FINDCOLOR        m_BorderStyle = pdfBorderNone        m_PageGap = DEF_PAGEGAP        m_Zoom = DEF_ZOOM        m_ZoomNotified = DEF_ZOOM        m_ZoomMode = pdfZoomFitWidth        m_Rotation = pdfRotate0        m_ShowThumbs = False        m_ThumbWidth = DEF_THUMBWIDTH        m_CursorMode = pdfCursorSelect        m_PdfiumPath = ""        m_FileName = ""        m_EmptyText = DEF_EMPTYTEXT        m_ShowToolbar = True        m_ShowOpenBtn = True        m_ShowSaveBtn = True    End Sub    Private Sub UserControl_InitProperties()        ApplyDefaults        StartRuntime    End Sub    Private Sub UserControl_ReadProperties(PropBag As PropertyBag)        Dim fn As String        With PropBag            m_BackColor = .ReadProperty("BackColor", DEF_BACKCOLOR)            m_ThumbBackColor = .ReadProperty("ThumbnailBackColor", DEF_THUMBBACKCOLOR)            m_SelColor = .ReadProperty("SelectionColor", DEF_SELCOLOR)            m_FindColor = .ReadProperty("SearchHighlightColor", DEF_FINDCOLOR)            m_BorderStyle = .ReadProperty("BorderStyle", pdfBorderNone)            m_PageGap = .ReadProperty("PageGap", DEF_PAGEGAP)            m_Zoom = ClampZoom(.ReadProperty("Zoom", DEF_ZOOM))            m_ZoomMode = .ReadProperty("ZoomMode", pdfZoomFitWidth)            m_Rotation = .ReadProperty("Rotation", pdfRotate0) And 3            m_ShowThumbs = .ReadProperty("ShowThumbnails", False)            m_ThumbWidth = .ReadProperty("ThumbnailWidth", DEF_THUMBWIDTH)            m_CursorMode = .ReadProperty("CursorMode", pdfCursorSelect)            m_PdfiumPath = .ReadProperty("PdfiumPath", "")            fn = .ReadProperty("FileName", "")            m_EmptyText = .ReadProperty("EmptyText", DEF_EMPTYTEXT)            m_ShowToolbar = .ReadProperty("ShowToolbar", True)            m_ShowOpenBtn = .ReadProperty("ShowOpenButton", True)            m_ShowSaveBtn = .ReadProperty("ShowSaveButton", True)            m_ConfirmClose = .ReadProperty("ConfirmSaveOnClose", True)            m_OrgSize = IMax(ORG_MIN, IMin(ORG_MAX, .ReadProperty("OrganizeThumbSize", ORG_DEF)))        End With        m_ZoomNotified = m_Zoom        m_FileName = fn        StartRuntime        If m_UserMode And Len(fn) > 0 Then LoadFile fn    End Sub    Private Sub UserControl_WriteProperties(PropBag As PropertyBag)        With PropBag            .WriteProperty "BackColor", m_BackColor, DEF_BACKCOLOR            .WriteProperty "ThumbnailBackColor", m_ThumbBackColor, DEF_THUMBBACKCOLOR            .WriteProperty "SelectionColor", m_SelColor, DEF_SELCOLOR            .WriteProperty "SearchHighlightColor", m_FindColor, DEF_FINDCOLOR            .WriteProperty "BorderStyle", m_BorderStyle, pdfBorderNone            .WriteProperty "PageGap", m_PageGap, DEF_PAGEGAP            .WriteProperty "Zoom", m_Zoom, DEF_ZOOM            .WriteProperty "ZoomMode", m_ZoomMode, pdfZoomFitWidth            .WriteProperty "Rotation", m_Rotation, pdfRotate0            .WriteProperty "ShowThumbnails", m_ShowThumbs, False            .WriteProperty "ThumbnailWidth", m_ThumbWidth, DEF_THUMBWIDTH            .WriteProperty "CursorMode", m_CursorMode, pdfCursorSelect            .WriteProperty "PdfiumPath", m_PdfiumPath, ""            .WriteProperty "FileName", m_FileName, ""            .WriteProperty "EmptyText", m_EmptyText, DEF_EMPTYTEXT            .WriteProperty "ShowToolbar", m_ShowToolbar, True            .WriteProperty "ShowOpenButton", m_ShowOpenBtn, True            .WriteProperty "ShowSaveButton", m_ShowSaveBtn, True            .WriteProperty "ConfirmSaveOnClose", m_ConfirmClose, True            .WriteProperty "OrganizeThumbSize", m_OrgSize, ORG_DEF        End With    End Sub    ' En ejecucion se subclasifica la ventana para pintar con doble bufer,    ' gestionar barras de desplazamiento, rueda del raton, teclado y DPI.    Private Sub StartRuntime()        m_UserMode = True        On Error Resume Next        m_UserMode = Ambient.UserMode        On Error GoTo 0        If Not m_UserMode Then Exit Sub        If m_hWnd <> 0 Then Exit Sub        m_hWnd = UserControl.hWnd        ' WS_CLIPCHILDREN: el doble bufer no pinta encima del cuadro de busqueda.        SetWindowLongPtrW m_hWnd, GWL_STYLE, GetWindowLongPtrW(m_hWnd, GWL_STYLE) Or WS_CLIPCHILDREN        m_GdipOK = GdipAcquire()        UpdateDpi        m_Subclassed = (SetWindowSubclass(m_hWnd, ucPdfSubclassAddress(), 1, ObjPtr(Me)) <> 0)        CreateSearchEdit        RefreshLayout False    End Sub    Private Sub StopSubclass()        StopEditSubclass        RemoveRootHook        StopAnim        If m_Subclassed Then            RemoveWindowSubclass m_hWnd, ucPdfSubclassAddress(), 1            m_Subclassed = False        End If    End Sub    Private Sub StopEditSubclass()        If m_EditSubclassed Then            RemoveWindowSubclass m_hEdit, ucPdfSubclassAddress(), 2            m_EditSubclassed = False        End If    End Sub    Private Sub UserControl_Terminate()        ClearHistory        StopSubclass        EraseCaches        If Not m_Doc Is Nothing Then m_Doc.CloseDocument        Set m_Doc = Nothing        Set m_Back = Nothing        Set m_Solid = Nothing        If m_hEdit <> 0 Then DestroyWindow m_hEdit        m_hEdit = 0        If m_hFont <> 0 Then DeleteObject m_hFont        m_hFont = 0        FreeGdipText        If m_GdipOK Then GdipRelease        m_GdipOK = False    End Sub    ' Solo en diseno (o si la subclasificacion no esta activa).    Private Sub UserControl_Paint()        If m_Subclassed Then Exit Sub        DrawDesignPlaceholder UserControl.hDC    End Sub    Private Sub UserControl_Resize()        If Not m_Subclassed Then UserControl.Refresh    End Sub    ' ========================================================================    '  Procedimiento de ventana (llamado desde ucPdfSubclassProc)    ' ========================================================================    Friend Function zWindowProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr        Dim pt As POINTAPI        On Error GoTo Failed        If hWnd = m_hEdit And m_hEdit <> 0 Then            zWindowProc = EditWindowProc(hWnd, uMsg, wParam, lParam)            Exit Function        End If        If hWnd = m_hRoot And m_RootSubclassed And m_hRoot <> m_hWnd Then            zWindowProc = RootWindowProc(hWnd, uMsg, wParam, lParam)            Exit Function        End If        Select Case uMsg            Case WM_ERASEBKGND                zWindowProc = 1                Exit Function            Case WM_CTLCOLOREDIT, WM_CTLCOLORSTATIC                ' Fondo blanco para el cuadro de busqueda (si no, hereda el del UserControl).                If lParam = m_hEdit And m_hEdit <> 0 Then                    SetBkColor wParam, &HFFFFFF                    SetTextColor wParam, &H0&                    zWindowProc = GetStockObject(WHITE_BRUSH)                    Exit Function                End If            Case WM_PAINT                OnPaint hWnd                Exit Function            Case WM_TIMER                If wParam = ANIM_TIMER_ID Then                    AnimStep                    Exit Function                End If                If wParam = TIP_TIMER_ID Then                    KillTimer hWnd, TIP_TIMER_ID                    m_TipShow = (m_TbHot >= 0 And m_TbDown < 0)                    Invalidate                    Exit Function                End If            Case WM_SIZE                RefreshLayout True            Case WM_DPICHANGED_AFTERPARENT                UpdateDpi                RefreshLayout True            Case WM_GETDLGCODE                zWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam) Or DLGC_WANTARROWS                ' En el editor de recorte, Intro y Esc son para el control                If m_CropMode Then zWindowProc = zWindowProc Or DLGC_WANTALLKEYS                Exit Function            Case WM_VSCROLL                OnScrollMessage SB_VERT, LoWordS(wParam) And &HFFFF&                Exit Function            Case WM_HSCROLL                OnScrollMessage SB_HORZ, LoWordS(wParam) And &HFFFF&                Exit Function            Case WM_MOUSEWHEEL, WM_MOUSEHWHEEL                pt.X = LoWordS(lParam)                pt.Y = HiWordS(lParam)                ScreenToClient hWnd, pt                OnMouseWheel HiWordS(wParam), LoWordS(wParam) And &HFFFF&, pt.X, pt.Y, (uMsg = WM_MOUSEHWHEEL)                Exit Function            Case WM_LBUTTONDOWN                OnMouseDown LoWordS(lParam), HiWordS(lParam), vbLeftButton, LoWordS(wParam) And &HFFFF&            Case WM_RBUTTONDOWN                OnMouseDown LoWordS(lParam), HiWordS(lParam), vbRightButton, LoWordS(wParam) And &HFFFF&            Case WM_MBUTTONDOWN                OnMouseDown LoWordS(lParam), HiWordS(lParam), vbMiddleButton, LoWordS(wParam) And &HFFFF&            Case WM_LBUTTONDBLCLK                OnDoubleClick LoWordS(lParam), HiWordS(lParam)            Case WM_MOUSEMOVE                OnMouseMove LoWordS(lParam), HiWordS(lParam)            Case WM_LBUTTONUP, WM_MBUTTONUP                OnMouseUp LoWordS(lParam), HiWordS(lParam)            Case WM_MOUSELEAVE                m_TrackingLeave = False                SetToolbarHot -1                SetResultHot -1            Case WM_CAPTURECHANGED                If lParam <> hWnd Then EndDrag            Case WM_SETCURSOR                ' Solo para la propia ventana: el cuadro de busqueda usa su cursor.                If wParam = hWnd And (LoWordS(lParam) And &HFFFF&) = HTCLIENT Then                    If OnSetCursor() Then                        zWindowProc = 1                        Exit Function                    End If                End If            Case WM_KEYDOWN                OnKeyDown CLng(wParam And &HFFFF&)            Case WM_NCDESTROY                StopSubclass        End Select        zWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)        Exit Function    Failed:        zWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)    End Function    ' ========================================================================    '  APARTADO 1 - Base funcional: carga del documento    ' ========================================================================    Public Function LoadFile(ByVal FileName As String, Optional ByVal Password As String) As Boolean        CloseDocument        If Not m_Doc.OpenFile(FileName, Password, m_PdfiumPath) Then            RaiseEvent LoadFailed(m_Doc.LastError, m_Doc.LastErrorText)            Exit Function        End If        m_FileName = FileName        If Len(PathFolder(FileName)) > 0 Then m_LastDir = PathFolder(FileName)        OnDocumentOpened        LoadFile = True    End Function    Public Function LoadFromBytes(ByRef Data() As Byte, Optional ByVal Password As String) As Boolean        CloseDocument        If Not m_Doc.OpenBytes(Data, Password, m_PdfiumPath) Then            RaiseEvent LoadFailed(m_Doc.LastError, m_Doc.LastErrorText)            Exit Function        End If        m_FileName = ""        OnDocumentOpened        LoadFromBytes = True    End Function    Public Sub CloseDocument()        Dim wasOpen As Boolean        wasOpen = HasDoc()        EraseCaches        If Not m_Doc Is Nothing Then m_Doc.CloseDocument        ClearHistory        m_Count = 0        m_FileName = ""        m_CropMode = False        Set m_CropDib = Nothing        m_Organize = False        m_Modified = False        StopAnim        Erase m_OrgThumb        m_ScrollX = 0        m_ScrollY = 0        m_ThumbScroll = 0        m_CurPage = 0        ResetInteraction        RefreshLayout False        If wasOpen Then RaiseEvent DocumentClosed    End Sub    Private Sub OnDocumentOpened()        Dim i As Long        Dim n As Long        m_Count = m_Doc.PageCount        n = IMax(m_Count - 1, 0)        ReDim m_PX(0 To n): ReDim m_PY(0 To n): ReDim m_PW(0 To n): ReDim m_PH(0 To n)        ReDim m_Tile(0 To n): ReDim m_TileX(0 To n): ReDim m_TileY(0 To n)        ReDim m_TileKW(0 To n): ReDim m_TileKH(0 To n): ReDim m_TileRot(0 To n)        ReDim m_Thumb(0 To n): ReDim m_ThumbRot(0 To n)        ReDim m_ThumbY(0 To n): ReDim m_ThumbW(0 To n): ReDim m_ThumbH(0 To n)        ReDim m_OrgThumb(0 To n): ReDim m_OrgCurX(0 To n): ReDim m_OrgCurY(0 To n)        ReDim m_OrgSelected(0 To n)        ClearHistory        ReDim m_PageId(0 To n)        For i = 0 To m_Count - 1            m_PageId(i) = i + 1        Next        m_NextPageId = m_Count + 1        m_SavedPos = 0        m_ScrollX = 0        m_ScrollY = 0        m_ThumbScroll = 0        m_CurPage = 0        ' Al abrir un PDF no se muestra ningun panel        m_ShowThumbs = False        m_ShowSearch = False        m_Organize = False        m_CropMode = False        m_Modified = False        StopAnim        ResetInteraction        InstallRootHook        RefreshLayout False        RaiseEvent DocumentLoaded(m_Count)        RaiseEvent PageChanged(1)    End Sub    Private Sub ResetInteraction()        m_HasSel = False        m_Selecting = False        m_Panning = False        m_FindText = ""        m_FindPage = -1        m_FindIdx = -1        m_FindLen = 0        m_Searched = False        m_MatchCount = 0        m_MatchPos = -1    End Sub    Private Sub EraseCaches()        Erase m_Tile        Erase m_Thumb    End Sub    Private Function HasDoc() As Boolean        If m_Doc Is Nothing Then Exit Function        HasDoc = (m_Count > 0 And m_Doc.IsOpen)    End Function    ' ========================================================================    '  APARTADO 2 - Visor: disposicion, zoom y desplazamiento    ' ========================================================================    Private Function Px(ByVal LogicalPixels As Long) As Long        Px = MulDiv(LogicalPixels, m_Dpi, 96)    End Function    Private Function PxPerPt() As Double        PxPerPt = (m_Zoom / 100#) * (m_Dpi / 72#)    End Function    Private Function ClampZoom(ByVal z As Double) As Double        If z < MIN_ZOOM Then z = MIN_ZOOM        If z > MAX_ZOOM Then z = MAX_ZOOM        ClampZoom = z    End Function    ' Tamano de pagina en puntos teniendo en cuenta la rotacion.    Private Function RotW(ByVal i As Long) As Double        If (m_Rotation And 1) <> 0 Then RotW = m_Doc.PageHeight(i) Else RotW = m_Doc.PageWidth(i)    End Function    Private Function RotH(ByVal i As Long) As Double        If (m_Rotation And 1) <> 0 Then RotH = m_Doc.PageWidth(i) Else RotH = m_Doc.PageHeight(i)    End Function    Private Sub ReadClientSize()        Dim rc As RECT        If m_hWnd = 0 Then Exit Sub        GetClientRect m_hWnd, rc        ' m_ClientH es el alto de la vista de paginas (sin la barra de herramientas).        m_ClientW = rc.Right - rc.Left        m_FullH = rc.Bottom - rc.Top        If m_ShowToolbar Then m_ViewY = IMin(Px(TB_HEIGHT), m_FullH) Else m_ViewY = 0        m_ClientH = IMax(0, m_FullH - m_ViewY)    End Sub    ' Panel lateral izquierdo: miniaturas o busqueda.    Private Function PanelVisible() As Boolean        PanelVisible = (m_ShowThumbs Or m_ShowSearch) And HasDoc() And Not m_Organize    End Function    Private Function PanelWidthLogical() As Long        If m_ShowSearch Then            PanelWidthLogical = IMax(m_ThumbWidth, SEARCH_PANEL_MINWIDTH)        Else            PanelWidthLogical = m_ThumbWidth        End If    End Function    Private Sub LayoutPages()        Dim i As Long, gap As Long, y As Long, maxW As Long, s As Double        Dim viewW As Long, viewH As Long, maxWpt As Double, idx As Long        If PanelVisible() Then            m_ViewX = IMax(0, IMin(Px(PanelWidthLogical()), m_ClientW \ 2))        Else            m_ViewX = 0        End If        If Not HasDoc() Then            m_DocW = 0            m_DocH = 0            Exit Sub        End If        gap = Px(m_PageGap)        viewW = IMax(1, m_ClientW - m_ViewX - 2 * gap - Px(4))        viewH = IMax(1, m_ClientH - 2 * gap - Px(4))        Select Case m_ZoomMode            Case pdfZoomFitWidth                For i = 0 To m_Count - 1                    maxWpt = DMax(maxWpt, RotW(i))                Next                m_Zoom = ClampZoom(viewW / (maxWpt * m_Dpi / 72#) * 100#)            Case pdfZoomFitPage                idx = IMax(0, IMin(m_CurPage, m_Count - 1))                m_Zoom = ClampZoom(DMin(viewW / (RotW(idx) * m_Dpi / 72#), viewH / (RotH(idx) * m_Dpi / 72#)) * 100#)        End Select        s = PxPerPt()        y = gap        For i = 0 To m_Count - 1            m_PW(i) = IMax(1, CLng(RotW(i) * s))            m_PH(i) = IMax(1, CLng(RotH(i) * s))            m_PY(i) = y            y = y + m_PH(i) + gap            If m_PW(i) > maxW Then maxW = m_PW(i)        Next        m_DocW = maxW + 2 * gap        m_DocH = y        For i = 0 To m_Count - 1            m_PX(i) = (m_DocW - m_PW(i)) \ 2        Next    End Sub    Private Sub LayoutThumbs()        Dim i As Long, y As Long, tw As Long, margin As Long, labelH As Long        m_ThumbsH = 0        If Not (m_ShowThumbs And HasDoc()) Then Exit Sub        margin = Px(10)        labelH = Px(18)        tw = IMax(Px(16), m_ViewX - 2 * margin - Px(6))        y = margin        For i = 0 To m_Count - 1            m_ThumbW(i) = tw            m_ThumbH(i) = IMax(1, CLng(tw * RotH(i) / RotW(i)))            If m_ThumbH(i) > tw * 2 Then                ' paginas muy alargadas: limitar la altura y estrechar                m_ThumbH(i) = tw * 2                m_ThumbW(i) = IMax(1, CLng(m_ThumbH(i) * RotW(i) / RotH(i)))            End If            m_ThumbY(i) = y            y = y + m_ThumbH(i) + labelH + margin        Next        m_ThumbsH = y        ClampThumbScroll    End Sub    Private Function OriginX() As Long        Dim viewW As Long        viewW = m_ClientW - m_ViewX        If m_DocW <= viewW Then            OriginX = m_ViewX + (viewW - m_DocW) \ 2        Else            OriginX = m_ViewX - m_ScrollX        End If    End Function    Private Function OriginY() As Long        If m_DocH <= m_ClientH Then            OriginY = m_ViewY + (m_ClientH - m_DocH) \ 2        Else            OriginY = m_ViewY - m_ScrollY        End If    End Function    Private Sub ClampScroll()        m_ScrollX = IMax(0, IMin(m_ScrollX, m_DocW - (m_ClientW - m_ViewX)))        m_ScrollY = IMax(0, IMin(m_ScrollY, m_DocH - m_ClientH))    End Sub    Private Sub ClampThumbScroll()        m_ThumbScroll = IMax(0, IMin(m_ThumbScroll, m_ThumbsH - m_ClientH))    End Sub    ' Pagina mas cercana a una coordenada Y de pantalla.    Private Function PageNearestY(ByVal sy As Long) As Long        Dim i As Long, dy As Long, half As Long        If Not HasDoc() Then            PageNearestY = -1            Exit Function        End If        dy = sy - OriginY()        half = Px(m_PageGap) \ 2        For i = 0 To m_Count - 1            If dy < m_PY(i) + m_PH(i) + half Then                PageNearestY = i                Exit Function            End If        Next        PageNearestY = m_Count - 1    End Function    ' Pagina que contiene el punto de pantalla (-1 si ninguna).    Private Function PageAtPoint(ByVal x As Long, ByVal y As Long) As Long        Dim i As Long, ox As Long, oy As Long        PageAtPoint = -1        If Not HasDoc() Or x < m_ViewX Or y < m_ViewY Then Exit Function        ox = OriginX()        oy = OriginY()        i = PageNearestY(y)        If i < 0 Then Exit Function        If x >= ox + m_PX(i) And x < ox + m_PX(i) + m_PW(i) And y >= oy + m_PY(i) And y < oy + m_PY(i) + m_PH(i) Then PageAtPoint = i    End Function    Private Sub CaptureAnchor(ByVal sx As Long, ByVal sy As Long)        Dim i As Long        m_AnchorSX = sx        m_AnchorSY = sy        i = PageNearestY(sy)        m_AnchorPage = i        If i < 0 Then Exit Sub        m_AnchorFX = (sx - (OriginX() + m_PX(i))) / m_PW(i)        m_AnchorFY = (sy - (OriginY() + m_PY(i))) / m_PH(i)    End Sub    Private Sub RestoreAnchor()        Dim i As Long        i = m_AnchorPage        If i >= 0 And i < m_Count Then            m_ScrollX = CLng(m_ViewX + m_PX(i) + m_AnchorFX * m_PW(i) - m_AnchorSX)            m_ScrollY = CLng(m_PY(i) + m_AnchorFY * m_PH(i) - m_AnchorSY)        End If        ClampScroll    End Sub    ' Recalcula la disposicion completa. Si UseAnchor es True, el punto de    ' pantalla (ax, ay) sigue mostrando el mismo punto del documento.    ' Por defecto el ancla es el borde superior y el centro horizontal.    Private Sub RefreshLayout(ByVal UseAnchor As Boolean, Optional ByVal ax As Long = -1, Optional ByVal ay As Long = -1)        Dim pass As Long, w0 As Long, h0 As Long        If m_hWnd = 0 Or m_InLayout Then Exit Sub        m_InLayout = True        UseAnchor = UseAnchor And HasDoc() And m_DocH > 0        If UseAnchor Then            If ax < 0 Then ax = m_ViewX + (m_ClientW - m_ViewX) \ 2            If ay < 0 Then ay = m_ViewY            CaptureAnchor ax, ay        End If        ' Las barras de desplazamiento cambian el area cliente: se repite        ' hasta que el tamano se estabiliza.        For pass = 1 To 4            ReadClientSize            w0 = m_ClientW            h0 = m_ClientH            LayoutPages            If UseAnchor Then RestoreAnchor Else ClampScroll            If m_Organize Then LayoutOrganize            UpdateScrollBars            ReadClientSize            If m_ClientW = w0 And m_ClientH = h0 Then Exit For        Next        LayoutThumbs        LayoutToolbar        If m_Organize Then LayoutOrganize        m_InLayout = False        UpdateCurrentPage        Invalidate        If Abs(m_Zoom - m_ZoomNotified) > 0.0001 Then            m_ZoomNotified = m_Zoom            RaiseEvent ZoomChanged(m_Zoom)        End If    End Sub    Private Sub UpdateScrollBars()        Dim si As SCROLLINFO, viewW As Long        If m_hWnd = 0 Then Exit Sub        si.cbSize = LenB(si)        si.fMask = SIF_RANGE Or SIF_PAGE Or SIF_POS        If m_Organize And HasDoc() Then            If m_OrgContentH > OrgViewH() Then                si.nMax = m_OrgContentH - 1                si.nPage = IMax(1, OrgViewH())                si.nPos = m_OrgScroll            Else                si.nMax = 0                si.nPage = 1            End If            SetScrollInfo m_hWnd, SB_VERT, si, 1            si.nMax = 0            si.nPage = 1            si.nPos = 0            SetScrollInfo m_hWnd, SB_HORZ, si, 1            Exit Sub        End If        If HasDoc() And m_DocH > m_ClientH Then            si.nMax = m_DocH - 1            si.nPage = m_ClientH            si.nPos = m_ScrollY        Else            si.nMax = 0            si.nPage = 1            si.nPos = 0        End If        SetScrollInfo m_hWnd, SB_VERT, si, 1        viewW = m_ClientW - m_ViewX        If HasDoc() And m_DocW > viewW Then            si.nMax = m_DocW - 1            si.nPage = IMax(1, viewW)            si.nPos = m_ScrollX        Else            si.nMax = 0            si.nPage = 1            si.nPos = 0        End If        SetScrollInfo m_hWnd, SB_HORZ, si, 1    End Sub    Private Sub OnScrollMessage(ByVal Bar As Long, ByVal Code As Long)        Dim si As SCROLLINFO, pos As Long, lineStep As Long, pageStep As Long        si.cbSize = LenB(si)        si.fMask = SIF_ALL        GetScrollInfo m_hWnd, Bar, si        pos = si.nPos        lineStep = Px(40)        pageStep = IMax(lineStep, CLng(si.nPage) - lineStep)        Select Case Code            Case SB_LINEUP: pos = pos - lineStep            Case SB_LINEDOWN: pos = pos + lineStep            Case SB_PAGEUP: pos = pos - pageStep            Case SB_PAGEDOWN: pos = pos + pageStep            Case SB_THUMBTRACK, SB_THUMBPOSITION: pos = si.nTrackPos            Case SB_TOP: pos = 0            Case SB_BOTTOM: pos = si.nMax            Case Else: Exit Sub        End Select        If m_Organize Then            If Bar = SB_VERT Then OrgScrollTo pos            Exit Sub        End If        If Bar = SB_VERT Then ScrollTo m_ScrollX, pos Else ScrollTo pos, m_ScrollY    End Sub    Private Sub UpdateCurrentPage()        Dim i As Long, best As Long, bestVis As Long, t As Long, b As Long, vis As Long, oy As Long        If m_LockPage Or Not HasDoc() Then Exit Sub        best = -1        bestVis = -1        oy = OriginY()        For i = 0 To m_Count - 1            t = oy + m_PY(i)            If t > m_ViewY + m_ClientH Then Exit For            b = t + m_PH(i)            vis = IMin(b, m_ViewY + m_ClientH) - IMax(t, m_ViewY)            If vis > bestVis Then                bestVis = vis                best = i            End If        Next        If best < 0 Then best = 0        SetCurrentPage best    End Sub    Private Sub SetCurrentPage(ByVal i As Long)        If i = m_CurPage Then Exit Sub        m_CurPage = i        EnsureThumbVisible i        RaiseEvent PageChanged(i + 1)    End Sub    Private Sub Invalidate()        If m_hWnd <> 0 Then            InvalidateRect m_hWnd, 0, 0        ElseIf Not m_UserMode Then            UserControl.Refresh        End If    End Sub    Private Sub ZoomAt(ByVal NewZoom As Double, ByVal ax As Long, ByVal ay As Long)        Dim modeChanged As Boolean        NewZoom = ClampZoom(NewZoom)        modeChanged = (m_ZoomMode <> pdfZoomCustom)        m_ZoomMode = pdfZoomCustom        If Abs(NewZoom - m_Zoom) < 0.0001 And Not modeChanged Then Exit Sub        m_Zoom = NewZoom        RefreshLayout True, ax, ay        PropertyChanged "Zoom"        PropertyChanged "ZoomMode"    End Sub    Private Function ViewCenterY() As Long        ViewCenterY = m_ViewY + m_ClientH \ 2    End Function    Private Function ViewCenterX() As Long        ViewCenterX = m_ViewX + (m_ClientW - m_ViewX) \ 2    End Function    ' Siguiente tramo de ZOOM_STEP (25 %): desde 110 % sube a 125 % y baja a 100 %.    ' Nunca baja de un tramo (25 %).    Private Function NextZoomStep(ByVal z As Double, ByVal Up As Boolean) As Double        Dim k As Double        If Up Then            k = Int(z / ZOOM_STEP + 0.0001) + 1        Else            k = -Int(-(z / ZOOM_STEP) + 0.0001) - 1            If k < 1 Then k = 1        End If        NextZoomStep = ClampZoom(k * ZOOM_STEP)        ' Por debajo del primer tramo, reducir no debe ampliar.        If Not Up And NextZoomStep > z Then NextZoomStep = z    End Function    ' --- API publica del visor ----------------------------------------------    Public Sub GoToPage(ByVal Page As Long)        Dim i As Long        If Not HasDoc() Then Exit Sub        i = IMax(0, IMin(Page - 1, m_Count - 1))        m_LockPage = True        ScrollTo m_ScrollX, m_PY(i) - Px(m_PageGap)        m_LockPage = False        SetCurrentPage i        If m_Organize Then            OrgSelectOnly i            EnsureOrgVisible i        End If        Invalidate    End Sub    Public Sub NextPage()        GoToPage m_CurPage + 2    End Sub    Public Sub PreviousPage()        GoToPage m_CurPage    End Sub    Public Sub FirstPage()        GoToPage 1    End Sub    Public Sub LastPage()        GoToPage m_Count    End Sub    Public Sub ZoomIn()        ZoomAt NextZoomStep(m_Zoom, True), ViewCenterX(), ViewCenterY()    End Sub    Public Sub ZoomOut()        ZoomAt NextZoomStep(m_Zoom, False), ViewCenterX(), ViewCenterY()    End Sub    Public Sub RotateClockwise()        Rotation = (m_Rotation + 1) And 3    End Sub    Public Sub RotateCounterClockwise()        Rotation = (m_Rotation + 3) And 3    End Sub    ' Desplaza la vista a la posicion indicada (pixeles de dispositivo).    Public Sub ScrollTo(ByVal X As Long, ByVal Y As Long)        Dim ox As Long, oy As Long, si As SCROLLINFO        ox = m_ScrollX        oy = m_ScrollY        m_ScrollX = X        m_ScrollY = Y        ClampScroll        If ox = m_ScrollX And oy = m_ScrollY Then Exit Sub        If m_hWnd <> 0 Then            si.cbSize = LenB(si)            si.fMask = SIF_POS            si.nPos = m_ScrollY            SetScrollInfo m_hWnd, SB_VERT, si, 1            si.nPos = m_ScrollX            SetScrollInfo m_hWnd, SB_HORZ, si, 1        End If        UpdateCurrentPage        Invalidate        If m_hWnd <> 0 Then UpdateWindow m_hWnd    End Sub    Public Property Get ScrollX() As Long        ScrollX = m_ScrollX    End Property    Public Property Get ScrollY() As Long        ScrollY = m_ScrollY    End Property    ' ========================================================================    '  Pintado (doble bufer + mosaicos)    ' ========================================================================    Private Sub OnPaint(ByVal hWnd As LongPtr)        Dim ps As PAINTSTRUCT, hdc As LongPtr        hdc = BeginPaint(hWnd, ps)        On Error Resume Next        RenderFrame        If m_Back.IsValid Then BitBlt hdc, 0, 0, m_ClientW, m_FullH, m_Back.hDC, 0, 0, SRCCOPY        On Error GoTo 0        EndPaint hWnd, ps    End Sub    Private Sub RenderFrame()        Dim rc As RECT        ReadClientSize        If m_ClientW <= 0 Or m_FullH <= 0 Then Exit Sub        If Not m_Back.EnsureSize(m_ClientW, m_FullH) Then Exit Sub        rc = MakeRect(0, m_ViewY, m_ClientW, m_FullH)        FillSolid m_Back.hDC, rc, ToColorRef(m_BackColor)        If HasDoc() And m_Organize Then            DrawOrganize m_Back.hDC        ElseIf HasDoc() Then            DrawPages m_Back.hDC            If m_ShowSearch Then                DrawSearchPanel m_Back.hDC            ElseIf m_ShowThumbs Then                DrawThumbnails m_Back.hDC            End If            ReleaseUnused        Else            DrawLabel m_Back.hDC, rc, m_EmptyText, GetSysColor(COLOR_BTNFACE)        End If        ' La barra se dibuja la ultima: tapa lo que sobresalga de la vista.        If m_ViewY > 0 Then DrawToolbar m_Back.hDC        If m_TipShow And m_TbHot >= 0 Then DrawTooltip m_Back.hDC        rc = MakeRect(0, 0, m_ClientW, m_FullH)        If m_BorderStyle = pdfBorderSingle Then FrameSolid m_Back.hDC, rc, GetSysColor(COLOR_BTNSHADOW)    End Sub    Private Sub DrawPages(ByVal hdc As LongPtr)        Dim i As Long, x As Long, y As Long, w As Long, h As Long, ox As Long, oy As Long, sh As Long        Dim vx0 As Long, vy0 As Long, vx1 As Long, vy1 As Long, rc As RECT        ox = OriginX()        oy = OriginY()        sh = IMax(2, Px(3))        m_VisFirst = -1        m_VisLast = -2        For i = 0 To m_Count - 1            y = oy + m_PY(i)            If y > m_ViewY + m_ClientH Then Exit For            h = m_PH(i)            If y + h + sh >= m_ViewY Then                x = ox + m_PX(i)                w = m_PW(i)                If x + w + sh >= m_ViewX And x < m_ClientW Then                    If m_VisFirst < 0 Then m_VisFirst = i                    m_VisLast = i                    rc = MakeRect(x + sh, y + sh, x + w + sh, y + h + sh)                    FillSolid hdc, rc, GetSysColor(COLOR_BTNSHADOW)                    vx0 = IMax(0, m_ViewX - x)                    vy0 = IMax(0, m_ViewY - y)                    vx1 = IMin(w, m_ClientW - x)                    vy1 = IMin(h, m_ViewY + m_ClientH - y)                    If vx1 > vx0 And vy1 > vy0 Then                        If EnsureTile(i, vx0, vy0, vx1, vy1) Then                            BitBlt hdc, x + vx0, y + vy0, vx1 - vx0, vy1 - vy0, m_Tile(i).hDC, vx0 - m_TileX(i), vy0 - m_TileY(i), SRCCOPY                        Else                            rc = MakeRect(x + vx0, y + vy0, x + vx1, y + vy1)                            FillSolid hdc, rc, &HFFFFFF                        End If                        DrawHighlights hdc, i, x, y                    End If                    rc = MakeRect(x - 1, y - 1, x + w + 1, y + h + 1)                    FrameSolid hdc, rc, &H808080                End If            End If        Next    End Sub    ' Garantiza que el mosaico de la pagina cubre la zona visible.    ' El mosaico abarca la zona visible mas medio cliente de margen, asi el    ' desplazamiento se resuelve con BitBlt sin volver a renderizar y la    ' memoria no crece con el zoom (a 6400% solo se renderiza lo visible).    Private Function EnsureTile(ByVal i As Long, ByVal vx0 As Long, ByVal vy0 As Long, ByVal vx1 As Long, ByVal vy1 As Long) As Boolean        Dim t As PdfDib, mx As Long, my As Long, tx0 As Long, ty0 As Long, tx1 As Long, ty1 As Long        Set t = m_Tile(i)        If Not t Is Nothing Then            If m_TileKW(i) = m_PW(i) And m_TileKH(i) = m_PH(i) And m_TileRot(i) = m_Rotation And t.IsValid Then                If vx0 >= m_TileX(i) And vy0 >= m_TileY(i) And vx1 <= m_TileX(i) + t.Width And vy1 <= m_TileY(i) + t.Height Then                    EnsureTile = True                    Exit Function                End If            End If        Else            Set t = New PdfDib            Set m_Tile(i) = t        End If        mx = m_ClientW \ 2        my = m_ClientH \ 2        tx0 = IMax(0, vx0 - mx)        ty0 = IMax(0, vy0 - my)        tx1 = IMin(m_PW(i), vx1 + mx)        ty1 = IMin(m_PH(i), vy1 + my)        If Not t.EnsureSize(tx1 - tx0, ty1 - ty0) Then            ' Sin memoria suficiente: solo la parte visible.            tx0 = vx0: ty0 = vy0: tx1 = vx1: ty1 = vy1            If Not t.EnsureSize(tx1 - tx0, ty1 - ty0) Then                Set m_Tile(i) = Nothing                Exit Function            End If        End If        If Not m_Doc.RenderTo(i, t, -tx0, -ty0, m_PW(i), m_PH(i), m_Rotation, RENDER_FLAGS) Then            Set m_Tile(i) = Nothing            Exit Function        End If        m_TileX(i) = tx0        m_TileY(i) = ty0        m_TileKW(i) = m_PW(i)        m_TileKH(i) = m_PH(i)        m_TileRot(i) = m_Rotation        EnsureTile = True    End Function    Private Sub DrawThumbnails(ByVal hdc As LongPtr)        Dim rc As RECT, i As Long, x As Long, y As Long, tw As Long, th As Long        Dim labelH As Long, d As Long, barH As Long, barY As Long        rc = MakeRect(0, m_ViewY, m_ViewX, m_FullH)        FillSolid hdc, rc, ToColorRef(m_ThumbBackColor)        labelH = Px(18)        d = Px(3)        m_ThumbVisFirst = -1        m_ThumbVisLast = -2        For i = 0 To m_Count - 1            y = m_ViewY + m_ThumbY(i) - m_ThumbScroll            If y > m_FullH Then Exit For            tw = m_ThumbW(i)            th = m_ThumbH(i)            If y + th + labelH >= m_ViewY Then                If m_ThumbVisFirst < 0 Then m_ThumbVisFirst = i                m_ThumbVisLast = i                x = (m_ViewX - tw) \ 2                If EnsureThumb(i) Then                    BitBlt hdc, x, y, tw, th, m_Thumb(i).hDC, 0, 0, SRCCOPY                Else                    rc = MakeRect(x, y, x + tw, y + th)                    FillSolid hdc, rc, &HFFFFFF                End If                If i = m_CurPage Then                    rc = MakeRect(x - d, y - d, x + tw + d, y + th + d)                    FrameSolid hdc, rc, ToColorRef(m_SelColor), IMax(2, Px(2))                Else                    rc = MakeRect(x - 1, y - 1, x + tw + 1, y + th + 1)                    FrameSolid hdc, rc, &H808080                End If                rc = MakeRect(0, y + th + Px(2), m_ViewX, y + th + labelH)                DrawLabel hdc, rc, CStr(i + 1), GetSysColor(COLOR_BTNTEXT)            End If        Next        rc = MakeRect(m_ViewX - 1, m_ViewY, m_ViewX, m_FullH)        FillSolid hdc, rc, GetSysColor(COLOR_BTNSHADOW)        ' Indicador de desplazamiento del panel de miniaturas        If m_ThumbsH > m_ClientH And m_ClientH > 0 Then            barH = IMax(Px(20), CLng(CDbl(m_ClientH) * m_ClientH / m_ThumbsH))            barY = CLng(CDbl(m_ClientH - barH) * m_ThumbScroll / (m_ThumbsH - m_ClientH))            rc = MakeRect(m_ViewX - Px(6), m_ViewY + barY, m_ViewX - Px(3), m_ViewY + barY + barH)            FillSolid hdc, rc, GetSysColor(COLOR_BTNSHADOW)        End If    End Sub    Private Function EnsureThumb(ByVal i As Long) As Boolean        Dim t As PdfDib        Set t = m_Thumb(i)        If Not t Is Nothing Then            If t.Width = m_ThumbW(i) And t.Height = m_ThumbH(i) And m_ThumbRot(i) = m_Rotation Then                EnsureThumb = True                Exit Function            End If        Else            Set t = New PdfDib        End If        If Not t.EnsureSize(m_ThumbW(i), m_ThumbH(i)) Then Exit Function        If Not m_Doc.RenderTo(i, t, 0, 0, m_ThumbW(i), m_ThumbH(i), m_Rotation, FPDF_ANNOT) Then Exit Function        Set m_Thumb(i) = t        m_ThumbRot(i) = m_Rotation        EnsureThumb = True    End Function    ' Libera mosaicos, miniaturas y paginas PDFium que ya no se ven.    Private Sub ReleaseUnused()        Dim i As Long        For i = 0 To m_Count - 1            If i < m_VisFirst - 1 Or i > m_VisLast + 1 Then                If Not m_Tile(i) Is Nothing Then Set m_Tile(i) = Nothing            End If            If i < m_ThumbVisFirst - 30 Or i > m_ThumbVisLast + 30 Then                If Not m_Thumb(i) Is Nothing Then Set m_Thumb(i) = Nothing            End If        Next        m_Doc.ReleasePagesExcept m_VisFirst - 2, m_VisLast + 2    End Sub    Private Sub AlphaFill(ByVal hdc As LongPtr, ByRef rc As RECT, ByVal OleColor As Long, ByVal Alpha As Long)        If rc.Right <= rc.Left Or rc.Bottom <= rc.Top Then Exit Sub        If Not m_Solid.EnsureSize(1, 1) Then Exit Sub        m_Solid.SetPixel 0, 0, ToPixel(OleColor)        AlphaBlend hdc, rc.Left, rc.Top, rc.Right - rc.Left, rc.Bottom - rc.Top, m_Solid.hDC, 0, 0, 1, 1, (Alpha And &HFF&) * &H10000    End Sub    Private Sub DrawLabel(ByVal hdc As LongPtr, ByRef rc As RECT, ByVal Text As String, ByVal ColorRef As Long)        Dim hOld As LongPtr, r As RECT        If Len(Text) = 0 Then Exit Sub        r = rc        If m_hFont <> 0 Then hOld = SelectObject(hdc, m_hFont)        SetBkMode hdc, TRANSPARENT        SetTextColor hdc, ColorRef        DrawTextW hdc, StrPtr(Text), -1, r, DT_CENTER Or DT_VCENTER Or DT_SINGLELINE Or DT_NOPREFIX Or DT_END_ELLIPSIS        If hOld <> 0 Then SelectObject hdc, hOld    End Sub    Private Sub DrawDesignPlaceholder(ByVal hdc As LongPtr)        Dim rc As RECT, pr As RECT, tw As Long, mw As Long, tbh As Long        GetClientRect UserControl.hWnd, rc        FillSolid hdc, rc, ToColorRef(m_BackColor)        If m_ShowToolbar Then            tbh = IMin(TB_HEIGHT, rc.Bottom)            pr = MakeRect(0, 0, rc.Right, tbh)            FillSolid hdc, pr, GetSysColor(COLOR_BTNFACE)            pr = MakeRect(0, tbh - 1, rc.Right, tbh)            FillSolid hdc, pr, GetSysColor(COLOR_BTNSHADOW)            pr = MakeRect(8, 0, rc.Right, tbh)            DrawLabel hdc, pr, "[abrir] [guardar] | [=] [Q] |  |<  <   1 / 1   >  >|  |  -  100 %  +  <->  [ ]  |  [impr] [org]", GetSysColor(COLOR_GRAYTEXT)        End If        If m_ShowThumbs Then            tw = IMin(m_ThumbWidth, rc.Right \ 2)            pr = MakeRect(0, tbh, tw, rc.Bottom)            FillSolid hdc, pr, ToColorRef(m_ThumbBackColor)        End If        mw = (rc.Right - tw) \ 5        pr = MakeRect(tw + mw, tbh + 12, rc.Right - mw, rc.Bottom - 12)        If pr.Right > pr.Left And pr.Bottom > pr.Top Then            FillSolid hdc, pr, &HFFFFFF            FrameSolid hdc, pr, &H808080            DrawLabel hdc, pr, "ucPDF", &H808080        End If        If m_BorderStyle = pdfBorderSingle Then FrameSolid hdc, rc, GetSysColor(COLOR_BTNSHADOW)    End Sub    ' ========================================================================    '  Raton, teclado y cursor    ' ========================================================================    Private Function ScreenToPdf(ByVal i As Long, ByVal x As Long, ByVal y As Long, ByRef PdfX As Double, ByRef PdfY As Double) As Boolean        Dim pg As LongPtr        pg = m_Doc.PageHandle(i)        If pg = 0 Then Exit Function        ScreenToPdf = (FPDF_DeviceToPage(pg, OriginX() + m_PX(i), OriginY() + m_PY(i), m_PW(i), m_PH(i), m_Rotation, x, y, PdfX, PdfY) <> 0)    End Function    Private Function CharAtPoint(ByVal i As Long, ByVal x As Long, ByVal y As Long, ByVal Tolerance As Double) As Long        Dim tp As LongPtr, px As Double, py As Double, r As Long        CharAtPoint = -1        If i < 0 Then Exit Function        tp = m_Doc.TextPageHandle(i)        If tp = 0 Then Exit Function        If Not ScreenToPdf(i, x, y, px, py) Then Exit Function        r = FPDFText_GetCharIndexAtPos(tp, px, py, Tolerance, Tolerance)        If r >= 0 Then CharAtPoint = r    End Function    Private Sub OnMouseDown(ByVal x As Long, ByVal y As Long, ByVal Button As Long, ByVal Keys As Long)        Dim i As Long, px As Double, py As Double, ch As Long        ' Botones de la barra y del panel de busqueda        If Button = vbLeftButton Then            i = ToolbarHitTest(x, y)            If i >= 0 Then                m_TbDown = i                SetCapture m_hWnd                Invalidate                Exit Sub            End If        End If        If y < m_ViewY Then Exit Sub        If m_Organize Then            OrgMouseDown x, y, Button            Exit Sub        End If        ' Al pulsar en la vista, el teclado vuelve al visor.        If m_hEdit <> 0 Then            If GetFocus() = m_hEdit Then SetFocusAPI m_hWnd        End If        If Not HasDoc() Then Exit Sub        If x < m_ViewX Then            If Button = vbLeftButton And m_ShowSearch Then                i = ResultAt(x, y)                If i >= 0 Then SelectSearchResult i            End If            If Button = vbLeftButton And m_ShowThumbs Then                i = ThumbAt(y)                If i >= 0 Then GoToPage i + 1            End If            Exit Sub        End If        i = PageAtPoint(x, y)        If i >= 0 Then            If ScreenToPdf(i, x, y, px, py) Then RaiseEvent PageClick(i + 1, px, py, Button)        End If        If Button = vbMiddleButton Or (Button = vbLeftButton And m_CursorMode = pdfCursorPan) Then            BeginPan x, y            Exit Sub        End If        If Button <> vbLeftButton Then Exit Sub        ch = -1        If i >= 0 Then ch = CharAtPoint(i, x, y, 3)        If ch >= 0 Then            If m_HasSel Then                m_HasSel = False                Invalidate            End If            m_SelAPage = i            m_SelAChar = ch            m_SelBPage = i            m_SelBChar = ch            m_Selecting = True            SetCapture m_hWnd        Else            If m_HasSel Then ClearSelection            BeginPan x, y        End If    End Sub    Private Sub BeginPan(ByVal x As Long, ByVal y As Long)        m_Panning = True        m_PanX = x        m_PanY = y        m_PanSX = m_ScrollX        m_PanSY = m_ScrollY        SetCapture m_hWnd        SetCursor LoadCursorW(0, IDC_SIZEALL)    End Sub    Private Sub OnMouseMove(ByVal x As Long, ByVal y As Long)        Dim i As Long, ch As Long, tme As TRACKMOUSEEVENTSTRUCT        If m_Panning Then            ScrollTo m_PanSX - (x - m_PanX), m_PanSY - (y - m_PanY)            Exit Sub        End If        If m_Organize Then OrgMouseMove x, y        ' Resaltado de botones de la barra (y aviso de salida del raton)        If m_ShowSearch Then SetResultHot ResultAt(x, y)        If m_TbCount > 0 Then            SetToolbarHot ToolbarHitTest(x, y)            If Not m_TrackingLeave Then                tme.cbSize = LenB(tme)                tme.dwFlags = TME_LEAVE                tme.hwndTrack = m_hWnd                m_TrackingLeave = (TrackMouseEvent(tme) <> 0)            End If        End If        If Not m_Selecting Then Exit Sub        ' Desplazamiento automatico al arrastrar fuera del area visible        If y < m_ViewY Then            ScrollTo m_ScrollX, m_ScrollY + (y - m_ViewY)        ElseIf y > m_ViewY + m_ClientH Then            ScrollTo m_ScrollX, m_ScrollY + (y - m_ViewY - m_ClientH)        End If        i = PageNearestY(y)        ch = CharAtPoint(i, x, y, 12)        If ch < 0 Then ch = CharAtPoint(i, x, y, 60)        If ch >= 0 Then            If i <> m_SelBPage Or ch <> m_SelBChar Or Not m_HasSel Then                m_SelBPage = i                m_SelBChar = ch                m_HasSel = True                Invalidate            End If        End If    End Sub    Private Sub OnMouseUp(ByVal x As Long, ByVal y As Long)        Dim wasSelecting As Boolean, cmdIdx As Long        m_TipShow = False        If m_TbDown >= 0 Then            cmdIdx = m_TbDown            m_TbDown = -1            If GetCapture() = m_hWnd Then ReleaseCapture            Invalidate            If ToolbarHitTest(x, y) = cmdIdx Then ExecuteToolbarCommand m_TbCmd(cmdIdx)            Exit Sub        End If        If m_Organize Then            OrgMouseUp x, y            Exit Sub        End If        wasSelecting = m_Selecting        m_Selecting = False        m_Panning = False        If GetCapture() = m_hWnd Then ReleaseCapture        If wasSelecting And m_HasSel Then RaiseEvent SelectionChanged    End Sub    Private Sub EndDrag()        Dim wasSelecting As Boolean        If m_CropMode Then m_CropDrag = 0        If m_Organize Then OrgCancelDrag        If m_TbDown >= 0 Then            m_TbDown = -1            Invalidate        End If        wasSelecting = m_Selecting        m_Selecting = False        m_Panning = False        If wasSelecting And m_HasSel Then RaiseEvent SelectionChanged    End Sub    ' Doble clic: selecciona la palabra.    Private Sub OnDoubleClick(ByVal x As Long, ByVal y As Long)        Dim i As Long, ch As Long, tp As LongPtr, n As Long, s As Long, e As Long        If m_Organize And HasDoc() Then            ' Doble clic en una miniatura: volver a la vista normal en esa pagina            i = OrgHitPage(x, y)            If i >= 0 Then                Organizing = False                GoToPage i + 1            End If            Exit Sub        End If        If Not HasDoc() Or x < m_ViewX Or m_CursorMode = pdfCursorPan Then Exit Sub        i = PageAtPoint(x, y)        ch = CharAtPoint(i, x, y, 3)        If ch < 0 Then Exit Sub        tp = m_Doc.TextPageHandle(i)        n = FPDFText_CountChars(tp)        s = ch        e = ch        If IsWordChar(FPDFText_GetUnicode(tp, ch)) Then            Do While s > 0                If Not IsWordChar(FPDFText_GetUnicode(tp, s - 1)) Then Exit Do                s = s - 1            Loop            Do While e < n - 1                If Not IsWordChar(FPDFText_GetUnicode(tp, e + 1)) Then Exit Do                e = e + 1            Loop        End If        m_Selecting = False        m_SelAPage = i: m_SelAChar = s        m_SelBPage = i: m_SelBChar = e        m_HasSel = True        Invalidate        RaiseEvent SelectionChanged    End Sub    Private Function IsWordChar(ByVal c As Long) As Boolean        If c <= 32 Or c > &HFFFF& Then Exit Function        IsWordChar = (InStr(1, " .,;:!?()[]{}<>""'/\|" & ChrW$(&HAB) & ChrW$(&HBB) & ChrW$(&HBF) & ChrW$(&HA1), ChrW$(c)) = 0)    End Function    Private Sub OnMouseWheel(ByVal Delta As Long, ByVal Keys As Long, ByVal x As Long, ByVal y As Long, ByVal Horizontal As Boolean)        Dim stepPx As Long        If Not HasDoc() Then Exit Sub        If m_Organize Then            If Horizontal Or m_CropMode Then Exit Sub            If (Keys And MK_CONTROL) <> 0 Then                SetOrgSize m_OrgSize + IIf(Delta > 0, 20, -20)            Else                OrgScrollTo m_OrgScroll - Delta * Px(120) \ 120            End If            Exit Sub        End If        If (Keys And MK_CONTROL) <> 0 And Not Horizontal Then            ZoomAt m_Zoom * (1.1 ^ (Delta / 120#)), x, y            Exit Sub        End If        stepPx = Px(120)        If x < m_ViewX And Not Horizontal Then            If m_ShowSearch Then                m_ResScroll = m_ResScroll - Delta * Px(RES_ITEM_H) \ 120                ClampResScroll                SetResultHot ResultAt(x, y)                Invalidate                Exit Sub            End If            If Not m_ShowThumbs Then Exit Sub            m_ThumbScroll = m_ThumbScroll - Delta * stepPx \ 120            ClampThumbScroll            Invalidate            Exit Sub        End If        If Horizontal Then            ScrollTo m_ScrollX + Delta * stepPx \ 120, m_ScrollY        ElseIf (Keys And MK_SHIFT) <> 0 Then            ScrollTo m_ScrollX - Delta * stepPx \ 120, m_ScrollY        Else            ScrollTo m_ScrollX, m_ScrollY - Delta * stepPx \ 120        End If    End Sub    Private Function OnSetCursor() As Boolean        Dim pt As POINTAPI, i As Long, id As Long        GetCursorPos pt        ScreenToClient m_hWnd, pt        id = IDC_ARROW        If m_Panning Or (m_Organize And m_OrgDragging) Then            id = IDC_SIZEALL        ElseIf m_CropMode And pt.Y >= OrgTop() Then            If m_CropDrag <> 0 Then                id = CropCursorFor(m_CropDrag)            ElseIf CropBtnAt(pt.X, pt.Y) > 0 Then                id = IDC_HAND            ElseIf CropHitTest(pt.X, pt.Y) <> 0 Or InRect(m_CropPgRect, pt.X, pt.Y) Then                id = CropCursorFor(CropHitTest(pt.X, pt.Y))            End If        ElseIf m_Organize And pt.Y >= m_ViewY Then            If OrgHitPage(pt.X, pt.Y) >= 0 Or PtInSlider(pt.X, pt.Y) Then id = IDC_HAND        ElseIf ToolbarHitTest(pt.X, pt.Y) >= 0 Or ResultAt(pt.X, pt.Y) >= 0 Then            id = IDC_HAND        ElseIf pt.Y < m_ViewY Then            id = IDC_ARROW        ElseIf HasDoc() And pt.X >= m_ViewX Then            i = PageAtPoint(pt.X, pt.Y)            If m_CursorMode = pdfCursorPan Then                id = IDC_HAND            ElseIf i >= 0 Then                If CharAtPoint(i, pt.X, pt.Y, 2) >= 0 Then id = IDC_IBEAM            End If        ElseIf HasDoc() And m_ShowThumbs And pt.X < m_ViewX Then            If ThumbAt(pt.Y) >= 0 Then id = IDC_HAND        End If        SetCursor LoadCursorW(0, id)        OnSetCursor = True    End Function    Private Sub OnKeyDown(ByVal vk As Long)        Dim isCtrl As Boolean, isShift As Boolean, stepPx As Long        isCtrl = (GetKeyState(VK_CONTROL) < 0)        isShift = (GetKeyState(VK_SHIFT) < 0)        If isCtrl And vk = &H4F And m_ShowOpenBtn Then          ' Ctrl+O            ShowOpenDialog            Exit Sub        End If        If m_CropMode Then            If vk = VK_ESCAPE Then CancelCrop            If vk = VK_RETURN Then ApplyCrop            Exit Sub        End If        If m_Organize Then            If vk = VK_ESCAPE Then                If m_OrgDragging Then OrgCancelDrag Else Organizing = False            ElseIf isCtrl And vk = &H53 And m_ShowSaveBtn Then                ShowSaveDialog            ElseIf isCtrl And vk = &H5A And Not isShift Then                Undo            ElseIf isCtrl And (vk = &H59 Or (vk = &H5A And isShift)) Then                Redo            ElseIf isCtrl And vk = &H41 Then                SelectAllPages            ElseIf vk = VK_DELETE Then                If ToolbarItemEnabled(CMD_ORG_DELETE) Then DeleteSelectedPages            End If            Exit Sub        End If        If Not HasDoc() Then Exit Sub        If isCtrl And vk = &H53 And m_ShowSaveBtn Then          ' Ctrl+S            ShowSaveDialog            Exit Sub        End If        stepPx = Px(40)        Select Case vk            Case VK_UP: ScrollTo m_ScrollX, m_ScrollY - stepPx            Case VK_DOWN: ScrollTo m_ScrollX, m_ScrollY + stepPx            Case VK_LEFT: ScrollTo m_ScrollX - stepPx, m_ScrollY            Case VK_RIGHT: ScrollTo m_ScrollX + stepPx, m_ScrollY            Case VK_PRIOR                If isCtrl Then PreviousPage Else ScrollTo m_ScrollX, m_ScrollY - IMax(stepPx, m_ClientH - stepPx)            Case VK_NEXT                If isCtrl Then NextPage Else ScrollTo m_ScrollX, m_ScrollY + IMax(stepPx, m_ClientH - stepPx)            Case VK_HOME: FirstPage            Case VK_END: LastPage            Case VK_ADD, VK_OEM_PLUS: If isCtrl Then ZoomIn            Case VK_SUBTRACT, VK_OEM_MINUS: If isCtrl Then ZoomOut            Case &H30, &H60: If isCtrl Then ZoomAt 100, ViewCenterX(), ViewCenterY()            Case &H41: If isCtrl Then SelectAll            Case &H43: If isCtrl Then CopySelection            Case VK_F3: If isShift Then FindPrevious Else FindNext            Case &H46: If isCtrl Then FocusSearchBox        End Select    End Sub    ' ========================================================================    '  APARTADO 3 - Herramientas: miniaturas    ' ========================================================================    Private Function ThumbAt(ByVal y As Long) As Long        Dim i As Long, dy As Long, labelH As Long, margin As Long        ThumbAt = -1        If Not (m_ShowThumbs And HasDoc()) Then Exit Function        If y < m_ViewY Then Exit Function        dy = y - m_ViewY + m_ThumbScroll        labelH = Px(18)        margin = Px(10)        For i = 0 To m_Count - 1            If dy < m_ThumbY(i) - margin \ 2 Then Exit Function            If dy < m_ThumbY(i) + m_ThumbH(i) + labelH + margin \ 2 Then                ThumbAt = i                Exit Function            End If        Next    End Function    Private Sub EnsureThumbVisible(ByVal i As Long)        Dim top As Long, bottom As Long        If Not (m_ShowThumbs And HasDoc()) Or i < 0 Or i >= m_Count Or m_ThumbsH = 0 Then Exit Sub        top = m_ThumbY(i) - Px(6)        bottom = m_ThumbY(i) + m_ThumbH(i) + Px(24)        If top < m_ThumbScroll Then            m_ThumbScroll = top        ElseIf bottom > m_ThumbScroll + m_ClientH Then            m_ThumbScroll = bottom - m_ClientH        End If        ClampThumbScroll    End Sub    ' ========================================================================    '  APARTADO 3 - Herramientas: seleccion de texto    ' ========================================================================    Private Function SelOrdered(ByRef p0 As Long, ByRef c0 As Long, ByRef p1 As Long, ByRef c1 As Long) As Boolean        If Not m_HasSel Then Exit Function        If m_SelAPage < m_SelBPage Or (m_SelAPage = m_SelBPage And m_SelAChar <= m_SelBChar) Then            p0 = m_SelAPage: c0 = m_SelAChar: p1 = m_SelBPage: c1 = m_SelBChar        Else            p0 = m_SelBPage: c0 = m_SelBChar: p1 = m_SelAPage: c1 = m_SelAChar        End If        SelOrdered = True    End Function    ' Rango de caracteres seleccionados (inclusivo) en la pagina i.    Private Function SelectionRangeOnPage(ByVal i As Long, ByRef s As Long, ByRef e As Long) As Boolean        Dim p0 As Long, c0 As Long, p1 As Long, c1 As Long        If Not SelOrdered(p0, c0, p1, c1) Then Exit Function        If i < p0 Or i > p1 Then Exit Function        If i = p0 Then s = c0 Else s = 0        If i = p1 Then e = c1 Else e = m_Doc.CharCount(i) - 1        SelectionRangeOnPage = (e >= s)    End Function    Private Sub DrawHighlights(ByVal hdc As LongPtr, ByVal i As Long, ByVal x As Long, ByVal y As Long)        Dim s As Long, e As Long        If m_HasSel Then            If SelectionRangeOnPage(i, s, e) Then DrawCharRange hdc, i, x, y, s, e - s + 1, m_SelColor, 90        End If        If m_FindPage = i And m_FindLen > 0 Then DrawCharRange hdc, i, x, y, m_FindIdx, m_FindLen, m_FindColor, 120    End Sub    Private Sub DrawCharRange(ByVal hdc As LongPtr, ByVal i As Long, ByVal x As Long, ByVal y As Long, ByVal StartChar As Long, ByVal Count As Long, ByVal OleColor As Long, ByVal Alpha As Long)        Dim tp As LongPtr, pg As LongPtr, n As Long, r As Long        Dim l As Double, t As Double, rr As Double, b As Double, rc As RECT        tp = m_Doc.TextPageHandle(i)        pg = m_Doc.PageHandle(i)        If tp = 0 Or pg = 0 Or Count <= 0 Then Exit Sub        n = FPDFText_CountRects(tp, StartChar, Count)        For r = 0 To n - 1            If FPDFText_GetRect(tp, r, l, t, rr, b) <> 0 Then                rc = PdfRectToScreen(pg, i, x, y, l, t, rr, b)                AlphaFill hdc, rc, OleColor, Alpha            End If        Next    End Sub    Private Function PdfRectToScreen(ByVal pg As LongPtr, ByVal i As Long, ByVal x As Long, ByVal y As Long, ByVal l As Double, ByVal t As Double, ByVal r As Double, ByVal b As Double) As RECT        Dim x1 As Long, y1 As Long, x2 As Long, y2 As Long        FPDF_PageToDevice pg, x, y, m_PW(i), m_PH(i), m_Rotation, l, t, x1, y1        FPDF_PageToDevice pg, x, y, m_PW(i), m_PH(i), m_Rotation, r, b, x2, y2        PdfRectToScreen = MakeRect(IMin(x1, x2), IMin(y1, y2), IMax(x1, x2), IMax(y1, y2))    End Function    Public Property Get HasSelection() As Boolean        HasSelection = m_HasSel    End Property    Public Property Get SelectedText() As String        Dim p0 As Long, c0 As Long, p1 As Long, c1 As Long, p As Long, s As Long, e As Long, r As String        If Not HasDoc() Then Exit Property        If Not SelOrdered(p0, c0, p1, c1) Then Exit Property        For p = p0 To p1            If SelectionRangeOnPage(p, s, e) Then                If Len(r) > 0 Then r = r & vbCrLf                r = r & m_Doc.GetText(p, s, e - s + 1)            End If        Next        SelectedText = r    End Property    Public Sub SelectAll()        If Not HasDoc() Then Exit Sub        m_SelAPage = 0        m_SelAChar = 0        m_SelBPage = m_Count - 1        m_SelBChar = IMax(0, m_Doc.CharCount(m_Count - 1) - 1)        m_HasSel = True        Invalidate        RaiseEvent SelectionChanged    End Sub    Public Sub ClearSelection()        If Not m_HasSel Then Exit Sub        m_HasSel = False        Invalidate        RaiseEvent SelectionChanged    End Sub    Public Function CopySelection() As Boolean        Dim t As String        t = SelectedText        If Len(t) > 0 Then CopySelection = SetClipboardUnicode(m_hWnd, t)    End Function    Public Function GetPageText(ByVal Page As Long) As String        If HasDoc() Then GetPageText = m_Doc.GetText(Page - 1)    End Function    ' ========================================================================    '  APARTADO 3 - Herramientas: busqueda de texto    ' ========================================================================    ' Busca el texto en todo el documento, guarda todas las coincidencias y    ' salta a la primera situada en la pagina actual o despues.    Public Function FindText(ByVal Text As String, Optional ByVal MatchCase As Boolean = False, Optional ByVal WholeWord As Boolean = False) As Boolean        Dim j As Long        m_FindText = Text        m_FindFlags = 0        If MatchCase Then m_FindFlags = m_FindFlags Or FPDF_MATCHCASE        If WholeWord Then m_FindFlags = m_FindFlags Or FPDF_MATCHWHOLEWORD        SyncSearchEdit        CollectMatches        m_Searched = (Len(Text) > 0 And HasDoc())        If m_MatchCount = 0 Then            m_MatchPos = -1            m_FindPage = -1            m_FindLen = 0            Invalidate            RaiseEvent SearchCompleted(False, 0)            Exit Function        End If        m_MatchPos = 0        For j = 0 To m_MatchCount - 1            If m_MatchPage(j) >= m_CurPage Then                m_MatchPos = j                Exit For            End If        Next        ApplyMatch        FindText = True    End Function    Public Function FindNext() As Boolean        If m_MatchCount = 0 Then            RaiseEvent SearchCompleted(False, 0)            Exit Function        End If        m_MatchPos = (m_MatchPos + 1) Mod m_MatchCount        ApplyMatch        FindNext = True    End Function    Public Function FindPrevious() As Boolean        If m_MatchCount = 0 Then            RaiseEvent SearchCompleted(False, 0)            Exit Function        End If        m_MatchPos = (m_MatchPos - 1 + m_MatchCount) Mod m_MatchCount        ApplyMatch        FindPrevious = True    End Function    Public Sub ClearSearch()        m_FindText = ""        m_FindPage = -1        m_FindIdx = -1        m_FindLen = 0        m_Searched = False        m_MatchCount = 0        m_MatchPos = -1        Erase m_MatchPage        Erase m_MatchIdx        Erase m_MatchLen        Erase m_MatchPre        Erase m_MatchHit        Erase m_MatchPost        m_ResScroll = 0        m_ResHot = -1        Invalidate    End Sub    ' Numero total de coincidencias de la ultima busqueda.    Public Property Get SearchResultCount() As Long        SearchResultCount = m_MatchCount    End Property    ' Coincidencia actual (base 1, 0 si no hay ninguna).    Public Property Get SearchResultIndex() As Long        If m_MatchCount > 0 Then SearchResultIndex = m_MatchPos + 1    End Property    Public Property Get SearchText() As String        SearchText = m_FindText    End Property    Private Sub ApplyMatch()        m_FindPage = m_MatchPage(m_MatchPos)        m_FindIdx = m_MatchIdx(m_MatchPos)        m_FindLen = m_MatchLen(m_MatchPos)        EnsureResultVisible m_MatchPos        ScrollMatchIntoView        Invalidate        RaiseEvent SearchCompleted(True, m_FindPage + 1)    End Sub    ' Recorre todas las paginas. Las paginas no visibles se liberan despues de    ' examinarlas para no mantener en memoria todo el documento.    Private Sub CollectMatches()        Dim p As Long, tp As LongPtr, h As LongPtr, cap As Long        m_MatchCount = 0        m_MatchPos = -1        Erase m_MatchPage        Erase m_MatchIdx        Erase m_MatchLen        Erase m_MatchPre        Erase m_MatchHit        Erase m_MatchPost        m_ResScroll = 0        m_ResHot = -1        If Not HasDoc() Or Len(m_FindText) = 0 Then Exit Sub        For p = 0 To m_Count - 1            tp = m_Doc.TextPageHandle(p)            If tp <> 0 Then                h = FPDFText_FindStart(tp, StrPtr(m_FindText), m_FindFlags, 0)                If h <> 0 Then                    Do While FPDFText_FindNext(h) <> 0                        If m_MatchCount >= cap Then                            cap = IMax(64, cap * 2)                            ReDim Preserve m_MatchPage(0 To cap - 1)                            ReDim Preserve m_MatchIdx(0 To cap - 1)                            ReDim Preserve m_MatchLen(0 To cap - 1)                            ReDim Preserve m_MatchPre(0 To cap - 1)                            ReDim Preserve m_MatchHit(0 To cap - 1)                            ReDim Preserve m_MatchPost(0 To cap - 1)                        End If                        m_MatchPage(m_MatchCount) = p                        m_MatchIdx(m_MatchCount) = FPDFText_GetSchResultIndex(h)                        m_MatchLen(m_MatchCount) = FPDFText_GetSchCount(h)                        BuildSnippet p, m_MatchIdx(m_MatchCount), m_MatchLen(m_MatchCount), m_MatchPre(m_MatchCount), m_MatchHit(m_MatchCount), m_MatchPost(m_MatchCount)                        m_MatchCount = m_MatchCount + 1                    Loop                    FPDFText_FindClose h                End If            End If            If p < m_VisFirst - 2 Or p > m_VisLast + 2 Then m_Doc.ReleasePage p        Next    End Sub    ' Extracto de contexto alrededor de una coincidencia, en tres tramos.    Private Sub BuildSnippet(ByVal p As Long, ByVal Index As Long, ByVal Length As Long, ByRef Pre As String, ByRef Hit As String, ByRef Post As String)        Dim s0 As Long, k As Long        s0 = IMax(0, Index - SNIP_BEFORE)        Pre = CleanSnippet(m_Doc.GetText(p, s0, Index - s0))        Hit = CleanSnippet(m_Doc.GetText(p, Index, Length))        Post = CleanSnippet(m_Doc.GetText(p, Index + Length, SNIP_AFTER))        If s0 > 0 Then            ' Empezar en una palabra completa            k = InStr(1, Pre, " ")            If k > 0 And k < Len(Pre) Then Pre = Mid$(Pre, k + 1)            Pre = ChrW$(&H2026) & LTrim$(Pre)        Else            Pre = LTrim$(Pre)        End If        If Len(Hit) = 0 Then Hit = m_FindText    End Sub    ' Saltos de linea y tabuladores a espacios; espacios repetidos a uno.    Private Function CleanSnippet(ByVal t As String) As String        t = Replace$(t, vbCrLf, " ")        t = Replace$(t, vbCr, " ")        t = Replace$(t, vbLf, " ")        t = Replace$(t, vbTab, " ")        t = Replace$(t, vbNullChar, "")        Do While InStr(1, t, "  ") > 0            t = Replace$(t, "  ", " ")        Loop        CleanSnippet = t    End Function    Private Sub ScrollMatchIntoView()        Dim tp As LongPtr, pg As LongPtr, n As Long, r As Long, rc As RECT, u As RECT, first As Boolean        Dim l As Double, t As Double, rr As Double, b As Double, x As Long, y As Long, dx As Long, dy As Long        tp = m_Doc.TextPageHandle(m_FindPage)        pg = m_Doc.PageHandle(m_FindPage)        If tp = 0 Or pg = 0 Then Exit Sub        x = OriginX() + m_PX(m_FindPage)        y = OriginY() + m_PY(m_FindPage)        n = FPDFText_CountRects(tp, m_FindIdx, m_FindLen)        first = True        For r = 0 To n - 1            If FPDFText_GetRect(tp, r, l, t, rr, b) <> 0 Then                rc = PdfRectToScreen(pg, m_FindPage, x, y, l, t, rr, b)                If first Then                    u = rc                    first = False                Else                    u = MakeRect(IMin(u.Left, rc.Left), IMin(u.Top, rc.Top), IMax(u.Right, rc.Right), IMax(u.Bottom, rc.Bottom))                End If            End If        Next        If first Then            GoToPage m_FindPage + 1            Exit Sub        End If        If u.Top < m_ViewY Or u.Bottom > m_ViewY + m_ClientH Then dy = u.Top - (m_ViewY + m_ClientH \ 3)        If u.Left < m_ViewX Or u.Right > m_ClientW Then dx = u.Left - (m_ViewX + (m_ClientW - m_ViewX) \ 3)        If dx <> 0 Or dy <> 0 Then ScrollTo m_ScrollX + dx, m_ScrollY + dy    End Sub    ' ========================================================================    '  APARTADO 3 - Herramientas: impresion    ' ========================================================================    ' Imprime el documento ajustando cada pagina al area imprimible    ' (reduce si es necesario, nunca amplia) y la centra. Las paginas    ' apaisadas se giran automaticamente si el papel esta en vertical.    ' La resolucion de renderizado se limita a 300 ppp para acotar la memoria.    Public Function PrintDocument(Optional ByVal ShowDialog As Boolean = True, Optional ByVal FromPage As Long = 1, Optional ByVal ToPage As Long = -1, Optional ByVal DocumentName As String) As Boolean        Dim hdcPrn As LongPtr        If Not NormalizePageRange(FromPage, ToPage) Then Exit Function        hdcPrn = PdfPrintDialog(m_hWnd, ShowDialog, 1, m_Count, FromPage, ToPage)        If hdcPrn = 0 Then Exit Function        PrintDocument = PrintToDC(hdcPrn, FromPage, ToPage, DocumentName, 1)        DeleteDC hdcPrn    End Function    ' Envia el documento directamente a la impresora predeterminada de    ' Windows, sin mostrar ningun dialogo. Devuelve False si no hay impresora    ' predeterminada, si falla el trabajo o si se cancela en PrintProgress.    Public Function PrintToDefaultPrinter(Optional ByVal FromPage As Long = 1, Optional ByVal ToPage As Long = -1, Optional ByVal Copies As Long = 1, Optional ByVal DocumentName As String) As Boolean        Dim prnName As String, hdcPrn As LongPtr        If Not NormalizePageRange(FromPage, ToPage) Then Exit Function        prnName = DefaultPrinterName()        If Len(prnName) = 0 Then Exit Function        hdcPrn = CreateDCW(StrPtr("WINSPOOL"), StrPtr(prnName), 0, 0)        If hdcPrn = 0 Then Exit Function        PrintToDefaultPrinter = PrintToDC(hdcPrn, FromPage, ToPage, DocumentName, IMax(1, Copies))        DeleteDC hdcPrn    End Function    ' Nombre de la impresora predeterminada ("" si no hay ninguna).    Public Function DefaultPrinterName() As String        Dim buf As String, n As Long        n = 0        GetDefaultPrinterW 0, n        If n <= 0 Then Exit Function        buf = String$(n, vbNullChar)        If GetDefaultPrinterW(StrPtr(buf), n) <> 0 Then            n = InStr(buf, vbNullChar)            If n > 0 Then DefaultPrinterName = Left$(buf, n - 1) Else DefaultPrinterName = buf        End If    End Function    Private Function NormalizePageRange(ByRef FromPage As Long, ByRef ToPage As Long) As Boolean        If Not HasDoc() Then Exit Function        If ToPage < 1 Or ToPage > m_Count Then ToPage = m_Count        If FromPage < 1 Then FromPage = 1        NormalizePageRange = (FromPage <= ToPage)    End Function    ' Imprime las paginas sobre un DC de impresora ya creado (no lo libera).    Private Function PrintToDC(ByVal hdcPrn As LongPtr, ByVal FromPage As Long, ByVal ToPage As Long, ByVal DocumentName As String, ByVal Copies As Long) As Boolean        Dim di As DOCINFOW, p As Long, n As Long, total As Long, done As Long, cancel As Boolean        Dim dpiX As Long, dpiY As Long, horz As Long, vert As Long, rot As Long        Dim wpt As Double, hpt As Double, s As Double, f As Double        Dim tw As Long, th As Long, bw As Long, bh As Long, dib As PdfDib, ok As Boolean        If Len(DocumentName) = 0 Then DocumentName = IIf(Len(m_FileName) > 0, m_FileName, "ucPDF")        di.cbSize = LenB(di)        di.lpszDocName = StrPtr(DocumentName)        If StartDocW(hdcPrn, di) <= 0 Then Exit Function        dpiX = GetDeviceCaps(hdcPrn, LOGPIXELSX)        dpiY = GetDeviceCaps(hdcPrn, LOGPIXELSY)        horz = GetDeviceCaps(hdcPrn, HORZRES)        vert = GetDeviceCaps(hdcPrn, VERTRES)        total = (ToPage - FromPage + 1) * Copies        Set dib = New PdfDib        ok = True        For n = 0 To total - 1            p = FromPage + (n Mod (ToPage - FromPage + 1))            cancel = False            RaiseEvent PrintProgress(p, done, total, cancel)            If cancel Then                AbortDoc hdcPrn                ok = False                Exit For            End If            If StartPage(hdcPrn) <= 0 Then                AbortDoc hdcPrn                ok = False                Exit For            End If            wpt = m_Doc.PageWidth(p - 1)            hpt = m_Doc.PageHeight(p - 1)            rot = 0            If (wpt > hpt) <> (horz > vert) Then                rot = 1                s = wpt: wpt = hpt: hpt = s            End If            s = DMin(1#, DMin(horz / (wpt * dpiX / 72#), vert / (hpt * dpiY / 72#)))            tw = CLng(wpt * dpiX / 72# * s)            th = CLng(hpt * dpiY / 72# * s)            f = DMin(1#, 300# / dpiX)            bw = IMax(1, CLng(tw * f))            bh = IMax(1, CLng(th * f))            If dib.EnsureSize(bw, bh) Then                If m_Doc.RenderTo(p - 1, dib, 0, 0, bw, bh, rot, FPDF_ANNOT Or FPDF_PRINTING) Then                    SetStretchBltMode hdcPrn, HALFTONE                    SetBrushOrgEx hdcPrn, 0, 0, 0                    dib.StretchToDC hdcPrn, (horz - tw) \ 2, (vert - th) \ 2, tw, th                End If            End If            EndPage hdcPrn            done = done + 1        Next        If ok Then EndDoc hdcPrn        Set dib = Nothing        Invalidate        PrintToDC = ok    End Function    ' ========================================================================    '  Barra de herramientas (GDI+)    '  [miniaturas] [buscar] | [|<] [<] [ 3 / 10 ] [>] [>|] | [-] [100 %] [+] [ancho] [pagina] | [imprimir]    '    '  El boton de busqueda abre un panel a la izquierda (como las miniaturas):    '    [ cuadro de busqueda                 ]    '    Resultados de la busqueda 2/7  [^] [v]    ' ========================================================================    Private Sub AddToolbarItem(ByVal Kind As Long, ByVal Cmd As Long, ByVal LogicalWidth As Long, Optional ByVal InPanel As Boolean = False, Optional ByVal InOrganize As Boolean = False)        ReDim Preserve m_TbKind(0 To m_TbCount)        ReDim Preserve m_TbCmd(0 To m_TbCount)        ReDim Preserve m_TbW(0 To m_TbCount)        ReDim Preserve m_TbRect(0 To m_TbCount)        ReDim Preserve m_TbPanel(0 To m_TbCount)        ReDim Preserve m_TbOrg(0 To m_TbCount)        m_TbKind(m_TbCount) = Kind        m_TbCmd(m_TbCount) = Cmd        m_TbW(m_TbCount) = LogicalWidth        m_TbPanel(m_TbCount) = InPanel        m_TbOrg(m_TbCount) = InOrganize        If Cmd = CMD_SEARCHEDIT Then m_EditIdx = m_TbCount        If Cmd = CMD_FINDCOUNT Then m_CountIdx = m_TbCount        m_TbCount = m_TbCount + 1    End Sub    Private Sub BuildToolbar()        m_TbCount = 0        ' Barra superior        AddToolbarItem TBK_BUTTON, CMD_OPEN, 28        AddToolbarItem TBK_BUTTON, CMD_SAVE, 28        AddToolbarItem TBK_SEP, CMD_SEPFILE, 13        AddToolbarItem TBK_BUTTON, CMD_THUMBS, 28        AddToolbarItem TBK_BUTTON, CMD_SEARCHPANEL, 28        AddToolbarItem TBK_SEP, CMD_SEP, 13        AddToolbarItem TBK_BUTTON, CMD_FIRST, 28        AddToolbarItem TBK_BUTTON, CMD_PREV, 28        AddToolbarItem TBK_LABEL, CMD_PAGELABEL, 76        AddToolbarItem TBK_BUTTON, CMD_NEXT, 28        AddToolbarItem TBK_BUTTON, CMD_LAST, 28        AddToolbarItem TBK_SEP, CMD_SEP, 13        AddToolbarItem TBK_BUTTON, CMD_ZOOMOUT, 28        AddToolbarItem TBK_LABEL, CMD_ZOOMLABEL, 58        AddToolbarItem TBK_BUTTON, CMD_ZOOMIN, 28        AddToolbarItem TBK_BUTTON, CMD_FITWIDTH, 28        AddToolbarItem TBK_BUTTON, CMD_FITPAGE, 28        AddToolbarItem TBK_SEP, CMD_SEP, 13        AddToolbarItem TBK_BUTTON, CMD_PRINT, 28        AddToolbarItem TBK_BUTTON, CMD_ORGANIZE, 28        ' Panel de busqueda        AddToolbarItem TBK_EDIT, CMD_SEARCHEDIT, 0, True        AddToolbarItem TBK_LABEL, CMD_FINDCOUNT, 0, True        AddToolbarItem TBK_BUTTON, CMD_FINDPREV, 26, True        AddToolbarItem TBK_BUTTON, CMD_FINDNEXT, 26, True        ' Cabecera del modo organizar (actuan sobre la seleccion)        AddToolbarItem TBK_BUTTON, CMD_ORG_UNDO, 28, False, True        AddToolbarItem TBK_BUTTON, CMD_ORG_REDO, 28, False, True        AddToolbarItem TBK_SEP, CMD_SEP, 13, False, True        AddToolbarItem TBK_BUTTON, CMD_ORG_ROTL, 28, False, True        AddToolbarItem TBK_BUTTON, CMD_ORG_ROTR, 28, False, True        AddToolbarItem TBK_SEP, CMD_SEP, 13, False, True        AddToolbarItem TBK_BUTTON, CMD_ORG_DELETE, 28, False, True        AddToolbarItem TBK_SEP, CMD_SEP, 13, False, True        AddToolbarItem TBK_BUTTON, CMD_ORG_INSBLANK, 28, False, True        AddToolbarItem TBK_BUTTON, CMD_ORG_INSFILE, 28, False, True        AddToolbarItem TBK_BUTTON, CMD_ORG_REPLACE, 28, False, True        AddToolbarItem TBK_SEP, CMD_SEP, 13, False, True        AddToolbarItem TBK_BUTTON, CMD_ORG_EXTRACT, 28, False, True        AddToolbarItem TBK_BUTTON, CMD_ORG_CROP, 28, False, True    End Sub    Private Sub LayoutToolbar()        Dim i As Long, x As Long, w As Long, gap As Long, bh As Long, top As Long        If m_TbCount = 0 Then Exit Sub        gap = Px(2)        bh = IMax(1, IMin(Px(28), m_ViewY - Px(6)))        top = (m_ViewY - bh) \ 2        x = Px(6)        For i = 0 To m_TbCount - 1            If Not m_TbPanel(i) And Not m_TbOrg(i) Then                If m_ViewY > 0 And ToolbarItemVisible(m_TbCmd(i)) Then                    w = Px(m_TbW(i))                    m_TbRect(i) = MakeRect(x, top, x + w, top + bh)                    x = x + w + gap                Else                    m_TbRect(i) = MakeRect(0, 0, 0, 0)                End If            End If        Next        LayoutSearchPanel        LayoutSearchEdit        LayoutOrgHeader    End Sub    ' Situa los elementos del panel de busqueda (vacios si el panel esta cerrado).    Private Sub LayoutSearchPanel()        Dim i As Long, pad As Long, x0 As Long, x1 As Long, y As Long, y2 As Long, bw As Long, rowH As Long, isOpen As Boolean        isOpen = m_ShowSearch And PanelVisible()        pad = Px(10)        x0 = pad        x1 = m_ViewX - pad        y = m_ViewY + pad        rowH = Px(28)        y2 = y + rowH + Px(8)        bw = Px(26)        For i = 0 To m_TbCount - 1            If m_TbPanel(i) Then                If Not isOpen Or x1 - x0 < Px(40) Then                    m_TbRect(i) = MakeRect(0, 0, 0, 0)                Else                    Select Case m_TbCmd(i)                        Case CMD_SEARCHEDIT: m_TbRect(i) = MakeRect(x0, y, x1, y + rowH)                        Case CMD_FINDNEXT: m_TbRect(i) = MakeRect(x1 - bw, y2, x1, y2 + bw)                        Case CMD_FINDPREV: m_TbRect(i) = MakeRect(x1 - 2 * bw - Px(2), y2, x1 - bw - Px(2), y2 + bw)                        Case CMD_FINDCOUNT: m_TbRect(i) = MakeRect(x0 + Px(2), y2, IMax(x0 + Px(2), x1 - 2 * bw - Px(8)), y2 + bw)                    End Select                End If            End If        Next        ' Lista de resultados: desde debajo de la linea de resultados hasta el final        If isOpen And x1 - x0 >= Px(40) And m_FullH - pad - (y2 + bw + Px(8)) > Px(30) Then            m_ResRect = MakeRect(x0, y2 + bw + Px(8), x1, m_FullH - pad)        Else            m_ResRect = MakeRect(0, 0, 0, 0)        End If        ClampResScroll    End Sub    ' --- Lista de resultados -------------------------------------------------    Private Function ResultListHeight() As Long        ResultListHeight = IMax(0, m_ResRect.Bottom - m_ResRect.Top - 2)    End Function    Private Sub ClampResScroll()        m_ResScroll = IMax(0, IMin(m_ResScroll, m_MatchCount * Px(RES_ITEM_H) - ResultListHeight()))    End Sub    ' Resultado bajo el punto (-1 si ninguno).    Private Function ResultAt(ByVal x As Long, ByVal y As Long) As Long        Dim j As Long        ResultAt = -1        If Not m_ShowSearch Or m_MatchCount = 0 Or m_ResRect.Right <= m_ResRect.Left Then Exit Function        If x < m_ResRect.Left Or x >= m_ResRect.Right Or y <= m_ResRect.Top Or y >= m_ResRect.Bottom - 1 Then Exit Function        j = (y - m_ResRect.Top - 1 + m_ResScroll) \ Px(RES_ITEM_H)        If j >= 0 And j < m_MatchCount Then ResultAt = j    End Function    Private Sub SetResultHot(ByVal j As Long)        If j = m_ResHot Then Exit Sub        m_ResHot = j        Invalidate    End Sub    Private Sub EnsureResultVisible(ByVal j As Long)        Dim ih As Long, t As Long        If j < 0 Or ResultListHeight() <= 0 Then Exit Sub        ih = Px(RES_ITEM_H)        t = j * ih        If t < m_ResScroll Then            m_ResScroll = t        ElseIf t + ih > m_ResScroll + ResultListHeight() Then            m_ResScroll = t + ih - ResultListHeight()        End If        ClampResScroll    End Sub    ' Ir al resultado j de la lista (base 0).    Public Sub SelectSearchResult(ByVal Index As Long)        If Index < 0 Or Index >= m_MatchCount Then Exit Sub        m_MatchPos = Index        ApplyMatch    End Sub    ' Coloca el EDIT de Win32 dentro de su recuadro del panel.    Private Sub LayoutSearchEdit()        Dim r As RECT, eh As Long        If m_hEdit = 0 Or m_TbCount = 0 Then Exit Sub        r = m_TbRect(m_EditIdx)        If r.Right > r.Left And m_ShowSearch And PanelVisible() Then            eh = IMin(r.Bottom - r.Top - Px(6), Px(18))            MoveWindow m_hEdit, r.Left + Px(7), r.Top + (r.Bottom - r.Top - eh) \ 2, IMax(1, r.Right - r.Left - Px(14)), eh, 1            ShowWindow m_hEdit, SW_SHOWNA            EnableWindow m_hEdit, 1        Else            ShowWindow m_hEdit, SW_HIDE        End If    End Sub    ' Botones que se pueden ocultar desde codigo (ShowOpenButton / ShowSaveButton).    Private Function ToolbarItemVisible(ByVal Cmd As Long) As Boolean        Select Case Cmd            Case CMD_OPEN: ToolbarItemVisible = m_ShowOpenBtn            Case CMD_SAVE: ToolbarItemVisible = m_ShowSaveBtn            Case CMD_SEPFILE: ToolbarItemVisible = m_ShowOpenBtn Or m_ShowSaveBtn            Case Else: ToolbarItemVisible = True        End Select    End Function    Private Function ToolbarItemEnabled(ByVal Cmd As Long) As Boolean        ' En el modo organizar no tienen sentido el zoom ni los paneles laterales        If m_Organize Then            Select Case Cmd                Case CMD_ZOOMOUT, CMD_ZOOMIN, CMD_FITWIDTH, CMD_FITPAGE, CMD_THUMBS, CMD_SEARCHPANEL                    Exit Function            End Select        End If        Select Case Cmd            Case CMD_ORGANIZE: ToolbarItemEnabled = HasDoc()            Case CMD_ORG_UNDO: ToolbarItemEnabled = m_Organize And CanUndo            Case CMD_ORG_REDO: ToolbarItemEnabled = m_Organize And CanRedo            Case CMD_ORG_ROTL, CMD_ORG_ROTR, CMD_ORG_INSBLANK, CMD_ORG_INSFILE, CMD_ORG_REPLACE, CMD_ORG_EXTRACT, CMD_ORG_CROP                ToolbarItemEnabled = m_Organize And HasDoc() And OrgSelCount() > 0 And Not m_CropMode            Case CMD_ORG_DELETE                ToolbarItemEnabled = m_Organize And HasDoc() And OrgSelCount() > 0 And OrgSelCount() < m_Count And Not m_CropMode            Case CMD_OPEN: ToolbarItemEnabled = (m_hWnd <> 0)            Case CMD_SAVE: ToolbarItemEnabled = HasDoc()            Case CMD_FIRST, CMD_PREV: ToolbarItemEnabled = HasDoc() And m_CurPage > 0            Case CMD_NEXT, CMD_LAST: ToolbarItemEnabled = HasDoc() And m_CurPage < m_Count - 1            Case CMD_ZOOMOUT: ToolbarItemEnabled = HasDoc() And m_Zoom > ZOOM_STEP + 0.01            Case CMD_ZOOMIN: ToolbarItemEnabled = HasDoc() And m_Zoom < MAX_ZOOM - 0.01            Case CMD_FITWIDTH, CMD_FITPAGE, CMD_PRINT: ToolbarItemEnabled = HasDoc()            Case CMD_THUMBS, CMD_SEARCHPANEL: ToolbarItemEnabled = HasDoc()            Case CMD_FINDPREV, CMD_FINDNEXT: ToolbarItemEnabled = HasDoc() And (m_MatchCount > 0 Or Len(GetSearchEditText()) > 0)        End Select    End Function    Private Function ToolbarItemChecked(ByVal Cmd As Long) As Boolean        Select Case Cmd            Case CMD_THUMBS: ToolbarItemChecked = m_ShowThumbs And HasDoc() And Not m_Organize            Case CMD_ORGANIZE: ToolbarItemChecked = m_Organize And HasDoc()            Case CMD_SEARCHPANEL: ToolbarItemChecked = m_ShowSearch And HasDoc()            Case CMD_FITWIDTH: ToolbarItemChecked = (m_ZoomMode = pdfZoomFitWidth) And HasDoc()            Case CMD_FITPAGE: ToolbarItemChecked = (m_ZoomMode = pdfZoomFitPage) And HasDoc()        End Select    End Function    ' Indice del boton habilitado bajo el punto (barra o panel; -1 si ninguno).    Private Function ToolbarHitTest(ByVal x As Long, ByVal y As Long) As Long        Dim i As Long, r As RECT        ToolbarHitTest = -1        For i = 0 To m_TbCount - 1            If m_TbKind(i) = TBK_BUTTON Then                r = m_TbRect(i)                If r.Right > r.Left And x >= r.Left And x < r.Right And y >= r.Top And y < r.Bottom Then                    If ToolbarItemEnabled(m_TbCmd(i)) Then ToolbarHitTest = i                    Exit Function                End If            End If        Next    End Function    Private Sub SetToolbarHot(ByVal i As Long)        If i = m_TbHot Then Exit Sub        m_TbHot = i        ' Informacion sobre herramientas tras una breve pausa        m_TipShow = False        If m_hWnd <> 0 Then            KillTimer m_hWnd, TIP_TIMER_ID            If i >= 0 Then SetTimer m_hWnd, TIP_TIMER_ID, 550, 0        End If        Invalidate    End Sub    Private Sub InvalidateToolbar()        Dim rc As RECT        If m_hWnd = 0 Or m_ViewY <= 0 Then Exit Sub        rc = MakeRect(0, 0, m_ClientW, m_ViewY)        InvalidateRect m_hWnd, VarPtr(rc), 0    End Sub    Private Sub ExecuteToolbarCommand(ByVal Cmd As Long)        Dim cancel As Boolean        RaiseEvent ToolbarClick(Cmd, cancel)        If cancel Then Exit Sub        Select Case Cmd            Case CMD_OPEN: ShowOpenDialog            Case CMD_SAVE: ShowSaveDialog            Case CMD_THUMBS: ShowThumbnails = Not m_ShowThumbs            Case CMD_SEARCHPANEL: ShowSearchPanel = Not m_ShowSearch            Case CMD_FIRST: FirstPage            Case CMD_PREV: PreviousPage            Case CMD_NEXT: NextPage            Case CMD_LAST: LastPage            Case CMD_ZOOMOUT: ZoomOut            Case CMD_ZOOMIN: ZoomIn            Case CMD_FITWIDTH: ZoomMode = pdfZoomFitWidth            Case CMD_FITPAGE: ZoomMode = pdfZoomFitPage            Case CMD_FINDPREV: RunSearchFromEdit True            Case CMD_FINDNEXT: RunSearchFromEdit False            Case CMD_PRINT: PrintDocument True            Case CMD_ORGANIZE: Organizing = Not m_Organize            Case CMD_ORG_UNDO: Undo            Case CMD_ORG_REDO: Redo            Case CMD_ORG_ROTL: RotateSelectedPages False            Case CMD_ORG_ROTR: RotateSelectedPages True            Case CMD_ORG_DELETE: DeleteSelectedPages            Case CMD_ORG_INSBLANK: InsertBlankPage            Case CMD_ORG_INSFILE: InsertPagesFromFile            Case CMD_ORG_REPLACE: ReplaceSelectedPages            Case CMD_ORG_EXTRACT: ExtractSelectedPages            Case CMD_ORG_CROP: CropSelectedPages        End Select        Invalidate    End Sub    Private Function ToolbarLabelText(ByVal Cmd As Long) As String        Select Case Cmd            Case CMD_PAGELABEL                If HasDoc() Then ToolbarLabelText = CStr(m_CurPage + 1) & " / " & CStr(m_Count) Else ToolbarLabelText = "- / -"            Case CMD_ZOOMLABEL                If HasDoc() Then ToolbarLabelText = CStr(CLng(m_Zoom)) & " %" Else ToolbarLabelText = "- %"            Case CMD_FINDCOUNT                ' "Resultados de la busqueda x/x" (con tilde: U+00FA)                ToolbarLabelText = "Resultados de la b" & ChrW$(&HFA) & "squeda "                If m_MatchCount > 0 Then                    ToolbarLabelText = ToolbarLabelText & CStr(m_MatchPos + 1) & "/" & CStr(m_MatchCount)                Else                    ToolbarLabelText = ToolbarLabelText & "0/0"                End If        End Select    End Function    Private Sub EnsureGdipText()        If Not m_GdipOK Or m_gpFont <> 0 Then Exit Sub        If GdipCreateFontFamilyFromName(StrPtr("Segoe UI"), 0, m_gpFamily) <> GP_OK Then            GdipCreateFontFamilyFromName StrPtr("Tahoma"), 0, m_gpFamily        End If        If m_gpFamily = 0 Then Exit Sub        GdipCreateFont m_gpFamily, CSng(MulDiv(12, m_Dpi, 96)), FontStyleRegular, UnitPixel, m_gpFont        GdipCreateStringFormat StringFormatFlagsNoWrap, 0, m_gpFormat        If m_gpFormat <> 0 Then            GdipSetStringFormatAlign m_gpFormat, StringAlignmentCenter            GdipSetStringFormatLineAlign m_gpFormat, StringAlignmentCenter            GdipSetStringFormatTrimming m_gpFormat, StringTrimmingEllipsisCharacter        End If        GdipCreateFont m_gpFamily, CSng(MulDiv(12, m_Dpi, 96)), FontStyleBold, UnitPixel, m_gpFontBold        GdipCreateFont m_gpFamily, CSng(MulDiv(11, m_Dpi, 96)), FontStyleRegular, UnitPixel, m_gpFontSmall        Dim typo As LongPtr        If GdipStringFormatGetGenericTypographic(typo) = GP_OK And typo <> 0 Then            If GdipCloneStringFormat(typo, m_gpFormatTypo) = GP_OK And m_gpFormatTypo <> 0 Then                GdipSetStringFormatFlags m_gpFormatTypo, StringFormatFlagsNoWrap Or StringFormatFlagsMeasureTrailingSpaces                GdipSetStringFormatLineAlign m_gpFormatTypo, StringAlignmentCenter                GdipSetStringFormatTrimming m_gpFormatTypo, StringTrimmingEllipsisCharacter            End If        End If        GdipCreateStringFormat StringFormatFlagsNoWrap, 0, m_gpFormatLeft        If m_gpFormatLeft <> 0 Then            GdipSetStringFormatAlign m_gpFormatLeft, StringAlignmentNear            GdipSetStringFormatLineAlign m_gpFormatLeft, StringAlignmentCenter            GdipSetStringFormatTrimming m_gpFormatLeft, StringTrimmingEllipsisCharacter        End If    End Sub    Private Sub FreeGdipText()        If m_gpFormat <> 0 Then GdipDeleteStringFormat m_gpFormat        If m_gpFormatLeft <> 0 Then GdipDeleteStringFormat m_gpFormatLeft        If m_gpFormatTypo <> 0 Then GdipDeleteStringFormat m_gpFormatTypo        If m_gpFontBold <> 0 Then GdipDeleteFont m_gpFontBold        If m_gpFontSmall <> 0 Then GdipDeleteFont m_gpFontSmall        If m_gpFont <> 0 Then GdipDeleteFont m_gpFont        If m_gpFamily <> 0 Then GdipDeleteFontFamily m_gpFamily        m_gpFormat = 0        m_gpFormatLeft = 0        m_gpFormatTypo = 0        m_gpFontBold = 0        m_gpFontSmall = 0        m_gpFont = 0        m_gpFamily = 0    End Sub    Private Sub DrawGpText(ByVal g As LongPtr, ByVal Text As String, ByRef r As RECT, ByVal Argb As Long, Optional ByVal AlignLeft As Boolean = False, Optional ByVal Font As LongPtr = 0)        Dim rf As RECTF, br As LongPtr, fmt As LongPtr        If Font = 0 Then Font = m_gpFont        If Font = 0 Or Len(Text) = 0 Then Exit Sub        rf.Left = r.Left        rf.Top = r.Top        rf.Width = r.Right - r.Left        rf.Height = r.Bottom - r.Top        If AlignLeft Then fmt = m_gpFormatLeft Else fmt = m_gpFormat        br = GpBrush(Argb)        GdipDrawString g, StrPtr(Text), Len(Text), Font, rf, fmt, br        GdipDeleteBrush br    End Sub    ' Prepara un objeto Graphics de GDI+ con antialias sobre el DC.    Private Function BeginGdip(ByVal hdc As LongPtr) As LongPtr        Dim g As LongPtr        If Not m_GdipOK Then Exit Function        If GdipCreateFromHDC(hdc, g) <> GP_OK Then Exit Function        GdipSetSmoothingMode g, SmoothingModeAntiAlias        GdipSetPixelOffsetMode g, PixelOffsetModeHalf        GdipSetTextRenderingHint g, TextRenderingHintClearTypeGridFit        EnsureGdipText        BeginGdip = g    End Function    Private Sub DrawToolbar(ByVal hdc As LongPtr)        Dim g As LongPtr, i As Long, r As RECT, br As LongPtr, pn As LongPtr        Dim faceRef As Long, textArgb As Long, grayArgb As Long, lineArgb As Long        Dim w As Single, h As Single, x As Single, rad As Single        faceRef = GetSysColor(COLOR_BTNFACE)        r = MakeRect(0, 0, m_ClientW, m_ViewY)        FillSolid hdc, r, faceRef        g = BeginGdip(hdc)        If g = 0 Then Exit Sub        textArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT))        grayArgb = ArgbFromColorRef(GetSysColor(COLOR_GRAYTEXT))        lineArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW))        rad = Px(4)        br = GpBrush(ArgbFromColorRef(faceRef))        GdipFillRectangle g, br, 0, 0, m_ClientW, m_ViewY        GdipDeleteBrush br        pn = GpPen(lineArgb, 1)        GdipDrawLine g, pn, 0, m_ViewY - 0.5, m_ClientW, m_ViewY - 0.5        GdipDeletePen pn        For i = 0 To m_TbCount - 1            If Not m_TbPanel(i) And Not m_TbOrg(i) And m_TbRect(i).Right > m_TbRect(i).Left Then                r = m_TbRect(i)                If r.Left >= m_ClientW Then Exit For                x = r.Left                w = r.Right - r.Left                h = r.Bottom - r.Top                Select Case m_TbKind(i)                    Case TBK_BUTTON                        DrawToolbarButton g, i, rad                    Case TBK_LABEL                        GpFillRoundRect g, x + 0.5, r.Top + Px(2) + 0.5, w - 1, h - Px(4) - 1, rad, &HFFFFFFFF, lineArgb, 1                        DrawGpText g, ToolbarLabelText(m_TbCmd(i)), r, IIf(HasDoc(), textArgb, grayArgb)                    Case TBK_SEP                        pn = GpPen(lineArgb, 1)                        GdipDrawLine g, pn, x + w / 2, r.Top + Px(4), x + w / 2, r.Bottom - Px(4)                        GdipDeletePen pn                End Select            End If        Next        GdipDeleteGraphics g    End Sub    ' Panel de busqueda: cuadro de texto, linea de resultados y flechas.    Private Sub DrawSearchPanel(ByVal hdc As LongPtr)        Dim g As LongPtr, r As RECT, br As LongPtr, pn As LongPtr, lineArgb As Long, accentArgb As Long, rad As Single, i As Long        r = MakeRect(0, m_ViewY, m_ViewX, m_FullH)        FillSolid hdc, r, ToColorRef(m_ThumbBackColor)        r = MakeRect(m_ViewX - 1, m_ViewY, m_ViewX, m_FullH)        FillSolid hdc, r, GetSysColor(COLOR_BTNSHADOW)        g = BeginGdip(hdc)        If g = 0 Then Exit Sub        lineArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW))        accentArgb = ArgbFromColorRef(ToColorRef(m_SelColor))        rad = Px(4)        ' Recuadro del cuadro de busqueda (el EDIT va dentro)        r = m_TbRect(m_EditIdx)        If r.Right > r.Left Then            If GetFocus() = m_hEdit And m_hEdit <> 0 Then                GpFillRoundRect g, r.Left + 0.5, r.Top + 0.5, r.Right - r.Left - 1, r.Bottom - r.Top - 1, rad, &HFFFFFFFF, accentArgb, 1.5            Else                GpFillRoundRect g, r.Left + 0.5, r.Top + 0.5, r.Right - r.Left - 1, r.Bottom - r.Top - 1, rad, &HFFFFFFFF, lineArgb, 1            End If        End If        ' "Resultados de la busqueda x/x"        r = m_TbRect(m_CountIdx)        If r.Right > r.Left Then DrawGpText g, ToolbarLabelText(CMD_FINDCOUNT), r, ArgbFromColorRef(GetSysColor(IIf(m_Searched And m_MatchCount = 0, COLOR_GRAYTEXT, COLOR_BTNTEXT))), True        ' Flechas arriba / abajo        For i = 0 To m_TbCount - 1            If m_TbPanel(i) And m_TbKind(i) = TBK_BUTTON Then                If m_TbRect(i).Right > m_TbRect(i).Left Then DrawToolbarButton g, i, rad            End If        Next        DrawResultList g, rad        GdipDeleteGraphics g    End Sub    ' Lista de resultados: "Pagina N" y un extracto con la coincidencia resaltada.    Private Sub DrawResultList(ByVal g As LongPtr, ByVal rad As Single)        Dim r As RECT, ir As RECT, j As Long, y As Long, ih As Long, pn As LongPtr, br As LongPtr        Dim lineArgb As Long, grayArgb As Long, msg As String, viewH As Long, barH As Long, barY As Long        r = m_ResRect        If r.Right <= r.Left Then Exit Sub        lineArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW))        grayArgb = ArgbFromColorRef(GetSysColor(COLOR_GRAYTEXT))        GpFillRoundRect g, r.Left + 0.5, r.Top + 0.5, r.Right - r.Left - 1, r.Bottom - r.Top - 1, rad, &HFFFFFFFF, lineArgb, 1        If m_MatchCount = 0 Then            If m_Searched Then msg = "Sin resultados" Else msg = "Escribe el texto y pulsa Intro"            ir = MakeRect(r.Left + Px(6), r.Top + Px(8), r.Right - Px(6), r.Top + Px(32))            DrawGpText g, msg, ir, grayArgb            Exit Sub        End If        ih = Px(RES_ITEM_H)        viewH = ResultListHeight()        GdipSetClipRect g, r.Left + 1, r.Top + 1, r.Right - r.Left - 2, viewH, CombineModeReplace        pn = GpPen(ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW), &H50), 1)        For j = m_ResScroll \ ih To m_MatchCount - 1            y = r.Top + 1 + j * ih - m_ResScroll            If y > r.Bottom Then Exit For            ir = MakeRect(r.Left + 1, y, r.Right - 1, y + ih)            If j = m_MatchPos Then                br = GpBrush(ArgbFromColorRef(ToColorRef(m_SelColor), &H30))                GdipFillRectangle g, br, ir.Left, ir.Top, ir.Right - ir.Left, ih                GdipDeleteBrush br                br = GpBrush(ArgbFromColorRef(ToColorRef(m_SelColor)))                GdipFillRectangle g, br, ir.Left, ir.Top, Px(3), ih                GdipDeleteBrush br            ElseIf j = m_ResHot Then                br = GpBrush(&H14000000)                GdipFillRectangle g, br, ir.Left, ir.Top, ir.Right - ir.Left, ih                GdipDeleteBrush br            End If            ' Linea 1: pagina            DrawGpText g, "P" & ChrW$(&HE1) & "gina " & CStr(m_MatchPage(j) + 1), MakeRect(ir.Left + Px(10), y + Px(4), ir.Right - Px(8), y + Px(20)), grayArgb, True, m_gpFontSmall            ' Linea 2: extracto            DrawSnippet g, j, ir.Left + Px(10), y + Px(20), ir.Right - Px(8), y + ih - Px(5)            GdipDrawLine g, pn, ir.Left + Px(8), y + ih - 0.5, ir.Right - Px(8), y + ih - 0.5        Next        GdipDeletePen pn        GdipResetClip g        ' Indicador de desplazamiento        If m_MatchCount * ih > viewH And viewH > 0 Then            barH = IMax(Px(20), CLng(CDbl(viewH) * viewH / (m_MatchCount * ih)))            barY = CLng(CDbl(viewH - barH) * m_ResScroll / (m_MatchCount * ih - viewH))            br = GpBrush(ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW), &HB0))            GdipFillRectangle g, br, r.Right - Px(5), r.Top + 1 + barY, Px(3), barH            GdipDeleteBrush br        End If    End Sub    ' Extracto en una linea: contexto previo + coincidencia (negrita sobre el    ' color de busqueda) + contexto posterior recortado con puntos suspensivos.    Private Sub DrawSnippet(ByVal g As LongPtr, ByVal j As Long, ByVal x0 As Long, ByVal y0 As Long, ByVal x1 As Long, ByVal y1 As Long)        Dim x As Single, w As Single, textArgb As Long, h As Single        If m_gpFont = 0 Or m_gpFontBold = 0 Or m_gpFormatTypo = 0 Then Exit Sub        textArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT))        h = y1 - y0        x = x0        If Len(m_MatchPre(j)) > 0 Then            w = MeasureGpText(g, m_MatchPre(j), m_gpFont)            If x + w > x1 Then w = x1 - x            DrawGpSegment g, m_MatchPre(j), m_gpFont, x, y0, w, h, textArgb            x = x + w        End If        If x < x1 Then            w = MeasureGpText(g, m_MatchHit(j), m_gpFontBold)            If x + w > x1 Then w = x1 - x            GpFillRoundRect g, x - 1, y0 + 1, w + 2, h - 2, Px(2), ArgbFromColorRef(ToColorRef(m_FindColor), &HC0)            DrawGpSegment g, m_MatchHit(j), m_gpFontBold, x, y0, w, h, textArgb            x = x + w        End If        If x < x1 And Len(m_MatchPost(j)) > 0 Then            DrawGpSegment g, m_MatchPost(j), m_gpFont, x, y0, x1 - x, h, textArgb        End If    End Sub    Private Function MeasureGpText(ByVal g As LongPtr, ByVal Text As String, ByVal Font As LongPtr) As Single        Dim lr As RECTF, bb As RECTF        If Len(Text) = 0 Or Font = 0 Then Exit Function        lr.Width = 100000        lr.Height = 1000        If GdipMeasureString(g, StrPtr(Text), Len(Text), Font, lr, m_gpFormatTypo, bb, 0, 0) = GP_OK Then MeasureGpText = bb.Width    End Function    Private Sub DrawGpSegment(ByVal g As LongPtr, ByVal Text As String, ByVal Font As LongPtr, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal Argb As Long)        Dim rf As RECTF, br As LongPtr        If Len(Text) = 0 Or w <= 0 Then Exit Sub        rf.Left = x        rf.Top = y        rf.Width = w        rf.Height = h        br = GpBrush(Argb)        GdipDrawString g, StrPtr(Text), Len(Text), Font, rf, m_gpFormatTypo, br        GdipDeleteBrush br    End Sub    Private Sub DrawToolbarButton(ByVal g As LongPtr, ByVal i As Long, ByVal rad As Single)        Dim r As RECT, cmd As Long, enabled As Boolean, checked As Boolean        Dim fillArgb As Long, borderArgb As Long, iconArgb As Long, accentRef As Long        r = m_TbRect(i)        cmd = m_TbCmd(i)        enabled = ToolbarItemEnabled(cmd)        checked = ToolbarItemChecked(cmd)        accentRef = ToColorRef(m_SelColor)        If checked Then            fillArgb = ArgbFromColorRef(accentRef, &H40)            borderArgb = ArgbFromColorRef(accentRef, &HA0)        End If        If enabled Then            If i = m_TbDown And i = m_TbHot Then                fillArgb = &H38000000            ElseIf i = m_TbHot Or i = m_TbDown Then                If Not checked Then fillArgb = &H1C000000 Else fillArgb = ArgbFromColorRef(accentRef, &H60)            End If        End If        If fillArgb <> 0 Or borderArgb <> 0 Then            GpFillRoundRect g, r.Left + 0.5, r.Top + 0.5, r.Right - r.Left - 1, r.Bottom - r.Top - 1, rad, fillArgb, borderArgb, 1        End If        If enabled Then iconArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT)) Else iconArgb = ArgbFromColorRef(GetSysColor(COLOR_GRAYTEXT))        DrawToolbarIcon g, cmd, (r.Left + r.Right) / 2, (r.Top + r.Bottom) / 2, Px(8), iconArgb    End Sub    ' Iconos vectoriales: (cx, cy) es el centro y s la mitad del tamano.    Private Sub DrawToolbarIcon(ByVal g As LongPtr, ByVal Cmd As Long, ByVal cx As Single, ByVal cy As Single, ByVal s As Single, ByVal Argb As Long)        Dim pn As LongPtr, br As LongPtr, lw As Single, pts(0 To 2) As POINTF, fp(0 To 6) As POINTF        lw = s / 5        If lw < 1.5 Then lw = 1.5        pn = GpPen(Argb, lw)        br = GpBrush(Argb)        Select Case Cmd            Case CMD_ORG_UNDO                ' Flecha curva hacia la izquierda                GpArcArrow g, pn, br, cx, cy + s * 0.25, s * 0.6, 0, -180, s * 0.45            Case CMD_ORG_REDO                GpArcArrow g, pn, br, cx, cy + s * 0.25, s * 0.6, 180, 180, s * 0.45            Case CMD_ORG_ROTL                ' Arco en sentido antihorario con la flecha arriba a la derecha                GpArcArrow g, pn, br, cx, cy + s * 0.08, s * 0.62, 240, -270, s * 0.42            Case CMD_ORG_ROTR                GpArcArrow g, pn, br, cx, cy + s * 0.08, s * 0.62, 300, 270, s * 0.42            Case CMD_ORG_DELETE                ' Papelera: tapa, asa, cuerpo y estrias                GdipDrawLine g, pn, cx - s * 0.8, cy - s * 0.55, cx + s * 0.8, cy - s * 0.55                GdipDrawLine g, pn, cx - s * 0.25, cy - s * 0.8, cx + s * 0.25, cy - s * 0.8                fp(0) = PtF(cx - s * 0.6, cy - s * 0.45)                fp(1) = PtF(cx - s * 0.45, cy + s * 0.85)                fp(2) = PtF(cx + s * 0.45, cy + s * 0.85)                fp(3) = PtF(cx + s * 0.6, cy - s * 0.45)                GdipDrawLines g, pn, fp(0), 4                GdipDrawLine g, pn, cx - s * 0.18, cy - s * 0.2, cx - s * 0.15, cy + s * 0.6                GdipDrawLine g, pn, cx + s * 0.18, cy - s * 0.2, cx + s * 0.15, cy + s * 0.6            Case CMD_ORG_INSBLANK                ' Pagina con un "+"                GdipDrawRectangle g, pn, cx - s * 0.75, cy - s * 0.85, s * 1.1, s * 1.5                GpFillRoundRect g, cx + s * 0.05, cy + s * 0.05, s * 0.9, s * 0.9, s * 0.45, Argb                GdipDeletePen pn                pn = GpPen(&HFFFFFFFF, lw)                GdipDrawLine g, pn, cx + s * 0.5, cy + s * 0.25, cx + s * 0.5, cy + s * 0.75                GdipDrawLine g, pn, cx + s * 0.25, cy + s * 0.5, cx + s * 0.75, cy + s * 0.5            Case CMD_ORG_INSFILE                ' Flecha que entra en una pagina                GdipDrawRectangle g, pn, cx - s * 0.15, cy - s * 0.85, s * 1.0, s * 1.7                GdipDrawLine g, pn, cx - s * 0.95, cy, cx - s * 0.05, cy                GpArrowHead g, br, cx + s * 0.35, cy, 1, 0, s * 0.45            Case CMD_ORG_REPLACE                ' Dos flechas opuestas (intercambio)                GdipDrawLine g, pn, cx - s * 0.8, cy - s * 0.35, cx + s * 0.35, cy - s * 0.35                GpArrowHead g, br, cx + s * 0.85, cy - s * 0.35, 1, 0, s * 0.45                GdipDrawLine g, pn, cx + s * 0.8, cy + s * 0.35, cx - s * 0.35, cy + s * 0.35                GpArrowHead g, br, cx - s * 0.85, cy + s * 0.35, -1, 0, s * 0.45            Case CMD_ORG_EXTRACT                ' Pagina con flecha que sale hacia arriba a la derecha                GdipDrawRectangle g, pn, cx - s * 0.85, cy - s * 0.45, s * 1.05, s * 1.3                GdipDrawLine g, pn, cx - s * 0.2, cy + s * 0.2, cx + s * 0.55, cy - s * 0.55                GpArrowHead g, br, cx + s * 0.85, cy - s * 0.85, 1, -1, s * 0.5            Case CMD_ORG_CROP                ' Simbolo clasico de recorte: dos escuadras cruzadas                fp(0) = PtF(cx - s * 0.5, cy - s * 0.9)                fp(1) = PtF(cx - s * 0.5, cy + s * 0.5)                fp(2) = PtF(cx + s * 0.9, cy + s * 0.5)                GdipDrawLines g, pn, fp(0), 3                fp(0) = PtF(cx - s * 0.9, cy - s * 0.5)                fp(1) = PtF(cx + s * 0.5, cy - s * 0.5)                fp(2) = PtF(cx + s * 0.5, cy + s * 0.9)                GdipDrawLines g, pn, fp(0), 3            Case CMD_OPEN                ' Carpeta: pestana y cuerpo                fp(0) = PtF(cx - s * 0.85, cy + s * 0.65)                fp(1) = PtF(cx - s * 0.85, cy - s * 0.6)                fp(2) = PtF(cx - s * 0.3, cy - s * 0.6)                fp(3) = PtF(cx - s * 0.12, cy - s * 0.38)                fp(4) = PtF(cx + s * 0.85, cy - s * 0.38)                fp(5) = PtF(cx + s * 0.85, cy + s * 0.65)                fp(6) = fp(0)                GdipDrawLines g, pn, fp(0), 7                GdipDrawLine g, pn, cx - s * 0.85, cy - s * 0.12, cx + s * 0.85, cy - s * 0.12            Case CMD_SAVE                ' Disquete: contorno, etiqueta superior y zona inferior                GpFillRoundRect g, cx - s * 0.75, cy - s * 0.75, s * 1.5, s * 1.5, s * 0.15, 0, Argb, lw                GdipDrawRectangle g, pn, cx - s * 0.38, cy - s * 0.75, s * 0.76, s * 0.45                GdipFillRectangle g, br, cx - s * 0.45, cy + s * 0.12, s * 0.9, s * 0.5            Case CMD_FIRST                GdipDrawLine g, pn, cx - s * 0.6, cy - s * 0.65, cx - s * 0.6, cy + s * 0.65                GpFillTriangle g, br, cx + s * 0.6, cy - s * 0.65, cx + s * 0.6, cy + s * 0.65, cx - s * 0.3, cy            Case CMD_PREV                GpFillTriangle g, br, cx + s * 0.45, cy - s * 0.65, cx + s * 0.45, cy + s * 0.65, cx - s * 0.5, cy            Case CMD_NEXT                GpFillTriangle g, br, cx - s * 0.45, cy - s * 0.65, cx - s * 0.45, cy + s * 0.65, cx + s * 0.5, cy            Case CMD_LAST                GdipDrawLine g, pn, cx + s * 0.6, cy - s * 0.65, cx + s * 0.6, cy + s * 0.65                GpFillTriangle g, br, cx - s * 0.6, cy - s * 0.65, cx - s * 0.6, cy + s * 0.65, cx + s * 0.3, cy            Case CMD_ZOOMOUT                GdipDrawLine g, pn, cx - s * 0.65, cy, cx + s * 0.65, cy            Case CMD_ZOOMIN                GdipDrawLine g, pn, cx - s * 0.65, cy, cx + s * 0.65, cy                GdipDrawLine g, pn, cx, cy - s * 0.65, cx, cy + s * 0.65            Case CMD_FITWIDTH                ' |<-->|  ajustar al ancho                GdipDrawLine g, pn, cx - s * 0.85, cy - s * 0.6, cx - s * 0.85, cy + s * 0.6                GdipDrawLine g, pn, cx + s * 0.85, cy - s * 0.6, cx + s * 0.85, cy + s * 0.6                GdipDrawLine g, pn, cx - s * 0.4, cy, cx + s * 0.4, cy                GpFillTriangle g, br, cx - s * 0.62, cy, cx - s * 0.3, cy - s * 0.32, cx - s * 0.3, cy + s * 0.32                GpFillTriangle g, br, cx + s * 0.62, cy, cx + s * 0.3, cy - s * 0.32, cx + s * 0.3, cy + s * 0.32            Case CMD_FITPAGE                ' pagina con flechas hacia sus bordes superior e inferior: ajustar pagina                GdipDrawRectangle g, pn, cx - s * 0.55, cy - s * 0.8, s * 1.1, s * 1.6                GpFillTriangle g, br, cx, cy - s * 0.55, cx - s * 0.3, cy - s * 0.18, cx + s * 0.3, cy - s * 0.18                GpFillTriangle g, br, cx, cy + s * 0.55, cx - s * 0.3, cy + s * 0.18, cx + s * 0.3, cy + s * 0.18            Case CMD_SEARCHPANEL                GdipDrawEllipse g, pn, cx - s * 0.75, cy - s * 0.75, s * 1.1, s * 1.1                GdipDrawLine g, pn, cx + s * 0.22, cy + s * 0.22, cx + s * 0.72, cy + s * 0.72            Case CMD_FINDPREV                pts(0) = PtF(cx - s * 0.6, cy + s * 0.3)                pts(1) = PtF(cx, cy - s * 0.3)                pts(2) = PtF(cx + s * 0.6, cy + s * 0.3)                GdipDrawLines g, pn, pts(0), 3            Case CMD_FINDNEXT                pts(0) = PtF(cx - s * 0.6, cy - s * 0.3)                pts(1) = PtF(cx, cy + s * 0.3)                pts(2) = PtF(cx + s * 0.6, cy - s * 0.3)                GdipDrawLines g, pn, pts(0), 3            Case CMD_ORGANIZE                ' Cuadricula 2x2 de paginas, una desplazada (moviendose)                GdipDrawRectangle g, pn, cx - s * 0.8, cy - s * 0.8, s * 0.6, s * 0.7                GdipDrawRectangle g, pn, cx + s * 0.2, cy - s * 0.8, s * 0.6, s * 0.7                GdipDrawRectangle g, pn, cx - s * 0.8, cy + s * 0.15, s * 0.6, s * 0.7                GdipFillRectangle g, br, cx + s * 0.35, cy + s * 0.05, s * 0.6, s * 0.7            Case CMD_THUMBS                GdipDrawRectangle g, pn, cx - s * 0.75, cy - s * 0.65, s * 1.5, s * 1.3                GdipFillRectangle g, br, cx - s * 0.75, cy - s * 0.65, s * 0.5, s * 1.3            Case CMD_PRINT                GdipDrawRectangle g, pn, cx - s * 0.4, cy - s * 0.8, s * 0.8, s * 0.45                GpFillRoundRect g, cx - s * 0.8, cy - s * 0.35, s * 1.6, s * 0.8, s * 0.15, 0, Argb, lw                GpFillRoundRect g, cx - s * 0.45, cy + s * 0.1, s * 0.9, s * 0.7, 0.5, &HFFFFFFFF, Argb, lw        End Select        GdipDeleteBrush br        GdipDeletePen pn    End Sub    ' --- Cuadro de busqueda (EDIT de Win32 como ventana hija del panel) -----    Private Sub CreateSearchEdit()        If m_hEdit <> 0 Or m_hWnd = 0 Then Exit Sub        m_hEdit = CreateWindowExW(0, StrPtr("EDIT"), 0, WS_CHILD Or WS_TABSTOP Or ES_AUTOHSCROLL, 0, 0, 10, 10, m_hWnd, 0, GetModuleHandleW(0), 0)        If m_hEdit = 0 Then Exit Sub        If m_hFont <> 0 Then SendMessageW m_hEdit, WM_SETFONT, m_hFont, 1        SendMessageW m_hEdit, EM_SETCUEBANNER, 1, StrPtr("Buscar en el documento...")        m_EditSubclassed = (SetWindowSubclass(m_hEdit, ucPdfSubclassAddress(), 2, ObjPtr(Me)) <> 0)    End Sub    Private Function EditWindowProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr        Select Case uMsg            Case WM_GETDLGCODE                ' Recibir Intro y Esc en lugar de que los procese el formulario.                EditWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam) Or DLGC_WANTALLKEYS                Exit Function            Case WM_KEYDOWN                Select Case CLng(wParam And &HFFFF&)                    Case VK_RETURN, VK_F3                        RunSearchFromEdit (GetKeyState(VK_SHIFT) < 0)                        Exit Function                    Case VK_ESCAPE                        SetFocusAPI m_hWnd                        Exit Function                End Select            Case WM_CHAR                ' Evita el pitido de Intro/Esc en un EDIT de una linea.                If wParam = 13 Or wParam = 27 Then Exit Function            Case WM_SETFOCUS, WM_KILLFOCUS                Invalidate            Case WM_NCDESTROY                StopEditSubclass                EditWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)                m_hEdit = 0                Exit Function        End Select        EditWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)        ' Al escribir se actualiza el estado de las flechas del panel.        If uMsg = WM_CHAR Then Invalidate    End Function    Private Function GetSearchEditText() As String        Dim n As Long, buf As String, r As Long        If m_hEdit = 0 Then Exit Function        n = GetWindowTextLengthW(m_hEdit)        If n <= 0 Then Exit Function        buf = String$(n + 1, vbNullChar)        r = GetWindowTextW(m_hEdit, StrPtr(buf), n + 1)        If r > 0 Then GetSearchEditText = Left$(buf, r)    End Function    Private Sub SyncSearchEdit()        If m_hEdit = 0 Then Exit Sub        If GetSearchEditText() <> m_FindText Then SetWindowTextW m_hEdit, StrPtr(m_FindText)    End Sub    ' Intro / flechas: si el texto no ha cambiado pasa a la siguiente (o a la    ' anterior); si ha cambiado lanza una busqueda nueva.    Private Sub RunSearchFromEdit(ByVal Backward As Boolean)        Dim t As String        t = GetSearchEditText()        If Len(t) = 0 Then            ClearSearch            Exit Sub        End If        If m_Searched And t = m_FindText Then            If Backward Then FindPrevious Else FindNext        Else            FindText t        End If        Invalidate    End Sub    ' Abre el panel de busqueda y pone el foco en el cuadro de texto.    Public Sub FocusSearchBox()        If Not m_ShowSearch Then            ShowSearchPanel = True            Exit Sub        End If        If m_hEdit = 0 Or Not PanelVisible() Then Exit Sub        SetFocusAPI m_hEdit        SendMessageW m_hEdit, EM_SETSEL, 0, -1    End Sub    ' --- Abrir / guardar con cuadro de dialogo --------------------------------    ' Muestra el dialogo de Windows. Devuelve la ruta elegida ("" si se cancela).    Private Function FileDialog(ByVal SaveMode As Boolean, ByVal Title As String, ByVal InitialDir As String, ByVal InitialName As String) As String        Dim ofn As OPENFILENAMEW, buf As String, flt As String, defExt As String, ok As Long, k As Long        Const MAXPATH As Long = 4096        flt = "Documentos PDF (*.pdf)" & vbNullChar & "*.pdf" & vbNullChar & _                 "Todos los archivos (*.*)" & vbNullChar & "*.*" & vbNullChar & vbNullChar        If Len(InitialName) >= MAXPATH Then InitialName = ""        buf = InitialName & String$(MAXPATH - Len(InitialName), vbNullChar)        defExt = "pdf"        With ofn            .lStructSize = LenB(ofn)            .hwndOwner = GetAncestor(m_hWnd, GA_ROOT)            .lpstrFilter = StrPtr(flt)            .nFilterIndex = 1            .lpstrFile = StrPtr(buf)            .nMaxFile = MAXPATH            If Len(InitialDir) > 0 Then .lpstrInitialDir = StrPtr(InitialDir)            .lpstrTitle = StrPtr(Title)            .lpstrDefExt = StrPtr(defExt)            If SaveMode Then                .Flags = OFN_EXPLORER Or OFN_ENABLESIZING Or OFN_HIDEREADONLY Or OFN_PATHMUSTEXIST Or OFN_OVERWRITEPROMPT Or OFN_NOREADONLYRETURN            Else                .Flags = OFN_EXPLORER Or OFN_ENABLESIZING Or OFN_HIDEREADONLY Or OFN_PATHMUSTEXIST Or OFN_FILEMUSTEXIST            End If        End With        If SaveMode Then ok = GetSaveFileNameW(ofn) Else ok = GetOpenFileNameW(ofn)        If ok = 0 Then Exit Function        k = InStr(1, buf, vbNullChar)        If k > 1 Then FileDialog = Left$(buf, k - 1)    End Function    ' Abre un PDF eligiendolo en el dialogo. Por defecto muestra la carpeta del    ' documento actual (o la ultima usada). Devuelve True si se cargo.    Public Function ShowOpenDialog() As Boolean        Dim selPath As String, initDir As String        If m_hWnd = 0 Then Exit Function        If Not ConfirmSaveChanges() Then Exit Function        If Len(m_FileName) > 0 Then initDir = PathFolder(m_FileName) Else initDir = m_LastDir        selPath = FileDialog(False, "Abrir PDF", initDir, "")        If Len(selPath) = 0 Then Exit Function        m_LastDir = PathFolder(selPath)        ShowOpenDialog = LoadFile(selPath)    End Function    ' Guarda una copia del PDF eligiendo destino en el dialogo. Por defecto    ' propone la carpeta de donde se abrio y el mismo nombre de archivo.    Public Function ShowSaveDialog() As Boolean        Dim selPath As String, initDir As String, initName As String        If m_hWnd = 0 Or Not HasDoc() Then Exit Function        If Len(m_FileName) > 0 Then            initDir = PathFolder(m_FileName)            initName = PathFileName(m_FileName)        Else            initDir = m_LastDir            initName = "documento.pdf"        End If        selPath = FileDialog(True, "Guardar PDF como", initDir, initName)        If Len(selPath) = 0 Then Exit Function        ShowSaveDialog = SaveAs(selPath)    End Function    ' Guarda una copia exacta del documento abierto en la ruta indicada. Si    ' tiene exito, el documento pasa a asociarse con esa ruta (FileName).    Public Function SaveAs(ByVal FileName As String) As Boolean        If Not HasDoc() Or Len(FileName) = 0 Then Exit Function        If Not m_Doc.SaveCopy(FileName) Then Exit Function        m_FileName = FileName        m_LastDir = PathFolder(FileName)        If m_StateCount > 0 Then m_SavedPos = m_StatePos Else m_SavedPos = 0        m_Modified = False        Invalidate        SaveAs = True        RaiseEvent DocumentSaved(FileName)    End Function    ' Mostrar u ocultar desde codigo los botones Abrir y Guardar de la barra.    Public Property Get ShowOpenButton() As Boolean        ShowOpenButton = m_ShowOpenBtn    End Property    Public Property Let ShowOpenButton(ByVal Value As Boolean)        m_ShowOpenBtn = Value        PropertyChanged "ShowOpenButton"        RefreshView False    End Property    Public Property Get ShowSaveButton() As Boolean        ShowSaveButton = m_ShowSaveBtn    End Property    Public Property Let ShowSaveButton(ByVal Value As Boolean)        m_ShowSaveBtn = Value        PropertyChanged "ShowSaveButton"        RefreshView False    End Property    Public Property Get ShowToolbar() As Boolean        ShowToolbar = m_ShowToolbar    End Property    Public Property Let ShowToolbar(ByVal Value As Boolean)        m_ShowToolbar = Value        PropertyChanged "ShowToolbar"        RefreshView False    End Property    ' ========================================================================    '  Organizar paginas    '  Cuadricula de miniaturas que ocupa la vista. Se arrastra una miniatura    '  para cambiar su posicion: el resto se desplaza con animacion y un hueco    '  punteado indica donde quedara la pagina. Al soltar se reordena el PDF    '  (FPDF_MovePages) y el documento queda con cambios sin guardar.    ' ========================================================================    Public Property Get Organizing() As Boolean        Organizing = m_Organize    End Property    Public Property Let Organizing(ByVal Value As Boolean)        If Value = m_Organize Then Exit Property        If Value And Not HasDoc() Then Exit Property        If Value Then            m_Organize = True            OrgSelectOnly m_CurPage            m_OrgHot = -1            m_OrgPress = -1            m_OrgDragging = False            m_OrgFlash = 0            If m_hEdit <> 0 Then                If GetFocus() = m_hEdit Then SetFocusAPI m_hWnd            End If            RefreshLayout False            SnapOrgPositions            EnsureOrgVisible m_OrgSel        Else            CancelCrop            OrgCancelDrag            m_Organize = False            StopAnim            Erase m_OrgThumb            ReDim m_OrgThumb(0 To IMax(m_Count - 1, 0))            RefreshLayout False            GoToPage m_CurPage + 1        End If        Invalidate    End Property    ' Ancho logico de las miniaturas del modo organizar (80..360).    Public Property Get OrganizeThumbSize() As Long        OrganizeThumbSize = m_OrgSize    End Property    Public Property Let OrganizeThumbSize(ByVal Value As Long)        If m_Organize Then            SetOrgSize Value        Else            m_OrgSize = IMax(ORG_MIN, IMin(ORG_MAX, Value))            PropertyChanged "OrganizeThumbSize"        End If    End Property    ' True si hay cambios (paginas reordenadas) sin guardar.    Public Property Get Modified() As Boolean        Modified = m_Modified    End Property    ' Preguntar si se guardan los cambios al cerrar la ventana principal.    Public Property Get ConfirmSaveOnClose() As Boolean        ConfirmSaveOnClose = m_ConfirmClose    End Property    Public Property Let ConfirmSaveOnClose(ByVal Value As Boolean)        m_ConfirmClose = Value        PropertyChanged "ConfirmSaveOnClose"    End Property    ' Si hay cambios sin guardar pregunta Si / No / Cancelar.    ' Devuelve True si se puede continuar (guardado o descartado).    Public Function ConfirmSaveChanges() As Boolean        Dim r As Long, msg As String, cap As String        If Not m_Modified Or Not HasDoc() Then            ConfirmSaveChanges = True            Exit Function        End If        msg = "El documento tiene cambios sin guardar." & vbCrLf & vbCrLf & ChrW$(&HBF) & "Desea guardarlos antes de continuar?"        If Len(m_FileName) > 0 Then cap = PathFileName(m_FileName) Else cap = "ucPDF"        r = MessageBoxW(GetAncestor(m_hWnd, GA_ROOT), StrPtr(msg), StrPtr(cap), MB_YESNOCANCEL Or MB_ICONWARNING)        Select Case r            Case IDYES: ConfirmSaveChanges = ShowSaveDialog()            Case IDNO: ConfirmSaveChanges = True        End Select    End Function    ' --- Aviso al cerrar: se subclasifica la ventana principal (WM_CLOSE) ----    Private Sub InstallRootHook()        Dim h As LongPtr        If m_RootSubclassed Or m_hWnd = 0 Then Exit Sub        h = GetAncestor(m_hWnd, GA_ROOT)        If h = 0 Or h = m_hWnd Then Exit Sub        m_hRoot = h        ' El id es ObjPtr(Me): varios ucPDF en el mismo formulario no se pisan.        m_RootSubclassed = (SetWindowSubclass(m_hRoot, ucPdfSubclassAddress(), ObjPtr(Me), ObjPtr(Me)) <> 0)    End Sub    Private Sub RemoveRootHook()        If m_RootSubclassed Then            RemoveWindowSubclass m_hRoot, ucPdfSubclassAddress(), ObjPtr(Me)            m_RootSubclassed = False        End If        m_hRoot = 0    End Sub    Private Function RootWindowProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr        Select Case uMsg            Case WM_CLOSE, WM_QUERYENDSESSION                If m_ConfirmClose And m_Modified And HasDoc() Then                    If Not ConfirmSaveChanges() Then                        RootWindowProc = 0          ' se cancela el cierre                        Exit Function                    End If                End If            Case WM_NCDESTROY                RemoveRootHook        End Select        RootWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)    End Function    ' --- Geometria -------------------------------------------------------------    Private Function OrgTop() As Long        OrgTop = m_ViewY + Px(ORG_HEADER_H)    End Function    Private Function OrgViewH() As Long        OrgViewH = IMax(0, m_FullH - OrgTop())    End Function    Private Sub LayoutOrganize()        Dim gap As Long, rows As Long, used As Long, sh As Long        If Not HasDoc() Then Exit Sub        gap = Px(ORG_GAP)        m_OrgCellW = Px(m_OrgSize)        m_OrgBoxH = CLng(m_OrgCellW * 1.3)        m_OrgPitchX = m_OrgCellW + gap        m_OrgPitchY = m_OrgBoxH + Px(ORG_LABEL_H) + gap        m_OrgCols = IMax(1, (m_ClientW - gap) \ m_OrgPitchX)        used = m_OrgCols * m_OrgPitchX - gap        m_OrgLeft = IMax(gap, (m_ClientW - used) \ 2)        rows = (m_Count + m_OrgCols - 1) \ m_OrgCols        m_OrgContentH = gap + rows * m_OrgPitchY        ClampOrgScroll        LayoutOrgHeader        ' Al cambiar el numero de columnas las miniaturas se recolocan animadas        StartAnim    End Sub    Private Sub ClampOrgScroll()        m_OrgScroll = IMax(0, IMin(m_OrgScroll, m_OrgContentH - OrgViewH()))    End Sub    Private Sub OrgScrollTo(ByVal y As Long)        Dim si As SCROLLINFO, old As Long, k As Long        old = m_OrgScroll        m_OrgScroll = y        ClampOrgScroll        If old = m_OrgScroll Then Exit Sub        si.cbSize = LenB(si)        si.fMask = SIF_POS        si.nPos = m_OrgScroll        SetScrollInfo m_hWnd, SB_VERT, si, 1        If m_OrgDragging Then            k = DropIndexAt(m_OrgMouseX, m_OrgMouseY)            If k <> m_OrgDropIdx Then                m_OrgDropIdx = k                StartAnim            End If        End If        Invalidate    End Sub    ' Posicion (coordenadas de contenido) de la casilla k de la cuadricula.    Private Sub SlotXY(ByVal k As Long, ByRef x As Double, ByRef y As Double)        x = m_OrgLeft + (k Mod m_OrgCols) * m_OrgPitchX        y = Px(ORG_GAP) + (k \ m_OrgCols) * m_OrgPitchY    End Sub    ' Casilla que debe ocupar la pagina p. Mientras se arrastra, las demas    ' paginas dejan libre la casilla de destino (m_OrgDropIdx).    Private Function TargetSlot(ByVal p As Long) As Long        Dim k As Long        If Not m_OrgDragging Then            TargetSlot = p            Exit Function        End If        If p = m_OrgDragPage Then            TargetSlot = m_OrgDropIdx            Exit Function        End If        k = p        If p > m_OrgDragPage Then k = k - 1        If k >= m_OrgDropIdx Then k = k + 1        TargetSlot = k    End Function    Private Sub SnapOrgPositions()        Dim p As Long, x As Double, y As Double        If Not HasDoc() Then Exit Sub        For p = 0 To m_Count - 1            SlotXY TargetSlot(p), x, y            m_OrgCurX(p) = x            m_OrgCurY(p) = y        Next    End Sub    Private Sub EnsureOrgVisible(ByVal i As Long)        Dim x As Double, y As Double        If i < 0 Or i >= m_Count Or m_OrgCols <= 0 Then Exit Sub        SlotXY i, x, y        If y - Px(ORG_GAP) < m_OrgScroll Then            m_OrgScroll = y - Px(ORG_GAP)        ElseIf y + m_OrgPitchY > m_OrgScroll + OrgViewH() Then            m_OrgScroll = y + m_OrgPitchY - OrgViewH()        End If        ClampOrgScroll        UpdateScrollBars    End Sub    ' Casilla de destino para un punto de pantalla.    Private Function DropIndexAt(ByVal x As Long, ByVal y As Long) As Long        Dim col As Long, row As Long, cy As Double, k As Long, gap As Long        gap = Px(ORG_GAP)        col = Int((x - m_OrgLeft + gap / 2) / m_OrgPitchX)        col = IMax(0, IMin(col, m_OrgCols - 1))        cy = y - OrgTop() + m_OrgScroll - gap / 2        row = IMax(0, Int(cy / m_OrgPitchY))        k = row * m_OrgCols + col        DropIndexAt = IMax(0, IMin(k, m_Count - 1))    End Function    ' Pagina bajo el punto de pantalla (-1 si ninguna).    Private Function OrgHitPage(ByVal x As Long, ByVal y As Long) As Long        Dim p As Long, sx As Double, sy As Double, top As Long        OrgHitPage = -1        If Not m_Organize Or Not HasDoc() Then Exit Function        top = OrgTop()        If y < top Then Exit Function        For p = 0 To m_Count - 1            If Not (m_OrgDragging And p = m_OrgDragPage) Then                SlotXY TargetSlot(p), sx, sy                sy = top + sy - m_OrgScroll                If x >= sx And x < sx + m_OrgCellW And y >= sy And y < sy + m_OrgBoxH + Px(ORG_LABEL_H) Then                    OrgHitPage = p                    Exit Function                End If            End If        Next    End Function    Private Function PtInSlider(ByVal x As Long, ByVal y As Long) As Boolean        If Not m_Organize Then Exit Function        PtInSlider = (x >= m_SliderRect.Left - Px(8) And x <= m_SliderRect.Right + Px(8) And y >= m_SliderRect.Top And y <= m_SliderRect.Bottom)    End Function    ' Cambia el tamano de las miniaturas conservando la posicion relativa.    Private Sub SetOrgSize(ByVal Value As Long)        Dim frac As Double        Value = IMax(ORG_MIN, IMin(ORG_MAX, ((Value + 5) \ 10) * 10))        If Value = m_OrgSize Then Exit Sub        If m_OrgContentH > 0 Then frac = m_OrgScroll / m_OrgContentH        m_OrgSize = Value        PropertyChanged "OrganizeThumbSize"        LayoutOrganize        m_OrgScroll = CLng(frac * m_OrgContentH)        ClampOrgScroll        SnapOrgPositions        UpdateScrollBars        Invalidate    End Sub    Private Sub SetOrgSizeFromX(ByVal x As Long)        Dim frac As Double, w As Long        w = m_SliderRect.Right - m_SliderRect.Left        If w <= 0 Then Exit Sub        frac = (x - m_SliderRect.Left) / w        If frac < 0 Then frac = 0        If frac > 1 Then frac = 1        SetOrgSize ORG_MIN + CLng(frac * (ORG_MAX - ORG_MIN))    End Sub    ' --- Animacion -----------------------------------------------------------    Private Sub StartAnim()        If m_AnimOn Or m_hWnd = 0 Then Exit Sub        m_AnimOn = (SetTimer(m_hWnd, ANIM_TIMER_ID, ANIM_MS, 0) <> 0)    End Sub    Private Sub StopAnim()        If Not m_AnimOn Then Exit Sub        KillTimer m_hWnd, ANIM_TIMER_ID        m_AnimOn = False    End Sub    ' Cada fotograma acerca cada miniatura un 30 % a su casilla (suavizado).    Private Sub AnimStep()        Dim p As Long, tx As Double, ty As Double, dx As Double, dy As Double, moving As Boolean        If Not HasDoc() Or Not m_Organize Then            StopAnim            Exit Sub        End If        ' Desplazamiento automatico al arrastrar cerca de los bordes        If m_OrgDragging Then            If m_OrgMouseY < OrgTop() + Px(28) Then                OrgScrollTo m_OrgScroll - Px(14)            ElseIf m_OrgMouseY > m_FullH - Px(28) Then                OrgScrollTo m_OrgScroll + Px(14)            End If            moving = True        End If        For p = 0 To m_Count - 1            If Not (m_OrgDragging And p = m_OrgDragPage) Then                SlotXY TargetSlot(p), tx, ty                dx = tx - m_OrgCurX(p)                dy = ty - m_OrgCurY(p)                If Abs(dx) < 0.5 And Abs(dy) < 0.5 Then                    m_OrgCurX(p) = tx                    m_OrgCurY(p) = ty                Else                    m_OrgCurX(p) = m_OrgCurX(p) + dx * 0.3                    m_OrgCurY(p) = m_OrgCurY(p) + dy * 0.3                    moving = True                End If            End If        Next        If m_OrgFlash > 0 Then            m_OrgFlash = IMax(0, m_OrgFlash - 10)            moving = True        End If        Invalidate        If Not moving Then StopAnim    End Sub    ' --- Raton -----------------------------------------------------------------    Private Sub OrgMouseDown(ByVal x As Long, ByVal y As Long, ByVal Button As Long)        Dim p As Long        If Button <> vbLeftButton Then Exit Sub        If m_CropMode Then            CropMouseDown x, y            Exit Sub        End If        If PtInSlider(x, y) Then            m_SliderDrag = True            SetCapture m_hWnd            SetOrgSizeFromX x            Exit Sub        End If        p = OrgHitPage(x, y)        m_OrgClickReset = -1        If p < 0 Then            ' Clic en vacio: quitar la seleccion (salvo con Ctrl)            If GetKeyState(VK_CONTROL) >= 0 Then                OrgClearSelection                Invalidate            End If            Exit Sub        End If        ' Seleccion: Ctrl alterna, Mayus selecciona un intervalo, clic normal        ' deja solo esa pagina (si ya estaba seleccionada se decide al soltar,        ' para poder arrastrar sin perder la seleccion multiple).        If GetKeyState(VK_SHIFT) < 0 And m_OrgSel >= 0 Then            OrgSelectRange m_OrgSel, p        ElseIf GetKeyState(VK_CONTROL) < 0 Then            m_OrgSelected(p) = Not m_OrgSelected(p)            m_OrgSel = p        ElseIf m_OrgSelected(p) Then            m_OrgClickReset = p            m_OrgSel = p        Else            OrgSelectOnly p        End If        m_OrgPress = p        m_OrgPressX = x        m_OrgPressY = y        m_OrgMouseX = x        m_OrgMouseY = y        SetCapture m_hWnd        If p <> m_CurPage Then SetCurrentPage p        Invalidate    End Sub    Private Sub OrgMouseMove(ByVal x As Long, ByVal y As Long)        Dim k As Long, p As Long        m_OrgMouseX = x        m_OrgMouseY = y        If m_CropMode Then            CropMouseMove x, y            Exit Sub        End If        If m_SliderDrag Then            SetOrgSizeFromX x            Exit Sub        End If        ' Empieza el arrastre al superar un pequeno umbral        If m_OrgPress >= 0 And Not m_OrgDragging Then            If Abs(x - m_OrgPressX) > Px(5) Or Abs(y - m_OrgPressY) > Px(5) Then                ' Se arrastra una pagina: pasa a ser la unica seleccionada                OrgSelectOnly m_OrgPress                m_OrgClickReset = -1                m_OrgDragging = True                m_OrgDragPage = m_OrgPress                m_OrgGrabDX = m_OrgPressX - CLng(m_OrgCurX(m_OrgPress))                m_OrgGrabDY = m_OrgPressY - (OrgTop() + CLng(m_OrgCurY(m_OrgPress)) - m_OrgScroll)                m_OrgDropIdx = m_OrgPress                m_OrgHot = -1                StartAnim            End If        End If        If m_OrgDragging Then            k = DropIndexAt(x, y)            If k <> m_OrgDropIdx Then                m_OrgDropIdx = k                StartAnim            End If            Invalidate            Exit Sub        End If        p = OrgHitPage(x, y)        If p <> m_OrgHot Then            m_OrgHot = p            Invalidate        End If    End Sub    Private Sub OrgMouseUp(ByVal x As Long, ByVal y As Long)        Dim src As Long, dest As Long        If m_CropMode Then            CropMouseUp            Exit Sub        End If        If m_SliderDrag Then            m_SliderDrag = False            If GetCapture() = m_hWnd Then ReleaseCapture            Invalidate                      ' las miniaturas se vuelven a renderizar a su tamano            Exit Sub        End If        If m_OrgDragging Then            src = m_OrgDragPage            dest = m_OrgDropIdx            ' La animacion de llegada parte de donde se solto            m_OrgCurX(src) = x - m_OrgGrabDX            m_OrgCurY(src) = y - m_OrgGrabDY - OrgTop() + m_OrgScroll            m_OrgDragging = False            m_OrgPress = -1            If GetCapture() = m_hWnd Then ReleaseCapture            If dest <> src Then DoMovePage src, dest Else dest = src            m_OrgFlashPage = m_OrgSel            m_OrgFlash = 255            StartAnim            Exit Sub        End If        If m_OrgClickReset >= 0 Then            OrgSelectOnly m_OrgClickReset            m_OrgClickReset = -1            Invalidate        End If        m_OrgPress = -1        If GetCapture() = m_hWnd Then ReleaseCapture    End Sub    ' --- Seleccion multiple ---------------------------------------------------    Private Function OrgIsSel(ByVal p As Long) As Boolean        If p < 0 Or p >= m_Count Then Exit Function        OrgIsSel = m_OrgSelected(p)    End Function    Private Sub OrgClearSelection()        Dim p As Long        For p = 0 To m_Count - 1            m_OrgSelected(p) = False        Next    End Sub    Private Sub OrgSelectOnly(ByVal p As Long)        If m_Count <= 0 Then Exit Sub        OrgClearSelection        p = IMax(0, IMin(p, m_Count - 1))        m_OrgSelected(p) = True        m_OrgSel = p    End Sub    Private Sub OrgSelectRange(ByVal a As Long, ByVal b As Long)        Dim p As Long        OrgClearSelection        For p = IMin(a, b) To IMax(a, b)            m_OrgSelected(p) = True        Next        m_OrgSel = b    End Sub    Private Function OrgSelCount() As Long        Dim p As Long        If Not m_Organize Then Exit Function        For p = 0 To m_Count - 1            If m_OrgSelected(p) Then OrgSelCount = OrgSelCount + 1        Next    End Function    ' Paginas sobre las que actuan las operaciones (orden ascendente, base 0):    ' la seleccion en el modo organizar; en la vista normal, la pagina actual.    Private Function TargetPages(ByRef idx() As Long) As Long        Dim p As Long, n As Long        If Not HasDoc() Then Exit Function        ReDim idx(0 To m_Count - 1)        If m_Organize Then            For p = 0 To m_Count - 1                If m_OrgSelected(p) Then                    idx(n) = p                    n = n + 1                End If            Next        Else            idx(0) = m_CurPage            n = 1        End If        TargetPages = n    End Function    ' Paginas seleccionadas en el modo organizar (base 1), separadas por comas.    Public Property Get SelectedPages() As String        Dim idx() As Long, n As Long, k As Long, r As String        n = TargetPages(idx)        For k = 0 To n - 1            If k > 0 Then r = r & ","            r = r & CStr(idx(k) + 1)        Next        SelectedPages = r    End Property    Public Sub SelectAllPages()        If Not m_Organize Or Not HasDoc() Then Exit Sub        OrgSelectRange 0, m_Count - 1        Invalidate    End Sub    Private Sub OrgCancelDrag()        If m_OrgDragging Then            m_OrgCurX(m_OrgDragPage) = m_OrgMouseX - m_OrgGrabDX            m_OrgCurY(m_OrgDragPage) = m_OrgMouseY - m_OrgGrabDY - OrgTop() + m_OrgScroll            m_OrgDragging = False            StartAnim        End If        m_OrgPress = -1        m_SliderDrag = False        Invalidate    End Sub    ' --- Reordenar ------------------------------------------------------------    Private Sub DoMovePage(ByVal src As Long, ByVal dest As Long)        Dim i As Long, c As Long, msg As String        BeginEdit        If Not m_Doc.MovePage(src, dest) Then            msg = "No se pudo mover la p" & ChrW$(&HE1) & "gina." & vbCrLf & "Compruebe que pdfium.dll incluye FPDF_MovePages."            MessageBoxW GetAncestor(m_hWnd, GA_ROOT), StrPtr(msg), StrPtr("ucPDF"), MB_ICONWARNING            Exit Sub        End If        ' Las caches siguen a su pagina (no hay que volver a renderizar)        MoveDblItem m_OrgCurX, src, dest        MoveDblItem m_OrgCurY, src, dest        MoveDibItem m_OrgThumb, src, dest        MoveDibItem m_Thumb, src, dest        MoveLngItem m_ThumbRot, src, dest        MoveBoolItem m_OrgSelected, src, dest        MoveLngItem m_PageId, src, dest        For i = 0 To m_Count - 1            Set m_Tile(i) = Nothing        Next        c = m_CurPage        If c = src Then            c = dest        ElseIf src < dest And c > src And c <= dest Then            c = c - 1        ElseIf src > dest And c >= dest And c < src Then            c = c + 1        End If        m_CurPage = c        OrgSelectOnly dest        ' Busqueda y seleccion hacen referencia a indices antiguos        m_HasSel = False        ClearSearch        CommitEdit        RefreshLayout False        RaiseEvent PagesReordered(src + 1, dest + 1)        RaiseEvent PageChanged(m_CurPage + 1)    End Sub    Private Sub MoveDblItem(ByRef a() As Double, ByVal src As Long, ByVal dest As Long)        Dim t As Double, i As Long        t = a(src)        If src < dest Then            For i = src To dest - 1                a(i) = a(i + 1)            Next        Else            For i = src To dest + 1 Step -1                a(i) = a(i - 1)            Next        End If        a(dest) = t    End Sub    Private Sub MoveBoolItem(ByRef a() As Boolean, ByVal src As Long, ByVal dest As Long)        Dim t As Boolean, i As Long        t = a(src)        If src < dest Then            For i = src To dest - 1                a(i) = a(i + 1)            Next        Else            For i = src To dest + 1 Step -1                a(i) = a(i - 1)            Next        End If        a(dest) = t    End Sub    Private Sub MoveLngItem(ByRef a() As Long, ByVal src As Long, ByVal dest As Long)        Dim t As Long, i As Long        t = a(src)        If src < dest Then            For i = src To dest - 1                a(i) = a(i + 1)            Next        Else            For i = src To dest + 1 Step -1                a(i) = a(i - 1)            Next        End If        a(dest) = t    End Sub    Private Sub MoveDibItem(ByRef a() As PdfDib, ByVal src As Long, ByVal dest As Long)        Dim t As PdfDib, i As Long        Set t = a(src)        If src < dest Then            For i = src To dest - 1                Set a(i) = a(i + 1)            Next        Else            For i = src To dest + 1 Step -1                Set a(i) = a(i - 1)            Next        End If        Set a(dest) = t    End Sub    ' --- Deshacer / rehacer ------------------------------------------------------    ' Historial lineal de estados: el estado 0 es el documento antes del primer    ' cambio y cada cambio confirmado anade uno. Deshacer/rehacer cargan el    ' estado anterior/siguiente. Un cambio nuevo descarta los estados de rehacer.    ' Los estados se guardan en %TEMP% (sin limite de pasos ni de memoria) y se    ' borran al cerrar el documento o el control.    Private Function StateFileName() As String        m_StateSerial = m_StateSerial + 1        StateFileName = Environ$("TEMP") & "\ucpdf_undo_" & Hex$(GetCurrentProcessId()) & "_" & Hex$(ObjPtr(Me)) & "_" & CStr(m_StateSerial) & ".pdf"    End Function    Private Function PushState() As Boolean        Dim fn As String, ids As Variant        fn = StateFileName()        If Not m_Doc.SaveSnapshot(fn) Then Exit Function        m_StateCount = m_StateCount + 1        ReDim Preserve m_StateFile(0 To m_StateCount - 1)        ReDim Preserve m_StateIds(0 To m_StateCount - 1)        m_StateFile(m_StateCount - 1) = fn        ids = m_PageId        m_StateIds(m_StateCount - 1) = ids        m_StatePos = m_StateCount - 1        PushState = True    End Function    ' Antes de modificar: guarda el estado inicial si aun no hay historial.    Private Sub BeginEdit()        If m_StateCount = 0 Then PushState    End Sub    ' Despues de modificar: descarta los estados de rehacer y guarda el nuevo.    Private Sub CommitEdit()        Dim k As Long        For k = m_StatePos + 1 To m_StateCount - 1            DeleteFileW StrPtr(m_StateFile(k))        Next        If m_StateCount > m_StatePos + 1 Then            If m_SavedPos > m_StatePos Then m_SavedPos = -1            m_StateCount = m_StatePos + 1            If m_StateCount > 0 Then                ReDim Preserve m_StateFile(0 To m_StateCount - 1)                ReDim Preserve m_StateIds(0 To m_StateCount - 1)            End If        End If        If Not PushState() Then            ' Sin espacio para el historial: el cambio queda, pero sin deshacer            m_Modified = True            Exit Sub        End If        UpdateModified    End Sub    Private Sub UpdateModified()        If m_StateCount > 0 Then m_Modified = (m_StatePos <> m_SavedPos)    End Sub    Private Sub ClearHistory()        Dim k As Long        For k = 0 To m_StateCount - 1            DeleteFileW StrPtr(m_StateFile(k))        Next        Erase m_StateFile        Erase m_StateIds        m_StateCount = 0        m_StatePos = -1        m_SavedPos = -1    End Sub    Public Property Get CanUndo() As Boolean        CanUndo = (m_StatePos > 0 And HasDoc() And Not m_CropMode)    End Property    Public Property Get CanRedo() As Boolean        CanRedo = (m_StatePos >= 0 And m_StatePos < m_StateCount - 1 And HasDoc() And Not m_CropMode)    End Property    ' Numero de pasos que se pueden deshacer / rehacer.    Public Property Get UndoCount() As Long        If m_StatePos > 0 Then UndoCount = m_StatePos    End Property    Public Property Get RedoCount() As Long        If m_StatePos >= 0 Then RedoCount = m_StateCount - 1 - m_StatePos    End Property    Public Sub Undo()        If CanUndo Then GoToState m_StatePos - 1, pdfOpUndo    End Sub    Public Sub Redo()        If CanRedo Then GoToState m_StatePos + 1, pdfOpRedo    End Sub    ' Carga el estado k. Las paginas que existian (mismo identificador) se    ' deslizan desde su posicion actual y conservan su miniatura.    Private Sub GoToState(ByVal k As Long, ByVal Operation As ucPdfPageOperation)        Dim ids As Variant, n As Long, j As Long, o As Long, pm() As Long, kt() As Boolean        Dim lookup As Collection, selFirst As Long        CancelCrop        OrgCancelDrag        If Not m_Doc.LoadSnapshot(m_StateFile(k)) Then            ShowWarning Txt("No se pudo recuperar el estado anterior del documento.")            Exit Sub        End If        m_StatePos = k        ids = m_StateIds(k)        n = m_Doc.PageCount        ReDim pm(0 To IMax(n - 1, 0))        ReDim kt(0 To IMax(n - 1, 0))        Set lookup = New Collection        For o = 0 To m_Count - 1            lookup.Add o, "p" & CStr(m_PageId(o))        Next        selFirst = -1        On Error Resume Next        For j = 0 To n - 1            pm(j) = -1            pm(j) = lookup("p" & CStr(ids(j)))            kt(j) = (pm(j) >= 0)            If pm(j) < 0 And selFirst < 0 Then selFirst = j        Next        On Error GoTo 0        If selFirst < 0 Then selFirst = IMax(0, IMin(m_OrgSel, n - 1))        RebuildAfterEdit pm, kt, selFirst, 1, Operation, ids    End Sub    ' --- Operaciones sobre la seleccion ---------------------------------------    ' Tras cambiar la estructura se reconstruyen las listas por pagina.    ' PosMap(j) = indice anterior de la nueva pagina j (-1 si es nueva): las    ' miniaturas existentes se deslizan desde su sitio anterior y las nuevas    ' aparecen en su casilla. KeepThumb(j) = False obliga a renderizarla de nuevo.    Private Sub RebuildAfterEdit(ByRef PosMap() As Long, ByRef KeepThumb() As Boolean, ByVal SelFirst As Long, ByVal SelCount As Long, ByVal Operation As ucPdfPageOperation, Optional ByVal ForcedIds As Variant)        Dim n As Long, j As Long, o As Long, ub As Long, x As Double, y As Double        Dim nx() As Double, ny() As Double, nt() As PdfDib, isNew() As Boolean, nid() As Long        n = m_Doc.PageCount        ub = IMax(n - 1, 0)        ReDim nx(0 To ub): ReDim ny(0 To ub): ReDim nt(0 To ub): ReDim isNew(0 To ub): ReDim nid(0 To ub)        For j = 0 To n - 1            o = PosMap(j)            If o >= 0 And o < m_Count Then                nx(j) = m_OrgCurX(o)                ny(j) = m_OrgCurY(o)                If KeepThumb(j) Then Set nt(j) = m_OrgThumb(o)            Else                isNew(j) = True            End If            ' Identificador: el de la instantanea (deshacer/rehacer), el mismo si            ' la pagina no cambia de aspecto, o uno nuevo si cambia o es nueva.            If Not IsMissing(ForcedIds) Then                nid(j) = ForcedIds(j)            ElseIf o >= 0 And o < m_Count And KeepThumb(j) Then                nid(j) = m_PageId(o)            Else                nid(j) = m_NextPageId                m_NextPageId = m_NextPageId + 1            End If        Next        m_PageId = nid        m_Count = n        ReDim m_PX(0 To ub): ReDim m_PY(0 To ub): ReDim m_PW(0 To ub): ReDim m_PH(0 To ub)        ReDim m_Tile(0 To ub): ReDim m_TileX(0 To ub): ReDim m_TileY(0 To ub)        ReDim m_TileKW(0 To ub): ReDim m_TileKH(0 To ub): ReDim m_TileRot(0 To ub)        ReDim m_Thumb(0 To ub): ReDim m_ThumbRot(0 To ub)        ReDim m_ThumbY(0 To ub): ReDim m_ThumbW(0 To ub): ReDim m_ThumbH(0 To ub)        ReDim m_OrgSelected(0 To ub)        m_OrgCurX = nx        m_OrgCurY = ny        m_OrgThumb = nt        ' Seleccion resultante        For j = SelFirst To IMin(SelFirst + SelCount - 1, n - 1)            If j >= 0 Then m_OrgSelected(j) = True        Next        m_OrgSel = IMax(0, IMin(SelFirst, n - 1))        m_CurPage = IMax(0, IMin(m_CurPage, n - 1))        If m_Organize Then m_CurPage = m_OrgSel        m_HasSel = False        ClearSearch        If Operation = pdfOpUndo Or Operation = pdfOpRedo Then UpdateModified Else CommitEdit        RefreshLayout False        ' Las paginas nuevas aparecen en su casilla con un destello        For j = 0 To n - 1            If isNew(j) Then                SlotXY j, x, y                m_OrgCurX(j) = x                m_OrgCurY(j) = y            End If        Next        m_OrgFlashPage = m_OrgSel        m_OrgFlash = 255        EnsureOrgVisible m_OrgSel        StartAnim        Invalidate        RaiseEvent PagesEdited(Operation, SelFirst + 1, SelCount)        RaiseEvent PageChanged(m_CurPage + 1)    End Sub    ' Mapa identidad (mismas paginas, mismo orden).    Private Sub IdentityMap(ByRef PosMap() As Long, ByRef KeepThumb() As Boolean)        Dim j As Long, n As Long        n = m_Doc.PageCount        ReDim PosMap(0 To IMax(n - 1, 0))        ReDim KeepThumb(0 To IMax(n - 1, 0))        For j = 0 To n - 1            PosMap(j) = j            KeepThumb(j) = True        Next    End Sub    Private Sub ShowWarning(ByVal Message As String)        MessageBoxW GetAncestor(m_hWnd, GA_ROOT), StrPtr(Message), StrPtr("ucPDF"), MB_ICONWARNING    End Sub    ' Abre un PDF elegido con el dialogo (para insertar o reemplazar).    Private Function OpenSourcePdf(ByVal Title As String, ByVal FileName As String) As PdfDocument        Dim src As PdfDocument, initDir As String        If Len(FileName) = 0 Then            If Len(m_FileName) > 0 Then initDir = PathFolder(m_FileName) Else initDir = m_LastDir            FileName = FileDialog(False, Title, initDir, "")            If Len(FileName) = 0 Then Exit Function            m_LastDir = PathFolder(FileName)        End If        Set src = New PdfDocument        If Not src.OpenFile(FileName, , m_PdfiumPath) Then            ShowWarning Txt("No se pudo abrir el archivo:") & vbCrLf & FileName & vbCrLf & src.LastErrorText            Exit Function        End If        Set OpenSourcePdf = src    End Function    ' Girar la seleccion 90 grados.    Public Sub RotateSelectedPages(ByVal Clockwise As Boolean)        Dim idx() As Long, n As Long, k As Long, pm() As Long, kt() As Boolean        n = TargetPages(idx)        If n = 0 Then Exit Sub        BeginEdit        If Not m_Doc.RotatePages(idx, n, IIf(Clockwise, 1, -1)) Then Exit Sub        IdentityMap pm, kt        For k = 0 To n - 1            kt(idx(k)) = False        Next        RebuildAfterEdit pm, kt, idx(0), 1, pdfOpRotate        ' Mantener la seleccion completa        For k = 0 To n - 1            m_OrgSelected(idx(k)) = True        Next        Invalidate    End Sub    ' Eliminar la seleccion (pide confirmacion; siempre queda al menos una pagina).    Public Sub DeleteSelectedPages(Optional ByVal Confirm As Boolean = True)        Dim idx() As Long, n As Long, k As Long, j As Long, o As Long, pm() As Long, kt() As Boolean        Dim msg As String, nNew As Long, isDel As Boolean        n = TargetPages(idx)        If n = 0 Then Exit Sub        If n >= m_Count Then            ShowWarning Txt("No se pueden eliminar todas las p&aacute;ginas del documento.")            Exit Sub        End If        If Confirm Then            If n = 1 Then                msg = Txt("&iquest;Eliminar la p&aacute;gina ") & CStr(idx(0) + 1) & "?"            Else                msg = Txt("&iquest;Eliminar las ") & CStr(n) & Txt(" p&aacute;ginas seleccionadas?")            End If            If MessageBoxW(GetAncestor(m_hWnd, GA_ROOT), StrPtr(msg), StrPtr("ucPDF"), &H4 Or MB_ICONWARNING) <> IDYES Then Exit Sub        End If        BeginEdit        If Not m_Doc.DeletePages(idx, n) Then Exit Sub        ' Las que quedan conservan su miniatura y se deslizan a los huecos        nNew = m_Count - n        ReDim pm(0 To IMax(nNew - 1, 0))        ReDim kt(0 To IMax(nNew - 1, 0))        k = 0        j = 0        For o = 0 To m_Count - 1            isDel = False            If k < n Then                If idx(k) = o Then                    isDel = True                    k = k + 1                End If            End If            If Not isDel Then                pm(j) = o                kt(j) = True                j = j + 1            End If        Next        RebuildAfterEdit pm, kt, IMin(idx(0), nNew - 1), 1, pdfOpDelete    End Sub    ' Inserta una pagina en blanco (del tamano de la ultima seleccionada)    ' justo despues de la seleccion.    Public Sub InsertBlankPage()        Dim idx() As Long, n As Long, ins As Long, pm() As Long, kt() As Boolean        n = TargetPages(idx)        If n = 0 Then Exit Sub        ins = idx(n - 1) + 1        BeginEdit        If Not m_Doc.InsertBlankPage(ins, m_Doc.PageWidth(idx(n - 1)), m_Doc.PageHeight(idx(n - 1))) Then            ShowWarning Txt("No se pudo insertar la p&aacute;gina.")            Exit Sub        End If        BuildInsertMap pm, kt, ins, 1        RebuildAfterEdit pm, kt, ins, 1, pdfOpInsertBlank    End Sub    ' Inserta todas las paginas de otro PDF despues de la seleccion.    Public Sub InsertPagesFromFile(Optional ByVal FileName As String)        Dim idx() As Long, n As Long, ins As Long, cnt As Long, pm() As Long, kt() As Boolean, src As PdfDocument        n = TargetPages(idx)        If n = 0 Then Exit Sub        Set src = OpenSourcePdf(Txt("Insertar p&aacute;ginas desde archivo"), FileName)        If src Is Nothing Then Exit Sub        ins = idx(n - 1) + 1        BeginEdit        cnt = m_Doc.ImportAllPages(src, ins)        Set src = Nothing        If cnt <= 0 Then            ShowWarning Txt("No se pudieron insertar las p&aacute;ginas.")            Exit Sub        End If        BuildInsertMap pm, kt, ins, cnt        RebuildAfterEdit pm, kt, ins, cnt, pdfOpInsertFromFile    End Sub    Private Sub BuildInsertMap(ByRef pm() As Long, ByRef kt() As Boolean, ByVal ins As Long, ByVal cnt As Long)        Dim j As Long, n As Long        n = m_Doc.PageCount        ReDim pm(0 To IMax(n - 1, 0))        ReDim kt(0 To IMax(n - 1, 0))        For j = 0 To n - 1            If j < ins Then                pm(j) = j            ElseIf j < ins + cnt Then                pm(j) = -1            Else                pm(j) = j - cnt            End If            kt(j) = (pm(j) >= 0)        Next    End Sub    ' Reemplaza la seleccion por las primeras paginas de otro PDF.    Public Sub ReplaceSelectedPages(Optional ByVal FileName As String)        Dim idx() As Long, n As Long, k As Long, cnt As Long, pm() As Long, kt() As Boolean, src As PdfDocument        n = TargetPages(idx)        If n = 0 Then Exit Sub        Set src = OpenSourcePdf(Txt("Reemplazar p&aacute;ginas con..."), FileName)        If src Is Nothing Then Exit Sub        If src.PageCount < n Then            ShowWarning Txt("El archivo solo tiene ") & CStr(src.PageCount) & Txt(" p&aacute;gina(s): se reemplazar&aacute;n las ") & CStr(src.PageCount) & Txt(" primeras de la selecci&oacute;n.")        End If        BeginEdit        cnt = m_Doc.ReplacePages(idx, n, src)        Set src = Nothing        If cnt <= 0 Then            ShowWarning Txt("No se pudieron reemplazar las p&aacute;ginas.")            Exit Sub        End If        IdentityMap pm, kt        For k = 0 To cnt - 1            kt(idx(k)) = False        Next        RebuildAfterEdit pm, kt, idx(0), 1, pdfOpReplace        For k = 0 To n - 1            m_OrgSelected(idx(k)) = True        Next        Invalidate    End Sub    ' Guarda la seleccion en un PDF nuevo. Propone la carpeta del documento y    ' el nombre "<nombre>_paginas.pdf". El documento actual no cambia.    Public Function ExtractSelectedPages(Optional ByVal FileName As String) As Boolean        Dim idx() As Long, n As Long, initDir As String, initName As String        n = TargetPages(idx)        If n = 0 Then Exit Function        If Len(FileName) = 0 Then            If Len(m_FileName) > 0 Then                initDir = PathFolder(m_FileName)                initName = PathFileName(m_FileName)                If LCase$(Right$(initName, 4)) = ".pdf" Then initName = Left$(initName, Len(initName) - 4)                initName = initName & "_paginas.pdf"            Else                initDir = m_LastDir                initName = "paginas.pdf"            End If            FileName = FileDialog(True, Txt("Extraer p&aacute;ginas a un documento nuevo"), initDir, initName)            If Len(FileName) = 0 Then Exit Function            m_LastDir = PathFolder(FileName)        End If        If Not m_Doc.ExtractPages(idx, n, FileName) Then            ShowWarning Txt("No se pudieron extraer las p&aacute;ginas.")            Exit Function        End If        ExtractSelectedPages = True        RaiseEvent PagesExtracted(FileName, n)    End Function    ' Abre el editor de recorte: se dibuja un rectangulo sobre la primera    ' pagina seleccionada y, al aplicar, se recortan todas las seleccionadas    ' con el mismo rectangulo (relativo al tamano de cada pagina).    Public Sub CropSelectedPages()        Dim idx() As Long, n As Long        n = TargetPages(idx)        If n = 0 Then Exit Sub        If Not m_Organize Then            Organizing = True            OrgSelectOnly idx(0)        End If        m_CropPage = idx(0)        m_CropMode = True        m_CropDrag = 0        m_CropHotBtn = 0        Set m_CropDib = Nothing        ' Rectangulo inicial: el contenido de la pagina con un pequeno margen        If Not CropAutoRect() Then            m_CropL = 0.05: m_CropT = 0.05: m_CropR = 0.95: m_CropB = 0.95        End If        LayoutCrop        Invalidate    End Sub    ' Recorte con margenes en puntos desde cada borde de la pagina mostrada.    Public Sub CropSelectedPagesMargins(ByVal LeftPt As Double, ByVal TopPt As Double, ByVal RightPt As Double, ByVal BottomPt As Double)        Dim idx() As Long, n As Long, k As Long, w As Double, h As Double, ok As Long        n = TargetPages(idx)        If n = 0 Then Exit Sub        BeginEdit        For k = 0 To n - 1            w = m_Doc.PageWidth(idx(k))            h = m_Doc.PageHeight(idx(k))            If m_Doc.CropPageFraction(idx(k), LeftPt / w, TopPt / h, 1 - RightPt / w, 1 - BottomPt / h) Then ok = ok + 1        Next        If ok > 0 Then FinishCrop idx, n    End Sub    ' Recorte automatico de los margenes en blanco.    Public Sub CropSelectedPagesAuto(Optional ByVal MarginPt As Double = 8)        Dim idx() As Long, n As Long, k As Long, ok As Long        n = TargetPages(idx)        If n = 0 Then Exit Sub        BeginEdit        For k = 0 To n - 1            If m_Doc.CropToContent(idx(k), MarginPt) Then ok = ok + 1        Next        If ok = 0 Then            ShowWarning Txt("No hay contenido que recortar en la selecci&oacute;n.")            Exit Sub        End If        FinishCrop idx, n    End Sub    Private Sub FinishCrop(ByRef idx() As Long, ByVal n As Long)        Dim k As Long, pm() As Long, kt() As Boolean        m_Doc.RefreshStructure        IdentityMap pm, kt        For k = 0 To n - 1            kt(idx(k)) = False        Next        RebuildAfterEdit pm, kt, idx(0), 1, pdfOpCrop        For k = 0 To n - 1            m_OrgSelected(idx(k)) = True        Next        Invalidate    End Sub    ' --- Editor de recorte ------------------------------------------------------    Private Function CropAutoRect() As Boolean        Dim fl As Double, ft As Double, fr As Double, fb As Double, mx As Double, my As Double        If Not m_Doc.ContentBounds(m_CropPage, fl, ft, fr, fb) Then Exit Function        mx = 8 / m_Doc.PageWidth(m_CropPage)        my = 8 / m_Doc.PageHeight(m_CropPage)        m_CropL = DMax(0, fl - mx): m_CropT = DMax(0, ft - my)        m_CropR = DMin(1, fr + mx): m_CropB = DMin(1, fb + my)        CropAutoRect = True    End Function    Public Property Get CropEditorActive() As Boolean        CropEditorActive = m_CropMode    End Property    Public Sub CancelCrop()        If Not m_CropMode Then Exit Sub        m_CropMode = False        m_CropDrag = 0        Set m_CropDib = Nothing        If GetCapture() = m_hWnd Then ReleaseCapture        Invalidate    End Sub    ' Aplica el rectangulo a todas las paginas seleccionadas.    Public Sub ApplyCrop()        Dim idx() As Long, n As Long, k As Long, ok As Long        If Not m_CropMode Then Exit Sub        n = TargetPages(idx)        CancelCrop        If n = 0 Then Exit Sub        BeginEdit        For k = 0 To n - 1            If m_Doc.CropPageFraction(idx(k), m_CropL, m_CropT, m_CropR, m_CropB) Then ok = ok + 1        Next        If ok > 0 Then FinishCrop idx, n    End Sub    Private Sub LayoutCrop()        Dim top As Long, barH As Long, aw As Long, ah As Long, w As Double, h As Double, sc As Double        Dim pw As Long, ph As Long, bw As Long, bh As Long, by As Long, x As Long        If Not m_CropMode Then Exit Sub        top = OrgTop()        barH = Px(52)        aw = m_ClientW - Px(48)        ah = m_FullH - top - barH - Px(32)        w = m_Doc.PageWidth(m_CropPage)        h = m_Doc.PageHeight(m_CropPage)        If aw < 10 Or ah < 10 Or w <= 0 Or h <= 0 Then            m_CropPgRect = MakeRect(0, 0, 0, 0)        Else            sc = DMin(aw / w, ah / h)            pw = IMax(1, CLng(w * sc))            ph = IMax(1, CLng(h * sc))            m_CropPgRect = MakeRect((m_ClientW - pw) \ 2, top + Px(16) + (ah - ph) \ 2, (m_ClientW - pw) \ 2 + pw, top + Px(16) + (ah - ph) \ 2 + ph)        End If        ' Botones de la barra inferior (de derecha a izquierda)        bh = Px(30)        by = m_FullH - barH + (barH - bh) \ 2        x = m_ClientW - Px(16)        bw = Px(110)        m_CropBtnApply = MakeRect(x - bw, by, x, by + bh)        x = x - bw - Px(8)        m_CropBtnCancel = MakeRect(x - bw, by, x, by + bh)        x = x - bw - Px(8)        bw = Px(170)        m_CropBtnAuto = MakeRect(x - bw, by, x, by + bh)    End Sub    Private Function InRect(ByRef r As RECT, ByVal x As Long, ByVal y As Long) As Boolean        InRect = (x >= r.Left And x < r.Right And y >= r.Top And y < r.Bottom)    End Function    Private Function CropBtnAt(ByVal x As Long, ByVal y As Long) As Long        If InRect(m_CropBtnApply, x, y) Then            CropBtnAt = 1        ElseIf InRect(m_CropBtnCancel, x, y) Then            CropBtnAt = 2        ElseIf InRect(m_CropBtnAuto, x, y) Then            CropBtnAt = 3        End If    End Function    ' Rectangulo de recorte en pantalla.    Private Function CropScreenRect() As RECT        Dim r As RECT, w As Long, h As Long        r = m_CropPgRect        w = r.Right - r.Left        h = r.Bottom - r.Top        CropScreenRect = MakeRect(r.Left + CLng(m_CropL * w), r.Top + CLng(m_CropT * h), r.Left + CLng(m_CropR * w), r.Top + CLng(m_CropB * h))    End Function    ' Tirador bajo el punto: 11 sup-izq, 12 sup, 13 sup-der, 14 der,    ' 15 inf-der, 16 inf, 17 inf-izq, 18 izq; 2 = dentro; 0 = fuera.    Private Function CropHitTest(ByVal x As Long, ByVal y As Long) As Long        Dim r As RECT, t As Long, mx As Long, my As Long        r = CropScreenRect()        t = Px(7)        mx = (r.Left + r.Right) \ 2        my = (r.Top + r.Bottom) \ 2        If Abs(x - r.Left) <= t And Abs(y - r.Top) <= t Then CropHitTest = 11: Exit Function        If Abs(x - r.Right) <= t And Abs(y - r.Top) <= t Then CropHitTest = 13: Exit Function        If Abs(x - r.Right) <= t And Abs(y - r.Bottom) <= t Then CropHitTest = 15: Exit Function        If Abs(x - r.Left) <= t And Abs(y - r.Bottom) <= t Then CropHitTest = 17: Exit Function        If Abs(y - r.Top) <= t And x > r.Left And x < r.Right Then CropHitTest = 12: Exit Function        If Abs(x - r.Right) <= t And y > r.Top And y < r.Bottom Then CropHitTest = 14: Exit Function        If Abs(y - r.Bottom) <= t And x > r.Left And x < r.Right Then CropHitTest = 16: Exit Function        If Abs(x - r.Left) <= t And y > r.Top And y < r.Bottom Then CropHitTest = 18: Exit Function        If x > r.Left And x < r.Right And y > r.Top And y < r.Bottom Then CropHitTest = 2    End Function    Private Function CropCursorFor(ByVal Hit As Long) As Long        Select Case Hit            Case 11, 15: CropCursorFor = IDC_SIZENWSE            Case 13, 17: CropCursorFor = IDC_SIZENESW            Case 12, 16: CropCursorFor = IDC_SIZENS            Case 14, 18: CropCursorFor = IDC_SIZEWE            Case 2: CropCursorFor = IDC_SIZEALL            Case Else: CropCursorFor = IDC_CROSS        End Select    End Function    Private Sub CropFrac(ByVal x As Long, ByVal y As Long, ByRef fx As Double, ByRef fy As Double)        Dim r As RECT        r = m_CropPgRect        fx = DMax(0, DMin(1, (x - r.Left) / IMax(1, r.Right - r.Left)))        fy = DMax(0, DMin(1, (y - r.Top) / IMax(1, r.Bottom - r.Top)))    End Sub    Private Sub CropMouseDown(ByVal x As Long, ByVal y As Long)        Dim hit As Long, fx As Double, fy As Double        Select Case CropBtnAt(x, y)            Case 1: ApplyCrop: Exit Sub            Case 2: CancelCrop: Exit Sub            Case 3                If CropAutoRect() Then Invalidate                Exit Sub        End Select        hit = CropHitTest(x, y)        CropFrac x, y, fx, fy        If hit = 0 Then            ' Fuera del rectangulo: empezar uno nuevo (solo dentro de la pagina)            If Not InRect(m_CropPgRect, x, y) Then Exit Sub            m_CropDrag = 1            m_CropAX = fx            m_CropAY = fy            m_CropL = fx: m_CropR = fx: m_CropT = fy: m_CropB = fy        Else            m_CropDrag = hit            m_CropAX = fx            m_CropAY = fy            m_CropGrabL = m_CropL            m_CropGrabT = m_CropT        End If        SetCapture m_hWnd        Invalidate    End Sub    Private Sub CropMouseMove(ByVal x As Long, ByVal y As Long)        Dim fx As Double, fy As Double, w As Double, h As Double, b As Long        Const MINF As Double = 0.03        If m_CropDrag = 0 Then            b = CropBtnAt(x, y)            If b <> m_CropHotBtn Then                m_CropHotBtn = b                Invalidate            End If            Exit Sub        End If        CropFrac x, y, fx, fy        Select Case m_CropDrag            Case 1                m_CropL = DMin(m_CropAX, fx): m_CropR = DMax(m_CropAX, fx)                m_CropT = DMin(m_CropAY, fy): m_CropB = DMax(m_CropAY, fy)            Case 2                w = m_CropR - m_CropL                h = m_CropB - m_CropT                m_CropL = DMax(0, DMin(1 - w, m_CropGrabL + fx - m_CropAX))                m_CropT = DMax(0, DMin(1 - h, m_CropGrabT + fy - m_CropAY))                m_CropR = m_CropL + w                m_CropB = m_CropT + h            Case Else                If m_CropDrag = 11 Or m_CropDrag = 17 Or m_CropDrag = 18 Then m_CropL = DMin(fx, m_CropR - MINF)                If m_CropDrag = 13 Or m_CropDrag = 14 Or m_CropDrag = 15 Then m_CropR = DMax(fx, m_CropL + MINF)                If m_CropDrag = 11 Or m_CropDrag = 12 Or m_CropDrag = 13 Then m_CropT = DMin(fy, m_CropB - MINF)                If m_CropDrag = 15 Or m_CropDrag = 16 Or m_CropDrag = 17 Then m_CropB = DMax(fy, m_CropT + MINF)        End Select        Invalidate    End Sub    Private Sub CropMouseUp()        If m_CropDrag = 1 Then            ' Un clic sin arrastrar no deja un rectangulo vacio            If m_CropR - m_CropL < 0.03 Or m_CropB - m_CropT < 0.03 Then                If Not CropAutoRect() Then                    m_CropL = 0.05: m_CropT = 0.05: m_CropR = 0.95: m_CropB = 0.95                End If            End If        End If        m_CropDrag = 0        If GetCapture() = m_hWnd Then ReleaseCapture        Invalidate    End Sub    Private Sub DrawCropEditor(ByVal hdc As LongPtr, ByVal g As LongPtr)        Dim pr As RECT, cr As RECT, hdcG As LongPtr, br As LongPtr, pn As LongPtr, accentArgb As Long        Dim pw As Long, ph As Long, i As Long, hx As Single, hy As Single, hs As Single, info As String        Dim wmm As Double, hmm As Double, n As Long, idx() As Long, barTop As Long        If g = 0 Then Exit Sub        LayoutCrop        pr = m_CropPgRect        pw = pr.Right - pr.Left        ph = pr.Bottom - pr.Top        accentArgb = ArgbFromColorRef(ToColorRef(m_SelColor))        If pw > 0 And ph > 0 Then            ' Vista previa de la pagina            If m_CropDib Is Nothing Then Set m_CropDib = New PdfDib            If m_CropDib.Width <> pw Or m_CropDib.Height <> ph Then                If m_CropDib.EnsureSize(pw, ph) Then m_Doc.RenderTo m_CropPage, m_CropDib, 0, 0, pw, ph, 0, FPDF_ANNOT            End If            GpFillRoundRect g, pr.Left + Px(4), pr.Top + Px(4), pw, ph, Px(2), &H40000000            GdipGetDC g, hdcG            BitBlt hdcG, pr.Left, pr.Top, pw, ph, m_CropDib.hDC, 0, 0, SRCCOPY            GdipReleaseDC g, hdcG            ' Zona que se descarta, oscurecida            cr = CropScreenRect()            br = GpBrush(&H8C000000)            GdipFillRectangle g, br, pr.Left, pr.Top, pw, cr.Top - pr.Top            GdipFillRectangle g, br, pr.Left, cr.Bottom, pw, pr.Bottom - cr.Bottom            GdipFillRectangle g, br, pr.Left, cr.Top, cr.Left - pr.Left, cr.Bottom - cr.Top            GdipFillRectangle g, br, cr.Right, cr.Top, pr.Right - cr.Right, cr.Bottom - cr.Top            GdipDeleteBrush br            ' Guias de tercios y borde            pn = GpPen(&H60FFFFFF, 1)            For i = 1 To 2                GdipDrawLine g, pn, cr.Left + (cr.Right - cr.Left) * i / 3, cr.Top, cr.Left + (cr.Right - cr.Left) * i / 3, cr.Bottom                GdipDrawLine g, pn, cr.Left, cr.Top + (cr.Bottom - cr.Top) * i / 3, cr.Right, cr.Top + (cr.Bottom - cr.Top) * i / 3            Next            GdipDeletePen pn            pn = GpPen(accentArgb, 2)            GdipDrawRectangle g, pn, cr.Left, cr.Top, cr.Right - cr.Left, cr.Bottom - cr.Top            GdipDeletePen pn            ' Tiradores            hs = Px(9)            pn = GpPen(accentArgb, 1.5)            br = GpBrush(&HFFFFFFFF)            For i = 0 To 7                Select Case i                    Case 0: hx = cr.Left: hy = cr.Top                    Case 1: hx = (cr.Left + cr.Right) / 2: hy = cr.Top                    Case 2: hx = cr.Right: hy = cr.Top                    Case 3: hx = cr.Right: hy = (cr.Top + cr.Bottom) / 2                    Case 4: hx = cr.Right: hy = cr.Bottom                    Case 5: hx = (cr.Left + cr.Right) / 2: hy = cr.Bottom                    Case 6: hx = cr.Left: hy = cr.Bottom                    Case 7: hx = cr.Left: hy = (cr.Top + cr.Bottom) / 2                End Select                GdipFillRectangle g, br, hx - hs / 2, hy - hs / 2, hs, hs                GdipDrawRectangle g, pn, hx - hs / 2, hy - hs / 2, hs, hs            Next            GdipDeleteBrush br            GdipDeletePen pn        End If        ' Barra inferior: informacion y botones        barTop = m_FullH - Px(52)        br = GpBrush(ArgbFromColorRef(GetSysColor(COLOR_BTNFACE)))        GdipFillRectangle g, br, 0, barTop, m_ClientW, m_FullH - barTop        GdipDeleteBrush br        pn = GpPen(ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW)), 1)        GdipDrawLine g, pn, 0, barTop + 0.5, m_ClientW, barTop + 0.5        GdipDeletePen pn        n = TargetPages(idx)        wmm = (m_CropR - m_CropL) * m_Doc.PageWidth(m_CropPage) / 72 * 25.4        hmm = (m_CropB - m_CropT) * m_Doc.PageHeight(m_CropPage) / 72 * 25.4        info = Txt("Dibuja o ajusta el rect&aacute;ngulo  &mdash;  ") & Format$(wmm, "0") & " x " & Format$(hmm, "0") & " mm" & _               Txt("  &mdash;  se aplicar&aacute; a ") & CStr(n) & Txt(" p&aacute;gina(s)")        DrawGpText g, info, MakeRect(Px(16), barTop, m_CropBtnAuto.Left - Px(12), m_FullH), ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT)), True        DrawCropButton g, m_CropBtnAuto, "Ajustar al contenido", False, (m_CropHotBtn = 3)        DrawCropButton g, m_CropBtnCancel, "Cancelar", False, (m_CropHotBtn = 2)        DrawCropButton g, m_CropBtnApply, "Recortar", True, (m_CropHotBtn = 1)    End Sub    Private Sub DrawCropButton(ByVal g As LongPtr, ByRef r As RECT, ByVal Caption As String, ByVal Primary As Boolean, ByVal Hot As Boolean)        Dim accentRef As Long, fillArgb As Long, borderArgb As Long, textArgb As Long        If r.Right <= Px(16) Then Exit Sub        accentRef = ToColorRef(m_SelColor)        If Primary Then            fillArgb = ArgbFromColorRef(accentRef, IIf(Hot, &HD8, &HFF))            borderArgb = fillArgb            textArgb = &HFFFFFFFF        Else            fillArgb = IIf(Hot, &HFFF0F0F0, &HFFFFFFFF)            borderArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW))            textArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT))        End If        GpFillRoundRect g, r.Left + 0.5, r.Top + 0.5, r.Right - r.Left - 1, r.Bottom - r.Top - 1, Px(4), fillArgb, borderArgb, 1        DrawGpText g, Caption, r, textArgb, False, IIf(Primary, m_gpFontBold, m_gpFont)    End Sub    ' --- Dibujo ----------------------------------------------------------------    Private Sub OrgPageFit(ByVal p As Long, ByRef tw As Long, ByRef th As Long)        Dim w As Double, h As Double        w = RotW(p)        h = RotH(p)        tw = m_OrgCellW        th = CLng(m_OrgCellW * h / w)        If th > m_OrgBoxH Then            th = m_OrgBoxH            tw = CLng(m_OrgBoxH * w / h)        End If        tw = IMax(1, tw)        th = IMax(1, th)    End Sub    Private Function EnsureOrgThumb(ByVal p As Long, ByVal tw As Long, ByVal th As Long) As Boolean        Dim t As PdfDib        Set t = m_OrgThumb(p)        If Not t Is Nothing Then            If t.Width = tw And t.Height = th Then                EnsureOrgThumb = True                Exit Function            End If            ' Mientras se arrastra el control de tamano se reescala la existente            If m_SliderDrag Then                EnsureOrgThumb = True                Exit Function            End If        Else            Set t = New PdfDib        End If        If Not t.EnsureSize(tw, th) Then Exit Function        If Not m_Doc.RenderTo(p, t, 0, 0, tw, th, m_Rotation, FPDF_ANNOT) Then Exit Function        Set m_OrgThumb(p) = t        EnsureOrgThumb = True    End Function    Private Sub DrawOrganize(ByVal hdc As LongPtr)        Dim g As LongPtr, p As Long, top As Long, x As Long, y As Long, sx As Double, sy As Double        Dim firstVis As Long, lastVis As Long, accentRef As Long, pn As LongPtr, gap As Long, keep As Long        top = OrgTop()        accentRef = ToColorRef(m_SelColor)        gap = Px(ORG_GAP)        firstVis = -1        lastVis = -2        g = BeginGdip(hdc)        If m_CropMode Then            DrawCropEditor hdc, g            DrawOrgHeader g            If g <> 0 Then GdipDeleteGraphics g            Exit Sub        End If        ' Hueco de destino: recuadro punteado y barra de insercion        If m_OrgDragging And g <> 0 Then            SlotXY m_OrgDropIdx, sx, sy            sy = top + sy - m_OrgScroll            GpFillRoundRect g, sx - Px(4), sy - Px(4), m_OrgCellW + Px(8), m_OrgBoxH + Px(8), Px(6), ArgbFromColorRef(accentRef, &H30)            pn = GpPen(ArgbFromColorRef(accentRef), Px(2))            GdipSetPenDashStyle pn, DashStyleDash            Dim ph As LongPtr            ph = GpRoundRect(sx - Px(4), sy - Px(4), m_OrgCellW + Px(8), m_OrgBoxH + Px(8), Px(6))            If ph <> 0 Then                GdipDrawPath g, pn, ph                GdipDeletePath ph            End If            GdipDeletePen pn            pn = GpPen(ArgbFromColorRef(accentRef), Px(4))            GdipDrawLine g, pn, sx - gap / 2, sy, sx - gap / 2, sy + m_OrgBoxH            GdipDeletePen pn        End If        For p = 0 To m_Count - 1            If Not (m_OrgDragging And p = m_OrgDragPage) Then                x = CLng(m_OrgCurX(p))                y = top + CLng(m_OrgCurY(p)) - m_OrgScroll                If y + m_OrgBoxH + Px(ORG_LABEL_H) >= top And y <= m_FullH Then                    DrawOrgItem hdc, g, p, x, y, False                    If firstVis < 0 Then firstVis = p                    lastVis = p                End If            End If        Next        DrawOrgHeader g        ' Pagina arrastrada: por encima de todo, ampliada, con sombra y translucida        If m_OrgDragging Then DrawOrgItem hdc, g, m_OrgDragPage, m_OrgMouseX - m_OrgGrabDX, m_OrgMouseY - m_OrgGrabDY, True        If g <> 0 Then GdipDeleteGraphics g        ' Liberar miniaturas y paginas lejanas        keep = m_OrgCols * 3        For p = 0 To m_Count - 1            If (p < firstVis - keep Or p > lastVis + keep) And Not (m_OrgDragging And p = m_OrgDragPage) Then                If Not m_OrgThumb(p) Is Nothing Then Set m_OrgThumb(p) = Nothing            End If        Next        m_Doc.ReleasePagesExcept firstVis - 1, lastVis + 1    End Sub    Private Sub DrawOrgItem(ByVal hdc As LongPtr, ByVal g As LongPtr, ByVal p As Long, ByVal x As Long, ByVal y As Long, ByVal Floating As Boolean)        Dim tw As Long, th As Long, bx As Long, by As Long, dw As Long, dh As Long, off As Long        Dim accentRef As Long, hdcG As LongPtr, t As PdfDib, pn As LongPtr, r As RECT        accentRef = ToColorRef(m_SelColor)        OrgPageFit p, tw, th        dw = tw        dh = th        If Floating Then            dw = CLng(tw * 1.06)            dh = CLng(th * 1.06)        End If        bx = x + (m_OrgCellW - dw) \ 2        by = y + (m_OrgBoxH - dh) \ 2        If g <> 0 Then            If Not Floating Then                If OrgIsSel(p) Then                    GpFillRoundRect g, x - Px(6), y - Px(6), m_OrgCellW + Px(12), m_OrgBoxH + Px(ORG_LABEL_H) + Px(8), Px(6), ArgbFromColorRef(accentRef, &H30), ArgbFromColorRef(accentRef, IIf(p = m_OrgSel, &HFF, &HA0)), IIf(p = m_OrgSel, 2, 1.5)                ElseIf p = m_OrgHot And Not m_OrgDragging Then                    GpFillRoundRect g, x - Px(6), y - Px(6), m_OrgCellW + Px(12), m_OrgBoxH + Px(ORG_LABEL_H) + Px(8), Px(6), &H18000000                End If                ' Destello de la pagina recien colocada                If p = m_OrgFlashPage And m_OrgFlash > 0 Then                    GpFillRoundRect g, bx - Px(6), by - Px(6), dw + Px(12), dh + Px(12), Px(8), ArgbFromColorRef(accentRef, m_OrgFlash \ 2)                End If            End If            ' Sombra (mas marcada y desplazada si flota)            If Floating Then off = Px(9) Else off = Px(2)            GpFillRoundRect g, bx + off, by + off, dw, dh, Px(3), IIf(Floating, &H50000000, &H38000000)            If Floating Then GpFillRoundRect g, bx + off \ 2, by + off \ 2, dw, dh, Px(3), &H20000000        End If        ' Miniatura (GDI dentro de GDI+ mediante GdipGetDC)        If EnsureOrgThumb(p, tw, th) Then            Set t = m_OrgThumb(p)            hdcG = hdc            If g <> 0 Then GdipGetDC g, hdcG            If Floating Then                AlphaBlend hdcG, bx, by, dw, dh, t.hDC, 0, 0, t.Width, t.Height, 225 * &H10000            ElseIf t.Width = dw And t.Height = dh Then                BitBlt hdcG, bx, by, dw, dh, t.hDC, 0, 0, SRCCOPY            Else                SetStretchBltMode hdcG, HALFTONE                SetBrushOrgEx hdcG, 0, 0, 0                StretchBlt hdcG, bx, by, dw, dh, t.hDC, 0, 0, t.Width, t.Height, SRCCOPY            End If            If g <> 0 Then GdipReleaseDC g, hdcG        End If        If g <> 0 Then            If Floating Then                pn = GpPen(ArgbFromColorRef(accentRef), Px(2))            Else                pn = GpPen(ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW)), 1)            End If            GdipDrawRectangle g, pn, bx - 0.5, by - 0.5, dw, dh            GdipDeletePen pn            If Not Floating Then                r = MakeRect(x, y + m_OrgBoxH + Px(2), x + m_OrgCellW, y + m_OrgBoxH + Px(ORG_LABEL_H))                DrawGpText g, CStr(p + 1), r, ArgbFromColorRef(IIf(OrgIsSel(p), accentRef, GetSysColor(COLOR_BTNTEXT))), False, IIf(OrgIsSel(p), m_gpFontBold, m_gpFont)            End If        End If    End Sub    ' Coloca los botones de la cabecera de organizar y el control de tamano.    ' Los botones que no caben se ocultan (sus funciones siguen disponibles por codigo).    Private Sub LayoutOrgHeader()        Dim i As Long, x As Long, w As Long, bh As Long, top As Long, sh As Long, limit As Long        sh = Px(20)        m_SliderRect = MakeRect(m_ClientW - Px(16) - Px(150), m_ViewY + (Px(ORG_HEADER_H) - sh) \ 2, m_ClientW - Px(16), m_ViewY + (Px(ORG_HEADER_H) + sh) \ 2)        bh = Px(28)        top = m_ViewY + (Px(ORG_HEADER_H) - bh) \ 2        x = Px(16) + Px(140)                    ' tras el titulo        limit = m_SliderRect.Left - Px(72)      ' antes de "Tamano"        For i = 0 To m_TbCount - 1            If m_TbOrg(i) Then                w = Px(m_TbW(i))                If m_Organize And HasDoc() And x + w <= limit Then                    m_TbRect(i) = MakeRect(x, top, x + w, top + bh)                    x = x + w + Px(2)                Else                    m_TbRect(i) = MakeRect(0, 0, 0, 0)                End If            End If        Next    End Sub    ' Cabecera: titulo, botones de edicion, aviso de cambios y control de tamano.    Private Sub DrawOrgHeader(ByVal g As LongPtr)        Dim r As RECT, br As LongPtr, pn As LongPtr, hdrB As Long, w As Single, i As Long, xEnd As Long        Dim accentArgb As Long, textArgb As Long, frac As Double, kx As Single, cy As Single, lblR As RECT        If g = 0 Then Exit Sub        hdrB = OrgTop()        accentArgb = ArgbFromColorRef(ToColorRef(m_SelColor))        textArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT))        br = GpBrush(ArgbFromColorRef(GetSysColor(COLOR_BTNFACE)))        GdipFillRectangle g, br, 0, m_ViewY, m_ClientW, hdrB - m_ViewY        GdipDeleteBrush br        pn = GpPen(ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW)), 1)        GdipDrawLine g, pn, 0, hdrB - 0.5, m_ClientW, hdrB - 0.5        GdipDeletePen pn        ' Titulo        r = MakeRect(Px(16), m_ViewY, Px(16) + Px(136), hdrB)        DrawGpSegment g, Txt("Organizar p&aacute;ginas"), m_gpFontBold, r.Left, r.Top, r.Right - r.Left, r.Bottom - r.Top, textArgb        ' Botones (separadores incluidos)        xEnd = Px(16) + Px(140)        For i = 0 To m_TbCount - 1            If m_TbOrg(i) And m_TbRect(i).Right > m_TbRect(i).Left Then                r = m_TbRect(i)                If m_TbKind(i) = TBK_BUTTON Then                    DrawToolbarButton g, i, Px(4)                Else                    pn = GpPen(ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW)), 1)                    GdipDrawLine g, pn, (r.Left + r.Right) / 2, r.Top + Px(4), (r.Left + r.Right) / 2, r.Bottom - Px(4)                    GdipDeletePen pn                End If                xEnd = r.Right            End If        Next        ' Seleccion y aviso de cambios sin guardar (si hay sitio)        lblR = MakeRect(xEnd + Px(14), m_ViewY, m_SliderRect.Left - Px(72), hdrB)        If lblR.Right - lblR.Left > Px(60) Then            If m_Modified Then                br = GpBrush(ArgbFromColorRef(&H2080F0))                GdipFillEllipse g, br, lblR.Left, (m_ViewY + hdrB) / 2 - Px(3), Px(6), Px(6)                GdipDeleteBrush br                lblR.Left = lblR.Left + Px(12)                DrawGpText g, "Cambios sin guardar", lblR, ArgbFromColorRef(&H1060C0), True            Else                DrawGpText g, CStr(OrgSelCount()) & Txt(" seleccionada(s) &mdash; Ctrl/May&uacute;s para varias"), lblR, ArgbFromColorRef(GetSysColor(COLOR_GRAYTEXT)), True            End If        End If        ' Control de tamano: "Tamano" + pista + mando        lblR = MakeRect(m_SliderRect.Left - Px(64), m_ViewY, m_SliderRect.Left - Px(10), hdrB)        DrawGpText g, Txt("Tama&ntilde;o"), lblR, textArgb        cy = (m_SliderRect.Top + m_SliderRect.Bottom) / 2        frac = (m_OrgSize - ORG_MIN) / (ORG_MAX - ORG_MIN)        kx = m_SliderRect.Left + frac * (m_SliderRect.Right - m_SliderRect.Left)        pn = GpPen(ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW)), Px(4))        GdipDrawLine g, pn, m_SliderRect.Left, cy, m_SliderRect.Right, cy        GdipDeletePen pn        pn = GpPen(accentArgb, Px(4))        GdipDrawLine g, pn, m_SliderRect.Left, cy, kx, cy        GdipDeletePen pn        br = GpBrush(&HFFFFFFFF)        GdipFillEllipse g, br, kx - Px(8), cy - Px(8), Px(16), Px(16)        GdipDeleteBrush br        pn = GpPen(accentArgb, IIf(m_SliderDrag, 2.5, 1.5))        GdipDrawEllipse g, pn, kx - Px(8), cy - Px(8), Px(16), Px(16)        GdipDeletePen pn    End Sub    ' --- Informacion sobre herramientas ---------------------------------------    Private Function ToolbarTipText(ByVal Cmd As Long) As String        Select Case Cmd            Case CMD_OPEN: ToolbarTipText = "Abrir PDF (Ctrl+O)"            Case CMD_SAVE: ToolbarTipText = "Guardar como (Ctrl+S)"            Case CMD_THUMBS: ToolbarTipText = "Miniaturas"            Case CMD_SEARCHPANEL: ToolbarTipText = "Buscar (Ctrl+F)"            Case CMD_FIRST: ToolbarTipText = Txt("Primera p&aacute;gina")            Case CMD_PREV: ToolbarTipText = Txt("P&aacute;gina anterior")            Case CMD_NEXT: ToolbarTipText = Txt("P&aacute;gina siguiente")            Case CMD_LAST: ToolbarTipText = Txt("&Uacute;ltima p&aacute;gina")            Case CMD_ZOOMOUT: ToolbarTipText = "Reducir"            Case CMD_ZOOMIN: ToolbarTipText = "Ampliar"            Case CMD_FITWIDTH: ToolbarTipText = "Ajustar al ancho"            Case CMD_FITPAGE: ToolbarTipText = Txt("Ajustar p&aacute;gina")            Case CMD_PRINT: ToolbarTipText = "Imprimir"            Case CMD_ORGANIZE: ToolbarTipText = Txt("Organizar p&aacute;ginas")            Case CMD_FINDPREV: ToolbarTipText = "Resultado anterior"            Case CMD_FINDNEXT: ToolbarTipText = "Resultado siguiente"            Case CMD_ORG_UNDO: ToolbarTipText = "Deshacer (Ctrl+Z)"            Case CMD_ORG_REDO: ToolbarTipText = "Rehacer (Ctrl+Y)"            Case CMD_ORG_ROTL: ToolbarTipText = "Girar a la izquierda"            Case CMD_ORG_ROTR: ToolbarTipText = "Girar a la derecha"            Case CMD_ORG_DELETE: ToolbarTipText = Txt("Eliminar p&aacute;ginas (Supr)")            Case CMD_ORG_INSBLANK: ToolbarTipText = Txt("Insertar p&aacute;gina en blanco despu&eacute;s de la selecci&oacute;n")            Case CMD_ORG_INSFILE: ToolbarTipText = Txt("Insertar p&aacute;ginas desde archivo")            Case CMD_ORG_REPLACE: ToolbarTipText = Txt("Reemplazar p&aacute;ginas desde archivo")            Case CMD_ORG_EXTRACT: ToolbarTipText = Txt("Extraer p&aacute;ginas a un documento nuevo")            Case CMD_ORG_CROP: ToolbarTipText = Txt("Recortar p&aacute;ginas (dibujar un rect&aacute;ngulo)")        End Select    End Function    Private Sub DrawTooltip(ByVal hdc As LongPtr)        Dim g As LongPtr, t As String, r As RECT, w As Single, x As Single, y As Single, h As Single, pad As Single        If m_TbHot < 0 Or m_TbHot >= m_TbCount Then Exit Sub        t = ToolbarTipText(m_TbCmd(m_TbHot))        If Len(t) = 0 Then Exit Sub        g = BeginGdip(hdc)        If g = 0 Then Exit Sub        r = m_TbRect(m_TbHot)        pad = Px(8)        w = MeasureGpText(g, t, m_gpFont) + 2 * pad        h = Px(24)        x = r.Left        y = r.Bottom + Px(6)        If x + w > m_ClientW - Px(4) Then x = m_ClientW - Px(4) - w        If x < Px(4) Then x = Px(4)        GpFillRoundRect g, x + Px(2), y + Px(2), w, h, Px(4), &H28000000        GpFillRoundRect g, x, y, w, h, Px(4), &HFFFFFFF0, ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW)), 1        DrawGpSegment g, t, m_gpFont, x + pad, y, w - 2 * pad, h, ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT))        GdipDeleteGraphics g    End Sub    ' ========================================================================    '  APARTADO 4 - Integracion: DPI    ' ========================================================================    Private Sub UpdateDpi()        Dim d As Long, hdc As LongPtr        On Error Resume Next        d = GetDpiForWindow(m_hWnd)         ' Windows 10 1607+        On Error GoTo 0        If d <= 0 Then            hdc = GetDC(0)            d = GetDeviceCaps(hdc, LOGPIXELSX)            ReleaseDC 0, hdc        End If        If d <= 0 Then d = 96        If d = m_Dpi And m_hFont <> 0 Then Exit Sub        m_Dpi = d        If m_hFont <> 0 Then DeleteObject m_hFont        m_hFont = CreateFontW(-MulDiv(9, m_Dpi, 72), 0, 0, 0, 400, 0, 0, 0, 1, 0, 0, 5, 0, StrPtr("Segoe UI"))        If m_hEdit <> 0 Then SendMessageW m_hEdit, WM_SETFONT, m_hFont, 1        FreeGdipText    End Sub    Public Property Get Dpi() As Long        Dpi = m_Dpi    End Property    ' ========================================================================    '  APARTADO 4 - Integracion: propiedades    ' ========================================================================    Private Sub RefreshView(Optional ByVal UseAnchor As Boolean = True)        If m_hWnd <> 0 Then            RefreshLayout UseAnchor        Else            UserControl.Refresh        End If    End Sub    Public Property Get hWnd() As LongPtr        hWnd = UserControl.hWnd    End Property    Public Property Get Is64Bit() As Boolean        #If Win64 Then            Is64Bit = True        #End If    End Property    Public Property Get PdfiumLoadedFrom() As String        PdfiumLoadedFrom = PdfiumLoadedPath    End Property    Public Property Get IsLoaded() As Boolean        IsLoaded = HasDoc()    End Property    Public Property Get PageCount() As Long        If HasDoc() Then PageCount = m_Count    End Property    Public Property Get CurrentPage() As Long        If HasDoc() Then CurrentPage = m_CurPage + 1    End Property    Public Property Let CurrentPage(ByVal Value As Long)        GoToPage Value    End Property    ' Tamano de la pagina en puntos (1/72").    Public Function GetPageSize(ByVal Page As Long, ByRef Width As Double, ByRef Height As Double) As Boolean        If Not HasDoc() Or Page < 1 Or Page > m_Count Then Exit Function        Width = m_Doc.PageWidth(Page - 1)        Height = m_Doc.PageHeight(Page - 1)        GetPageSize = True    End Function    Public Property Get LastError() As Long        LastError = m_Doc.LastError    End Property    Public Property Get LastErrorText() As String        LastErrorText = m_Doc.LastErrorText    End Property    Public Property Get BackColor() As OLE_COLOR        BackColor = m_BackColor    End Property    Public Property Let BackColor(ByVal Value As OLE_COLOR)        m_BackColor = Value        PropertyChanged "BackColor"        Invalidate    End Property    Public Property Get ThumbnailBackColor() As OLE_COLOR        ThumbnailBackColor = m_ThumbBackColor    End Property    Public Property Let ThumbnailBackColor(ByVal Value As OLE_COLOR)        m_ThumbBackColor = Value        PropertyChanged "ThumbnailBackColor"        Invalidate    End Property    Public Property Get SelectionColor() As OLE_COLOR        SelectionColor = m_SelColor    End Property    Public Property Let SelectionColor(ByVal Value As OLE_COLOR)        m_SelColor = Value        PropertyChanged "SelectionColor"        Invalidate    End Property    Public Property Get SearchHighlightColor() As OLE_COLOR        SearchHighlightColor = m_FindColor    End Property    Public Property Let SearchHighlightColor(ByVal Value As OLE_COLOR)        m_FindColor = Value        PropertyChanged "SearchHighlightColor"        Invalidate    End Property    Public Property Get BorderStyle() As ucPdfBorderStyle        BorderStyle = m_BorderStyle    End Property    Public Property Let BorderStyle(ByVal Value As ucPdfBorderStyle)        m_BorderStyle = Value        PropertyChanged "BorderStyle"        Invalidate    End Property    Public Property Get PageGap() As Long        PageGap = m_PageGap    End Property    Public Property Let PageGap(ByVal Value As Long)        m_PageGap = IMax(0, IMin(Value, 200))        PropertyChanged "PageGap"        RefreshView    End Property    Public Property Get Zoom() As Double        Zoom = m_Zoom    End Property    Public Property Let Zoom(ByVal Value As Double)        If m_hWnd <> 0 Then            ZoomAt Value, ViewCenterX(), ViewCenterY()        Else            m_Zoom = ClampZoom(Value)            m_ZoomMode = pdfZoomCustom            PropertyChanged "Zoom"            PropertyChanged "ZoomMode"        End If    End Property    Public Property Get ZoomMode() As ucPdfZoomMode        ZoomMode = m_ZoomMode    End Property    Public Property Let ZoomMode(ByVal Value As ucPdfZoomMode)        m_ZoomMode = Value        PropertyChanged "ZoomMode"        RefreshView    End Property    Public Property Get Rotation() As ucPdfRotation        Rotation = m_Rotation    End Property    Public Property Let Rotation(ByVal Value As ucPdfRotation)        Value = Value And 3        If Value = m_Rotation Then Exit Property        m_Rotation = Value        PropertyChanged "Rotation"        RefreshView    End Property    Public Property Get ShowThumbnails() As Boolean        ShowThumbnails = m_ShowThumbs    End Property    Public Property Let ShowThumbnails(ByVal Value As Boolean)        m_ShowThumbs = Value        If Value Then m_ShowSearch = False        PropertyChanged "ShowThumbnails"        LayoutSearchEdit        RefreshView        EnsureThumbVisible m_CurPage    End Property    ' Panel de busqueda a la izquierda (sustituye a las miniaturas mientras esta abierto).    Public Property Get ShowSearchPanel() As Boolean        ShowSearchPanel = m_ShowSearch    End Property    Public Property Let ShowSearchPanel(ByVal Value As Boolean)        If Value = m_ShowSearch Then Exit Property        m_ShowSearch = Value        If Value Then m_ShowThumbs = False        PropertyChanged "ShowThumbnails"        RefreshView        LayoutSearchEdit        If Value Then            FocusSearchBox        ElseIf m_hEdit <> 0 Then            If GetFocus() = m_hEdit Then SetFocusAPI m_hWnd        End If    End Property    Public Property Get ThumbnailWidth() As Long        ThumbnailWidth = m_ThumbWidth    End Property    Public Property Let ThumbnailWidth(ByVal Value As Long)        m_ThumbWidth = IMax(48, IMin(Value, 600))        PropertyChanged "ThumbnailWidth"        RefreshView    End Property    Public Property Get CursorMode() As ucPdfCursorMode        CursorMode = m_CursorMode    End Property    Public Property Let CursorMode(ByVal Value As ucPdfCursorMode)        m_CursorMode = Value        PropertyChanged "CursorMode"    End Property    Public Property Get PdfiumPath() As String        PdfiumPath = m_PdfiumPath    End Property    Public Property Let PdfiumPath(ByVal Value As String)        m_PdfiumPath = Value        PropertyChanged "PdfiumPath"    End Property    Public Property Get FileName() As String        FileName = m_FileName    End Property    Public Property Let FileName(ByVal Value As String)        If m_UserMode And m_hWnd <> 0 Then            If Len(Value) > 0 Then LoadFile Value Else CloseDocument        Else            m_FileName = Value        End If        PropertyChanged "FileName"    End Property    Public Property Get EmptyText() As String        EmptyText = m_EmptyText    End Property    Public Property Let EmptyText(ByVal Value As String)        m_EmptyText = Value        PropertyChanged "EmptyText"        Invalidate    End Property    Public Sub Refresh()        RefreshView False    End SubEnd Class