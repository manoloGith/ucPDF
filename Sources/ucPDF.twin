' ============================================================================'  ucPDF.twin  -  Control de usuario visor de PDF (PDFium)''  IMPORTANTE: crea en el IDE un UserControl llamado "ucPDF" (Project > Add >'  UserControl), conserva los atributos que genera el IDE ([FormDesignerId],'  [ClassId], ...) y sustituye el resto del codigo por este archivo. El'  control no necesita controles hijos: todo se dibuja con GDI.''  Apartados:'   1. Base funcional  -> PdfiumApi.twin, PdfDocument.twin, PdfDib.twin'   2. Visor           -> navegacion, zoom, desplazamiento y redimensionado'                         con doble bufer y mosaicos (sin parpadeo ni artefactos)'   3. Herramientas    -> seleccion y busqueda de texto, miniaturas, impresion'   4. Integracion     -> eventos, propiedades de diseno, DPI, Win32/Win64' ============================================================================[Description("Visor de documentos PDF basado en PDFium")]Class ucPDF    ' ========================================================================    '  Eventos    ' ========================================================================    Public Event DocumentLoaded(ByVal PageCount As Long)    Public Event DocumentClosed()    Public Event LoadFailed(ByVal ErrorCode As Long, ByVal Description As String)    Public Event PageChanged(ByVal Page As Long)    Public Event ZoomChanged(ByVal Zoom As Double)    Public Event SelectionChanged()    Public Event SearchCompleted(ByVal Found As Boolean, ByVal Page As Long)    Public Event PageClick(ByVal Page As Long, ByVal PdfX As Double, ByVal PdfY As Double, ByVal Button As Long)    Public Event PrintProgress(ByVal Page As Long, ByVal PagesPrinted As Long, ByVal PagesTotal As Long, ByRef Cancel As Boolean)    Public Event ToolbarClick(ByVal Command As ucPdfToolbarCommand, ByRef Cancel As Boolean)    Public Event DocumentSaved(ByVal FileName As String)    ' ========================================================================    '  Constantes    ' ========================================================================    Private Const DEF_BACKCOLOR As Long = &H8000000C        ' vbApplicationWorkspace    Private Const DEF_THUMBBACKCOLOR As Long = &H8000000F   ' vbButtonFace    Private Const DEF_SELCOLOR As Long = &HD77800           ' azul (BGR)    Private Const DEF_FINDCOLOR As Long = &HFFFF&           ' amarillo (BGR)    Private Const DEF_ZOOM As Double = 100    Private Const DEF_PAGEGAP As Long = 12    Private Const DEF_THUMBWIDTH As Long = 160    Private Const DEF_EMPTYTEXT As String = "Sin documento"    Private Const MIN_ZOOM As Double = 5    Private Const MAX_ZOOM As Double = 6400    Private Const RENDER_FLAGS As Long = FPDF_ANNOT Or FPDF_LCD_TEXT    Private Const COLOR_BTNTEXT As Long = 18    Private Const ZOOM_STEP As Double = 25    ' Barra de herramientas: tipos de elemento y comandos    Private Const TB_HEIGHT As Long = 36    Private Const TBK_BUTTON As Long = 0    Private Const TBK_LABEL As Long = 1    Private Const TBK_EDIT As Long = 2    Private Const TBK_SEP As Long = 3    Private Const CMD_FIRST As Long = 1    Private Const CMD_PREV As Long = 2    Private Const CMD_PAGELABEL As Long = 3    Private Const CMD_NEXT As Long = 4    Private Const CMD_LAST As Long = 5    Private Const CMD_ZOOMOUT As Long = 6    Private Const CMD_ZOOMLABEL As Long = 7    Private Const CMD_ZOOMIN As Long = 8    Private Const CMD_SEARCHEDIT As Long = 9    Private Const CMD_FINDCOUNT As Long = 10    Private Const CMD_FINDNEXT As Long = 12    Private Const CMD_THUMBS As Long = 13    Private Const CMD_PRINT As Long = 14    Private Const CMD_FITWIDTH As Long = 15    Private Const CMD_FITPAGE As Long = 16    Private Const CMD_SEARCHPANEL As Long = 17    Private Const CMD_FINDPREV As Long = 18    Private Const CMD_OPEN As Long = 19    Private Const CMD_SAVE As Long = 20    Private Const CMD_SEPFILE As Long = 99      ' separador tras abrir/guardar (se oculta con ellos)    Private Const SEARCH_PANEL_MINWIDTH As Long = 260    Private Const RES_ITEM_H As Long = 46       ' alto logico de cada resultado    Private Const SNIP_BEFORE As Long = 24      ' caracteres de contexto antes    Private Const SNIP_AFTER As Long = 70       ' caracteres de contexto despues    Private Const CMD_SEP As Long = 0    ' ========================================================================    '  Propiedades persistentes    ' ========================================================================    Private m_BackColor As Long    Private m_ThumbBackColor As Long    Private m_SelColor As Long    Private m_FindColor As Long    Private m_BorderStyle As ucPdfBorderStyle    Private m_PageGap As Long    Private m_Zoom As Double    Private m_ZoomMode As ucPdfZoomMode    Private m_Rotation As ucPdfRotation    Private m_ShowThumbs As Boolean    Private m_ShowSearch As Boolean         ' panel de busqueda (excluyente con las miniaturas)    Private m_ThumbWidth As Long    Private m_CursorMode As ucPdfCursorMode    Private m_PdfiumPath As String    Private m_FileName As String    Private m_EmptyText As String    ' ========================================================================    '  Estado de ejecucion    ' ========================================================================    Private m_Doc As PdfDocument    Private m_Back As PdfDib    Private m_Solid As PdfDib    Private m_hWnd As LongPtr    Private m_UserMode As Boolean    Private m_Subclassed As Boolean    Private m_Dpi As Long    Private m_hFont As LongPtr    Private m_InLayout As Boolean    Private m_LockPage As Boolean    Private m_ZoomNotified As Double    ' Disposicion (coordenadas del documento en pixeles de dispositivo)    Private m_Count As Long    Private m_PX() As Long    Private m_PY() As Long    Private m_PW() As Long    Private m_PH() As Long    Private m_DocW As Long    Private m_DocH As Long    Private m_ScrollX As Long    Private m_ScrollY As Long    Private m_ClientW As Long    Private m_ClientH As Long    Private m_ViewX As Long    Private m_CurPage As Long    Private m_VisFirst As Long    Private m_VisLast As Long    ' Mosaicos renderizados (uno por pagina visible)    Private m_Tile() As PdfDib    Private m_TileX() As Long    Private m_TileY() As Long    Private m_TileKW() As Long    Private m_TileKH() As Long    Private m_TileRot() As Long    ' Miniaturas    Private m_Thumb() As PdfDib    Private m_ThumbRot() As Long    Private m_ThumbY() As Long    Private m_ThumbW() As Long    Private m_ThumbH() As Long    Private m_ThumbsH As Long    Private m_ThumbScroll As Long    Private m_ThumbVisFirst As Long    Private m_ThumbVisLast As Long    ' Ancla para conservar la posicion al hacer zoom / redimensionar    Private m_AnchorPage As Long    Private m_AnchorFX As Double    Private m_AnchorFY As Double    Private m_AnchorSX As Long    Private m_AnchorSY As Long    ' Seleccion de texto (A = inicio del arrastre, B = posicion actual)    Private m_HasSel As Boolean    Private m_Selecting As Boolean    Private m_SelAPage As Long    Private m_SelAChar As Long    Private m_SelBPage As Long    Private m_SelBChar As Long    ' Desplazamiento con la mano    Private m_Panning As Boolean    Private m_PanX As Long    Private m_PanY As Long    Private m_PanSX As Long    Private m_PanSY As Long    ' Busqueda (lista de todas las coincidencias del documento)    Private m_FindText As String    Private m_FindFlags As Long    Private m_FindPage As Long    Private m_FindIdx As Long    Private m_FindLen As Long    Private m_Searched As Boolean    Private m_MatchCount As Long    Private m_MatchPos As Long    Private m_MatchPage() As Long    Private m_MatchIdx() As Long    Private m_MatchLen() As Long    Private m_MatchPre() As String          ' extracto: texto anterior a la coincidencia    Private m_MatchHit() As String          ' extracto: texto encontrado    Private m_MatchPost() As String         ' extracto: texto posterior    Private m_ResRect As RECT               ' lista de resultados del panel de busqueda    Private m_ResScroll As Long    Private m_ResHot As Long    ' Barra de herramientas (dibujada con GDI+)    Private m_ShowToolbar As Boolean    Private m_ShowOpenBtn As Boolean    Private m_ShowSaveBtn As Boolean    Private m_LastDir As String             ' ultima carpeta usada en abrir/guardar    Private m_ViewY As Long                 ' alto de la barra = inicio vertical de la vista    Private m_FullH As Long                 ' alto total del area cliente    Private m_GdipOK As Boolean    Private m_gpFamily As LongPtr    Private m_gpFont As LongPtr    Private m_gpFormat As LongPtr    Private m_gpFormatLeft As LongPtr    Private m_gpFormatTypo As LongPtr       ' tipografico: mide y dibuja tramos sin relleno    Private m_gpFontBold As LongPtr    Private m_gpFontSmall As LongPtr    Private m_TbCount As Long    Private m_TbKind() As Long    Private m_TbCmd() As Long    Private m_TbW() As Long                 ' ancho logico (96 ppp)    Private m_TbRect() As RECT    Private m_TbPanel() As Boolean          ' True = elemento del panel de busqueda    Private m_TbHot As Long    Private m_TbDown As Long    Private m_TrackingLeave As Boolean    Private m_hEdit As LongPtr    Private m_EditIdx As Long               ' elemento del cuadro de busqueda    Private m_CountIdx As Long              ' elemento "Resultados de la busqueda"    Private m_EditSubclassed As Boolean    ' ========================================================================    '  Ciclo de vida del UserControl    ' ========================================================================    Private Sub UserControl_Initialize()        Set m_Doc = New PdfDocument        Set m_Back = New PdfDib        Set m_Solid = New PdfDib        m_Dpi = 96        m_FindPage = -1        m_VisLast = -2        m_ThumbVisLast = -2        m_TbHot = -1        m_TbDown = -1        m_MatchPos = -1        m_ResHot = -1        BuildToolbar        ApplyDefaults    End Sub    Private Sub ApplyDefaults()        m_BackColor = DEF_BACKCOLOR        m_ThumbBackColor = DEF_THUMBBACKCOLOR        m_SelColor = DEF_SELCOLOR        m_FindColor = DEF_FINDCOLOR        m_BorderStyle = pdfBorderNone        m_PageGap = DEF_PAGEGAP        m_Zoom = DEF_ZOOM        m_ZoomNotified = DEF_ZOOM        m_ZoomMode = pdfZoomFitWidth        m_Rotation = pdfRotate0        m_ShowThumbs = True        m_ThumbWidth = DEF_THUMBWIDTH        m_CursorMode = pdfCursorSelect        m_PdfiumPath = ""        m_FileName = ""        m_EmptyText = DEF_EMPTYTEXT        m_ShowToolbar = True        m_ShowOpenBtn = True        m_ShowSaveBtn = True    End Sub    Private Sub UserControl_InitProperties()        ApplyDefaults        StartRuntime    End Sub    Private Sub UserControl_ReadProperties(PropBag As PropertyBag)        Dim fn As String        With PropBag            m_BackColor = .ReadProperty("BackColor", DEF_BACKCOLOR)            m_ThumbBackColor = .ReadProperty("ThumbnailBackColor", DEF_THUMBBACKCOLOR)            m_SelColor = .ReadProperty("SelectionColor", DEF_SELCOLOR)            m_FindColor = .ReadProperty("SearchHighlightColor", DEF_FINDCOLOR)            m_BorderStyle = .ReadProperty("BorderStyle", pdfBorderNone)            m_PageGap = .ReadProperty("PageGap", DEF_PAGEGAP)            m_Zoom = ClampZoom(.ReadProperty("Zoom", DEF_ZOOM))            m_ZoomMode = .ReadProperty("ZoomMode", pdfZoomFitWidth)            m_Rotation = .ReadProperty("Rotation", pdfRotate0) And 3            m_ShowThumbs = .ReadProperty("ShowThumbnails", True)            m_ThumbWidth = .ReadProperty("ThumbnailWidth", DEF_THUMBWIDTH)            m_CursorMode = .ReadProperty("CursorMode", pdfCursorSelect)            m_PdfiumPath = .ReadProperty("PdfiumPath", "")            fn = .ReadProperty("FileName", "")            m_EmptyText = .ReadProperty("EmptyText", DEF_EMPTYTEXT)            m_ShowToolbar = .ReadProperty("ShowToolbar", True)            m_ShowOpenBtn = .ReadProperty("ShowOpenButton", True)            m_ShowSaveBtn = .ReadProperty("ShowSaveButton", True)        End With        m_ZoomNotified = m_Zoom        m_FileName = fn        StartRuntime        If m_UserMode And Len(fn) > 0 Then LoadFile fn    End Sub    Private Sub UserControl_WriteProperties(PropBag As PropertyBag)        With PropBag            .WriteProperty "BackColor", m_BackColor, DEF_BACKCOLOR            .WriteProperty "ThumbnailBackColor", m_ThumbBackColor, DEF_THUMBBACKCOLOR            .WriteProperty "SelectionColor", m_SelColor, DEF_SELCOLOR            .WriteProperty "SearchHighlightColor", m_FindColor, DEF_FINDCOLOR            .WriteProperty "BorderStyle", m_BorderStyle, pdfBorderNone            .WriteProperty "PageGap", m_PageGap, DEF_PAGEGAP            .WriteProperty "Zoom", m_Zoom, DEF_ZOOM            .WriteProperty "ZoomMode", m_ZoomMode, pdfZoomFitWidth            .WriteProperty "Rotation", m_Rotation, pdfRotate0            .WriteProperty "ShowThumbnails", m_ShowThumbs, True            .WriteProperty "ThumbnailWidth", m_ThumbWidth, DEF_THUMBWIDTH            .WriteProperty "CursorMode", m_CursorMode, pdfCursorSelect            .WriteProperty "PdfiumPath", m_PdfiumPath, ""            .WriteProperty "FileName", m_FileName, ""            .WriteProperty "EmptyText", m_EmptyText, DEF_EMPTYTEXT            .WriteProperty "ShowToolbar", m_ShowToolbar, True            .WriteProperty "ShowOpenButton", m_ShowOpenBtn, True            .WriteProperty "ShowSaveButton", m_ShowSaveBtn, True        End With    End Sub    ' En ejecucion se subclasifica la ventana para pintar con doble bufer,    ' gestionar barras de desplazamiento, rueda del raton, teclado y DPI.    Private Sub StartRuntime()        m_UserMode = True        On Error Resume Next        m_UserMode = Ambient.UserMode        On Error GoTo 0        If Not m_UserMode Then Exit Sub        If m_hWnd <> 0 Then Exit Sub        m_hWnd = UserControl.hWnd        ' WS_CLIPCHILDREN: el doble bufer no pinta encima del cuadro de busqueda.        SetWindowLongPtrW m_hWnd, GWL_STYLE, GetWindowLongPtrW(m_hWnd, GWL_STYLE) Or WS_CLIPCHILDREN        m_GdipOK = GdipAcquire()        UpdateDpi        m_Subclassed = (SetWindowSubclass(m_hWnd, ucPdfSubclassAddress(), 1, ObjPtr(Me)) <> 0)        CreateSearchEdit        RefreshLayout False    End Sub    Private Sub StopSubclass()        StopEditSubclass        If m_Subclassed Then            RemoveWindowSubclass m_hWnd, ucPdfSubclassAddress(), 1            m_Subclassed = False        End If    End Sub    Private Sub StopEditSubclass()        If m_EditSubclassed Then            RemoveWindowSubclass m_hEdit, ucPdfSubclassAddress(), 2            m_EditSubclassed = False        End If    End Sub    Private Sub UserControl_Terminate()        StopSubclass        EraseCaches        If Not m_Doc Is Nothing Then m_Doc.CloseDocument        Set m_Doc = Nothing        Set m_Back = Nothing        Set m_Solid = Nothing        If m_hEdit <> 0 Then DestroyWindow m_hEdit        m_hEdit = 0        If m_hFont <> 0 Then DeleteObject m_hFont        m_hFont = 0        FreeGdipText        If m_GdipOK Then GdipRelease        m_GdipOK = False    End Sub    ' Solo en diseno (o si la subclasificacion no esta activa).    Private Sub UserControl_Paint()        If m_Subclassed Then Exit Sub        DrawDesignPlaceholder UserControl.hDC    End Sub    Private Sub UserControl_Resize()        If Not m_Subclassed Then UserControl.Refresh    End Sub    ' ========================================================================    '  Procedimiento de ventana (llamado desde ucPdfSubclassProc)    ' ========================================================================    Friend Function zWindowProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr        Dim pt As POINTAPI        On Error GoTo Failed        If hWnd = m_hEdit And m_hEdit <> 0 Then            zWindowProc = EditWindowProc(hWnd, uMsg, wParam, lParam)            Exit Function        End If        Select Case uMsg            Case WM_ERASEBKGND                zWindowProc = 1                Exit Function            Case WM_CTLCOLOREDIT, WM_CTLCOLORSTATIC                ' Fondo blanco para el cuadro de busqueda (si no, hereda el del UserControl).                If lParam = m_hEdit And m_hEdit <> 0 Then                    SetBkColor wParam, &HFFFFFF                    SetTextColor wParam, &H0&                    zWindowProc = GetStockObject(WHITE_BRUSH)                    Exit Function                End If            Case WM_PAINT                OnPaint hWnd                Exit Function            Case WM_SIZE                RefreshLayout True            Case WM_DPICHANGED_AFTERPARENT                UpdateDpi                RefreshLayout True            Case WM_GETDLGCODE                zWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam) Or DLGC_WANTARROWS                Exit Function            Case WM_VSCROLL                OnScrollMessage SB_VERT, LoWordS(wParam) And &HFFFF&                Exit Function            Case WM_HSCROLL                OnScrollMessage SB_HORZ, LoWordS(wParam) And &HFFFF&                Exit Function            Case WM_MOUSEWHEEL, WM_MOUSEHWHEEL                pt.X = LoWordS(lParam)                pt.Y = HiWordS(lParam)                ScreenToClient hWnd, pt                OnMouseWheel HiWordS(wParam), LoWordS(wParam) And &HFFFF&, pt.X, pt.Y, (uMsg = WM_MOUSEHWHEEL)                Exit Function            Case WM_LBUTTONDOWN                OnMouseDown LoWordS(lParam), HiWordS(lParam), vbLeftButton, LoWordS(wParam) And &HFFFF&            Case WM_RBUTTONDOWN                OnMouseDown LoWordS(lParam), HiWordS(lParam), vbRightButton, LoWordS(wParam) And &HFFFF&            Case WM_MBUTTONDOWN                OnMouseDown LoWordS(lParam), HiWordS(lParam), vbMiddleButton, LoWordS(wParam) And &HFFFF&            Case WM_LBUTTONDBLCLK                OnDoubleClick LoWordS(lParam), HiWordS(lParam)            Case WM_MOUSEMOVE                OnMouseMove LoWordS(lParam), HiWordS(lParam)            Case WM_LBUTTONUP, WM_MBUTTONUP                OnMouseUp LoWordS(lParam), HiWordS(lParam)            Case WM_MOUSELEAVE                m_TrackingLeave = False                SetToolbarHot -1                SetResultHot -1            Case WM_CAPTURECHANGED                If lParam <> hWnd Then EndDrag            Case WM_SETCURSOR                ' Solo para la propia ventana: el cuadro de busqueda usa su cursor.                If wParam = hWnd And (LoWordS(lParam) And &HFFFF&) = HTCLIENT Then                    If OnSetCursor() Then                        zWindowProc = 1                        Exit Function                    End If                End If            Case WM_KEYDOWN                OnKeyDown CLng(wParam And &HFFFF&)            Case WM_NCDESTROY                StopSubclass        End Select        zWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)        Exit Function    Failed:        zWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)    End Function    ' ========================================================================    '  APARTADO 1 - Base funcional: carga del documento    ' ========================================================================    Public Function LoadFile(ByVal FileName As String, Optional ByVal Password As String) As Boolean        CloseDocument        If Not m_Doc.OpenFile(FileName, Password, m_PdfiumPath) Then            RaiseEvent LoadFailed(m_Doc.LastError, m_Doc.LastErrorText)            Exit Function        End If        m_FileName = FileName        If Len(PathFolder(FileName)) > 0 Then m_LastDir = PathFolder(FileName)        OnDocumentOpened        LoadFile = True    End Function    Public Function LoadFromBytes(ByRef Data() As Byte, Optional ByVal Password As String) As Boolean        CloseDocument        If Not m_Doc.OpenBytes(Data, Password, m_PdfiumPath) Then            RaiseEvent LoadFailed(m_Doc.LastError, m_Doc.LastErrorText)            Exit Function        End If        m_FileName = ""        OnDocumentOpened        LoadFromBytes = True    End Function    Public Sub CloseDocument()        Dim wasOpen As Boolean        wasOpen = HasDoc()        EraseCaches        If Not m_Doc Is Nothing Then m_Doc.CloseDocument        m_Count = 0        m_FileName = ""        m_ScrollX = 0        m_ScrollY = 0        m_ThumbScroll = 0        m_CurPage = 0        ResetInteraction        RefreshLayout False        If wasOpen Then RaiseEvent DocumentClosed    End Sub    Private Sub OnDocumentOpened()        Dim n As Long        m_Count = m_Doc.PageCount        n = IMax(m_Count - 1, 0)        ReDim m_PX(0 To n): ReDim m_PY(0 To n): ReDim m_PW(0 To n): ReDim m_PH(0 To n)        ReDim m_Tile(0 To n): ReDim m_TileX(0 To n): ReDim m_TileY(0 To n)        ReDim m_TileKW(0 To n): ReDim m_TileKH(0 To n): ReDim m_TileRot(0 To n)        ReDim m_Thumb(0 To n): ReDim m_ThumbRot(0 To n)        ReDim m_ThumbY(0 To n): ReDim m_ThumbW(0 To n): ReDim m_ThumbH(0 To n)        m_ScrollX = 0        m_ScrollY = 0        m_ThumbScroll = 0        m_CurPage = 0        ResetInteraction        RefreshLayout False        RaiseEvent DocumentLoaded(m_Count)        RaiseEvent PageChanged(1)    End Sub    Private Sub ResetInteraction()        m_HasSel = False        m_Selecting = False        m_Panning = False        m_FindText = ""        m_FindPage = -1        m_FindIdx = -1        m_FindLen = 0        m_Searched = False        m_MatchCount = 0        m_MatchPos = -1    End Sub    Private Sub EraseCaches()        Erase m_Tile        Erase m_Thumb    End Sub    Private Function HasDoc() As Boolean        If m_Doc Is Nothing Then Exit Function        HasDoc = (m_Count > 0 And m_Doc.IsOpen)    End Function    ' ========================================================================    '  APARTADO 2 - Visor: disposicion, zoom y desplazamiento    ' ========================================================================    Private Function Px(ByVal LogicalPixels As Long) As Long        Px = MulDiv(LogicalPixels, m_Dpi, 96)    End Function    Private Function PxPerPt() As Double        PxPerPt = (m_Zoom / 100#) * (m_Dpi / 72#)    End Function    Private Function ClampZoom(ByVal z As Double) As Double        If z < MIN_ZOOM Then z = MIN_ZOOM        If z > MAX_ZOOM Then z = MAX_ZOOM        ClampZoom = z    End Function    ' Tamano de pagina en puntos teniendo en cuenta la rotacion.    Private Function RotW(ByVal i As Long) As Double        If (m_Rotation And 1) <> 0 Then RotW = m_Doc.PageHeight(i) Else RotW = m_Doc.PageWidth(i)    End Function    Private Function RotH(ByVal i As Long) As Double        If (m_Rotation And 1) <> 0 Then RotH = m_Doc.PageWidth(i) Else RotH = m_Doc.PageHeight(i)    End Function    Private Sub ReadClientSize()        Dim rc As RECT        If m_hWnd = 0 Then Exit Sub        GetClientRect m_hWnd, rc        ' m_ClientH es el alto de la vista de paginas (sin la barra de herramientas).        m_ClientW = rc.Right - rc.Left        m_FullH = rc.Bottom - rc.Top        If m_ShowToolbar Then m_ViewY = IMin(Px(TB_HEIGHT), m_FullH) Else m_ViewY = 0        m_ClientH = IMax(0, m_FullH - m_ViewY)    End Sub    ' Panel lateral izquierdo: miniaturas o busqueda.    Private Function PanelVisible() As Boolean        PanelVisible = (m_ShowThumbs Or m_ShowSearch) And HasDoc()    End Function    Private Function PanelWidthLogical() As Long        If m_ShowSearch Then            PanelWidthLogical = IMax(m_ThumbWidth, SEARCH_PANEL_MINWIDTH)        Else            PanelWidthLogical = m_ThumbWidth        End If    End Function    Private Sub LayoutPages()        Dim i As Long, gap As Long, y As Long, maxW As Long, s As Double        Dim viewW As Long, viewH As Long, maxWpt As Double, idx As Long        If PanelVisible() Then            m_ViewX = IMax(0, IMin(Px(PanelWidthLogical()), m_ClientW \ 2))        Else            m_ViewX = 0        End If        If Not HasDoc() Then            m_DocW = 0            m_DocH = 0            Exit Sub        End If        gap = Px(m_PageGap)        viewW = IMax(1, m_ClientW - m_ViewX - 2 * gap - Px(4))        viewH = IMax(1, m_ClientH - 2 * gap - Px(4))        Select Case m_ZoomMode            Case pdfZoomFitWidth                For i = 0 To m_Count - 1                    maxWpt = DMax(maxWpt, RotW(i))                Next                m_Zoom = ClampZoom(viewW / (maxWpt * m_Dpi / 72#) * 100#)            Case pdfZoomFitPage                idx = IMax(0, IMin(m_CurPage, m_Count - 1))                m_Zoom = ClampZoom(DMin(viewW / (RotW(idx) * m_Dpi / 72#), viewH / (RotH(idx) * m_Dpi / 72#)) * 100#)        End Select        s = PxPerPt()        y = gap        For i = 0 To m_Count - 1            m_PW(i) = IMax(1, CLng(RotW(i) * s))            m_PH(i) = IMax(1, CLng(RotH(i) * s))            m_PY(i) = y            y = y + m_PH(i) + gap            If m_PW(i) > maxW Then maxW = m_PW(i)        Next        m_DocW = maxW + 2 * gap        m_DocH = y        For i = 0 To m_Count - 1            m_PX(i) = (m_DocW - m_PW(i)) \ 2        Next    End Sub    Private Sub LayoutThumbs()        Dim i As Long, y As Long, tw As Long, margin As Long, labelH As Long        m_ThumbsH = 0        If Not (m_ShowThumbs And HasDoc()) Then Exit Sub        margin = Px(10)        labelH = Px(18)        tw = IMax(Px(16), m_ViewX - 2 * margin - Px(6))        y = margin        For i = 0 To m_Count - 1            m_ThumbW(i) = tw            m_ThumbH(i) = IMax(1, CLng(tw * RotH(i) / RotW(i)))            If m_ThumbH(i) > tw * 2 Then                ' paginas muy alargadas: limitar la altura y estrechar                m_ThumbH(i) = tw * 2                m_ThumbW(i) = IMax(1, CLng(m_ThumbH(i) * RotW(i) / RotH(i)))            End If            m_ThumbY(i) = y            y = y + m_ThumbH(i) + labelH + margin        Next        m_ThumbsH = y        ClampThumbScroll    End Sub    Private Function OriginX() As Long        Dim viewW As Long        viewW = m_ClientW - m_ViewX        If m_DocW <= viewW Then            OriginX = m_ViewX + (viewW - m_DocW) \ 2        Else            OriginX = m_ViewX - m_ScrollX        End If    End Function    Private Function OriginY() As Long        If m_DocH <= m_ClientH Then            OriginY = m_ViewY + (m_ClientH - m_DocH) \ 2        Else            OriginY = m_ViewY - m_ScrollY        End If    End Function    Private Sub ClampScroll()        m_ScrollX = IMax(0, IMin(m_ScrollX, m_DocW - (m_ClientW - m_ViewX)))        m_ScrollY = IMax(0, IMin(m_ScrollY, m_DocH - m_ClientH))    End Sub    Private Sub ClampThumbScroll()        m_ThumbScroll = IMax(0, IMin(m_ThumbScroll, m_ThumbsH - m_ClientH))    End Sub    ' Pagina mas cercana a una coordenada Y de pantalla.    Private Function PageNearestY(ByVal sy As Long) As Long        Dim i As Long, dy As Long, half As Long        If Not HasDoc() Then            PageNearestY = -1            Exit Function        End If        dy = sy - OriginY()        half = Px(m_PageGap) \ 2        For i = 0 To m_Count - 1            If dy < m_PY(i) + m_PH(i) + half Then                PageNearestY = i                Exit Function            End If        Next        PageNearestY = m_Count - 1    End Function    ' Pagina que contiene el punto de pantalla (-1 si ninguna).    Private Function PageAtPoint(ByVal x As Long, ByVal y As Long) As Long        Dim i As Long, ox As Long, oy As Long        PageAtPoint = -1        If Not HasDoc() Or x < m_ViewX Or y < m_ViewY Then Exit Function        ox = OriginX()        oy = OriginY()        i = PageNearestY(y)        If i < 0 Then Exit Function        If x >= ox + m_PX(i) And x < ox + m_PX(i) + m_PW(i) And y >= oy + m_PY(i) And y < oy + m_PY(i) + m_PH(i) Then PageAtPoint = i    End Function    Private Sub CaptureAnchor(ByVal sx As Long, ByVal sy As Long)        Dim i As Long        m_AnchorSX = sx        m_AnchorSY = sy        i = PageNearestY(sy)        m_AnchorPage = i        If i < 0 Then Exit Sub        m_AnchorFX = (sx - (OriginX() + m_PX(i))) / m_PW(i)        m_AnchorFY = (sy - (OriginY() + m_PY(i))) / m_PH(i)    End Sub    Private Sub RestoreAnchor()        Dim i As Long        i = m_AnchorPage        If i >= 0 And i < m_Count Then            m_ScrollX = CLng(m_ViewX + m_PX(i) + m_AnchorFX * m_PW(i) - m_AnchorSX)            m_ScrollY = CLng(m_PY(i) + m_AnchorFY * m_PH(i) - m_AnchorSY)        End If        ClampScroll    End Sub    ' Recalcula la disposicion completa. Si UseAnchor es True, el punto de    ' pantalla (ax, ay) sigue mostrando el mismo punto del documento.    ' Por defecto el ancla es el borde superior y el centro horizontal.    Private Sub RefreshLayout(ByVal UseAnchor As Boolean, Optional ByVal ax As Long = -1, Optional ByVal ay As Long = -1)        Dim pass As Long, w0 As Long, h0 As Long        If m_hWnd = 0 Or m_InLayout Then Exit Sub        m_InLayout = True        UseAnchor = UseAnchor And HasDoc() And m_DocH > 0        If UseAnchor Then            If ax < 0 Then ax = m_ViewX + (m_ClientW - m_ViewX) \ 2            If ay < 0 Then ay = m_ViewY            CaptureAnchor ax, ay        End If        ' Las barras de desplazamiento cambian el area cliente: se repite        ' hasta que el tamano se estabiliza.        For pass = 1 To 4            ReadClientSize            w0 = m_ClientW            h0 = m_ClientH            LayoutPages            If UseAnchor Then RestoreAnchor Else ClampScroll            UpdateScrollBars            ReadClientSize            If m_ClientW = w0 And m_ClientH = h0 Then Exit For        Next        LayoutThumbs        LayoutToolbar        m_InLayout = False        UpdateCurrentPage        Invalidate        If Abs(m_Zoom - m_ZoomNotified) > 0.0001 Then            m_ZoomNotified = m_Zoom            RaiseEvent ZoomChanged(m_Zoom)        End If    End Sub    Private Sub UpdateScrollBars()        Dim si As SCROLLINFO, viewW As Long        If m_hWnd = 0 Then Exit Sub        si.cbSize = LenB(si)        si.fMask = SIF_RANGE Or SIF_PAGE Or SIF_POS        If HasDoc() And m_DocH > m_ClientH Then            si.nMax = m_DocH - 1            si.nPage = m_ClientH            si.nPos = m_ScrollY        Else            si.nMax = 0            si.nPage = 1            si.nPos = 0        End If        SetScrollInfo m_hWnd, SB_VERT, si, 1        viewW = m_ClientW - m_ViewX        If HasDoc() And m_DocW > viewW Then            si.nMax = m_DocW - 1            si.nPage = IMax(1, viewW)            si.nPos = m_ScrollX        Else            si.nMax = 0            si.nPage = 1            si.nPos = 0        End If        SetScrollInfo m_hWnd, SB_HORZ, si, 1    End Sub    Private Sub OnScrollMessage(ByVal Bar As Long, ByVal Code As Long)        Dim si As SCROLLINFO, pos As Long, lineStep As Long, pageStep As Long        si.cbSize = LenB(si)        si.fMask = SIF_ALL        GetScrollInfo m_hWnd, Bar, si        pos = si.nPos        lineStep = Px(40)        pageStep = IMax(lineStep, CLng(si.nPage) - lineStep)        Select Case Code            Case SB_LINEUP: pos = pos - lineStep            Case SB_LINEDOWN: pos = pos + lineStep            Case SB_PAGEUP: pos = pos - pageStep            Case SB_PAGEDOWN: pos = pos + pageStep            Case SB_THUMBTRACK, SB_THUMBPOSITION: pos = si.nTrackPos            Case SB_TOP: pos = 0            Case SB_BOTTOM: pos = si.nMax            Case Else: Exit Sub        End Select        If Bar = SB_VERT Then ScrollTo m_ScrollX, pos Else ScrollTo pos, m_ScrollY    End Sub    Private Sub UpdateCurrentPage()        Dim i As Long, best As Long, bestVis As Long, t As Long, b As Long, vis As Long, oy As Long        If m_LockPage Or Not HasDoc() Then Exit Sub        best = -1        bestVis = -1        oy = OriginY()        For i = 0 To m_Count - 1            t = oy + m_PY(i)            If t > m_ViewY + m_ClientH Then Exit For            b = t + m_PH(i)            vis = IMin(b, m_ViewY + m_ClientH) - IMax(t, m_ViewY)            If vis > bestVis Then                bestVis = vis                best = i            End If        Next        If best < 0 Then best = 0        SetCurrentPage best    End Sub    Private Sub SetCurrentPage(ByVal i As Long)        If i = m_CurPage Then Exit Sub        m_CurPage = i        EnsureThumbVisible i        RaiseEvent PageChanged(i + 1)    End Sub    Private Sub Invalidate()        If m_hWnd <> 0 Then            InvalidateRect m_hWnd, 0, 0        ElseIf Not m_UserMode Then            UserControl.Refresh        End If    End Sub    Private Sub ZoomAt(ByVal NewZoom As Double, ByVal ax As Long, ByVal ay As Long)        Dim modeChanged As Boolean        NewZoom = ClampZoom(NewZoom)        modeChanged = (m_ZoomMode <> pdfZoomCustom)        m_ZoomMode = pdfZoomCustom        If Abs(NewZoom - m_Zoom) < 0.0001 And Not modeChanged Then Exit Sub        m_Zoom = NewZoom        RefreshLayout True, ax, ay        PropertyChanged "Zoom"        PropertyChanged "ZoomMode"    End Sub    Private Function ViewCenterY() As Long        ViewCenterY = m_ViewY + m_ClientH \ 2    End Function    Private Function ViewCenterX() As Long        ViewCenterX = m_ViewX + (m_ClientW - m_ViewX) \ 2    End Function    ' Siguiente tramo de ZOOM_STEP (25 %): desde 110 % sube a 125 % y baja a 100 %.    ' Nunca baja de un tramo (25 %).    Private Function NextZoomStep(ByVal z As Double, ByVal Up As Boolean) As Double        Dim k As Double        If Up Then            k = Int(z / ZOOM_STEP + 0.0001) + 1        Else            k = -Int(-(z / ZOOM_STEP) + 0.0001) - 1            If k < 1 Then k = 1        End If        NextZoomStep = ClampZoom(k * ZOOM_STEP)        ' Por debajo del primer tramo, reducir no debe ampliar.        If Not Up And NextZoomStep > z Then NextZoomStep = z    End Function    ' --- API publica del visor ----------------------------------------------    Public Sub GoToPage(ByVal Page As Long)        Dim i As Long        If Not HasDoc() Then Exit Sub        i = IMax(0, IMin(Page - 1, m_Count - 1))        m_LockPage = True        ScrollTo m_ScrollX, m_PY(i) - Px(m_PageGap)        m_LockPage = False        SetCurrentPage i        Invalidate    End Sub    Public Sub NextPage()        GoToPage m_CurPage + 2    End Sub    Public Sub PreviousPage()        GoToPage m_CurPage    End Sub    Public Sub FirstPage()        GoToPage 1    End Sub    Public Sub LastPage()        GoToPage m_Count    End Sub    Public Sub ZoomIn()        ZoomAt NextZoomStep(m_Zoom, True), ViewCenterX(), ViewCenterY()    End Sub    Public Sub ZoomOut()        ZoomAt NextZoomStep(m_Zoom, False), ViewCenterX(), ViewCenterY()    End Sub    Public Sub RotateClockwise()        Rotation = (m_Rotation + 1) And 3    End Sub    Public Sub RotateCounterClockwise()        Rotation = (m_Rotation + 3) And 3    End Sub    ' Desplaza la vista a la posicion indicada (pixeles de dispositivo).    Public Sub ScrollTo(ByVal X As Long, ByVal Y As Long)        Dim ox As Long, oy As Long, si As SCROLLINFO        ox = m_ScrollX        oy = m_ScrollY        m_ScrollX = X        m_ScrollY = Y        ClampScroll        If ox = m_ScrollX And oy = m_ScrollY Then Exit Sub        If m_hWnd <> 0 Then            si.cbSize = LenB(si)            si.fMask = SIF_POS            si.nPos = m_ScrollY            SetScrollInfo m_hWnd, SB_VERT, si, 1            si.nPos = m_ScrollX            SetScrollInfo m_hWnd, SB_HORZ, si, 1        End If        UpdateCurrentPage        Invalidate        If m_hWnd <> 0 Then UpdateWindow m_hWnd    End Sub    Public Property Get ScrollX() As Long        ScrollX = m_ScrollX    End Property    Public Property Get ScrollY() As Long        ScrollY = m_ScrollY    End Property    ' ========================================================================    '  Pintado (doble bufer + mosaicos)    ' ========================================================================    Private Sub OnPaint(ByVal hWnd As LongPtr)        Dim ps As PAINTSTRUCT, hdc As LongPtr        hdc = BeginPaint(hWnd, ps)        On Error Resume Next        RenderFrame        If m_Back.IsValid Then BitBlt hdc, 0, 0, m_ClientW, m_FullH, m_Back.hDC, 0, 0, SRCCOPY        On Error GoTo 0        EndPaint hWnd, ps    End Sub    Private Sub RenderFrame()        Dim rc As RECT        ReadClientSize        If m_ClientW <= 0 Or m_FullH <= 0 Then Exit Sub        If Not m_Back.EnsureSize(m_ClientW, m_FullH) Then Exit Sub        rc = MakeRect(0, m_ViewY, m_ClientW, m_FullH)        FillSolid m_Back.hDC, rc, ToColorRef(m_BackColor)        If HasDoc() Then            DrawPages m_Back.hDC            If m_ShowSearch Then                DrawSearchPanel m_Back.hDC            ElseIf m_ShowThumbs Then                DrawThumbnails m_Back.hDC            End If            ReleaseUnused        Else            DrawLabel m_Back.hDC, rc, m_EmptyText, GetSysColor(COLOR_BTNFACE)        End If        ' La barra se dibuja la ultima: tapa lo que sobresalga de la vista.        If m_ViewY > 0 Then DrawToolbar m_Back.hDC        rc = MakeRect(0, 0, m_ClientW, m_FullH)        If m_BorderStyle = pdfBorderSingle Then FrameSolid m_Back.hDC, rc, GetSysColor(COLOR_BTNSHADOW)    End Sub    Private Sub DrawPages(ByVal hdc As LongPtr)        Dim i As Long, x As Long, y As Long, w As Long, h As Long, ox As Long, oy As Long, sh As Long        Dim vx0 As Long, vy0 As Long, vx1 As Long, vy1 As Long, rc As RECT        ox = OriginX()        oy = OriginY()        sh = IMax(2, Px(3))        m_VisFirst = -1        m_VisLast = -2        For i = 0 To m_Count - 1            y = oy + m_PY(i)            If y > m_ViewY + m_ClientH Then Exit For            h = m_PH(i)            If y + h + sh >= m_ViewY Then                x = ox + m_PX(i)                w = m_PW(i)                If x + w + sh >= m_ViewX And x < m_ClientW Then                    If m_VisFirst < 0 Then m_VisFirst = i                    m_VisLast = i                    rc = MakeRect(x + sh, y + sh, x + w + sh, y + h + sh)                    FillSolid hdc, rc, GetSysColor(COLOR_BTNSHADOW)                    vx0 = IMax(0, m_ViewX - x)                    vy0 = IMax(0, m_ViewY - y)                    vx1 = IMin(w, m_ClientW - x)                    vy1 = IMin(h, m_ViewY + m_ClientH - y)                    If vx1 > vx0 And vy1 > vy0 Then                        If EnsureTile(i, vx0, vy0, vx1, vy1) Then                            BitBlt hdc, x + vx0, y + vy0, vx1 - vx0, vy1 - vy0, m_Tile(i).hDC, vx0 - m_TileX(i), vy0 - m_TileY(i), SRCCOPY                        Else                            rc = MakeRect(x + vx0, y + vy0, x + vx1, y + vy1)                            FillSolid hdc, rc, &HFFFFFF                        End If                        DrawHighlights hdc, i, x, y                    End If                    rc = MakeRect(x - 1, y - 1, x + w + 1, y + h + 1)                    FrameSolid hdc, rc, &H808080                End If            End If        Next    End Sub    ' Garantiza que el mosaico de la pagina cubre la zona visible.    ' El mosaico abarca la zona visible mas medio cliente de margen, asi el    ' desplazamiento se resuelve con BitBlt sin volver a renderizar y la    ' memoria no crece con el zoom (a 6400% solo se renderiza lo visible).    Private Function EnsureTile(ByVal i As Long, ByVal vx0 As Long, ByVal vy0 As Long, ByVal vx1 As Long, ByVal vy1 As Long) As Boolean        Dim t As PdfDib, mx As Long, my As Long, tx0 As Long, ty0 As Long, tx1 As Long, ty1 As Long        Set t = m_Tile(i)        If Not t Is Nothing Then            If m_TileKW(i) = m_PW(i) And m_TileKH(i) = m_PH(i) And m_TileRot(i) = m_Rotation And t.IsValid Then                If vx0 >= m_TileX(i) And vy0 >= m_TileY(i) And vx1 <= m_TileX(i) + t.Width And vy1 <= m_TileY(i) + t.Height Then                    EnsureTile = True                    Exit Function                End If            End If        Else            Set t = New PdfDib            Set m_Tile(i) = t        End If        mx = m_ClientW \ 2        my = m_ClientH \ 2        tx0 = IMax(0, vx0 - mx)        ty0 = IMax(0, vy0 - my)        tx1 = IMin(m_PW(i), vx1 + mx)        ty1 = IMin(m_PH(i), vy1 + my)        If Not t.EnsureSize(tx1 - tx0, ty1 - ty0) Then            ' Sin memoria suficiente: solo la parte visible.            tx0 = vx0: ty0 = vy0: tx1 = vx1: ty1 = vy1            If Not t.EnsureSize(tx1 - tx0, ty1 - ty0) Then                Set m_Tile(i) = Nothing                Exit Function            End If        End If        If Not m_Doc.RenderTo(i, t, -tx0, -ty0, m_PW(i), m_PH(i), m_Rotation, RENDER_FLAGS) Then            Set m_Tile(i) = Nothing            Exit Function        End If        m_TileX(i) = tx0        m_TileY(i) = ty0        m_TileKW(i) = m_PW(i)        m_TileKH(i) = m_PH(i)        m_TileRot(i) = m_Rotation        EnsureTile = True    End Function    Private Sub DrawThumbnails(ByVal hdc As LongPtr)        Dim rc As RECT, i As Long, x As Long, y As Long, tw As Long, th As Long        Dim labelH As Long, d As Long, barH As Long, barY As Long        rc = MakeRect(0, m_ViewY, m_ViewX, m_FullH)        FillSolid hdc, rc, ToColorRef(m_ThumbBackColor)        labelH = Px(18)        d = Px(3)        m_ThumbVisFirst = -1        m_ThumbVisLast = -2        For i = 0 To m_Count - 1            y = m_ViewY + m_ThumbY(i) - m_ThumbScroll            If y > m_FullH Then Exit For            tw = m_ThumbW(i)            th = m_ThumbH(i)            If y + th + labelH >= m_ViewY Then                If m_ThumbVisFirst < 0 Then m_ThumbVisFirst = i                m_ThumbVisLast = i                x = (m_ViewX - tw) \ 2                If EnsureThumb(i) Then                    BitBlt hdc, x, y, tw, th, m_Thumb(i).hDC, 0, 0, SRCCOPY                Else                    rc = MakeRect(x, y, x + tw, y + th)                    FillSolid hdc, rc, &HFFFFFF                End If                If i = m_CurPage Then                    rc = MakeRect(x - d, y - d, x + tw + d, y + th + d)                    FrameSolid hdc, rc, ToColorRef(m_SelColor), IMax(2, Px(2))                Else                    rc = MakeRect(x - 1, y - 1, x + tw + 1, y + th + 1)                    FrameSolid hdc, rc, &H808080                End If                rc = MakeRect(0, y + th + Px(2), m_ViewX, y + th + labelH)                DrawLabel hdc, rc, CStr(i + 1), GetSysColor(COLOR_BTNTEXT)            End If        Next        rc = MakeRect(m_ViewX - 1, m_ViewY, m_ViewX, m_FullH)        FillSolid hdc, rc, GetSysColor(COLOR_BTNSHADOW)        ' Indicador de desplazamiento del panel de miniaturas        If m_ThumbsH > m_ClientH And m_ClientH > 0 Then            barH = IMax(Px(20), CLng(CDbl(m_ClientH) * m_ClientH / m_ThumbsH))            barY = CLng(CDbl(m_ClientH - barH) * m_ThumbScroll / (m_ThumbsH - m_ClientH))            rc = MakeRect(m_ViewX - Px(6), m_ViewY + barY, m_ViewX - Px(3), m_ViewY + barY + barH)            FillSolid hdc, rc, GetSysColor(COLOR_BTNSHADOW)        End If    End Sub    Private Function EnsureThumb(ByVal i As Long) As Boolean        Dim t As PdfDib        Set t = m_Thumb(i)        If Not t Is Nothing Then            If t.Width = m_ThumbW(i) And t.Height = m_ThumbH(i) And m_ThumbRot(i) = m_Rotation Then                EnsureThumb = True                Exit Function            End If        Else            Set t = New PdfDib        End If        If Not t.EnsureSize(m_ThumbW(i), m_ThumbH(i)) Then Exit Function        If Not m_Doc.RenderTo(i, t, 0, 0, m_ThumbW(i), m_ThumbH(i), m_Rotation, FPDF_ANNOT) Then Exit Function        Set m_Thumb(i) = t        m_ThumbRot(i) = m_Rotation        EnsureThumb = True    End Function    ' Libera mosaicos, miniaturas y paginas PDFium que ya no se ven.    Private Sub ReleaseUnused()        Dim i As Long        For i = 0 To m_Count - 1            If i < m_VisFirst - 1 Or i > m_VisLast + 1 Then                If Not m_Tile(i) Is Nothing Then Set m_Tile(i) = Nothing            End If            If i < m_ThumbVisFirst - 30 Or i > m_ThumbVisLast + 30 Then                If Not m_Thumb(i) Is Nothing Then Set m_Thumb(i) = Nothing            End If        Next        m_Doc.ReleasePagesExcept m_VisFirst - 2, m_VisLast + 2    End Sub    Private Sub AlphaFill(ByVal hdc As LongPtr, ByRef rc As RECT, ByVal OleColor As Long, ByVal Alpha As Long)        If rc.Right <= rc.Left Or rc.Bottom <= rc.Top Then Exit Sub        If Not m_Solid.EnsureSize(1, 1) Then Exit Sub        m_Solid.SetPixel 0, 0, ToPixel(OleColor)        AlphaBlend hdc, rc.Left, rc.Top, rc.Right - rc.Left, rc.Bottom - rc.Top, m_Solid.hDC, 0, 0, 1, 1, (Alpha And &HFF&) * &H10000    End Sub    Private Sub DrawLabel(ByVal hdc As LongPtr, ByRef rc As RECT, ByVal Text As String, ByVal ColorRef As Long)        Dim hOld As LongPtr, r As RECT        If Len(Text) = 0 Then Exit Sub        r = rc        If m_hFont <> 0 Then hOld = SelectObject(hdc, m_hFont)        SetBkMode hdc, TRANSPARENT        SetTextColor hdc, ColorRef        DrawTextW hdc, StrPtr(Text), -1, r, DT_CENTER Or DT_VCENTER Or DT_SINGLELINE Or DT_NOPREFIX Or DT_END_ELLIPSIS        If hOld <> 0 Then SelectObject hdc, hOld    End Sub    Private Sub DrawDesignPlaceholder(ByVal hdc As LongPtr)        Dim rc As RECT, pr As RECT, tw As Long, mw As Long, tbh As Long        GetClientRect UserControl.hWnd, rc        FillSolid hdc, rc, ToColorRef(m_BackColor)        If m_ShowToolbar Then            tbh = IMin(TB_HEIGHT, rc.Bottom)            pr = MakeRect(0, 0, rc.Right, tbh)            FillSolid hdc, pr, GetSysColor(COLOR_BTNFACE)            pr = MakeRect(0, tbh - 1, rc.Right, tbh)            FillSolid hdc, pr, GetSysColor(COLOR_BTNSHADOW)            pr = MakeRect(8, 0, rc.Right, tbh)            DrawLabel hdc, pr, "[abrir] [guardar] | [=] [Q] |  |<  <   1 / 1   >  >|  |  -  100 %  +  <->  [ ]  |  [impr]", GetSysColor(COLOR_GRAYTEXT)        End If        If m_ShowThumbs Then            tw = IMin(m_ThumbWidth, rc.Right \ 2)            pr = MakeRect(0, tbh, tw, rc.Bottom)            FillSolid hdc, pr, ToColorRef(m_ThumbBackColor)        End If        mw = (rc.Right - tw) \ 5        pr = MakeRect(tw + mw, tbh + 12, rc.Right - mw, rc.Bottom - 12)        If pr.Right > pr.Left And pr.Bottom > pr.Top Then            FillSolid hdc, pr, &HFFFFFF            FrameSolid hdc, pr, &H808080            DrawLabel hdc, pr, "ucPDF", &H808080        End If        If m_BorderStyle = pdfBorderSingle Then FrameSolid hdc, rc, GetSysColor(COLOR_BTNSHADOW)    End Sub    ' ========================================================================    '  Raton, teclado y cursor    ' ========================================================================    Private Function ScreenToPdf(ByVal i As Long, ByVal x As Long, ByVal y As Long, ByRef PdfX As Double, ByRef PdfY As Double) As Boolean        Dim pg As LongPtr        pg = m_Doc.PageHandle(i)        If pg = 0 Then Exit Function        ScreenToPdf = (FPDF_DeviceToPage(pg, OriginX() + m_PX(i), OriginY() + m_PY(i), m_PW(i), m_PH(i), m_Rotation, x, y, PdfX, PdfY) <> 0)    End Function    Private Function CharAtPoint(ByVal i As Long, ByVal x As Long, ByVal y As Long, ByVal Tolerance As Double) As Long        Dim tp As LongPtr, px As Double, py As Double, r As Long        CharAtPoint = -1        If i < 0 Then Exit Function        tp = m_Doc.TextPageHandle(i)        If tp = 0 Then Exit Function        If Not ScreenToPdf(i, x, y, px, py) Then Exit Function        r = FPDFText_GetCharIndexAtPos(tp, px, py, Tolerance, Tolerance)        If r >= 0 Then CharAtPoint = r    End Function    Private Sub OnMouseDown(ByVal x As Long, ByVal y As Long, ByVal Button As Long, ByVal Keys As Long)        Dim i As Long, px As Double, py As Double, ch As Long        ' Botones de la barra y del panel de busqueda        If Button = vbLeftButton Then            i = ToolbarHitTest(x, y)            If i >= 0 Then                m_TbDown = i                SetCapture m_hWnd                Invalidate                Exit Sub            End If        End If        If y < m_ViewY Then Exit Sub        ' Al pulsar en la vista, el teclado vuelve al visor.        If m_hEdit <> 0 Then            If GetFocus() = m_hEdit Then SetFocusAPI m_hWnd        End If        If Not HasDoc() Then Exit Sub        If x < m_ViewX Then            If Button = vbLeftButton And m_ShowSearch Then                i = ResultAt(x, y)                If i >= 0 Then SelectSearchResult i            End If            If Button = vbLeftButton And m_ShowThumbs Then                i = ThumbAt(y)                If i >= 0 Then GoToPage i + 1            End If            Exit Sub        End If        i = PageAtPoint(x, y)        If i >= 0 Then            If ScreenToPdf(i, x, y, px, py) Then RaiseEvent PageClick(i + 1, px, py, Button)        End If        If Button = vbMiddleButton Or (Button = vbLeftButton And m_CursorMode = pdfCursorPan) Then            BeginPan x, y            Exit Sub        End If        If Button <> vbLeftButton Then Exit Sub        ch = -1        If i >= 0 Then ch = CharAtPoint(i, x, y, 3)        If ch >= 0 Then            If m_HasSel Then                m_HasSel = False                Invalidate            End If            m_SelAPage = i            m_SelAChar = ch            m_SelBPage = i            m_SelBChar = ch            m_Selecting = True            SetCapture m_hWnd        Else            If m_HasSel Then ClearSelection            BeginPan x, y        End If    End Sub    Private Sub BeginPan(ByVal x As Long, ByVal y As Long)        m_Panning = True        m_PanX = x        m_PanY = y        m_PanSX = m_ScrollX        m_PanSY = m_ScrollY        SetCapture m_hWnd        SetCursor LoadCursorW(0, IDC_SIZEALL)    End Sub    Private Sub OnMouseMove(ByVal x As Long, ByVal y As Long)        Dim i As Long, ch As Long, tme As TRACKMOUSEEVENTSTRUCT        If m_Panning Then            ScrollTo m_PanSX - (x - m_PanX), m_PanSY - (y - m_PanY)            Exit Sub        End If        ' Resaltado de botones de la barra (y aviso de salida del raton)        If m_ShowSearch Then SetResultHot ResultAt(x, y)        If m_TbCount > 0 Then            SetToolbarHot ToolbarHitTest(x, y)            If Not m_TrackingLeave Then                tme.cbSize = LenB(tme)                tme.dwFlags = TME_LEAVE                tme.hwndTrack = m_hWnd                m_TrackingLeave = (TrackMouseEvent(tme) <> 0)            End If        End If        If Not m_Selecting Then Exit Sub        ' Desplazamiento automatico al arrastrar fuera del area visible        If y < m_ViewY Then            ScrollTo m_ScrollX, m_ScrollY + (y - m_ViewY)        ElseIf y > m_ViewY + m_ClientH Then            ScrollTo m_ScrollX, m_ScrollY + (y - m_ViewY - m_ClientH)        End If        i = PageNearestY(y)        ch = CharAtPoint(i, x, y, 12)        If ch < 0 Then ch = CharAtPoint(i, x, y, 60)        If ch >= 0 Then            If i <> m_SelBPage Or ch <> m_SelBChar Or Not m_HasSel Then                m_SelBPage = i                m_SelBChar = ch                m_HasSel = True                Invalidate            End If        End If    End Sub    Private Sub OnMouseUp(ByVal x As Long, ByVal y As Long)        Dim wasSelecting As Boolean, cmdIdx As Long        If m_TbDown >= 0 Then            cmdIdx = m_TbDown            m_TbDown = -1            If GetCapture() = m_hWnd Then ReleaseCapture            Invalidate            If ToolbarHitTest(x, y) = cmdIdx Then ExecuteToolbarCommand m_TbCmd(cmdIdx)            Exit Sub        End If        wasSelecting = m_Selecting        m_Selecting = False        m_Panning = False        If GetCapture() = m_hWnd Then ReleaseCapture        If wasSelecting And m_HasSel Then RaiseEvent SelectionChanged    End Sub    Private Sub EndDrag()        Dim wasSelecting As Boolean        If m_TbDown >= 0 Then            m_TbDown = -1            Invalidate        End If        wasSelecting = m_Selecting        m_Selecting = False        m_Panning = False        If wasSelecting And m_HasSel Then RaiseEvent SelectionChanged    End Sub    ' Doble clic: selecciona la palabra.    Private Sub OnDoubleClick(ByVal x As Long, ByVal y As Long)        Dim i As Long, ch As Long, tp As LongPtr, n As Long, s As Long, e As Long        If Not HasDoc() Or x < m_ViewX Or m_CursorMode = pdfCursorPan Then Exit Sub        i = PageAtPoint(x, y)        ch = CharAtPoint(i, x, y, 3)        If ch < 0 Then Exit Sub        tp = m_Doc.TextPageHandle(i)        n = FPDFText_CountChars(tp)        s = ch        e = ch        If IsWordChar(FPDFText_GetUnicode(tp, ch)) Then            Do While s > 0                If Not IsWordChar(FPDFText_GetUnicode(tp, s - 1)) Then Exit Do                s = s - 1            Loop            Do While e < n - 1                If Not IsWordChar(FPDFText_GetUnicode(tp, e + 1)) Then Exit Do                e = e + 1            Loop        End If        m_Selecting = False        m_SelAPage = i: m_SelAChar = s        m_SelBPage = i: m_SelBChar = e        m_HasSel = True        Invalidate        RaiseEvent SelectionChanged    End Sub    Private Function IsWordChar(ByVal c As Long) As Boolean        If c <= 32 Or c > &HFFFF& Then Exit Function        IsWordChar = (InStr(1, " .,;:!?()[]{}<>""'/\|" & ChrW$(&HAB) & ChrW$(&HBB) & ChrW$(&HBF) & ChrW$(&HA1), ChrW$(c)) = 0)    End Function    Private Sub OnMouseWheel(ByVal Delta As Long, ByVal Keys As Long, ByVal x As Long, ByVal y As Long, ByVal Horizontal As Boolean)        Dim stepPx As Long        If Not HasDoc() Then Exit Sub        If (Keys And MK_CONTROL) <> 0 And Not Horizontal Then            ZoomAt m_Zoom * (1.1 ^ (Delta / 120#)), x, y            Exit Sub        End If        stepPx = Px(120)        If x < m_ViewX And Not Horizontal Then            If m_ShowSearch Then                m_ResScroll = m_ResScroll - Delta * Px(RES_ITEM_H) \ 120                ClampResScroll                SetResultHot ResultAt(x, y)                Invalidate                Exit Sub            End If            If Not m_ShowThumbs Then Exit Sub            m_ThumbScroll = m_ThumbScroll - Delta * stepPx \ 120            ClampThumbScroll            Invalidate            Exit Sub        End If        If Horizontal Then            ScrollTo m_ScrollX + Delta * stepPx \ 120, m_ScrollY        ElseIf (Keys And MK_SHIFT) <> 0 Then            ScrollTo m_ScrollX - Delta * stepPx \ 120, m_ScrollY        Else            ScrollTo m_ScrollX, m_ScrollY - Delta * stepPx \ 120        End If    End Sub    Private Function OnSetCursor() As Boolean        Dim pt As POINTAPI, i As Long, id As Long        GetCursorPos pt        ScreenToClient m_hWnd, pt        id = IDC_ARROW        If m_Panning Then            id = IDC_SIZEALL        ElseIf ToolbarHitTest(pt.X, pt.Y) >= 0 Or ResultAt(pt.X, pt.Y) >= 0 Then            id = IDC_HAND        ElseIf pt.Y < m_ViewY Then            id = IDC_ARROW        ElseIf HasDoc() And pt.X >= m_ViewX Then            i = PageAtPoint(pt.X, pt.Y)            If m_CursorMode = pdfCursorPan Then                id = IDC_HAND            ElseIf i >= 0 Then                If CharAtPoint(i, pt.X, pt.Y, 2) >= 0 Then id = IDC_IBEAM            End If        ElseIf HasDoc() And m_ShowThumbs And pt.X < m_ViewX Then            If ThumbAt(pt.Y) >= 0 Then id = IDC_HAND        End If        SetCursor LoadCursorW(0, id)        OnSetCursor = True    End Function    Private Sub OnKeyDown(ByVal vk As Long)        Dim isCtrl As Boolean, isShift As Boolean, stepPx As Long        isCtrl = (GetKeyState(VK_CONTROL) < 0)        isShift = (GetKeyState(VK_SHIFT) < 0)        If isCtrl And vk = &H4F And m_ShowOpenBtn Then          ' Ctrl+O            ShowOpenDialog            Exit Sub        End If        If Not HasDoc() Then Exit Sub        If isCtrl And vk = &H53 And m_ShowSaveBtn Then          ' Ctrl+S            ShowSaveDialog            Exit Sub        End If        stepPx = Px(40)        Select Case vk            Case VK_UP: ScrollTo m_ScrollX, m_ScrollY - stepPx            Case VK_DOWN: ScrollTo m_ScrollX, m_ScrollY + stepPx            Case VK_LEFT: ScrollTo m_ScrollX - stepPx, m_ScrollY            Case VK_RIGHT: ScrollTo m_ScrollX + stepPx, m_ScrollY            Case VK_PRIOR                If isCtrl Then PreviousPage Else ScrollTo m_ScrollX, m_ScrollY - IMax(stepPx, m_ClientH - stepPx)            Case VK_NEXT                If isCtrl Then NextPage Else ScrollTo m_ScrollX, m_ScrollY + IMax(stepPx, m_ClientH - stepPx)            Case VK_HOME: FirstPage            Case VK_END: LastPage            Case VK_ADD, VK_OEM_PLUS: If isCtrl Then ZoomIn            Case VK_SUBTRACT, VK_OEM_MINUS: If isCtrl Then ZoomOut            Case &H30, &H60: If isCtrl Then ZoomAt 100, ViewCenterX(), ViewCenterY()            Case &H41: If isCtrl Then SelectAll            Case &H43: If isCtrl Then CopySelection            Case VK_F3: If isShift Then FindPrevious Else FindNext            Case &H46: If isCtrl Then FocusSearchBox        End Select    End Sub    ' ========================================================================    '  APARTADO 3 - Herramientas: miniaturas    ' ========================================================================    Private Function ThumbAt(ByVal y As Long) As Long        Dim i As Long, dy As Long, labelH As Long, margin As Long        ThumbAt = -1        If Not (m_ShowThumbs And HasDoc()) Then Exit Function        If y < m_ViewY Then Exit Function        dy = y - m_ViewY + m_ThumbScroll        labelH = Px(18)        margin = Px(10)        For i = 0 To m_Count - 1            If dy < m_ThumbY(i) - margin \ 2 Then Exit Function            If dy < m_ThumbY(i) + m_ThumbH(i) + labelH + margin \ 2 Then                ThumbAt = i                Exit Function            End If        Next    End Function    Private Sub EnsureThumbVisible(ByVal i As Long)        Dim top As Long, bottom As Long        If Not (m_ShowThumbs And HasDoc()) Or i < 0 Or i >= m_Count Or m_ThumbsH = 0 Then Exit Sub        top = m_ThumbY(i) - Px(6)        bottom = m_ThumbY(i) + m_ThumbH(i) + Px(24)        If top < m_ThumbScroll Then            m_ThumbScroll = top        ElseIf bottom > m_ThumbScroll + m_ClientH Then            m_ThumbScroll = bottom - m_ClientH        End If        ClampThumbScroll    End Sub    ' ========================================================================    '  APARTADO 3 - Herramientas: seleccion de texto    ' ========================================================================    Private Function SelOrdered(ByRef p0 As Long, ByRef c0 As Long, ByRef p1 As Long, ByRef c1 As Long) As Boolean        If Not m_HasSel Then Exit Function        If m_SelAPage < m_SelBPage Or (m_SelAPage = m_SelBPage And m_SelAChar <= m_SelBChar) Then            p0 = m_SelAPage: c0 = m_SelAChar: p1 = m_SelBPage: c1 = m_SelBChar        Else            p0 = m_SelBPage: c0 = m_SelBChar: p1 = m_SelAPage: c1 = m_SelAChar        End If        SelOrdered = True    End Function    ' Rango de caracteres seleccionados (inclusivo) en la pagina i.    Private Function SelectionRangeOnPage(ByVal i As Long, ByRef s As Long, ByRef e As Long) As Boolean        Dim p0 As Long, c0 As Long, p1 As Long, c1 As Long        If Not SelOrdered(p0, c0, p1, c1) Then Exit Function        If i < p0 Or i > p1 Then Exit Function        If i = p0 Then s = c0 Else s = 0        If i = p1 Then e = c1 Else e = m_Doc.CharCount(i) - 1        SelectionRangeOnPage = (e >= s)    End Function    Private Sub DrawHighlights(ByVal hdc As LongPtr, ByVal i As Long, ByVal x As Long, ByVal y As Long)        Dim s As Long, e As Long        If m_HasSel Then            If SelectionRangeOnPage(i, s, e) Then DrawCharRange hdc, i, x, y, s, e - s + 1, m_SelColor, 90        End If        If m_FindPage = i And m_FindLen > 0 Then DrawCharRange hdc, i, x, y, m_FindIdx, m_FindLen, m_FindColor, 120    End Sub    Private Sub DrawCharRange(ByVal hdc As LongPtr, ByVal i As Long, ByVal x As Long, ByVal y As Long, ByVal StartChar As Long, ByVal Count As Long, ByVal OleColor As Long, ByVal Alpha As Long)        Dim tp As LongPtr, pg As LongPtr, n As Long, r As Long        Dim l As Double, t As Double, rr As Double, b As Double, rc As RECT        tp = m_Doc.TextPageHandle(i)        pg = m_Doc.PageHandle(i)        If tp = 0 Or pg = 0 Or Count <= 0 Then Exit Sub        n = FPDFText_CountRects(tp, StartChar, Count)        For r = 0 To n - 1            If FPDFText_GetRect(tp, r, l, t, rr, b) <> 0 Then                rc = PdfRectToScreen(pg, i, x, y, l, t, rr, b)                AlphaFill hdc, rc, OleColor, Alpha            End If        Next    End Sub    Private Function PdfRectToScreen(ByVal pg As LongPtr, ByVal i As Long, ByVal x As Long, ByVal y As Long, ByVal l As Double, ByVal t As Double, ByVal r As Double, ByVal b As Double) As RECT        Dim x1 As Long, y1 As Long, x2 As Long, y2 As Long        FPDF_PageToDevice pg, x, y, m_PW(i), m_PH(i), m_Rotation, l, t, x1, y1        FPDF_PageToDevice pg, x, y, m_PW(i), m_PH(i), m_Rotation, r, b, x2, y2        PdfRectToScreen = MakeRect(IMin(x1, x2), IMin(y1, y2), IMax(x1, x2), IMax(y1, y2))    End Function    Public Property Get HasSelection() As Boolean        HasSelection = m_HasSel    End Property    Public Property Get SelectedText() As String        Dim p0 As Long, c0 As Long, p1 As Long, c1 As Long, p As Long, s As Long, e As Long, r As String        If Not HasDoc() Then Exit Property        If Not SelOrdered(p0, c0, p1, c1) Then Exit Property        For p = p0 To p1            If SelectionRangeOnPage(p, s, e) Then                If Len(r) > 0 Then r = r & vbCrLf                r = r & m_Doc.GetText(p, s, e - s + 1)            End If        Next        SelectedText = r    End Property    Public Sub SelectAll()        If Not HasDoc() Then Exit Sub        m_SelAPage = 0        m_SelAChar = 0        m_SelBPage = m_Count - 1        m_SelBChar = IMax(0, m_Doc.CharCount(m_Count - 1) - 1)        m_HasSel = True        Invalidate        RaiseEvent SelectionChanged    End Sub    Public Sub ClearSelection()        If Not m_HasSel Then Exit Sub        m_HasSel = False        Invalidate        RaiseEvent SelectionChanged    End Sub    Public Function CopySelection() As Boolean        Dim t As String        t = SelectedText        If Len(t) > 0 Then CopySelection = SetClipboardUnicode(m_hWnd, t)    End Function    Public Function GetPageText(ByVal Page As Long) As String        If HasDoc() Then GetPageText = m_Doc.GetText(Page - 1)    End Function    ' ========================================================================    '  APARTADO 3 - Herramientas: busqueda de texto    ' ========================================================================    ' Busca el texto en todo el documento, guarda todas las coincidencias y    ' salta a la primera situada en la pagina actual o despues.    Public Function FindText(ByVal Text As String, Optional ByVal MatchCase As Boolean = False, Optional ByVal WholeWord As Boolean = False) As Boolean        Dim j As Long        m_FindText = Text        m_FindFlags = 0        If MatchCase Then m_FindFlags = m_FindFlags Or FPDF_MATCHCASE        If WholeWord Then m_FindFlags = m_FindFlags Or FPDF_MATCHWHOLEWORD        SyncSearchEdit        CollectMatches        m_Searched = (Len(Text) > 0 And HasDoc())        If m_MatchCount = 0 Then            m_MatchPos = -1            m_FindPage = -1            m_FindLen = 0            Invalidate            RaiseEvent SearchCompleted(False, 0)            Exit Function        End If        m_MatchPos = 0        For j = 0 To m_MatchCount - 1            If m_MatchPage(j) >= m_CurPage Then                m_MatchPos = j                Exit For            End If        Next        ApplyMatch        FindText = True    End Function    Public Function FindNext() As Boolean        If m_MatchCount = 0 Then            RaiseEvent SearchCompleted(False, 0)            Exit Function        End If        m_MatchPos = (m_MatchPos + 1) Mod m_MatchCount        ApplyMatch        FindNext = True    End Function    Public Function FindPrevious() As Boolean        If m_MatchCount = 0 Then            RaiseEvent SearchCompleted(False, 0)            Exit Function        End If        m_MatchPos = (m_MatchPos - 1 + m_MatchCount) Mod m_MatchCount        ApplyMatch        FindPrevious = True    End Function    Public Sub ClearSearch()        m_FindText = ""        m_FindPage = -1        m_FindIdx = -1        m_FindLen = 0        m_Searched = False        m_MatchCount = 0        m_MatchPos = -1        Erase m_MatchPage        Erase m_MatchIdx        Erase m_MatchLen        Erase m_MatchPre        Erase m_MatchHit        Erase m_MatchPost        m_ResScroll = 0        m_ResHot = -1        Invalidate    End Sub    ' Numero total de coincidencias de la ultima busqueda.    Public Property Get SearchResultCount() As Long        SearchResultCount = m_MatchCount    End Property    ' Coincidencia actual (base 1, 0 si no hay ninguna).    Public Property Get SearchResultIndex() As Long        If m_MatchCount > 0 Then SearchResultIndex = m_MatchPos + 1    End Property    Public Property Get SearchText() As String        SearchText = m_FindText    End Property    Private Sub ApplyMatch()        m_FindPage = m_MatchPage(m_MatchPos)        m_FindIdx = m_MatchIdx(m_MatchPos)        m_FindLen = m_MatchLen(m_MatchPos)        EnsureResultVisible m_MatchPos        ScrollMatchIntoView        Invalidate        RaiseEvent SearchCompleted(True, m_FindPage + 1)    End Sub    ' Recorre todas las paginas. Las paginas no visibles se liberan despues de    ' examinarlas para no mantener en memoria todo el documento.    Private Sub CollectMatches()        Dim p As Long, tp As LongPtr, h As LongPtr, cap As Long        m_MatchCount = 0        m_MatchPos = -1        Erase m_MatchPage        Erase m_MatchIdx        Erase m_MatchLen        Erase m_MatchPre        Erase m_MatchHit        Erase m_MatchPost        m_ResScroll = 0        m_ResHot = -1        If Not HasDoc() Or Len(m_FindText) = 0 Then Exit Sub        For p = 0 To m_Count - 1            tp = m_Doc.TextPageHandle(p)            If tp <> 0 Then                h = FPDFText_FindStart(tp, StrPtr(m_FindText), m_FindFlags, 0)                If h <> 0 Then                    Do While FPDFText_FindNext(h) <> 0                        If m_MatchCount >= cap Then                            cap = IMax(64, cap * 2)                            ReDim Preserve m_MatchPage(0 To cap - 1)                            ReDim Preserve m_MatchIdx(0 To cap - 1)                            ReDim Preserve m_MatchLen(0 To cap - 1)                            ReDim Preserve m_MatchPre(0 To cap - 1)                            ReDim Preserve m_MatchHit(0 To cap - 1)                            ReDim Preserve m_MatchPost(0 To cap - 1)                        End If                        m_MatchPage(m_MatchCount) = p                        m_MatchIdx(m_MatchCount) = FPDFText_GetSchResultIndex(h)                        m_MatchLen(m_MatchCount) = FPDFText_GetSchCount(h)                        BuildSnippet p, m_MatchIdx(m_MatchCount), m_MatchLen(m_MatchCount), m_MatchPre(m_MatchCount), m_MatchHit(m_MatchCount), m_MatchPost(m_MatchCount)                        m_MatchCount = m_MatchCount + 1                    Loop                    FPDFText_FindClose h                End If            End If            If p < m_VisFirst - 2 Or p > m_VisLast + 2 Then m_Doc.ReleasePage p        Next    End Sub    ' Extracto de contexto alrededor de una coincidencia, en tres tramos.    Private Sub BuildSnippet(ByVal p As Long, ByVal Index As Long, ByVal Length As Long, ByRef Pre As String, ByRef Hit As String, ByRef Post As String)        Dim s0 As Long, k As Long        s0 = IMax(0, Index - SNIP_BEFORE)        Pre = CleanSnippet(m_Doc.GetText(p, s0, Index - s0))        Hit = CleanSnippet(m_Doc.GetText(p, Index, Length))        Post = CleanSnippet(m_Doc.GetText(p, Index + Length, SNIP_AFTER))        If s0 > 0 Then            ' Empezar en una palabra completa            k = InStr(1, Pre, " ")            If k > 0 And k < Len(Pre) Then Pre = Mid$(Pre, k + 1)            Pre = ChrW$(&H2026) & LTrim$(Pre)        Else            Pre = LTrim$(Pre)        End If        If Len(Hit) = 0 Then Hit = m_FindText    End Sub    ' Saltos de linea y tabuladores a espacios; espacios repetidos a uno.    Private Function CleanSnippet(ByVal t As String) As String        t = Replace$(t, vbCrLf, " ")        t = Replace$(t, vbCr, " ")        t = Replace$(t, vbLf, " ")        t = Replace$(t, vbTab, " ")        t = Replace$(t, vbNullChar, "")        Do While InStr(1, t, "  ") > 0            t = Replace$(t, "  ", " ")        Loop        CleanSnippet = t    End Function    Private Sub ScrollMatchIntoView()        Dim tp As LongPtr, pg As LongPtr, n As Long, r As Long, rc As RECT, u As RECT, first As Boolean        Dim l As Double, t As Double, rr As Double, b As Double, x As Long, y As Long, dx As Long, dy As Long        tp = m_Doc.TextPageHandle(m_FindPage)        pg = m_Doc.PageHandle(m_FindPage)        If tp = 0 Or pg = 0 Then Exit Sub        x = OriginX() + m_PX(m_FindPage)        y = OriginY() + m_PY(m_FindPage)        n = FPDFText_CountRects(tp, m_FindIdx, m_FindLen)        first = True        For r = 0 To n - 1            If FPDFText_GetRect(tp, r, l, t, rr, b) <> 0 Then                rc = PdfRectToScreen(pg, m_FindPage, x, y, l, t, rr, b)                If first Then                    u = rc                    first = False                Else                    u = MakeRect(IMin(u.Left, rc.Left), IMin(u.Top, rc.Top), IMax(u.Right, rc.Right), IMax(u.Bottom, rc.Bottom))                End If            End If        Next        If first Then            GoToPage m_FindPage + 1            Exit Sub        End If        If u.Top < m_ViewY Or u.Bottom > m_ViewY + m_ClientH Then dy = u.Top - (m_ViewY + m_ClientH \ 3)        If u.Left < m_ViewX Or u.Right > m_ClientW Then dx = u.Left - (m_ViewX + (m_ClientW - m_ViewX) \ 3)        If dx <> 0 Or dy <> 0 Then ScrollTo m_ScrollX + dx, m_ScrollY + dy    End Sub    ' ========================================================================    '  APARTADO 3 - Herramientas: impresion    ' ========================================================================    ' Imprime el documento ajustando cada pagina al area imprimible    ' (reduce si es necesario, nunca amplia) y la centra. Las paginas    ' apaisadas se giran automaticamente si el papel esta en vertical.    ' La resolucion de renderizado se limita a 300 ppp para acotar la memoria.    Public Function PrintDocument(Optional ByVal ShowDialog As Boolean = True, Optional ByVal FromPage As Long = 1, Optional ByVal ToPage As Long = -1, Optional ByVal DocumentName As String) As Boolean        Dim hdcPrn As LongPtr        If Not NormalizePageRange(FromPage, ToPage) Then Exit Function        hdcPrn = PdfPrintDialog(m_hWnd, ShowDialog, 1, m_Count, FromPage, ToPage)        If hdcPrn = 0 Then Exit Function        PrintDocument = PrintToDC(hdcPrn, FromPage, ToPage, DocumentName, 1)        DeleteDC hdcPrn    End Function    ' Envia el documento directamente a la impresora predeterminada de    ' Windows, sin mostrar ningun dialogo. Devuelve False si no hay impresora    ' predeterminada, si falla el trabajo o si se cancela en PrintProgress.    Public Function PrintToDefaultPrinter(Optional ByVal FromPage As Long = 1, Optional ByVal ToPage As Long = -1, Optional ByVal Copies As Long = 1, Optional ByVal DocumentName As String) As Boolean        Dim prnName As String, hdcPrn As LongPtr        If Not NormalizePageRange(FromPage, ToPage) Then Exit Function        prnName = DefaultPrinterName()        If Len(prnName) = 0 Then Exit Function        hdcPrn = CreateDCW(StrPtr("WINSPOOL"), StrPtr(prnName), 0, 0)        If hdcPrn = 0 Then Exit Function        PrintToDefaultPrinter = PrintToDC(hdcPrn, FromPage, ToPage, DocumentName, IMax(1, Copies))        DeleteDC hdcPrn    End Function    ' Nombre de la impresora predeterminada ("" si no hay ninguna).    Public Function DefaultPrinterName() As String        Dim buf As String, n As Long        n = 0        GetDefaultPrinterW 0, n        If n <= 0 Then Exit Function        buf = String$(n, vbNullChar)        If GetDefaultPrinterW(StrPtr(buf), n) <> 0 Then            n = InStr(buf, vbNullChar)            If n > 0 Then DefaultPrinterName = Left$(buf, n - 1) Else DefaultPrinterName = buf        End If    End Function    Private Function NormalizePageRange(ByRef FromPage As Long, ByRef ToPage As Long) As Boolean        If Not HasDoc() Then Exit Function        If ToPage < 1 Or ToPage > m_Count Then ToPage = m_Count        If FromPage < 1 Then FromPage = 1        NormalizePageRange = (FromPage <= ToPage)    End Function    ' Imprime las paginas sobre un DC de impresora ya creado (no lo libera).    Private Function PrintToDC(ByVal hdcPrn As LongPtr, ByVal FromPage As Long, ByVal ToPage As Long, ByVal DocumentName As String, ByVal Copies As Long) As Boolean        Dim di As DOCINFOW, p As Long, n As Long, total As Long, done As Long, cancel As Boolean        Dim dpiX As Long, dpiY As Long, horz As Long, vert As Long, rot As Long        Dim wpt As Double, hpt As Double, s As Double, f As Double        Dim tw As Long, th As Long, bw As Long, bh As Long, dib As PdfDib, ok As Boolean        If Len(DocumentName) = 0 Then DocumentName = IIf(Len(m_FileName) > 0, m_FileName, "ucPDF")        di.cbSize = LenB(di)        di.lpszDocName = StrPtr(DocumentName)        If StartDocW(hdcPrn, di) <= 0 Then Exit Function        dpiX = GetDeviceCaps(hdcPrn, LOGPIXELSX)        dpiY = GetDeviceCaps(hdcPrn, LOGPIXELSY)        horz = GetDeviceCaps(hdcPrn, HORZRES)        vert = GetDeviceCaps(hdcPrn, VERTRES)        total = (ToPage - FromPage + 1) * Copies        Set dib = New PdfDib        ok = True        For n = 0 To total - 1            p = FromPage + (n Mod (ToPage - FromPage + 1))            cancel = False            RaiseEvent PrintProgress(p, done, total, cancel)            If cancel Then                AbortDoc hdcPrn                ok = False                Exit For            End If            If StartPage(hdcPrn) <= 0 Then                AbortDoc hdcPrn                ok = False                Exit For            End If            wpt = m_Doc.PageWidth(p - 1)            hpt = m_Doc.PageHeight(p - 1)            rot = 0            If (wpt > hpt) <> (horz > vert) Then                rot = 1                s = wpt: wpt = hpt: hpt = s            End If            s = DMin(1#, DMin(horz / (wpt * dpiX / 72#), vert / (hpt * dpiY / 72#)))            tw = CLng(wpt * dpiX / 72# * s)            th = CLng(hpt * dpiY / 72# * s)            f = DMin(1#, 300# / dpiX)            bw = IMax(1, CLng(tw * f))            bh = IMax(1, CLng(th * f))            If dib.EnsureSize(bw, bh) Then                If m_Doc.RenderTo(p - 1, dib, 0, 0, bw, bh, rot, FPDF_ANNOT Or FPDF_PRINTING) Then                    SetStretchBltMode hdcPrn, HALFTONE                    SetBrushOrgEx hdcPrn, 0, 0, 0                    dib.StretchToDC hdcPrn, (horz - tw) \ 2, (vert - th) \ 2, tw, th                End If            End If            EndPage hdcPrn            done = done + 1        Next        If ok Then EndDoc hdcPrn        Set dib = Nothing        Invalidate        PrintToDC = ok    End Function    ' ========================================================================    '  Barra de herramientas (GDI+)    '  [miniaturas] [buscar] | [|<] [<] [ 3 / 10 ] [>] [>|] | [-] [100 %] [+] [ancho] [pagina] | [imprimir]    '    '  El boton de busqueda abre un panel a la izquierda (como las miniaturas):    '    [ cuadro de busqueda                 ]    '    Resultados de la busqueda 2/7  [^] [v]    ' ========================================================================    Private Sub AddToolbarItem(ByVal Kind As Long, ByVal Cmd As Long, ByVal LogicalWidth As Long, Optional ByVal InPanel As Boolean = False)        ReDim Preserve m_TbKind(0 To m_TbCount)        ReDim Preserve m_TbCmd(0 To m_TbCount)        ReDim Preserve m_TbW(0 To m_TbCount)        ReDim Preserve m_TbRect(0 To m_TbCount)        ReDim Preserve m_TbPanel(0 To m_TbCount)        m_TbKind(m_TbCount) = Kind        m_TbCmd(m_TbCount) = Cmd        m_TbW(m_TbCount) = LogicalWidth        m_TbPanel(m_TbCount) = InPanel        If Cmd = CMD_SEARCHEDIT Then m_EditIdx = m_TbCount        If Cmd = CMD_FINDCOUNT Then m_CountIdx = m_TbCount        m_TbCount = m_TbCount + 1    End Sub    Private Sub BuildToolbar()        m_TbCount = 0        ' Barra superior        AddToolbarItem TBK_BUTTON, CMD_OPEN, 28        AddToolbarItem TBK_BUTTON, CMD_SAVE, 28        AddToolbarItem TBK_SEP, CMD_SEPFILE, 13        AddToolbarItem TBK_BUTTON, CMD_THUMBS, 28        AddToolbarItem TBK_BUTTON, CMD_SEARCHPANEL, 28        AddToolbarItem TBK_SEP, CMD_SEP, 13        AddToolbarItem TBK_BUTTON, CMD_FIRST, 28        AddToolbarItem TBK_BUTTON, CMD_PREV, 28        AddToolbarItem TBK_LABEL, CMD_PAGELABEL, 76        AddToolbarItem TBK_BUTTON, CMD_NEXT, 28        AddToolbarItem TBK_BUTTON, CMD_LAST, 28        AddToolbarItem TBK_SEP, CMD_SEP, 13        AddToolbarItem TBK_BUTTON, CMD_ZOOMOUT, 28        AddToolbarItem TBK_LABEL, CMD_ZOOMLABEL, 58        AddToolbarItem TBK_BUTTON, CMD_ZOOMIN, 28        AddToolbarItem TBK_BUTTON, CMD_FITWIDTH, 28        AddToolbarItem TBK_BUTTON, CMD_FITPAGE, 28        AddToolbarItem TBK_SEP, CMD_SEP, 13        AddToolbarItem TBK_BUTTON, CMD_PRINT, 28        ' Panel de busqueda        AddToolbarItem TBK_EDIT, CMD_SEARCHEDIT, 0, True        AddToolbarItem TBK_LABEL, CMD_FINDCOUNT, 0, True        AddToolbarItem TBK_BUTTON, CMD_FINDPREV, 26, True        AddToolbarItem TBK_BUTTON, CMD_FINDNEXT, 26, True    End Sub    Private Sub LayoutToolbar()        Dim i As Long, x As Long, w As Long, gap As Long, bh As Long, top As Long        If m_TbCount = 0 Then Exit Sub        gap = Px(2)        bh = IMax(1, IMin(Px(28), m_ViewY - Px(6)))        top = (m_ViewY - bh) \ 2        x = Px(6)        For i = 0 To m_TbCount - 1            If Not m_TbPanel(i) Then                If m_ViewY > 0 And ToolbarItemVisible(m_TbCmd(i)) Then                    w = Px(m_TbW(i))                    m_TbRect(i) = MakeRect(x, top, x + w, top + bh)                    x = x + w + gap                Else                    m_TbRect(i) = MakeRect(0, 0, 0, 0)                End If            End If        Next        LayoutSearchPanel        LayoutSearchEdit    End Sub    ' Situa los elementos del panel de busqueda (vacios si el panel esta cerrado).    Private Sub LayoutSearchPanel()        Dim i As Long, pad As Long, x0 As Long, x1 As Long, y As Long, y2 As Long, bw As Long, rowH As Long, isOpen As Boolean        isOpen = m_ShowSearch And PanelVisible()        pad = Px(10)        x0 = pad        x1 = m_ViewX - pad        y = m_ViewY + pad        rowH = Px(28)        y2 = y + rowH + Px(8)        bw = Px(26)        For i = 0 To m_TbCount - 1            If m_TbPanel(i) Then                If Not isOpen Or x1 - x0 < Px(40) Then                    m_TbRect(i) = MakeRect(0, 0, 0, 0)                Else                    Select Case m_TbCmd(i)                        Case CMD_SEARCHEDIT: m_TbRect(i) = MakeRect(x0, y, x1, y + rowH)                        Case CMD_FINDNEXT: m_TbRect(i) = MakeRect(x1 - bw, y2, x1, y2 + bw)                        Case CMD_FINDPREV: m_TbRect(i) = MakeRect(x1 - 2 * bw - Px(2), y2, x1 - bw - Px(2), y2 + bw)                        Case CMD_FINDCOUNT: m_TbRect(i) = MakeRect(x0 + Px(2), y2, IMax(x0 + Px(2), x1 - 2 * bw - Px(8)), y2 + bw)                    End Select                End If            End If        Next        ' Lista de resultados: desde debajo de la linea de resultados hasta el final        If isOpen And x1 - x0 >= Px(40) And m_FullH - pad - (y2 + bw + Px(8)) > Px(30) Then            m_ResRect = MakeRect(x0, y2 + bw + Px(8), x1, m_FullH - pad)        Else            m_ResRect = MakeRect(0, 0, 0, 0)        End If        ClampResScroll    End Sub    ' --- Lista de resultados -------------------------------------------------    Private Function ResultListHeight() As Long        ResultListHeight = IMax(0, m_ResRect.Bottom - m_ResRect.Top - 2)    End Function    Private Sub ClampResScroll()        m_ResScroll = IMax(0, IMin(m_ResScroll, m_MatchCount * Px(RES_ITEM_H) - ResultListHeight()))    End Sub    ' Resultado bajo el punto (-1 si ninguno).    Private Function ResultAt(ByVal x As Long, ByVal y As Long) As Long        Dim j As Long        ResultAt = -1        If Not m_ShowSearch Or m_MatchCount = 0 Or m_ResRect.Right <= m_ResRect.Left Then Exit Function        If x < m_ResRect.Left Or x >= m_ResRect.Right Or y <= m_ResRect.Top Or y >= m_ResRect.Bottom - 1 Then Exit Function        j = (y - m_ResRect.Top - 1 + m_ResScroll) \ Px(RES_ITEM_H)        If j >= 0 And j < m_MatchCount Then ResultAt = j    End Function    Private Sub SetResultHot(ByVal j As Long)        If j = m_ResHot Then Exit Sub        m_ResHot = j        Invalidate    End Sub    Private Sub EnsureResultVisible(ByVal j As Long)        Dim ih As Long, t As Long        If j < 0 Or ResultListHeight() <= 0 Then Exit Sub        ih = Px(RES_ITEM_H)        t = j * ih        If t < m_ResScroll Then            m_ResScroll = t        ElseIf t + ih > m_ResScroll + ResultListHeight() Then            m_ResScroll = t + ih - ResultListHeight()        End If        ClampResScroll    End Sub    ' Ir al resultado j de la lista (base 0).    Public Sub SelectSearchResult(ByVal Index As Long)        If Index < 0 Or Index >= m_MatchCount Then Exit Sub        m_MatchPos = Index        ApplyMatch    End Sub    ' Coloca el EDIT de Win32 dentro de su recuadro del panel.    Private Sub LayoutSearchEdit()        Dim r As RECT, eh As Long        If m_hEdit = 0 Or m_TbCount = 0 Then Exit Sub        r = m_TbRect(m_EditIdx)        If r.Right > r.Left And m_ShowSearch And PanelVisible() Then            eh = IMin(r.Bottom - r.Top - Px(6), Px(18))            MoveWindow m_hEdit, r.Left + Px(7), r.Top + (r.Bottom - r.Top - eh) \ 2, IMax(1, r.Right - r.Left - Px(14)), eh, 1            ShowWindow m_hEdit, SW_SHOWNA            EnableWindow m_hEdit, 1        Else            ShowWindow m_hEdit, SW_HIDE        End If    End Sub    ' Botones que se pueden ocultar desde codigo (ShowOpenButton / ShowSaveButton).    Private Function ToolbarItemVisible(ByVal Cmd As Long) As Boolean        Select Case Cmd            Case CMD_OPEN: ToolbarItemVisible = m_ShowOpenBtn            Case CMD_SAVE: ToolbarItemVisible = m_ShowSaveBtn            Case CMD_SEPFILE: ToolbarItemVisible = m_ShowOpenBtn Or m_ShowSaveBtn            Case Else: ToolbarItemVisible = True        End Select    End Function    Private Function ToolbarItemEnabled(ByVal Cmd As Long) As Boolean        Select Case Cmd            Case CMD_OPEN: ToolbarItemEnabled = (m_hWnd <> 0)            Case CMD_SAVE: ToolbarItemEnabled = HasDoc()            Case CMD_FIRST, CMD_PREV: ToolbarItemEnabled = HasDoc() And m_CurPage > 0            Case CMD_NEXT, CMD_LAST: ToolbarItemEnabled = HasDoc() And m_CurPage < m_Count - 1            Case CMD_ZOOMOUT: ToolbarItemEnabled = HasDoc() And m_Zoom > ZOOM_STEP + 0.01            Case CMD_ZOOMIN: ToolbarItemEnabled = HasDoc() And m_Zoom < MAX_ZOOM - 0.01            Case CMD_FITWIDTH, CMD_FITPAGE, CMD_PRINT: ToolbarItemEnabled = HasDoc()            Case CMD_THUMBS, CMD_SEARCHPANEL: ToolbarItemEnabled = HasDoc()            Case CMD_FINDPREV, CMD_FINDNEXT: ToolbarItemEnabled = HasDoc() And (m_MatchCount > 0 Or Len(GetSearchEditText()) > 0)        End Select    End Function    Private Function ToolbarItemChecked(ByVal Cmd As Long) As Boolean        Select Case Cmd            Case CMD_THUMBS: ToolbarItemChecked = m_ShowThumbs And HasDoc()            Case CMD_SEARCHPANEL: ToolbarItemChecked = m_ShowSearch And HasDoc()            Case CMD_FITWIDTH: ToolbarItemChecked = (m_ZoomMode = pdfZoomFitWidth) And HasDoc()            Case CMD_FITPAGE: ToolbarItemChecked = (m_ZoomMode = pdfZoomFitPage) And HasDoc()        End Select    End Function    ' Indice del boton habilitado bajo el punto (barra o panel; -1 si ninguno).    Private Function ToolbarHitTest(ByVal x As Long, ByVal y As Long) As Long        Dim i As Long, r As RECT        ToolbarHitTest = -1        For i = 0 To m_TbCount - 1            If m_TbKind(i) = TBK_BUTTON Then                r = m_TbRect(i)                If r.Right > r.Left And x >= r.Left And x < r.Right And y >= r.Top And y < r.Bottom Then                    If ToolbarItemEnabled(m_TbCmd(i)) Then ToolbarHitTest = i                    Exit Function                End If            End If        Next    End Function    Private Sub SetToolbarHot(ByVal i As Long)        If i = m_TbHot Then Exit Sub        m_TbHot = i        Invalidate    End Sub    Private Sub InvalidateToolbar()        Dim rc As RECT        If m_hWnd = 0 Or m_ViewY <= 0 Then Exit Sub        rc = MakeRect(0, 0, m_ClientW, m_ViewY)        InvalidateRect m_hWnd, VarPtr(rc), 0    End Sub    Private Sub ExecuteToolbarCommand(ByVal Cmd As Long)        Dim cancel As Boolean        RaiseEvent ToolbarClick(Cmd, cancel)        If cancel Then Exit Sub        Select Case Cmd            Case CMD_OPEN: ShowOpenDialog            Case CMD_SAVE: ShowSaveDialog            Case CMD_THUMBS: ShowThumbnails = Not m_ShowThumbs            Case CMD_SEARCHPANEL: ShowSearchPanel = Not m_ShowSearch            Case CMD_FIRST: FirstPage            Case CMD_PREV: PreviousPage            Case CMD_NEXT: NextPage            Case CMD_LAST: LastPage            Case CMD_ZOOMOUT: ZoomOut            Case CMD_ZOOMIN: ZoomIn            Case CMD_FITWIDTH: ZoomMode = pdfZoomFitWidth            Case CMD_FITPAGE: ZoomMode = pdfZoomFitPage            Case CMD_FINDPREV: RunSearchFromEdit True            Case CMD_FINDNEXT: RunSearchFromEdit False            Case CMD_PRINT: PrintDocument True        End Select        Invalidate    End Sub    Private Function ToolbarLabelText(ByVal Cmd As Long) As String        Select Case Cmd            Case CMD_PAGELABEL                If HasDoc() Then ToolbarLabelText = CStr(m_CurPage + 1) & " / " & CStr(m_Count) Else ToolbarLabelText = "- / -"            Case CMD_ZOOMLABEL                If HasDoc() Then ToolbarLabelText = CStr(CLng(m_Zoom)) & " %" Else ToolbarLabelText = "- %"            Case CMD_FINDCOUNT                ' "Resultados de la busqueda x/x" (con tilde: U+00FA)                ToolbarLabelText = "Resultados de la b" & ChrW$(&HFA) & "squeda "                If m_MatchCount > 0 Then                    ToolbarLabelText = ToolbarLabelText & CStr(m_MatchPos + 1) & "/" & CStr(m_MatchCount)                Else                    ToolbarLabelText = ToolbarLabelText & "0/0"                End If        End Select    End Function    Private Sub EnsureGdipText()        If Not m_GdipOK Or m_gpFont <> 0 Then Exit Sub        If GdipCreateFontFamilyFromName(StrPtr("Segoe UI"), 0, m_gpFamily) <> GP_OK Then            GdipCreateFontFamilyFromName StrPtr("Tahoma"), 0, m_gpFamily        End If        If m_gpFamily = 0 Then Exit Sub        GdipCreateFont m_gpFamily, CSng(MulDiv(12, m_Dpi, 96)), FontStyleRegular, UnitPixel, m_gpFont        GdipCreateStringFormat StringFormatFlagsNoWrap, 0, m_gpFormat        If m_gpFormat <> 0 Then            GdipSetStringFormatAlign m_gpFormat, StringAlignmentCenter            GdipSetStringFormatLineAlign m_gpFormat, StringAlignmentCenter            GdipSetStringFormatTrimming m_gpFormat, StringTrimmingEllipsisCharacter        End If        GdipCreateFont m_gpFamily, CSng(MulDiv(12, m_Dpi, 96)), FontStyleBold, UnitPixel, m_gpFontBold        GdipCreateFont m_gpFamily, CSng(MulDiv(11, m_Dpi, 96)), FontStyleRegular, UnitPixel, m_gpFontSmall        Dim typo As LongPtr        If GdipStringFormatGetGenericTypographic(typo) = GP_OK And typo <> 0 Then            If GdipCloneStringFormat(typo, m_gpFormatTypo) = GP_OK And m_gpFormatTypo <> 0 Then                GdipSetStringFormatFlags m_gpFormatTypo, StringFormatFlagsNoWrap Or StringFormatFlagsMeasureTrailingSpaces                GdipSetStringFormatLineAlign m_gpFormatTypo, StringAlignmentCenter                GdipSetStringFormatTrimming m_gpFormatTypo, StringTrimmingEllipsisCharacter            End If        End If        GdipCreateStringFormat StringFormatFlagsNoWrap, 0, m_gpFormatLeft        If m_gpFormatLeft <> 0 Then            GdipSetStringFormatAlign m_gpFormatLeft, StringAlignmentNear            GdipSetStringFormatLineAlign m_gpFormatLeft, StringAlignmentCenter            GdipSetStringFormatTrimming m_gpFormatLeft, StringTrimmingEllipsisCharacter        End If    End Sub    Private Sub FreeGdipText()        If m_gpFormat <> 0 Then GdipDeleteStringFormat m_gpFormat        If m_gpFormatLeft <> 0 Then GdipDeleteStringFormat m_gpFormatLeft        If m_gpFormatTypo <> 0 Then GdipDeleteStringFormat m_gpFormatTypo        If m_gpFontBold <> 0 Then GdipDeleteFont m_gpFontBold        If m_gpFontSmall <> 0 Then GdipDeleteFont m_gpFontSmall        If m_gpFont <> 0 Then GdipDeleteFont m_gpFont        If m_gpFamily <> 0 Then GdipDeleteFontFamily m_gpFamily        m_gpFormat = 0        m_gpFormatLeft = 0        m_gpFormatTypo = 0        m_gpFontBold = 0        m_gpFontSmall = 0        m_gpFont = 0        m_gpFamily = 0    End Sub    Private Sub DrawGpText(ByVal g As LongPtr, ByVal Text As String, ByRef r As RECT, ByVal Argb As Long, Optional ByVal AlignLeft As Boolean = False, Optional ByVal Font As LongPtr = 0)        Dim rf As RECTF, br As LongPtr, fmt As LongPtr        If Font = 0 Then Font = m_gpFont        If Font = 0 Or Len(Text) = 0 Then Exit Sub        rf.Left = r.Left        rf.Top = r.Top        rf.Width = r.Right - r.Left        rf.Height = r.Bottom - r.Top        If AlignLeft Then fmt = m_gpFormatLeft Else fmt = m_gpFormat        br = GpBrush(Argb)        GdipDrawString g, StrPtr(Text), Len(Text), Font, rf, fmt, br        GdipDeleteBrush br    End Sub    ' Prepara un objeto Graphics de GDI+ con antialias sobre el DC.    Private Function BeginGdip(ByVal hdc As LongPtr) As LongPtr        Dim g As LongPtr        If Not m_GdipOK Then Exit Function        If GdipCreateFromHDC(hdc, g) <> GP_OK Then Exit Function        GdipSetSmoothingMode g, SmoothingModeAntiAlias        GdipSetPixelOffsetMode g, PixelOffsetModeHalf        GdipSetTextRenderingHint g, TextRenderingHintClearTypeGridFit        EnsureGdipText        BeginGdip = g    End Function    Private Sub DrawToolbar(ByVal hdc As LongPtr)        Dim g As LongPtr, i As Long, r As RECT, br As LongPtr, pn As LongPtr        Dim faceRef As Long, textArgb As Long, grayArgb As Long, lineArgb As Long        Dim w As Single, h As Single, x As Single, rad As Single        faceRef = GetSysColor(COLOR_BTNFACE)        r = MakeRect(0, 0, m_ClientW, m_ViewY)        FillSolid hdc, r, faceRef        g = BeginGdip(hdc)        If g = 0 Then Exit Sub        textArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT))        grayArgb = ArgbFromColorRef(GetSysColor(COLOR_GRAYTEXT))        lineArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW))        rad = Px(4)        br = GpBrush(ArgbFromColorRef(faceRef))        GdipFillRectangle g, br, 0, 0, m_ClientW, m_ViewY        GdipDeleteBrush br        pn = GpPen(lineArgb, 1)        GdipDrawLine g, pn, 0, m_ViewY - 0.5, m_ClientW, m_ViewY - 0.5        GdipDeletePen pn        For i = 0 To m_TbCount - 1            If Not m_TbPanel(i) And m_TbRect(i).Right > m_TbRect(i).Left Then                r = m_TbRect(i)                If r.Left >= m_ClientW Then Exit For                x = r.Left                w = r.Right - r.Left                h = r.Bottom - r.Top                Select Case m_TbKind(i)                    Case TBK_BUTTON                        DrawToolbarButton g, i, rad                    Case TBK_LABEL                        GpFillRoundRect g, x + 0.5, r.Top + Px(2) + 0.5, w - 1, h - Px(4) - 1, rad, &HFFFFFFFF, lineArgb, 1                        DrawGpText g, ToolbarLabelText(m_TbCmd(i)), r, IIf(HasDoc(), textArgb, grayArgb)                    Case TBK_SEP                        pn = GpPen(lineArgb, 1)                        GdipDrawLine g, pn, x + w / 2, r.Top + Px(4), x + w / 2, r.Bottom - Px(4)                        GdipDeletePen pn                End Select            End If        Next        GdipDeleteGraphics g    End Sub    ' Panel de busqueda: cuadro de texto, linea de resultados y flechas.    Private Sub DrawSearchPanel(ByVal hdc As LongPtr)        Dim g As LongPtr, r As RECT, br As LongPtr, pn As LongPtr, lineArgb As Long, accentArgb As Long, rad As Single, i As Long        r = MakeRect(0, m_ViewY, m_ViewX, m_FullH)        FillSolid hdc, r, ToColorRef(m_ThumbBackColor)        r = MakeRect(m_ViewX - 1, m_ViewY, m_ViewX, m_FullH)        FillSolid hdc, r, GetSysColor(COLOR_BTNSHADOW)        g = BeginGdip(hdc)        If g = 0 Then Exit Sub        lineArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW))        accentArgb = ArgbFromColorRef(ToColorRef(m_SelColor))        rad = Px(4)        ' Recuadro del cuadro de busqueda (el EDIT va dentro)        r = m_TbRect(m_EditIdx)        If r.Right > r.Left Then            If GetFocus() = m_hEdit And m_hEdit <> 0 Then                GpFillRoundRect g, r.Left + 0.5, r.Top + 0.5, r.Right - r.Left - 1, r.Bottom - r.Top - 1, rad, &HFFFFFFFF, accentArgb, 1.5            Else                GpFillRoundRect g, r.Left + 0.5, r.Top + 0.5, r.Right - r.Left - 1, r.Bottom - r.Top - 1, rad, &HFFFFFFFF, lineArgb, 1            End If        End If        ' "Resultados de la busqueda x/x"        r = m_TbRect(m_CountIdx)        If r.Right > r.Left Then DrawGpText g, ToolbarLabelText(CMD_FINDCOUNT), r, ArgbFromColorRef(GetSysColor(IIf(m_Searched And m_MatchCount = 0, COLOR_GRAYTEXT, COLOR_BTNTEXT))), True        ' Flechas arriba / abajo        For i = 0 To m_TbCount - 1            If m_TbPanel(i) And m_TbKind(i) = TBK_BUTTON Then                If m_TbRect(i).Right > m_TbRect(i).Left Then DrawToolbarButton g, i, rad            End If        Next        DrawResultList g, rad        GdipDeleteGraphics g    End Sub    ' Lista de resultados: "Pagina N" y un extracto con la coincidencia resaltada.    Private Sub DrawResultList(ByVal g As LongPtr, ByVal rad As Single)        Dim r As RECT, ir As RECT, j As Long, y As Long, ih As Long, pn As LongPtr, br As LongPtr        Dim lineArgb As Long, grayArgb As Long, msg As String, viewH As Long, barH As Long, barY As Long        r = m_ResRect        If r.Right <= r.Left Then Exit Sub        lineArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW))        grayArgb = ArgbFromColorRef(GetSysColor(COLOR_GRAYTEXT))        GpFillRoundRect g, r.Left + 0.5, r.Top + 0.5, r.Right - r.Left - 1, r.Bottom - r.Top - 1, rad, &HFFFFFFFF, lineArgb, 1        If m_MatchCount = 0 Then            If m_Searched Then msg = "Sin resultados" Else msg = "Escribe el texto y pulsa Intro"            ir = MakeRect(r.Left + Px(6), r.Top + Px(8), r.Right - Px(6), r.Top + Px(32))            DrawGpText g, msg, ir, grayArgb            Exit Sub        End If        ih = Px(RES_ITEM_H)        viewH = ResultListHeight()        GdipSetClipRect g, r.Left + 1, r.Top + 1, r.Right - r.Left - 2, viewH, CombineModeReplace        pn = GpPen(ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW), &H50), 1)        For j = m_ResScroll \ ih To m_MatchCount - 1            y = r.Top + 1 + j * ih - m_ResScroll            If y > r.Bottom Then Exit For            ir = MakeRect(r.Left + 1, y, r.Right - 1, y + ih)            If j = m_MatchPos Then                br = GpBrush(ArgbFromColorRef(ToColorRef(m_SelColor), &H30))                GdipFillRectangle g, br, ir.Left, ir.Top, ir.Right - ir.Left, ih                GdipDeleteBrush br                br = GpBrush(ArgbFromColorRef(ToColorRef(m_SelColor)))                GdipFillRectangle g, br, ir.Left, ir.Top, Px(3), ih                GdipDeleteBrush br            ElseIf j = m_ResHot Then                br = GpBrush(&H14000000)                GdipFillRectangle g, br, ir.Left, ir.Top, ir.Right - ir.Left, ih                GdipDeleteBrush br            End If            ' Linea 1: pagina            DrawGpText g, "P" & ChrW$(&HE1) & "gina " & CStr(m_MatchPage(j) + 1), MakeRect(ir.Left + Px(10), y + Px(4), ir.Right - Px(8), y + Px(20)), grayArgb, True, m_gpFontSmall            ' Linea 2: extracto            DrawSnippet g, j, ir.Left + Px(10), y + Px(20), ir.Right - Px(8), y + ih - Px(5)            GdipDrawLine g, pn, ir.Left + Px(8), y + ih - 0.5, ir.Right - Px(8), y + ih - 0.5        Next        GdipDeletePen pn        GdipResetClip g        ' Indicador de desplazamiento        If m_MatchCount * ih > viewH And viewH > 0 Then            barH = IMax(Px(20), CLng(CDbl(viewH) * viewH / (m_MatchCount * ih)))            barY = CLng(CDbl(viewH - barH) * m_ResScroll / (m_MatchCount * ih - viewH))            br = GpBrush(ArgbFromColorRef(GetSysColor(COLOR_BTNSHADOW), &HB0))            GdipFillRectangle g, br, r.Right - Px(5), r.Top + 1 + barY, Px(3), barH            GdipDeleteBrush br        End If    End Sub    ' Extracto en una linea: contexto previo + coincidencia (negrita sobre el    ' color de busqueda) + contexto posterior recortado con puntos suspensivos.    Private Sub DrawSnippet(ByVal g As LongPtr, ByVal j As Long, ByVal x0 As Long, ByVal y0 As Long, ByVal x1 As Long, ByVal y1 As Long)        Dim x As Single, w As Single, textArgb As Long, h As Single        If m_gpFont = 0 Or m_gpFontBold = 0 Or m_gpFormatTypo = 0 Then Exit Sub        textArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT))        h = y1 - y0        x = x0        If Len(m_MatchPre(j)) > 0 Then            w = MeasureGpText(g, m_MatchPre(j), m_gpFont)            If x + w > x1 Then w = x1 - x            DrawGpSegment g, m_MatchPre(j), m_gpFont, x, y0, w, h, textArgb            x = x + w        End If        If x < x1 Then            w = MeasureGpText(g, m_MatchHit(j), m_gpFontBold)            If x + w > x1 Then w = x1 - x            GpFillRoundRect g, x - 1, y0 + 1, w + 2, h - 2, Px(2), ArgbFromColorRef(ToColorRef(m_FindColor), &HC0)            DrawGpSegment g, m_MatchHit(j), m_gpFontBold, x, y0, w, h, textArgb            x = x + w        End If        If x < x1 And Len(m_MatchPost(j)) > 0 Then            DrawGpSegment g, m_MatchPost(j), m_gpFont, x, y0, x1 - x, h, textArgb        End If    End Sub    Private Function MeasureGpText(ByVal g As LongPtr, ByVal Text As String, ByVal Font As LongPtr) As Single        Dim lr As RECTF, bb As RECTF        If Len(Text) = 0 Or Font = 0 Then Exit Function        lr.Width = 100000        lr.Height = 1000        If GdipMeasureString(g, StrPtr(Text), Len(Text), Font, lr, m_gpFormatTypo, bb, 0, 0) = GP_OK Then MeasureGpText = bb.Width    End Function    Private Sub DrawGpSegment(ByVal g As LongPtr, ByVal Text As String, ByVal Font As LongPtr, ByVal x As Single, ByVal y As Single, ByVal w As Single, ByVal h As Single, ByVal Argb As Long)        Dim rf As RECTF, br As LongPtr        If Len(Text) = 0 Or w <= 0 Then Exit Sub        rf.Left = x        rf.Top = y        rf.Width = w        rf.Height = h        br = GpBrush(Argb)        GdipDrawString g, StrPtr(Text), Len(Text), Font, rf, m_gpFormatTypo, br        GdipDeleteBrush br    End Sub    Private Sub DrawToolbarButton(ByVal g As LongPtr, ByVal i As Long, ByVal rad As Single)        Dim r As RECT, cmd As Long, enabled As Boolean, checked As Boolean        Dim fillArgb As Long, borderArgb As Long, iconArgb As Long, accentRef As Long        r = m_TbRect(i)        cmd = m_TbCmd(i)        enabled = ToolbarItemEnabled(cmd)        checked = ToolbarItemChecked(cmd)        accentRef = ToColorRef(m_SelColor)        If checked Then            fillArgb = ArgbFromColorRef(accentRef, &H40)            borderArgb = ArgbFromColorRef(accentRef, &HA0)        End If        If enabled Then            If i = m_TbDown And i = m_TbHot Then                fillArgb = &H38000000            ElseIf i = m_TbHot Or i = m_TbDown Then                If Not checked Then fillArgb = &H1C000000 Else fillArgb = ArgbFromColorRef(accentRef, &H60)            End If        End If        If fillArgb <> 0 Or borderArgb <> 0 Then            GpFillRoundRect g, r.Left + 0.5, r.Top + 0.5, r.Right - r.Left - 1, r.Bottom - r.Top - 1, rad, fillArgb, borderArgb, 1        End If        If enabled Then iconArgb = ArgbFromColorRef(GetSysColor(COLOR_BTNTEXT)) Else iconArgb = ArgbFromColorRef(GetSysColor(COLOR_GRAYTEXT))        DrawToolbarIcon g, cmd, (r.Left + r.Right) / 2, (r.Top + r.Bottom) / 2, Px(8), iconArgb    End Sub    ' Iconos vectoriales: (cx, cy) es el centro y s la mitad del tamano.    Private Sub DrawToolbarIcon(ByVal g As LongPtr, ByVal Cmd As Long, ByVal cx As Single, ByVal cy As Single, ByVal s As Single, ByVal Argb As Long)        Dim pn As LongPtr, br As LongPtr, lw As Single, pts(0 To 2) As POINTF, fp(0 To 6) As POINTF        lw = s / 5        If lw < 1.5 Then lw = 1.5        pn = GpPen(Argb, lw)        br = GpBrush(Argb)        Select Case Cmd            Case CMD_OPEN                ' Carpeta: pestana y cuerpo                fp(0) = PtF(cx - s * 0.85, cy + s * 0.65)                fp(1) = PtF(cx - s * 0.85, cy - s * 0.6)                fp(2) = PtF(cx - s * 0.3, cy - s * 0.6)                fp(3) = PtF(cx - s * 0.12, cy - s * 0.38)                fp(4) = PtF(cx + s * 0.85, cy - s * 0.38)                fp(5) = PtF(cx + s * 0.85, cy + s * 0.65)                fp(6) = fp(0)                GdipDrawLines g, pn, fp(0), 7                GdipDrawLine g, pn, cx - s * 0.85, cy - s * 0.12, cx + s * 0.85, cy - s * 0.12            Case CMD_SAVE                ' Disquete: contorno, etiqueta superior y zona inferior                GpFillRoundRect g, cx - s * 0.75, cy - s * 0.75, s * 1.5, s * 1.5, s * 0.15, 0, Argb, lw                GdipDrawRectangle g, pn, cx - s * 0.38, cy - s * 0.75, s * 0.76, s * 0.45                GdipFillRectangle g, br, cx - s * 0.45, cy + s * 0.12, s * 0.9, s * 0.5            Case CMD_FIRST                GdipDrawLine g, pn, cx - s * 0.6, cy - s * 0.65, cx - s * 0.6, cy + s * 0.65                GpFillTriangle g, br, cx + s * 0.6, cy - s * 0.65, cx + s * 0.6, cy + s * 0.65, cx - s * 0.3, cy            Case CMD_PREV                GpFillTriangle g, br, cx + s * 0.45, cy - s * 0.65, cx + s * 0.45, cy + s * 0.65, cx - s * 0.5, cy            Case CMD_NEXT                GpFillTriangle g, br, cx - s * 0.45, cy - s * 0.65, cx - s * 0.45, cy + s * 0.65, cx + s * 0.5, cy            Case CMD_LAST                GdipDrawLine g, pn, cx + s * 0.6, cy - s * 0.65, cx + s * 0.6, cy + s * 0.65                GpFillTriangle g, br, cx - s * 0.6, cy - s * 0.65, cx - s * 0.6, cy + s * 0.65, cx + s * 0.3, cy            Case CMD_ZOOMOUT                GdipDrawLine g, pn, cx - s * 0.65, cy, cx + s * 0.65, cy            Case CMD_ZOOMIN                GdipDrawLine g, pn, cx - s * 0.65, cy, cx + s * 0.65, cy                GdipDrawLine g, pn, cx, cy - s * 0.65, cx, cy + s * 0.65            Case CMD_FITWIDTH                ' |<-->|  ajustar al ancho                GdipDrawLine g, pn, cx - s * 0.85, cy - s * 0.6, cx - s * 0.85, cy + s * 0.6                GdipDrawLine g, pn, cx + s * 0.85, cy - s * 0.6, cx + s * 0.85, cy + s * 0.6                GdipDrawLine g, pn, cx - s * 0.4, cy, cx + s * 0.4, cy                GpFillTriangle g, br, cx - s * 0.62, cy, cx - s * 0.3, cy - s * 0.32, cx - s * 0.3, cy + s * 0.32                GpFillTriangle g, br, cx + s * 0.62, cy, cx + s * 0.3, cy - s * 0.32, cx + s * 0.3, cy + s * 0.32            Case CMD_FITPAGE                ' pagina con flechas hacia sus bordes superior e inferior: ajustar pagina                GdipDrawRectangle g, pn, cx - s * 0.55, cy - s * 0.8, s * 1.1, s * 1.6                GpFillTriangle g, br, cx, cy - s * 0.55, cx - s * 0.3, cy - s * 0.18, cx + s * 0.3, cy - s * 0.18                GpFillTriangle g, br, cx, cy + s * 0.55, cx - s * 0.3, cy + s * 0.18, cx + s * 0.3, cy + s * 0.18            Case CMD_SEARCHPANEL                GdipDrawEllipse g, pn, cx - s * 0.75, cy - s * 0.75, s * 1.1, s * 1.1                GdipDrawLine g, pn, cx + s * 0.22, cy + s * 0.22, cx + s * 0.72, cy + s * 0.72            Case CMD_FINDPREV                pts(0) = PtF(cx - s * 0.6, cy + s * 0.3)                pts(1) = PtF(cx, cy - s * 0.3)                pts(2) = PtF(cx + s * 0.6, cy + s * 0.3)                GdipDrawLines g, pn, pts(0), 3            Case CMD_FINDNEXT                pts(0) = PtF(cx - s * 0.6, cy - s * 0.3)                pts(1) = PtF(cx, cy + s * 0.3)                pts(2) = PtF(cx + s * 0.6, cy - s * 0.3)                GdipDrawLines g, pn, pts(0), 3            Case CMD_THUMBS                GdipDrawRectangle g, pn, cx - s * 0.75, cy - s * 0.65, s * 1.5, s * 1.3                GdipFillRectangle g, br, cx - s * 0.75, cy - s * 0.65, s * 0.5, s * 1.3            Case CMD_PRINT                GdipDrawRectangle g, pn, cx - s * 0.4, cy - s * 0.8, s * 0.8, s * 0.45                GpFillRoundRect g, cx - s * 0.8, cy - s * 0.35, s * 1.6, s * 0.8, s * 0.15, 0, Argb, lw                GpFillRoundRect g, cx - s * 0.45, cy + s * 0.1, s * 0.9, s * 0.7, 0.5, &HFFFFFFFF, Argb, lw        End Select        GdipDeleteBrush br        GdipDeletePen pn    End Sub    ' --- Cuadro de busqueda (EDIT de Win32 como ventana hija del panel) -----    Private Sub CreateSearchEdit()        If m_hEdit <> 0 Or m_hWnd = 0 Then Exit Sub        m_hEdit = CreateWindowExW(0, StrPtr("EDIT"), 0, WS_CHILD Or WS_TABSTOP Or ES_AUTOHSCROLL, 0, 0, 10, 10, m_hWnd, 0, GetModuleHandleW(0), 0)        If m_hEdit = 0 Then Exit Sub        If m_hFont <> 0 Then SendMessageW m_hEdit, WM_SETFONT, m_hFont, 1        SendMessageW m_hEdit, EM_SETCUEBANNER, 1, StrPtr("Buscar en el documento...")        m_EditSubclassed = (SetWindowSubclass(m_hEdit, ucPdfSubclassAddress(), 2, ObjPtr(Me)) <> 0)    End Sub    Private Function EditWindowProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr        Select Case uMsg            Case WM_GETDLGCODE                ' Recibir Intro y Esc en lugar de que los procese el formulario.                EditWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam) Or DLGC_WANTALLKEYS                Exit Function            Case WM_KEYDOWN                Select Case CLng(wParam And &HFFFF&)                    Case VK_RETURN, VK_F3                        RunSearchFromEdit (GetKeyState(VK_SHIFT) < 0)                        Exit Function                    Case VK_ESCAPE                        SetFocusAPI m_hWnd                        Exit Function                End Select            Case WM_CHAR                ' Evita el pitido de Intro/Esc en un EDIT de una linea.                If wParam = 13 Or wParam = 27 Then Exit Function            Case WM_SETFOCUS, WM_KILLFOCUS                Invalidate            Case WM_NCDESTROY                StopEditSubclass                EditWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)                m_hEdit = 0                Exit Function        End Select        EditWindowProc = DefSubclassProc(hWnd, uMsg, wParam, lParam)        ' Al escribir se actualiza el estado de las flechas del panel.        If uMsg = WM_CHAR Then Invalidate    End Function    Private Function GetSearchEditText() As String        Dim n As Long, buf As String, r As Long        If m_hEdit = 0 Then Exit Function        n = GetWindowTextLengthW(m_hEdit)        If n <= 0 Then Exit Function        buf = String$(n + 1, vbNullChar)        r = GetWindowTextW(m_hEdit, StrPtr(buf), n + 1)        If r > 0 Then GetSearchEditText = Left$(buf, r)    End Function    Private Sub SyncSearchEdit()        If m_hEdit = 0 Then Exit Sub        If GetSearchEditText() <> m_FindText Then SetWindowTextW m_hEdit, StrPtr(m_FindText)    End Sub    ' Intro / flechas: si el texto no ha cambiado pasa a la siguiente (o a la    ' anterior); si ha cambiado lanza una busqueda nueva.    Private Sub RunSearchFromEdit(ByVal Backward As Boolean)        Dim t As String        t = GetSearchEditText()        If Len(t) = 0 Then            ClearSearch            Exit Sub        End If        If m_Searched And t = m_FindText Then            If Backward Then FindPrevious Else FindNext        Else            FindText t        End If        Invalidate    End Sub    ' Abre el panel de busqueda y pone el foco en el cuadro de texto.    Public Sub FocusSearchBox()        If Not m_ShowSearch Then            ShowSearchPanel = True            Exit Sub        End If        If m_hEdit = 0 Or Not PanelVisible() Then Exit Sub        SetFocusAPI m_hEdit        SendMessageW m_hEdit, EM_SETSEL, 0, -1    End Sub    ' --- Abrir / guardar con cuadro de dialogo --------------------------------    ' Muestra el dialogo de Windows. Devuelve la ruta elegida ("" si se cancela).    Private Function FileDialog(ByVal SaveMode As Boolean, ByVal Title As String, ByVal InitialDir As String, ByVal InitialName As String) As String        Dim ofn As OPENFILENAMEW, buf As String, flt As String, defExt As String, ok As Long, k As Long        Const MAXPATH As Long = 4096        flt = "Documentos PDF (*.pdf)" & vbNullChar & "*.pdf" & vbNullChar & _                 "Todos los archivos (*.*)" & vbNullChar & "*.*" & vbNullChar & vbNullChar        If Len(InitialName) >= MAXPATH Then InitialName = ""        buf = InitialName & String$(MAXPATH - Len(InitialName), vbNullChar)        defExt = "pdf"        With ofn            .lStructSize = LenB(ofn)            .hwndOwner = GetAncestor(m_hWnd, GA_ROOT)            .lpstrFilter = StrPtr(flt)            .nFilterIndex = 1            .lpstrFile = StrPtr(buf)            .nMaxFile = MAXPATH            If Len(InitialDir) > 0 Then .lpstrInitialDir = StrPtr(InitialDir)            .lpstrTitle = StrPtr(Title)            .lpstrDefExt = StrPtr(defExt)            If SaveMode Then                .Flags = OFN_EXPLORER Or OFN_ENABLESIZING Or OFN_HIDEREADONLY Or OFN_PATHMUSTEXIST Or OFN_OVERWRITEPROMPT Or OFN_NOREADONLYRETURN            Else                .Flags = OFN_EXPLORER Or OFN_ENABLESIZING Or OFN_HIDEREADONLY Or OFN_PATHMUSTEXIST Or OFN_FILEMUSTEXIST            End If        End With        If SaveMode Then ok = GetSaveFileNameW(ofn) Else ok = GetOpenFileNameW(ofn)        If ok = 0 Then Exit Function        k = InStr(1, buf, vbNullChar)        If k > 1 Then FileDialog = Left$(buf, k - 1)    End Function    ' Abre un PDF eligiendolo en el dialogo. Por defecto muestra la carpeta del    ' documento actual (o la ultima usada). Devuelve True si se cargo.    Public Function ShowOpenDialog() As Boolean        Dim selPath As String, initDir As String        If m_hWnd = 0 Then Exit Function        If Len(m_FileName) > 0 Then initDir = PathFolder(m_FileName) Else initDir = m_LastDir        selPath = FileDialog(False, "Abrir PDF", initDir, "")        If Len(selPath) = 0 Then Exit Function        m_LastDir = PathFolder(selPath)        ShowOpenDialog = LoadFile(selPath)    End Function    ' Guarda una copia del PDF eligiendo destino en el dialogo. Por defecto    ' propone la carpeta de donde se abrio y el mismo nombre de archivo.    Public Function ShowSaveDialog() As Boolean        Dim selPath As String, initDir As String, initName As String        If m_hWnd = 0 Or Not HasDoc() Then Exit Function        If Len(m_FileName) > 0 Then            initDir = PathFolder(m_FileName)            initName = PathFileName(m_FileName)        Else            initDir = m_LastDir            initName = "documento.pdf"        End If        selPath = FileDialog(True, "Guardar PDF como", initDir, initName)        If Len(selPath) = 0 Then Exit Function        ShowSaveDialog = SaveAs(selPath)    End Function    ' Guarda una copia exacta del documento abierto en la ruta indicada. Si    ' tiene exito, el documento pasa a asociarse con esa ruta (FileName).    Public Function SaveAs(ByVal FileName As String) As Boolean        If Not HasDoc() Or Len(FileName) = 0 Then Exit Function        If Not m_Doc.SaveCopy(FileName) Then Exit Function        m_FileName = FileName        m_LastDir = PathFolder(FileName)        SaveAs = True        RaiseEvent DocumentSaved(FileName)    End Function    ' Mostrar u ocultar desde codigo los botones Abrir y Guardar de la barra.    Public Property Get ShowOpenButton() As Boolean        ShowOpenButton = m_ShowOpenBtn    End Property    Public Property Let ShowOpenButton(ByVal Value As Boolean)        m_ShowOpenBtn = Value        PropertyChanged "ShowOpenButton"        RefreshView False    End Property    Public Property Get ShowSaveButton() As Boolean        ShowSaveButton = m_ShowSaveBtn    End Property    Public Property Let ShowSaveButton(ByVal Value As Boolean)        m_ShowSaveBtn = Value        PropertyChanged "ShowSaveButton"        RefreshView False    End Property    Public Property Get ShowToolbar() As Boolean        ShowToolbar = m_ShowToolbar    End Property    Public Property Let ShowToolbar(ByVal Value As Boolean)        m_ShowToolbar = Value        PropertyChanged "ShowToolbar"        RefreshView False    End Property    ' ========================================================================    '  APARTADO 4 - Integracion: DPI    ' ========================================================================    Private Sub UpdateDpi()        Dim d As Long, hdc As LongPtr        On Error Resume Next        d = GetDpiForWindow(m_hWnd)         ' Windows 10 1607+        On Error GoTo 0        If d <= 0 Then            hdc = GetDC(0)            d = GetDeviceCaps(hdc, LOGPIXELSX)            ReleaseDC 0, hdc        End If        If d <= 0 Then d = 96        If d = m_Dpi And m_hFont <> 0 Then Exit Sub        m_Dpi = d        If m_hFont <> 0 Then DeleteObject m_hFont        m_hFont = CreateFontW(-MulDiv(9, m_Dpi, 72), 0, 0, 0, 400, 0, 0, 0, 1, 0, 0, 5, 0, StrPtr("Segoe UI"))        If m_hEdit <> 0 Then SendMessageW m_hEdit, WM_SETFONT, m_hFont, 1        FreeGdipText    End Sub    Public Property Get Dpi() As Long        Dpi = m_Dpi    End Property    ' ========================================================================    '  APARTADO 4 - Integracion: propiedades    ' ========================================================================    Private Sub RefreshView(Optional ByVal UseAnchor As Boolean = True)        If m_hWnd <> 0 Then            RefreshLayout UseAnchor        Else            UserControl.Refresh        End If    End Sub    Public Property Get hWnd() As LongPtr        hWnd = UserControl.hWnd    End Property    Public Property Get Is64Bit() As Boolean        #If Win64 Then            Is64Bit = True        #End If    End Property    Public Property Get PdfiumLoadedFrom() As String        PdfiumLoadedFrom = PdfiumLoadedPath    End Property    Public Property Get IsLoaded() As Boolean        IsLoaded = HasDoc()    End Property    Public Property Get PageCount() As Long        If HasDoc() Then PageCount = m_Count    End Property    Public Property Get CurrentPage() As Long        If HasDoc() Then CurrentPage = m_CurPage + 1    End Property    Public Property Let CurrentPage(ByVal Value As Long)        GoToPage Value    End Property    ' Tamano de la pagina en puntos (1/72").    Public Function GetPageSize(ByVal Page As Long, ByRef Width As Double, ByRef Height As Double) As Boolean        If Not HasDoc() Or Page < 1 Or Page > m_Count Then Exit Function        Width = m_Doc.PageWidth(Page - 1)        Height = m_Doc.PageHeight(Page - 1)        GetPageSize = True    End Function    Public Property Get LastError() As Long        LastError = m_Doc.LastError    End Property    Public Property Get LastErrorText() As String        LastErrorText = m_Doc.LastErrorText    End Property    Public Property Get BackColor() As OLE_COLOR        BackColor = m_BackColor    End Property    Public Property Let BackColor(ByVal Value As OLE_COLOR)        m_BackColor = Value        PropertyChanged "BackColor"        Invalidate    End Property    Public Property Get ThumbnailBackColor() As OLE_COLOR        ThumbnailBackColor = m_ThumbBackColor    End Property    Public Property Let ThumbnailBackColor(ByVal Value As OLE_COLOR)        m_ThumbBackColor = Value        PropertyChanged "ThumbnailBackColor"        Invalidate    End Property    Public Property Get SelectionColor() As OLE_COLOR        SelectionColor = m_SelColor    End Property    Public Property Let SelectionColor(ByVal Value As OLE_COLOR)        m_SelColor = Value        PropertyChanged "SelectionColor"        Invalidate    End Property    Public Property Get SearchHighlightColor() As OLE_COLOR        SearchHighlightColor = m_FindColor    End Property    Public Property Let SearchHighlightColor(ByVal Value As OLE_COLOR)        m_FindColor = Value        PropertyChanged "SearchHighlightColor"        Invalidate    End Property    Public Property Get BorderStyle() As ucPdfBorderStyle        BorderStyle = m_BorderStyle    End Property    Public Property Let BorderStyle(ByVal Value As ucPdfBorderStyle)        m_BorderStyle = Value        PropertyChanged "BorderStyle"        Invalidate    End Property    Public Property Get PageGap() As Long        PageGap = m_PageGap    End Property    Public Property Let PageGap(ByVal Value As Long)        m_PageGap = IMax(0, IMin(Value, 200))        PropertyChanged "PageGap"        RefreshView    End Property    Public Property Get Zoom() As Double        Zoom = m_Zoom    End Property    Public Property Let Zoom(ByVal Value As Double)        If m_hWnd <> 0 Then            ZoomAt Value, ViewCenterX(), ViewCenterY()        Else            m_Zoom = ClampZoom(Value)            m_ZoomMode = pdfZoomCustom            PropertyChanged "Zoom"            PropertyChanged "ZoomMode"        End If    End Property    Public Property Get ZoomMode() As ucPdfZoomMode        ZoomMode = m_ZoomMode    End Property    Public Property Let ZoomMode(ByVal Value As ucPdfZoomMode)        m_ZoomMode = Value        PropertyChanged "ZoomMode"        RefreshView    End Property    Public Property Get Rotation() As ucPdfRotation        Rotation = m_Rotation    End Property    Public Property Let Rotation(ByVal Value As ucPdfRotation)        Value = Value And 3        If Value = m_Rotation Then Exit Property        m_Rotation = Value        PropertyChanged "Rotation"        RefreshView    End Property    Public Property Get ShowThumbnails() As Boolean        ShowThumbnails = m_ShowThumbs    End Property    Public Property Let ShowThumbnails(ByVal Value As Boolean)        m_ShowThumbs = Value        If Value Then m_ShowSearch = False        PropertyChanged "ShowThumbnails"        LayoutSearchEdit        RefreshView        EnsureThumbVisible m_CurPage    End Property    ' Panel de busqueda a la izquierda (sustituye a las miniaturas mientras esta abierto).    Public Property Get ShowSearchPanel() As Boolean        ShowSearchPanel = m_ShowSearch    End Property    Public Property Let ShowSearchPanel(ByVal Value As Boolean)        If Value = m_ShowSearch Then Exit Property        m_ShowSearch = Value        If Value Then m_ShowThumbs = False        PropertyChanged "ShowThumbnails"        RefreshView        LayoutSearchEdit        If Value Then            FocusSearchBox        ElseIf m_hEdit <> 0 Then            If GetFocus() = m_hEdit Then SetFocusAPI m_hWnd        End If    End Property    Public Property Get ThumbnailWidth() As Long        ThumbnailWidth = m_ThumbWidth    End Property    Public Property Let ThumbnailWidth(ByVal Value As Long)        m_ThumbWidth = IMax(48, IMin(Value, 600))        PropertyChanged "ThumbnailWidth"        RefreshView    End Property    Public Property Get CursorMode() As ucPdfCursorMode        CursorMode = m_CursorMode    End Property    Public Property Let CursorMode(ByVal Value As ucPdfCursorMode)        m_CursorMode = Value        PropertyChanged "CursorMode"    End Property    Public Property Get PdfiumPath() As String        PdfiumPath = m_PdfiumPath    End Property    Public Property Let PdfiumPath(ByVal Value As String)        m_PdfiumPath = Value        PropertyChanged "PdfiumPath"    End Property    Public Property Get FileName() As String        FileName = m_FileName    End Property    Public Property Let FileName(ByVal Value As String)        If m_UserMode And m_hWnd <> 0 Then            If Len(Value) > 0 Then LoadFile Value Else CloseDocument        Else            m_FileName = Value        End If        PropertyChanged "FileName"    End Property    Public Property Get EmptyText() As String        EmptyText = m_EmptyText    End Property    Public Property Let EmptyText(ByVal Value As String)        m_EmptyText = Value        PropertyChanged "EmptyText"        Invalidate    End Property    Public Sub Refresh()        RefreshView False    End SubEnd Class