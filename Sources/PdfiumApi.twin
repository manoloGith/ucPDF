' ============================================================================'  PdfiumApi.twin'  Apartado 1 - Base funcional: carga de PDFium y declaraciones de la API C.''  pdfium.dll se carga dinamicamente con LoadLibraryW desde la ruta indicada'  (o desde App.Path\x86 | App.Path\x64 segun la arquitectura). Una vez el'  modulo esta en memoria, las sentencias Declare ... Lib "pdfium" se'  resuelven contra el modulo ya cargado.''  Binarios recomendados: https://github.com/bblanchon/pdfium-binaries'  (pdfium-win-x86 / pdfium-win-x64).' ============================================================================[Description("Carga dinamica y API de PDFium")]Module PdfiumApi    ' --- Codigos de FPDF_GetLastError ---------------------------------------    Public Const FPDF_ERR_SUCCESS As Long = 0    Public Const FPDF_ERR_UNKNOWN As Long = 1    Public Const FPDF_ERR_FILE As Long = 2    Public Const FPDF_ERR_FORMAT As Long = 3    Public Const FPDF_ERR_PASSWORD As Long = 4    Public Const FPDF_ERR_SECURITY As Long = 5    Public Const FPDF_ERR_PAGE As Long = 6    ' Codigo propio: la biblioteca no se pudo cargar    Public Const FPDF_ERR_NOLIBRARY As Long = -1    ' --- Indicadores de renderizado -----------------------------------------    Public Const FPDF_ANNOT As Long = &H1    Public Const FPDF_LCD_TEXT As Long = &H2    Public Const FPDF_NO_NATIVETEXT As Long = &H4    Public Const FPDF_GRAYSCALE As Long = &H8    Public Const FPDF_PRINTING As Long = &H800    ' --- Formatos de FPDF_BITMAP --------------------------------------------    Public Const FPDFBitmap_Gray As Long = 1    Public Const FPDFBitmap_BGR As Long = 2      ' 24 bpp (no usar con DIB de 32 bpp)    Public Const FPDFBitmap_BGRx As Long = 3     ' 32 bpp sin alfa    Public Const FPDFBitmap_BGRA As Long = 4    ' --- Opciones de busqueda -----------------------------------------------    Public Const FPDF_MATCHCASE As Long = &H1    Public Const FPDF_MATCHWHOLEWORD As Long = &H2    ' CONVENCION DE LLAMADA: las funciones de PDFium se declaran CDecl.    ' fpdfview.h solo usa __stdcall si se compila con FPDFSDK_EXPORTS, y los    ' binarios de bblanchon/pdfium-binaries no lo definen: en Win32 exportan    ' cdecl. Declararlas stdcall descuadra la pila en cada llamada (fallos    ' ACCESS_VIOLATION aleatorios poco despues de llamar a PDFium). En Win64    ' solo hay una convencion y CDecl no cambia nada.    ' --- Biblioteca / documento ---------------------------------------------    Public Declare PtrSafe Sub FPDF_InitLibrary CDecl Lib "pdfium" ()    Public Declare PtrSafe Sub FPDF_DestroyLibrary CDecl Lib "pdfium" ()    Public Declare PtrSafe Function FPDF_GetLastError CDecl Lib "pdfium" () As Long    Public Declare PtrSafe Function FPDF_LoadMemDocument CDecl Lib "pdfium" (ByVal data_buf As LongPtr, ByVal nSize As Long, ByVal password As LongPtr) As LongPtr    Public Declare PtrSafe Sub FPDF_CloseDocument CDecl Lib "pdfium" (ByVal document As LongPtr)    Public Declare PtrSafe Function FPDF_GetPageCount CDecl Lib "pdfium" (ByVal document As LongPtr) As Long    Public Declare PtrSafe Function FPDF_GetPageSizeByIndex CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal page_index As Long, ByRef pWidth As Double, ByRef pHeight As Double) As Long    ' --- Paginas y renderizado ----------------------------------------------    Public Declare PtrSafe Function FPDF_LoadPage CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal page_index As Long) As LongPtr    Public Declare PtrSafe Sub FPDF_ClosePage CDecl Lib "pdfium" (ByVal page As LongPtr)    Public Declare PtrSafe Function FPDFBitmap_CreateEx CDecl Lib "pdfium" (ByVal nWidth As Long, ByVal nHeight As Long, ByVal bmpFormat As Long, ByVal first_scan As LongPtr, ByVal stride As Long) As LongPtr    Public Declare PtrSafe Function FPDFBitmap_FillRect CDecl Lib "pdfium" (ByVal bitmap As LongPtr, ByVal x As Long, ByVal y As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal argb As Long) As Long    Public Declare PtrSafe Sub FPDFBitmap_Destroy CDecl Lib "pdfium" (ByVal bitmap As LongPtr)    Public Declare PtrSafe Sub FPDF_RenderPageBitmap CDecl Lib "pdfium" (ByVal bitmap As LongPtr, ByVal page As LongPtr, ByVal start_x As Long, ByVal start_y As Long, ByVal size_x As Long, ByVal size_y As Long, ByVal rotate As Long, ByVal flags As Long)    Public Declare PtrSafe Function FPDF_DeviceToPage CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal start_x As Long, ByVal start_y As Long, ByVal size_x As Long, ByVal size_y As Long, ByVal rotate As Long, ByVal device_x As Long, ByVal device_y As Long, ByRef page_x As Double, ByRef page_y As Double) As Long    Public Declare PtrSafe Function FPDF_PageToDevice CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal start_x As Long, ByVal start_y As Long, ByVal size_x As Long, ByVal size_y As Long, ByVal rotate As Long, ByVal page_x As Double, ByVal page_y As Double, ByRef device_x As Long, ByRef device_y As Long) As Long    ' --- Edicion y guardado --------------------------------------------------    Public Type FPDF_FILEWRITE        version As Long        WriteBlock As LongPtr    End Type    ' FPDF_MovePages: dest_page_index es el indice final de la pagina movida.    Public Declare PtrSafe Function FPDF_MovePages CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal page_indices As LongPtr, ByVal page_indices_len As Long, ByVal dest_page_index As Long) As Long    Public Declare PtrSafe Function FPDF_SaveAsCopy CDecl Lib "pdfium" (ByVal document As LongPtr, ByRef pFileWrite As FPDF_FILEWRITE, ByVal flags As Long) As Long    Public Const FPDF_INCREMENTAL As Long = 1    Public Const FPDF_NO_INCREMENTAL As Long = 2    ' --- Edicion de paginas ----------------------------------------------------    Public Declare PtrSafe Function FPDFPage_GetRotation CDecl Lib "pdfium" (ByVal page As LongPtr) As Long    Public Declare PtrSafe Sub FPDFPage_SetRotation CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal rotate As Long)    Public Declare PtrSafe Sub FPDFPage_Delete CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal page_index As Long)    Public Declare PtrSafe Function FPDFPage_New CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal page_index As Long, ByVal pWidth As Double, ByVal pHeight As Double) As LongPtr    Public Declare PtrSafe Function FPDF_CreateNewDocument CDecl Lib "pdfium" () As LongPtr    ' page_indices = 0 importa todas las paginas del documento origen    Public Declare PtrSafe Function FPDF_ImportPagesByIndex CDecl Lib "pdfium" (ByVal dest_doc As LongPtr, ByVal src_doc As LongPtr, ByVal page_indices As LongPtr, ByVal length As Long, ByVal index As Long) As Long    Public Declare PtrSafe Sub FPDFPage_SetCropBox CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal cLeft As Single, ByVal cBottom As Single, ByVal cRight As Single, ByVal cTop As Single)    ' --- Texto --------------------------------------------------------------    Public Declare PtrSafe Function FPDFText_LoadPage CDecl Lib "pdfium" (ByVal page As LongPtr) As LongPtr    Public Declare PtrSafe Sub FPDFText_ClosePage CDecl Lib "pdfium" (ByVal text_page As LongPtr)    Public Declare PtrSafe Function FPDFText_CountChars CDecl Lib "pdfium" (ByVal text_page As LongPtr) As Long    Public Declare PtrSafe Function FPDFText_GetUnicode CDecl Lib "pdfium" (ByVal text_page As LongPtr, ByVal index As Long) As Long    Public Declare PtrSafe Function FPDFText_GetText CDecl Lib "pdfium" (ByVal text_page As LongPtr, ByVal start_index As Long, ByVal count As Long, ByVal result As LongPtr) As Long    Public Declare PtrSafe Function FPDFText_GetCharIndexAtPos CDecl Lib "pdfium" (ByVal text_page As LongPtr, ByVal x As Double, ByVal y As Double, ByVal xTolerance As Double, ByVal yTolerance As Double) As Long    Public Declare PtrSafe Function FPDFText_CountRects CDecl Lib "pdfium" (ByVal text_page As LongPtr, ByVal start_index As Long, ByVal count As Long) As Long    Public Declare PtrSafe Function FPDFText_GetRect CDecl Lib "pdfium" (ByVal text_page As LongPtr, ByVal rect_index As Long, ByRef rLeft As Double, ByRef rTop As Double, ByRef rRight As Double, ByRef rBottom As Double) As Long    Public Declare PtrSafe Function FPDFText_FindStart CDecl Lib "pdfium" (ByVal text_page As LongPtr, ByVal findwhat As LongPtr, ByVal flags As Long, ByVal start_index As Long) As LongPtr    Public Declare PtrSafe Function FPDFText_FindNext CDecl Lib "pdfium" (ByVal handle As LongPtr) As Long    Public Declare PtrSafe Function FPDFText_GetSchResultIndex CDecl Lib "pdfium" (ByVal handle As LongPtr) As Long    Public Declare PtrSafe Function FPDFText_GetSchCount CDecl Lib "pdfium" (ByVal handle As LongPtr) As Long    Public Declare PtrSafe Function FPDFText_GetBoundedText CDecl Lib "pdfium" (ByVal text_page As LongPtr, ByVal bLeft As Double, ByVal bTop As Double, ByVal bRight As Double, ByVal bBottom As Double, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Function FPDF_GetFileVersion CDecl Lib "pdfium" (ByVal document As LongPtr, ByRef fileVersion As Long) As Long    ' tag en ASCII (puntero a bytes); el resultado es UTF-16LE con nulo final, en bytes    Public Declare PtrSafe Function FPDF_GetMetaText CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal tag As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Sub FPDFText_FindClose CDecl Lib "pdfium" (ByVal handle As LongPtr)    ' --- Formularios (AcroForm) -------------------------------------------------    ' PDFium solo dibuja los campos con FPDF_FFLDraw sobre un entorno de    ' formularios (FPDFDOC_InitFormFillEnvironment). Coordenadas de pagina.    Public Const FORMTYPE_NONE As Long = 0    Public Const FORMTYPE_ACRO_FORM As Long = 1    Public Const FPDF_FORMFIELD_UNKNOWN As Long = 0    Public Const FPDF_FORMFIELD_PUSHBUTTON As Long = 1    Public Const FPDF_FORMFIELD_CHECKBOX As Long = 2    Public Const FPDF_FORMFIELD_RADIOBUTTON As Long = 3    Public Const FPDF_FORMFIELD_COMBOBOX As Long = 4    Public Const FPDF_FORMFIELD_LISTBOX As Long = 5    Public Const FPDF_FORMFIELD_TEXTFIELD As Long = 6    Public Const FPDF_FORMFIELD_SIGNATURE As Long = 7    ' Indicadores /Ff    Public Const FPDF_FORMFLAG_READONLY As Long = &H1    Public Const FPDF_FORMFLAG_REQUIRED As Long = &H2    Public Const FPDF_FORMFLAG_TEXT_MULTILINE As Long = &H1000    Public Const FPDF_FORMFLAG_TEXT_PASSWORD As Long = &H2000    Public Const FPDF_FORMFLAG_CHOICE_EDIT As Long = &H40000    Public Const FPDF_FORMFLAG_CHOICE_MULTI_SELECT As Long = &H200000    ' Modificadores de FORM_On*    Public Const FWL_EVENTFLAG_ShiftKey As Long = &H1    Public Const FWL_EVENTFLAG_ControlKey As Long = &H2    Public Const FWL_EVENTFLAG_AltKey As Long = &H4    Public Const FPDF_ANNOT_WIDGET As Long = 20    Public Const FLAT_NORMALDISPLAY As Long = 0    Public Type FS_RECTF        rLeft As Single        rTop As Single        rRight As Single        rBottom As Single    End Type    Public Declare PtrSafe Function FPDF_GetFormType CDecl Lib "pdfium" (ByVal document As LongPtr) As Long    Public Declare PtrSafe Function FPDFDOC_InitFormFillEnvironment CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal formInfo As LongPtr) As LongPtr    Public Declare PtrSafe Sub FPDFDOC_ExitFormFillEnvironment CDecl Lib "pdfium" (ByVal hHandle As LongPtr)    Public Declare PtrSafe Sub FORM_OnAfterLoadPage CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal hHandle As LongPtr)    Public Declare PtrSafe Sub FORM_OnBeforeClosePage CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal hHandle As LongPtr)    Public Declare PtrSafe Sub FPDF_FFLDraw CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal bitmap As LongPtr, ByVal page As LongPtr, ByVal start_x As Long, ByVal start_y As Long, ByVal size_x As Long, ByVal size_y As Long, ByVal rotate As Long, ByVal flags As Long)    ' color = COLORREF (0x00BBGGRR); fieldType 0 = todos los tipos    Public Declare PtrSafe Sub FPDF_SetFormFieldHighlightColor CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal fieldType As Long, ByVal color As Long)    Public Declare PtrSafe Sub FPDF_SetFormFieldHighlightAlpha CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal alpha As Long)    Public Declare PtrSafe Function FORM_OnMouseMove CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal modifier As Long, ByVal page_x As Double, ByVal page_y As Double) As Long    Public Declare PtrSafe Function FORM_OnLButtonDown CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal modifier As Long, ByVal page_x As Double, ByVal page_y As Double) As Long    Public Declare PtrSafe Function FORM_OnLButtonUp CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal modifier As Long, ByVal page_x As Double, ByVal page_y As Double) As Long    Public Declare PtrSafe Function FORM_OnLButtonDoubleClick CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal modifier As Long, ByVal page_x As Double, ByVal page_y As Double) As Long    Public Declare PtrSafe Function FORM_OnKeyDown CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal nKeyCode As Long, ByVal modifier As Long) As Long    Public Declare PtrSafe Function FORM_OnChar CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal nChar As Long, ByVal modifier As Long) As Long    Public Declare PtrSafe Function FORM_ForceToKillFocus CDecl Lib "pdfium" (ByVal hHandle As LongPtr) As Long    Public Declare PtrSafe Function FORM_GetFocusedAnnot CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByRef page_index As Long, ByRef annot As LongPtr) As Long    Public Declare PtrSafe Function FORM_SetFocusedAnnot CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr) As Long    Public Declare PtrSafe Sub FORM_SelectAllText CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr)    Public Declare PtrSafe Sub FORM_ReplaceSelection CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal wsText As LongPtr)    ' Devuelven bytes UTF-16LE con el nulo final    Public Declare PtrSafe Function FORM_GetSelectedText CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Function FORM_GetFocusedText CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Function FORM_SetIndexSelected CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal index As Long, ByVal selected As Long) As Long    Public Declare PtrSafe Function FORM_CanUndo CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr) As Long    Public Declare PtrSafe Function FORM_CanRedo CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr) As Long    Public Declare PtrSafe Function FORM_Undo CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr) As Long    Public Declare PtrSafe Function FORM_Redo CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr) As Long    ' Tipo de campo bajo el punto (FPDF_FORMFIELD_*) o -1    Public Declare PtrSafe Function FPDFPage_HasFormFieldAtPoint CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal page As LongPtr, ByVal page_x As Double, ByVal page_y As Double) As Long    Public Declare PtrSafe Function FPDFPage_Flatten CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal nFlag As Long) As Long    ' --- Anotaciones (widgets de los campos) -------------------------------------    Public Declare PtrSafe Function FPDFPage_GetAnnotCount CDecl Lib "pdfium" (ByVal page As LongPtr) As Long    Public Declare PtrSafe Function FPDFPage_GetAnnot CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal index As Long) As LongPtr    Public Declare PtrSafe Sub FPDFPage_CloseAnnot CDecl Lib "pdfium" (ByVal annot As LongPtr)    Public Declare PtrSafe Function FPDFAnnot_GetSubtype CDecl Lib "pdfium" (ByVal annot As LongPtr) As Long    Public Declare PtrSafe Function FPDFAnnot_GetRect CDecl Lib "pdfium" (ByVal annot As LongPtr, ByRef rect As FS_RECTF) As Long    ' Las cadenas se devuelven en bytes UTF-16LE con el nulo final    Public Declare PtrSafe Function FPDFAnnot_GetFormFieldName CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Function FPDFAnnot_GetFormFieldAlternateName CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Function FPDFAnnot_GetFormFieldValue CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Function FPDFAnnot_GetFormFieldExportValue CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Function FPDFAnnot_GetOptionLabel CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr, ByVal index As Long, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Function FPDFAnnot_GetFormFieldType CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr) As Long    Public Declare PtrSafe Function FPDFAnnot_GetFormFieldFlags CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr) As Long    Public Declare PtrSafe Function FPDFAnnot_IsChecked CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr) As Long    Public Declare PtrSafe Function FPDFAnnot_GetOptionCount CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr) As Long    Public Declare PtrSafe Function FPDFAnnot_IsOptionSelected CDecl Lib "pdfium" (ByVal hHandle As LongPtr, ByVal annot As LongPtr, ByVal index As Long) As Long    ' --- Anotaciones de marcado y notas -------------------------------------------    Public Const FPDF_ANNOT_TEXT As Long = 1    Public Const FPDF_ANNOT_FREETEXT As Long = 3    Public Const FPDF_ANNOT_HIGHLIGHT As Long = 9    Public Const FPDF_ANNOT_UNDERLINE As Long = 10    Public Const FPDF_ANNOT_SQUIGGLY As Long = 11    Public Const FPDF_ANNOT_STRIKEOUT As Long = 12    Public Const FPDF_ANNOT_FLAG_PRINT As Long = 4    Public Const FPDFANNOT_COLORTYPE_Color As Long = 0    ' Cuadrilatero de texto: (x1,y1) arriba-izq, (x2,y2) arriba-der, (x3,y3) abajo-izq, (x4,y4) abajo-der    Public Type FS_QUADPOINTSF        x1 As Single        y1 As Single        x2 As Single        y2 As Single        x3 As Single        y3 As Single        x4 As Single        y4 As Single    End Type    Public Declare PtrSafe Function FPDFPage_CreateAnnot CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal subtype As Long) As LongPtr    Public Declare PtrSafe Function FPDFPage_RemoveAnnot CDecl Lib "pdfium" (ByVal page As LongPtr, ByVal index As Long) As Long    Public Declare PtrSafe Function FPDFAnnot_SetColor CDecl Lib "pdfium" (ByVal annot As LongPtr, ByVal colorType As Long, ByVal R As Long, ByVal G As Long, ByVal B As Long, ByVal A As Long) As Long    Public Declare PtrSafe Function FPDFAnnot_GetColor CDecl Lib "pdfium" (ByVal annot As LongPtr, ByVal colorType As Long, ByRef R As Long, ByRef G As Long, ByRef B As Long, ByRef A As Long) As Long    Public Declare PtrSafe Function FPDFAnnot_AppendAttachmentPoints CDecl Lib "pdfium" (ByVal annot As LongPtr, ByRef quadPoints As FS_QUADPOINTSF) As Long    Public Declare PtrSafe Function FPDFAnnot_CountAttachmentPoints CDecl Lib "pdfium" (ByVal annot As LongPtr) As Long    Public Declare PtrSafe Function FPDFAnnot_GetAttachmentPoints CDecl Lib "pdfium" (ByVal annot As LongPtr, ByVal quadIndex As Long, ByRef quadPoints As FS_QUADPOINTSF) As Long    Public Declare PtrSafe Function FPDFAnnot_SetRect CDecl Lib "pdfium" (ByVal annot As LongPtr, ByRef rect As FS_RECTF) As Long    Public Declare PtrSafe Function FPDFAnnot_SetFlags CDecl Lib "pdfium" (ByVal annot As LongPtr, ByVal flags As Long) As Long    ' key: ASCII con nulo final; value: UTF-16 con nulo final    Public Declare PtrSafe Function FPDFAnnot_SetStringValue CDecl Lib "pdfium" (ByVal annot As LongPtr, ByVal key As LongPtr, ByVal value As LongPtr) As Long    ' Bytes UTF-16LE con el nulo final    Public Declare PtrSafe Function FPDFAnnot_GetStringValue CDecl Lib "pdfium" (ByVal annot As LongPtr, ByVal key As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    ' --- Marcadores (esquema del documento) --------------------------------------    Public Const PDFACTION_GOTO As Long = 1    Public Const PDFACTION_URI As Long = 3    ' bookmark = 0: primer marcador de nivel superior    Public Declare PtrSafe Function FPDFBookmark_GetFirstChild CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal bookmark As LongPtr) As LongPtr    Public Declare PtrSafe Function FPDFBookmark_GetNextSibling CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal bookmark As LongPtr) As LongPtr    ' Bytes UTF-16LE con el nulo final    Public Declare PtrSafe Function FPDFBookmark_GetTitle CDecl Lib "pdfium" (ByVal bookmark As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    ' Hijos visibles: > 0 abierto, < 0 cerrado, 0 sin hijos    Public Declare PtrSafe Function FPDFBookmark_GetCount CDecl Lib "pdfium" (ByVal bookmark As LongPtr) As Long    Public Declare PtrSafe Function FPDFBookmark_GetDest CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal bookmark As LongPtr) As LongPtr    Public Declare PtrSafe Function FPDFBookmark_GetAction CDecl Lib "pdfium" (ByVal bookmark As LongPtr) As LongPtr    Public Declare PtrSafe Function FPDFAction_GetType CDecl Lib "pdfium" (ByVal action As LongPtr) As Long    Public Declare PtrSafe Function FPDFAction_GetDest CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal action As LongPtr) As LongPtr    ' Bytes ASCII con el nulo final    Public Declare PtrSafe Function FPDFAction_GetURIPath CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal action As LongPtr, ByVal buffer As LongPtr, ByVal buflen As Long) As Long    Public Declare PtrSafe Function FPDFDest_GetDestPageIndex CDecl Lib "pdfium" (ByVal document As LongPtr, ByVal dest As LongPtr) As Long    Public Declare PtrSafe Function FPDFDest_GetLocationInPage CDecl Lib "pdfium" (ByVal dest As LongPtr, ByRef hasXVal As Long, ByRef hasYVal As Long, ByRef hasZoomVal As Long, ByRef x As Single, ByRef y As Single, ByRef zoom As Single) As Long    ' --- Callbacks del entorno de formularios ------------------------------------    ' FPDF_FORMFILLINFO version 1: int version y despues punteros a funcion    ' (Release, FFI_Invalidate, FFI_OutputSelectedRect, FFI_SetCursor,    ' FFI_SetTimer, FFI_KillTimer, FFI_GetLocalTime, FFI_OnChange, ...). Se    ' reserva un bloque a cero y solo se rellenan los que se usan (PDFium    ' comprueba que no sean nulos). Al final del bloque se guarda ObjPtr del    ' PdfDocument propietario. Las llamadas son cdecl (sin FPDF_CALLCONV).    Private Const FFI_SLOTS As Long = 40          ' la estructura v2 tiene 35 campos    Private Const FFI_SLOT_INVALIDATE As Long = 2    Private Const FFI_SLOT_ONCHANGE As Long = 8    Public Function PdfFormInfoCreate(ByVal Owner As LongPtr) As LongPtr        Dim p As LongPtr, ps As Long, v As LongPtr        ps = LenB(p)        p = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, CLngPtr(FFI_SLOTS + 1) * ps)        If p = 0 Then Exit Function        CopyMemory ByVal p, 1&, 4                                           ' version        v = AddressOf PdfFormInvalidate        CopyMemory ByVal (p + FFI_SLOT_INVALIDATE * ps), v, ps        v = AddressOf PdfFormOnChange        CopyMemory ByVal (p + FFI_SLOT_ONCHANGE * ps), v, ps        CopyMemory ByVal (p + FFI_SLOTS * ps), Owner, ps                    ' propietario        PdfFormInfoCreate = p    End Function    ' Desconecta el propietario (los callbacks posteriores no hacen nada).    Public Sub PdfFormInfoDetach(ByVal pInfo As LongPtr)        Dim z As LongPtr        If pInfo <> 0 Then CopyMemory ByVal (pInfo + FFI_SLOTS * LenB(z)), z, LenB(z)    End Sub    Public Sub PdfFormInfoFree(ByVal pInfo As LongPtr)        If pInfo <> 0 Then HeapFree GetProcessHeap(), 0, pInfo    End Sub    Private Function FormOwner(ByVal pThis As LongPtr) As LongPtr        Dim o As LongPtr        If pThis <> 0 Then CopyMemory o, ByVal (pThis + FFI_SLOTS * LenB(o)), LenB(o)        FormOwner = o    End Function    ' Referencia "prestada" (sin AddRef) que se anula antes de salir.    Public Sub PdfFormInvalidate CDecl(ByVal pThis As LongPtr, ByVal page As LongPtr, ByVal dLeft As Double, ByVal dTop As Double, ByVal dRight As Double, ByVal dBottom As Double)        Dim d As PdfDocument, o As LongPtr, z As LongPtr        On Error Resume Next        o = FormOwner(pThis)        If o = 0 Then Exit Sub        CopyMemory ByVal VarPtr(d), o, LenB(o)        d.zFormInvalidate page        CopyMemory ByVal VarPtr(d), z, LenB(z)    End Sub    Public Sub PdfFormOnChange CDecl(ByVal pThis As LongPtr)        Dim d As PdfDocument, o As LongPtr, z As LongPtr        On Error Resume Next        o = FormOwner(pThis)        If o = 0 Then Exit Sub        CopyMemory ByVal VarPtr(d), o, LenB(o)        d.zFormChanged        CopyMemory ByVal VarPtr(d), z, LenB(z)    End Sub    ' --- Guardado a memoria ---------------------------------------------------    ' PDFium llama a WriteBlock con convencion cdecl (no lleva FPDF_CALLCONV),    ' por eso el procedimiento se declara CDecl: imprescindible en Win32; en    ' Win64 solo hay una convencion de llamada.    Private m_WriteBuf() As Byte    Private m_WriteLen As Long    Public Function PdfiumWriteBlock CDecl(ByVal pThis As LongPtr, ByVal pData As LongPtr, ByVal size As Long) As Long        Dim cap As Long        If size <= 0 Then            PdfiumWriteBlock = 1            Exit Function        End If        On Error GoTo Failed        cap = UBound(m_WriteBuf) + 1        If m_WriteLen + size > cap Then            cap = IMax(cap * 2, m_WriteLen + size)            ReDim Preserve m_WriteBuf(0 To cap - 1)        End If        CopyMemory m_WriteBuf(m_WriteLen), ByVal pData, size        m_WriteLen = m_WriteLen + size        PdfiumWriteBlock = 1        Exit Function    Failed:        PdfiumWriteBlock = 0    End Function    ' Serializa el documento (con sus cambios) a un array de bytes.    Public Function PdfiumSaveToBytes(ByVal Document As LongPtr, ByRef Data() As Byte) As Boolean        Dim fw As FPDF_FILEWRITE        If Document = 0 Then Exit Function        ReDim m_WriteBuf(0 To 65535)        m_WriteLen = 0        fw.version = 1        fw.WriteBlock = AddressOf PdfiumWriteBlock        On Error GoTo Failed        If FPDF_SaveAsCopy(Document, fw, FPDF_NO_INCREMENTAL) <> 0 And m_WriteLen > 0 Then            ReDim Preserve m_WriteBuf(0 To m_WriteLen - 1)            Data = m_WriteBuf            PdfiumSaveToBytes = True        End If    Failed:        Erase m_WriteBuf        m_WriteLen = 0    End Function    ' --- Estado del cargador ------------------------------------------------    Private m_hLib As LongPtr    Private m_Refs As Long    Private m_LoadError As String    ' Subcarpeta esperada para la arquitectura actual.    Public Function PdfiumArchFolder() As String        #If Win64 Then            PdfiumArchFolder = "x64"        #Else            PdfiumArchFolder = "x86"        #End If    End Function    ' Ruta por defecto: App.Path\<x86|x64>\pdfium.dll y, si no existe, App.Path\pdfium.dll.    Public Function PdfiumDefaultPath() As String        Dim base As String        base = App.Path        If Right$(base, 1) <> "\" Then base = base & "\"        If FileExists(base & PdfiumArchFolder() & "\pdfium.dll") Then            PdfiumDefaultPath = base & PdfiumArchFolder() & "\pdfium.dll"        ElseIf FileExists(base & "pdfium.dll") Then            PdfiumDefaultPath = base & "pdfium.dll"        End If    End Function    ' Resuelve la ruta indicada por el usuario: admite archivo o carpeta    ' (en una carpeta se busca primero <carpeta>\<x86|x64>\pdfium.dll).    Private Function ResolvePath(ByVal CustomPath As String) As String        Dim p As String        p = Trim$(CustomPath)        If Len(p) = 0 Then            ResolvePath = PdfiumDefaultPath()            Exit Function        End If        If FolderExists(p) Then            If Right$(p, 1) <> "\" Then p = p & "\"            If FileExists(p & PdfiumArchFolder() & "\pdfium.dll") Then                ResolvePath = p & PdfiumArchFolder() & "\pdfium.dll"            Else                ResolvePath = p & "pdfium.dll"            End If        Else            ResolvePath = p        End If    End Function    ' Carga pdfium.dll (si hace falta) e inicializa la biblioteca.    ' Usa recuento de referencias: cada PdfiumAcquire exitoso requiere un PdfiumRelease.    Public Function PdfiumAcquire(Optional ByVal CustomPath As String) As Boolean        Dim path As String, errNum As Long        If m_Refs > 0 Then            m_Refs = m_Refs + 1            PdfiumAcquire = True            Exit Function        End If        m_LoadError = ""        If m_hLib = 0 Then            path = ResolvePath(CustomPath)            If Len(path) > 0 Then                m_hLib = LoadLibraryW(StrPtr(path))                errNum = Err.LastDllError            End If            ' Ultimo recurso: orden de busqueda estandar de Windows.            If m_hLib = 0 Then                m_hLib = LoadLibraryW(StrPtr("pdfium.dll"))                If errNum = 0 Then errNum = Err.LastDllError            End If            If m_hLib = 0 Then                If errNum = 193 Then                    m_LoadError = "pdfium.dll no corresponde a la arquitectura del proceso (" & PdfiumArchFolder() & ")."                Else                    m_LoadError = "No se pudo cargar pdfium.dll (" & IIf(Len(path) > 0, path, "ruta no encontrada") & "), error " & errNum & "."                End If                Exit Function            End If        End If        On Error GoTo InitFailed        FPDF_InitLibrary        m_Refs = 1        PdfiumAcquire = True        Exit Function    InitFailed:        m_LoadError = "pdfium.dll no exporta la API esperada: " & Err.Description        ' La DLL no se descarga: el runtime guarda en cache las direcciones de los Declare.    End Function    ' Libera una referencia. Con la ultima se llama a FPDF_DestroyLibrary.    ' El modulo no se descarga para no invalidar los Declare ya resueltos.    Public Sub PdfiumRelease()        If m_Refs <= 0 Then Exit Sub        m_Refs = m_Refs - 1        If m_Refs = 0 Then FPDF_DestroyLibrary    End Sub    Public Property Get PdfiumIsInitialized() As Boolean        PdfiumIsInitialized = (m_Refs > 0)    End Property    Public Property Get PdfiumRefCount() As Long        PdfiumRefCount = m_Refs    End Property    Public Property Get PdfiumLoadedPath() As String        If m_hLib <> 0 Then PdfiumLoadedPath = ModulePath(m_hLib)    End Property    Public Property Get PdfiumLoadError() As String        PdfiumLoadError = m_LoadError    End Property    Public Function PdfiumErrorText(ByVal Code As Long) As String        Select Case Code            Case FPDF_ERR_SUCCESS: PdfiumErrorText = "Sin error"            Case FPDF_ERR_FILE: PdfiumErrorText = "Archivo no encontrado o no se pudo abrir"            Case FPDF_ERR_FORMAT: PdfiumErrorText = "El archivo no es un PDF valido o esta danado"            Case FPDF_ERR_PASSWORD: PdfiumErrorText = "Contrasena incorrecta o requerida"            Case FPDF_ERR_SECURITY: PdfiumErrorText = "Esquema de seguridad no soportado"            Case FPDF_ERR_PAGE: PdfiumErrorText = "Pagina no encontrada o con contenido erroneo"            Case FPDF_ERR_NOLIBRARY: PdfiumErrorText = m_LoadError            Case Else: PdfiumErrorText = "Error desconocido (" & Code & ")"        End Select    End FunctionEnd Module