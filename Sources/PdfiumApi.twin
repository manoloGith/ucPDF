' ============================================================================'  PdfiumApi.twin'  Apartado 1 - Base funcional: carga de PDFium y declaraciones de la API C.''  pdfium.dll se carga dinamicamente con LoadLibraryW desde la ruta indicada'  (o desde App.Path\x86 | App.Path\x64 segun la arquitectura). Una vez el'  modulo esta en memoria, las sentencias Declare ... Lib "pdfium" se'  resuelven contra el modulo ya cargado.''  Binarios recomendados: https://github.com/bblanchon/pdfium-binaries'  (pdfium-win-x86 / pdfium-win-x64).' ============================================================================[Description("Carga dinamica y API de PDFium")]Module PdfiumApi    ' --- Codigos de FPDF_GetLastError ---------------------------------------    Public Const FPDF_ERR_SUCCESS As Long = 0    Public Const FPDF_ERR_UNKNOWN As Long = 1    Public Const FPDF_ERR_FILE As Long = 2    Public Const FPDF_ERR_FORMAT As Long = 3    Public Const FPDF_ERR_PASSWORD As Long = 4    Public Const FPDF_ERR_SECURITY As Long = 5    Public Const FPDF_ERR_PAGE As Long = 6    ' Codigo propio: la biblioteca no se pudo cargar    Public Const FPDF_ERR_NOLIBRARY As Long = -1    ' --- Indicadores de renderizado -----------------------------------------    Public Const FPDF_ANNOT As Long = &H1    Public Const FPDF_LCD_TEXT As Long = &H2    Public Const FPDF_NO_NATIVETEXT As Long = &H4    Public Const FPDF_GRAYSCALE As Long = &H8    Public Const FPDF_PRINTING As Long = &H800    ' --- Formatos de FPDF_BITMAP --------------------------------------------    Public Const FPDFBitmap_BGRx As Long = 2    Public Const FPDFBitmap_BGRA As Long = 4    ' --- Opciones de busqueda -----------------------------------------------    Public Const FPDF_MATCHCASE As Long = &H1    Public Const FPDF_MATCHWHOLEWORD As Long = &H2    ' --- Biblioteca / documento ---------------------------------------------    Public Declare PtrSafe Sub FPDF_InitLibrary Lib "pdfium" ()    Public Declare PtrSafe Sub FPDF_DestroyLibrary Lib "pdfium" ()    Public Declare PtrSafe Function FPDF_GetLastError Lib "pdfium" () As Long    Public Declare PtrSafe Function FPDF_LoadMemDocument Lib "pdfium" (ByVal data_buf As LongPtr, ByVal nSize As Long, ByVal password As LongPtr) As LongPtr    Public Declare PtrSafe Sub FPDF_CloseDocument Lib "pdfium" (ByVal document As LongPtr)    Public Declare PtrSafe Function FPDF_GetPageCount Lib "pdfium" (ByVal document As LongPtr) As Long    Public Declare PtrSafe Function FPDF_GetPageSizeByIndex Lib "pdfium" (ByVal document As LongPtr, ByVal page_index As Long, ByRef pWidth As Double, ByRef pHeight As Double) As Long    ' --- Paginas y renderizado ----------------------------------------------    Public Declare PtrSafe Function FPDF_LoadPage Lib "pdfium" (ByVal document As LongPtr, ByVal page_index As Long) As LongPtr    Public Declare PtrSafe Sub FPDF_ClosePage Lib "pdfium" (ByVal page As LongPtr)    Public Declare PtrSafe Function FPDFBitmap_CreateEx Lib "pdfium" (ByVal nWidth As Long, ByVal nHeight As Long, ByVal bmpFormat As Long, ByVal first_scan As LongPtr, ByVal stride As Long) As LongPtr    Public Declare PtrSafe Function FPDFBitmap_FillRect Lib "pdfium" (ByVal bitmap As LongPtr, ByVal x As Long, ByVal y As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal argb As Long) As Long    Public Declare PtrSafe Sub FPDFBitmap_Destroy Lib "pdfium" (ByVal bitmap As LongPtr)    Public Declare PtrSafe Sub FPDF_RenderPageBitmap Lib "pdfium" (ByVal bitmap As LongPtr, ByVal page As LongPtr, ByVal start_x As Long, ByVal start_y As Long, ByVal size_x As Long, ByVal size_y As Long, ByVal rotate As Long, ByVal flags As Long)    Public Declare PtrSafe Function FPDF_DeviceToPage Lib "pdfium" (ByVal page As LongPtr, ByVal start_x As Long, ByVal start_y As Long, ByVal size_x As Long, ByVal size_y As Long, ByVal rotate As Long, ByVal device_x As Long, ByVal device_y As Long, ByRef page_x As Double, ByRef page_y As Double) As Long    Public Declare PtrSafe Function FPDF_PageToDevice Lib "pdfium" (ByVal page As LongPtr, ByVal start_x As Long, ByVal start_y As Long, ByVal size_x As Long, ByVal size_y As Long, ByVal rotate As Long, ByVal page_x As Double, ByVal page_y As Double, ByRef device_x As Long, ByRef device_y As Long) As Long    ' --- Texto --------------------------------------------------------------    Public Declare PtrSafe Function FPDFText_LoadPage Lib "pdfium" (ByVal page As LongPtr) As LongPtr    Public Declare PtrSafe Sub FPDFText_ClosePage Lib "pdfium" (ByVal text_page As LongPtr)    Public Declare PtrSafe Function FPDFText_CountChars Lib "pdfium" (ByVal text_page As LongPtr) As Long    Public Declare PtrSafe Function FPDFText_GetUnicode Lib "pdfium" (ByVal text_page As LongPtr, ByVal index As Long) As Long    Public Declare PtrSafe Function FPDFText_GetText Lib "pdfium" (ByVal text_page As LongPtr, ByVal start_index As Long, ByVal count As Long, ByVal result As LongPtr) As Long    Public Declare PtrSafe Function FPDFText_GetCharIndexAtPos Lib "pdfium" (ByVal text_page As LongPtr, ByVal x As Double, ByVal y As Double, ByVal xTolerance As Double, ByVal yTolerance As Double) As Long    Public Declare PtrSafe Function FPDFText_CountRects Lib "pdfium" (ByVal text_page As LongPtr, ByVal start_index As Long, ByVal count As Long) As Long    Public Declare PtrSafe Function FPDFText_GetRect Lib "pdfium" (ByVal text_page As LongPtr, ByVal rect_index As Long, ByRef rLeft As Double, ByRef rTop As Double, ByRef rRight As Double, ByRef rBottom As Double) As Long    Public Declare PtrSafe Function FPDFText_FindStart Lib "pdfium" (ByVal text_page As LongPtr, ByVal findwhat As LongPtr, ByVal flags As Long, ByVal start_index As Long) As LongPtr    Public Declare PtrSafe Function FPDFText_FindNext Lib "pdfium" (ByVal handle As LongPtr) As Long    Public Declare PtrSafe Function FPDFText_GetSchResultIndex Lib "pdfium" (ByVal handle As LongPtr) As Long    Public Declare PtrSafe Function FPDFText_GetSchCount Lib "pdfium" (ByVal handle As LongPtr) As Long    Public Declare PtrSafe Sub FPDFText_FindClose Lib "pdfium" (ByVal handle As LongPtr)    ' --- Estado del cargador ------------------------------------------------    Private m_hLib As LongPtr    Private m_Refs As Long    Private m_LoadError As String    ' Subcarpeta esperada para la arquitectura actual.    Public Function PdfiumArchFolder() As String        #If Win64 Then            PdfiumArchFolder = "x64"        #Else            PdfiumArchFolder = "x86"        #End If    End Function    ' Ruta por defecto: App.Path\<x86|x64>\pdfium.dll y, si no existe, App.Path\pdfium.dll.    Public Function PdfiumDefaultPath() As String        Dim base As String        base = App.Path        If Right$(base, 1) <> "\" Then base = base & "\"        If FileExists(base & PdfiumArchFolder() & "\pdfium.dll") Then            PdfiumDefaultPath = base & PdfiumArchFolder() & "\pdfium.dll"        ElseIf FileExists(base & "pdfium.dll") Then            PdfiumDefaultPath = base & "pdfium.dll"        End If    End Function    ' Resuelve la ruta indicada por el usuario: admite archivo o carpeta    ' (en una carpeta se busca primero <carpeta>\<x86|x64>\pdfium.dll).    Private Function ResolvePath(ByVal CustomPath As String) As String        Dim p As String        p = Trim$(CustomPath)        If Len(p) = 0 Then            ResolvePath = PdfiumDefaultPath()            Exit Function        End If        If FolderExists(p) Then            If Right$(p, 1) <> "\" Then p = p & "\"            If FileExists(p & PdfiumArchFolder() & "\pdfium.dll") Then                ResolvePath = p & PdfiumArchFolder() & "\pdfium.dll"            Else                ResolvePath = p & "pdfium.dll"            End If        Else            ResolvePath = p        End If    End Function    ' Carga pdfium.dll (si hace falta) e inicializa la biblioteca.    ' Usa recuento de referencias: cada PdfiumAcquire exitoso requiere un PdfiumRelease.    Public Function PdfiumAcquire(Optional ByVal CustomPath As String) As Boolean        Dim path As String, errNum As Long        If m_Refs > 0 Then            m_Refs = m_Refs + 1            PdfiumAcquire = True            Exit Function        End If        m_LoadError = ""        If m_hLib = 0 Then            path = ResolvePath(CustomPath)            If Len(path) > 0 Then                m_hLib = LoadLibraryW(StrPtr(path))                errNum = Err.LastDllError            End If            ' Ultimo recurso: orden de busqueda estandar de Windows.            If m_hLib = 0 Then                m_hLib = LoadLibraryW(StrPtr("pdfium.dll"))                If errNum = 0 Then errNum = Err.LastDllError            End If            If m_hLib = 0 Then                If errNum = 193 Then                    m_LoadError = "pdfium.dll no corresponde a la arquitectura del proceso (" & PdfiumArchFolder() & ")."                Else                    m_LoadError = "No se pudo cargar pdfium.dll (" & IIf(Len(path) > 0, path, "ruta no encontrada") & "), error " & errNum & "."                End If                Exit Function            End If        End If        On Error GoTo InitFailed        FPDF_InitLibrary        m_Refs = 1        PdfiumAcquire = True        Exit Function    InitFailed:        m_LoadError = "pdfium.dll no exporta la API esperada: " & Err.Description        ' La DLL no se descarga: el runtime guarda en cache las direcciones de los Declare.    End Function    ' Libera una referencia. Con la ultima se llama a FPDF_DestroyLibrary.    ' El modulo no se descarga para no invalidar los Declare ya resueltos.    Public Sub PdfiumRelease()        If m_Refs <= 0 Then Exit Sub        m_Refs = m_Refs - 1        If m_Refs = 0 Then FPDF_DestroyLibrary    End Sub    Public Property Get PdfiumIsInitialized() As Boolean        PdfiumIsInitialized = (m_Refs > 0)    End Property    Public Property Get PdfiumRefCount() As Long        PdfiumRefCount = m_Refs    End Property    Public Property Get PdfiumLoadedPath() As String        If m_hLib <> 0 Then PdfiumLoadedPath = ModulePath(m_hLib)    End Property    Public Property Get PdfiumLoadError() As String        PdfiumLoadError = m_LoadError    End Property    Public Function PdfiumErrorText(ByVal Code As Long) As String        Select Case Code            Case FPDF_ERR_SUCCESS: PdfiumErrorText = "Sin error"            Case FPDF_ERR_FILE: PdfiumErrorText = "Archivo no encontrado o no se pudo abrir"            Case FPDF_ERR_FORMAT: PdfiumErrorText = "El archivo no es un PDF valido o esta danado"            Case FPDF_ERR_PASSWORD: PdfiumErrorText = "Contrasena incorrecta o requerida"            Case FPDF_ERR_SECURITY: PdfiumErrorText = "Esquema de seguridad no soportado"            Case FPDF_ERR_PAGE: PdfiumErrorText = "Pagina no encontrada o con contenido erroneo"            Case FPDF_ERR_NOLIBRARY: PdfiumErrorText = m_LoadError            Case Else: PdfiumErrorText = "Error desconocido (" & Code & ")"        End Select    End FunctionEnd Module