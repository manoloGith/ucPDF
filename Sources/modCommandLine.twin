' ============================================================================'  modCommandLine.twin'  Punto de entrada (Sub Main) y ejecucion de comandos desde la linea de'  comandos. Configura el proyecto con "Startup object = Sub Main".''    programa.exe                         -> abre la interfaz (Form1)'    programa.exe <comando> [args] [--opciones]''  Codigos de salida:  0 correcto, 1 uso incorrecto, 2 no se pudo abrir un'  archivo, 3 la operacion fallo, 4 PDFium no disponible, 5 sin resultados.''  Salida: se escribe en la consola desde la que se lanzo el programa'  (AttachConsole). Si el EXE es de subsistema Windows, CMD no espera a que'  termine: use  start /wait programa.exe ...  o compile como aplicacion de'  consola. Con redireccion (> archivo, | tubo) se escribe en UTF-8.' ============================================================================[Description("Sub Main y comandos de linea de comandos de ucPDF")]Module modCommandLine    Public Const CLI_OK As Long = 0    Public Const CLI_USAGE As Long = 1    Public Const CLI_OPEN_FAILED As Long = 2    Public Const CLI_FAILED As Long = 3    Public Const CLI_NO_PDFIUM As Long = 4    Public Const CLI_NOT_FOUND As Long = 5    Private m_Pos() As String           ' argumentos posicionales    Private m_PosCount As Long    Private m_OptName() As String       ' opciones --nombre valor    Private m_OptValue() As String    Private m_OptCount As Long    Private m_hOut As LongPtr    Private m_hErr As LongPtr    Private m_ConsoleReady As Boolean    Private m_Quiet As Boolean    Private m_Output As String          ' copia de la salida (para RunCommandLine desde codigo)    ' Opciones que no llevan valor    Private Const FLAG_OPTIONS As String = "|case|word|auto|quiet|q|help|h|"    ' ------------------------------------------------------------------------    '  Sub Main    ' ------------------------------------------------------------------------    Public Sub Main()        Dim code As Long        If CommandLineArgCount() = 0 Then            ' Sin argumentos: interfaz grafica. Cambie Form1 por su formulario.            Form1.Show            Exit Sub        End If        code = RunCommandLine()        ExitProcess code    End Sub    ' Numero de argumentos (sin contar el nombre del programa).    Public Function CommandLineArgCount() As Long        Dim argv As LongPtr, n As Long        argv = CommandLineToArgvW(GetCommandLineW(), n)        If argv <> 0 Then LocalFree argv        CommandLineArgCount = IMax(0, n - 1)    End Function    ' Ejecuta un comando. Sin parametro usa la linea de comandos del proceso;    ' con parametro (p. ej. desde ucPDF.RunCommand) interpreta ese texto.    ' Output devuelve todo lo que se escribio.    Public Function RunCommandLine(Optional ByVal CommandLine As String, Optional ByRef Output As String) As Long        Dim fromProcess As Boolean        fromProcess = (Len(CommandLine) = 0)        m_Output = ""        If fromProcess Then            ParseArgs GetCommandLineW(), True            OpenConsole        Else            ParseArgs StrPtr("ucpdf " & CommandLine), True        End If        m_Quiet = HasOpt("quiet") Or HasOpt("q")        On Error GoTo Crashed        RunCommandLine = Dispatch()        Output = m_Output        Exit Function    Crashed:        WriteErr "Error inesperado: " & Err.Description        RunCommandLine = CLI_FAILED        Output = m_Output    End Function    ' ------------------------------------------------------------------------    '  Comandos    ' ------------------------------------------------------------------------    Private Function Dispatch() As Long        Dim cmd As String        If m_PosCount = 0 Or HasOpt("help") Or HasOpt("h") Then            ShowHelp            Dispatch = IIf(m_PosCount = 0, CLI_USAGE, CLI_OK)            Exit Function        End If        cmd = LCase$(m_Pos(0))        Select Case cmd            Case "help", "ayuda", "/?", "-?": ShowHelp: Dispatch = CLI_OK            Case "info": Dispatch = CmdInfo()            Case "pages", "paginas": Dispatch = CmdPages()            Case "text", "texto": Dispatch = CmdText()            Case "textrect", "textozona", "textarea": Dispatch = CmdTextRect()            Case "areas", "zonas": Dispatch = CmdAreas()            Case "search", "buscar": Dispatch = CmdSearch()            Case "extract", "extraer": Dispatch = CmdExtract()            Case "delete", "eliminar": Dispatch = CmdDelete()            Case "rotate", "girar": Dispatch = CmdRotate()            Case "move", "mover": Dispatch = CmdMove()            Case "insertblank", "insertarblanco": Dispatch = CmdInsertBlank()            Case "insert", "insertar": Dispatch = CmdInsert()            Case "replace", "reemplazar": Dispatch = CmdReplace()            Case "crop", "recortar": Dispatch = CmdCrop()            Case "merge", "unir": Dispatch = CmdMerge()            Case "split", "dividir": Dispatch = CmdSplit()            Case "image", "imagen", "render": Dispatch = CmdImage()            Case "print", "imprimir": Dispatch = CmdPrint()            Case Else                WriteErr "Comando desconocido: " & m_Pos(0) & "   (use: help)"                Dispatch = CLI_USAGE        End Select    End Function    Private Sub ShowHelp()        Dim h As String        h = "ucPDF - herramientas PDF desde la linea de comandos" & vbCrLf & vbCrLf & _            "Uso: programa.exe <comando> [argumentos] [--opciones]" & vbCrLf & vbCrLf & _            "Consulta" & vbCrLf & _            "  info    <in.pdf>                              Informacion y metadatos" & vbCrLf & _            "  pages   <in.pdf>                              Numero de paginas" & vbCrLf & _            "  text    <in.pdf> [out.txt] [--pages R] [--encoding utf8|utf8nobom|utf16|ansi] [--sep ff|header|none]" & vbCrLf & _            "  textrect <in.pdf> [out.txt] --page N --rect L,T,R,B [--units pt|mm|cm|in|%]" & vbCrLf & _            "  areas   <in.pdf> <zonas.ini> [out.txt] [--format ini|tab]   Texto de cada zona del INI" & vbCrLf & _            "  search  <in.pdf> <texto> [--case] [--word] [--out archivo]" & vbCrLf & vbCrLf & _            "Paginas (escriben un PDF nuevo; out puede ser el mismo in)" & vbCrLf & _            "  extract <in.pdf> <out.pdf> --pages R" & vbCrLf & _            "  delete  <in.pdf> <out.pdf> --pages R" & vbCrLf & _            "  rotate  <in.pdf> <out.pdf> --pages R --angle 90|180|270|-90" & vbCrLf & _            "  move    <in.pdf> <out.pdf> --page N --to M" & vbCrLf & _            "  insertblank <in.pdf> <out.pdf> --after N [--size AnchoxAlto] [--units pt|mm]" & vbCrLf & _            "  insert  <in.pdf> <out.pdf> --from otro.pdf --after N" & vbCrLf & _            "  replace <in.pdf> <out.pdf> --from otro.pdf --pages R" & vbCrLf & _            "  crop    <in.pdf> <out.pdf> --pages R (--rect L,T,R,B [--units] | --auto [--margin pt])" & vbCrLf & _            "  merge   <out.pdf> <in1.pdf> <in2.pdf> ..." & vbCrLf & _            "  split   <in.pdf> <carpeta> [--every N] [--name base]" & vbCrLf & vbCrLf & _            "Salida" & vbCrLf & _            "  image   <in.pdf> <out.png|jpg|bmp|tif|gif> [--pages R] [--dpi 150] [--quality 90]   ({n} = numero de pagina)" & vbCrLf & _            "  print   <in.pdf> [--printer nombre] [--pages R] [--copies N]" & vbCrLf & vbCrLf & _            "Opciones generales: --password clave  --pdfium ruta  --quiet" & vbCrLf & _            "Rangos R: all | 1-3,5,8- | -4 | last | odd | even | 3-last   (base 1)" & vbCrLf & _            "Coordenadas: desde la esquina superior izquierda de la pagina tal como se ve." & vbCrLf & _            "Codigos de salida: 0 ok, 1 uso, 2 abrir, 3 fallo, 4 PDFium, 5 sin resultados"        WriteOut h    End Sub    Private Function CmdInfo() As Long        Dim doc As PdfDocument        If Not NeedPos(2, "info <in.pdf>") Then CmdInfo = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdInfo)        If doc Is Nothing Then Exit Function        WriteOut DocumentInfo(doc)    End Function    Private Function CmdPages() As Long        Dim doc As PdfDocument        If Not NeedPos(2, "pages <in.pdf>") Then CmdPages = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdPages)        If doc Is Nothing Then Exit Function        WriteOut CStr(doc.PageCount)    End Function    Private Function CmdText() As Long        Dim doc As PdfDocument, idx() As Long, n As Long, t As String        If Not NeedPos(2, "text <in.pdf> [out.txt]") Then CmdText = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdText)        If doc Is Nothing Then Exit Function        n = PagesOpt(doc, "pages", "all", idx, CmdText)        If n <= 0 Then Exit Function        t = DocumentText(doc, idx, n, Opt("sep", "ff"))        CmdText = EmitText(t, 2)    End Function    Private Function CmdTextRect() As Long        Dim doc As PdfDocument, p As Long, L As Double, T As Double, R As Double, B As Double        If Not NeedPos(2, "textrect <in.pdf> [out.txt] --page N --rect L,T,R,B") Then CmdTextRect = CLI_USAGE: Exit Function        If Not ParseRect(Opt("rect"), L, T, R, B) Then            WriteErr "Falta --rect L,T,R,B (izquierda, arriba, derecha, abajo)"            CmdTextRect = CLI_USAGE            Exit Function        End If        Set doc = OpenDoc(m_Pos(1), CmdTextRect)        If doc Is Nothing Then Exit Function        p = PageOpt(doc, "page", 1, CmdTextRect)        If p < 0 Then Exit Function        CmdTextRect = EmitText(TextInRect(doc, p, L, T, R, B, Opt("units", "pt")), 2)    End Function    ' Texto de las zonas guardadas con la herramienta Zonas del control:    ' una linea "Nombre=texto" (o "Nombre<TAB>Pagina<TAB>texto" con --format tab).    Private Function CmdAreas() As Long        Dim doc As PdfDocument, t As String, n As Long        If Not NeedPos(3, "areas <in.pdf> <zonas.ini> [out.txt]") Then CmdAreas = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdAreas)        If doc Is Nothing Then Exit Function        t = AreasText(doc, m_Pos(2), Opt("format", "ini"), n)        If n < 0 Then CmdAreas = Fail("No se pudo leer " & m_Pos(2)): Exit Function        If n = 0 Then CmdAreas = Fail("El archivo no contiene zonas: " & m_Pos(2), CLI_NOT_FOUND): Exit Function        CmdAreas = EmitText(t, 3)    End Function    Private Function CmdSearch() As Long        Dim doc As PdfDocument, flags As Long, cnt As Long, r As String        If Not NeedPos(3, "search <in.pdf> <texto>") Then CmdSearch = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdSearch)        If doc Is Nothing Then Exit Function        If HasOpt("case") Then flags = flags Or FPDF_MATCHCASE        If HasOpt("word") Then flags = flags Or FPDF_MATCHWHOLEWORD        r = SearchReport(doc, m_Pos(2), flags, cnt)        If Len(Opt("out")) > 0 Then            If Not WriteTextFile(Opt("out"), r, Opt("encoding", "utf8")) Then                WriteErr "No se pudo escribir " & Opt("out")                CmdSearch = CLI_FAILED                Exit Function            End If            Info CStr(cnt) & " coincidencia(s) -> " & Opt("out")        Else            If Len(r) > 0 Then WriteOut Left$(r, Len(r) - 2)            Info CStr(cnt) & " coincidencia(s)"        End If        If cnt = 0 Then CmdSearch = CLI_NOT_FOUND    End Function    Private Function CmdExtract() As Long        Dim doc As PdfDocument, idx() As Long, n As Long        If Not NeedPos(3, "extract <in.pdf> <out.pdf> --pages R") Then CmdExtract = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdExtract)        If doc Is Nothing Then Exit Function        n = PagesOpt(doc, "pages", "", idx, CmdExtract)        If n <= 0 Then Exit Function        If doc.ExtractPages(idx, n, m_Pos(2)) Then            Info CStr(n) & " pagina(s) -> " & m_Pos(2)        Else            CmdExtract = Fail("No se pudieron extraer las paginas")        End If    End Function    Private Function CmdDelete() As Long        Dim doc As PdfDocument, idx() As Long, n As Long        If Not NeedPos(3, "delete <in.pdf> <out.pdf> --pages R") Then CmdDelete = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdDelete)        If doc Is Nothing Then Exit Function        n = PagesOpt(doc, "pages", "", idx, CmdDelete)        If n <= 0 Then Exit Function        If n >= doc.PageCount Then            CmdDelete = Fail("No se pueden eliminar todas las paginas")            Exit Function        End If        SortIndices idx, n        If Not doc.DeletePages(idx, n) Then CmdDelete = Fail("No se pudieron eliminar las paginas"): Exit Function        CmdDelete = SaveDoc(doc, m_Pos(2), CStr(n) & " pagina(s) eliminada(s)")    End Function    Private Function CmdRotate() As Long        Dim doc As PdfDocument, idx() As Long, n As Long, steps As Long        If Not NeedPos(3, "rotate <in.pdf> <out.pdf> --pages R --angle 90") Then CmdRotate = CLI_USAGE: Exit Function        steps = AngleSteps(Opt("angle", "90"))        If steps < 0 Then CmdRotate = Fail("--angle debe ser multiplo de 90", CLI_USAGE): Exit Function        Set doc = OpenDoc(m_Pos(1), CmdRotate)        If doc Is Nothing Then Exit Function        n = PagesOpt(doc, "pages", "all", idx, CmdRotate)        If n <= 0 Then Exit Function        If steps > 0 Then            If Not doc.RotatePages(idx, n, steps) Then CmdRotate = Fail("No se pudieron girar las paginas"): Exit Function        End If        CmdRotate = SaveDoc(doc, m_Pos(2), CStr(n) & " pagina(s) girada(s)")    End Function    Private Function CmdMove() As Long        Dim doc As PdfDocument, src As Long, dest As Long        If Not NeedPos(3, "move <in.pdf> <out.pdf> --page N --to M") Then CmdMove = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdMove)        If doc Is Nothing Then Exit Function        src = PageOpt(doc, "page", -1, CmdMove)        If src < 0 Then Exit Function        dest = PageOpt(doc, "to", -1, CmdMove)        If dest < 0 Then Exit Function        If Not doc.MovePage(src, dest) Then CmdMove = Fail("No se pudo mover la pagina"): Exit Function        CmdMove = SaveDoc(doc, m_Pos(2), "Pagina " & CStr(src + 1) & " -> posicion " & CStr(dest + 1))    End Function    Private Function CmdInsertBlank() As Long        Dim doc As PdfDocument, after As Long, w As Double, h As Double, sz() As String, units As String        If Not NeedPos(3, "insertblank <in.pdf> <out.pdf> --after N") Then CmdInsertBlank = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdInsertBlank)        If doc Is Nothing Then Exit Function        after = AfterOpt(doc, CmdInsertBlank)        If after < 0 Then Exit Function        units = Opt("units", "pt")        If Len(Opt("size")) > 0 Then            sz = Split(LCase$(Opt("size")), "x")            If UBound(sz) <> 1 Then CmdInsertBlank = Fail("--size debe ser AnchoxAlto", CLI_USAGE): Exit Function            w = ToPoints(Val(sz(0)), units, 0)            h = ToPoints(Val(sz(1)), units, 0)        Else            ' Mismo tamano que la pagina anterior (o la primera)            w = doc.PageWidth(IMax(0, after - 1))            h = doc.PageHeight(IMax(0, after - 1))        End If        If w < 1 Or h < 1 Then CmdInsertBlank = Fail("Tamano no valido", CLI_USAGE): Exit Function        If Not doc.InsertBlankPage(after, w, h) Then CmdInsertBlank = Fail("No se pudo insertar la pagina"): Exit Function        CmdInsertBlank = SaveDoc(doc, m_Pos(2), "Pagina en blanco insertada en la posicion " & CStr(after + 1))    End Function    Private Function CmdInsert() As Long        Dim doc As PdfDocument, src As PdfDocument, after As Long, cnt As Long        If Not NeedPos(3, "insert <in.pdf> <out.pdf> --from otro.pdf --after N") Then CmdInsert = CLI_USAGE: Exit Function        If Len(Opt("from")) = 0 Then CmdInsert = Fail("Falta --from archivo.pdf", CLI_USAGE): Exit Function        Set doc = OpenDoc(m_Pos(1), CmdInsert)        If doc Is Nothing Then Exit Function        Set src = OpenDoc(Opt("from"), CmdInsert)        If src Is Nothing Then Exit Function        after = AfterOpt(doc, CmdInsert)        If after < 0 Then Exit Function        cnt = doc.ImportAllPages(src, after)        Set src = Nothing        If cnt <= 0 Then CmdInsert = Fail("No se pudieron insertar las paginas"): Exit Function        CmdInsert = SaveDoc(doc, m_Pos(2), CStr(cnt) & " pagina(s) insertada(s)")    End Function    Private Function CmdReplace() As Long        Dim doc As PdfDocument, src As PdfDocument, idx() As Long, n As Long, cnt As Long        If Not NeedPos(3, "replace <in.pdf> <out.pdf> --from otro.pdf --pages R") Then CmdReplace = CLI_USAGE: Exit Function        If Len(Opt("from")) = 0 Then CmdReplace = Fail("Falta --from archivo.pdf", CLI_USAGE): Exit Function        Set doc = OpenDoc(m_Pos(1), CmdReplace)        If doc Is Nothing Then Exit Function        Set src = OpenDoc(Opt("from"), CmdReplace)        If src Is Nothing Then Exit Function        n = PagesOpt(doc, "pages", "", idx, CmdReplace)        If n <= 0 Then Exit Function        SortIndices idx, n        cnt = doc.ReplacePages(idx, n, src)        Set src = Nothing        If cnt <= 0 Then CmdReplace = Fail("No se pudieron reemplazar las paginas"): Exit Function        CmdReplace = SaveDoc(doc, m_Pos(2), CStr(cnt) & " pagina(s) reemplazada(s)")    End Function    Private Function CmdCrop() As Long        Dim doc As PdfDocument, idx() As Long, n As Long, k As Long, ok As Long        Dim L As Double, T As Double, R As Double, B As Double, w As Double, h As Double, units As String        If Not NeedPos(3, "crop <in.pdf> <out.pdf> --pages R (--rect L,T,R,B | --auto)") Then CmdCrop = CLI_USAGE: Exit Function        If Not HasOpt("auto") Then            If Not ParseRect(Opt("rect"), L, T, R, B) Then CmdCrop = Fail("Use --rect L,T,R,B o --auto", CLI_USAGE): Exit Function        End If        Set doc = OpenDoc(m_Pos(1), CmdCrop)        If doc Is Nothing Then Exit Function        n = PagesOpt(doc, "pages", "all", idx, CmdCrop)        If n <= 0 Then Exit Function        units = Opt("units", "pt")        For k = 0 To n - 1            If HasOpt("auto") Then                If doc.CropToContent(idx(k), Val(Opt("margin", "8"))) Then ok = ok + 1            Else                w = doc.PageWidth(idx(k))                h = doc.PageHeight(idx(k))                If doc.CropPageFraction(idx(k), ToPoints(L, units, w) / w, ToPoints(T, units, h) / h, ToPoints(R, units, w) / w, ToPoints(B, units, h) / h) Then ok = ok + 1            End If        Next        If ok = 0 Then CmdCrop = Fail("No se recorto ninguna pagina"): Exit Function        doc.RefreshStructure        CmdCrop = SaveDoc(doc, m_Pos(2), CStr(ok) & " pagina(s) recortada(s)")    End Function    Private Function CmdMerge() As Long        Dim files() As String, k As Long, total As Long, failed As String        If Not NeedPos(4, "merge <out.pdf> <in1.pdf> <in2.pdf> ...") Then CmdMerge = CLI_USAGE: Exit Function        ReDim files(0 To m_PosCount - 3)        For k = 2 To m_PosCount - 1            files(k - 2) = m_Pos(k)        Next        total = MergeFiles(files, m_Pos(1), Opt("password"), Opt("pdfium"), failed)        If total = 0 Then            If Len(failed) > 0 Then                CmdMerge = Fail("No se pudo abrir o unir " & failed, CLI_OPEN_FAILED)            Else                CmdMerge = Fail("No se pudo crear " & m_Pos(1))            End If            Exit Function        End If        Info CStr(m_PosCount - 2) & " archivo(s), " & CStr(total) & " pagina(s) -> " & m_Pos(1)    End Function    Private Function CmdSplit() As Long        Dim doc As PdfDocument, base As String, cnt As Long        If Not NeedPos(3, "split <in.pdf> <carpeta> [--every N]") Then CmdSplit = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdSplit)        If doc Is Nothing Then Exit Function        base = Opt("name")        If Len(base) = 0 Then            base = PathFileName(m_Pos(1))            If LCase$(Right$(base, 4)) = ".pdf" Then base = Left$(base, Len(base) - 4)        End If        cnt = SplitDocument(doc, m_Pos(2), base, CLng(Val(Opt("every", "1"))))        If cnt = 0 Then CmdSplit = Fail("No se pudo dividir el documento"): Exit Function        Info CStr(cnt) & " archivo(s) en " & m_Pos(2)    End Function    Private Function CmdImage() As Long        Dim doc As PdfDocument, idx() As Long, n As Long, k As Long, fn As String, dpi As Long        If Not NeedPos(3, "image <in.pdf> <out.png> [--pages R] [--dpi 150]") Then CmdImage = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdImage)        If doc Is Nothing Then Exit Function        n = PagesOpt(doc, "pages", "1", idx, CmdImage)        If n <= 0 Then Exit Function        dpi = CLng(Val(Opt("dpi", "150")))        For k = 0 To n - 1            If n = 1 And InStr(1, m_Pos(2), "{n}", vbTextCompare) = 0 Then fn = m_Pos(2) Else fn = NumberedFileName(m_Pos(2), idx(k) + 1, doc.PageCount)            If Not RenderPageToImage(doc, idx(k), fn, dpi, CLng(Val(Opt("quality", "90")))) Then                CmdImage = Fail("No se pudo exportar la pagina " & CStr(idx(k) + 1) & " a " & fn)                Exit Function            End If            Info "Pagina " & CStr(idx(k) + 1) & " -> " & fn        Next    End Function    Private Function CmdPrint() As Long        Dim doc As PdfDocument, idx() As Long, n As Long, prn As String        If Not NeedPos(2, "print <in.pdf> [--printer nombre]") Then CmdPrint = CLI_USAGE: Exit Function        Set doc = OpenDoc(m_Pos(1), CmdPrint)        If doc Is Nothing Then Exit Function        n = PagesOpt(doc, "pages", "all", idx, CmdPrint)        If n <= 0 Then Exit Function        prn = Opt("printer")        If Len(prn) = 0 Then prn = DefaultPrinter()        If Len(prn) = 0 Then CmdPrint = Fail("No hay impresora predeterminada"): Exit Function        If Not PrintPages(doc, idx, n, prn, CLng(Val(Opt("copies", "1"))), PathFileName(m_Pos(1))) Then            CmdPrint = Fail("No se pudo imprimir en " & prn)            Exit Function        End If        Info CStr(n) & " pagina(s) enviada(s) a " & prn    End Function    ' ------------------------------------------------------------------------    '  Ayudantes de los comandos    ' ------------------------------------------------------------------------    Private Function NeedPos(ByVal Count As Long, ByVal Usage As String) As Boolean        If m_PosCount >= Count Then            NeedPos = True        Else            WriteErr "Uso: programa.exe " & Usage        End If    End Function    Private Function OpenDoc(ByVal FileName As String, ByRef Code As Long) As PdfDocument        Dim doc As PdfDocument        Set doc = New PdfDocument        If doc.OpenFile(FileName, Opt("password"), Opt("pdfium")) Then            Set OpenDoc = doc        Else            If doc.LastError = FPDF_ERR_NOLIBRARY Then                WriteErr PdfiumLoadError                Code = CLI_NO_PDFIUM            Else                WriteErr "No se pudo abrir " & FileName & ": " & doc.LastErrorText                Code = CLI_OPEN_FAILED            End If        End If    End Function    ' Paginas de la opcion Name (o Default). Devuelve cuantas; si 0 deja Code.    Private Function PagesOpt(ByVal Doc As PdfDocument, ByVal OptionName As String, ByVal Dflt As String, ByRef Idx() As Long, ByRef Code As Long) As Long        Dim spec As String, n As Long        spec = Opt(OptionName, Dflt)        If Len(spec) = 0 Then            WriteErr "Falta --" & OptionName & " (por ejemplo --" & OptionName & " 1-3,5)"            Code = CLI_USAGE            Exit Function        End If        n = ParsePageRange(spec, Doc.PageCount, Idx)        If n <= 0 Then            WriteErr "Rango de paginas no valido: " & spec & " (el documento tiene " & CStr(Doc.PageCount) & ")"            Code = CLI_USAGE            Exit Function        End If        PagesOpt = n    End Function    ' Pagina unica (base 1 en la opcion) -> indice base 0, o -1.    Private Function PageOpt(ByVal Doc As PdfDocument, ByVal OptionName As String, ByVal Dflt As Long, ByRef Code As Long) As Long        Dim idx() As Long, spec As String        spec = Opt(OptionName, IIf(Dflt > 0, CStr(Dflt), ""))        PageOpt = -1        If ParsePageRange(spec, Doc.PageCount, idx) <> 1 Then            WriteErr "Pagina no valida en --" & OptionName & ": " & spec            Code = CLI_USAGE            Exit Function        End If        PageOpt = idx(0)    End Function    ' --after N (0 = al principio) -> posicion de insercion base 0.    Private Function AfterOpt(ByVal Doc As PdfDocument, ByRef Code As Long) As Long        Dim s As String, v As Long        s = LCase$(Opt("after", "last"))        If s = "last" Or s = "ultima" Then            v = Doc.PageCount        ElseIf IsNumeric(s) Then            v = CLng(Val(s))        Else            v = -1        End If        If v < 0 Or v > Doc.PageCount Then            WriteErr "--after debe estar entre 0 y " & CStr(Doc.PageCount)            Code = CLI_USAGE            AfterOpt = -1            Exit Function        End If        AfterOpt = v    End Function    ' Angulo -> pasos de 90 grados en sentido horario (0..3), -1 si no vale.    Private Function AngleSteps(ByVal s As String) As Long        Dim a As Long        If Not IsNumeric(s) Then AngleSteps = -1: Exit Function        a = CLng(Val(s))        If a Mod 90 <> 0 Then AngleSteps = -1: Exit Function        AngleSteps = ((a \ 90) Mod 4 + 4) Mod 4    End Function    Private Function SaveDoc(ByVal Doc As PdfDocument, ByVal OutFile As String, ByVal Message As String) As Long        If Doc.SaveCopy(OutFile) Then            Info Message & " -> " & OutFile        Else            SaveDoc = Fail("No se pudo guardar " & OutFile)        End If    End Function    ' Texto a archivo (posicional OutIndex) o a la salida estandar.    Private Function EmitText(ByVal Text As String, ByVal OutIndex As Long) As Long        If m_PosCount > OutIndex Then            If WriteTextFile(m_Pos(OutIndex), Text, Opt("encoding", "utf8")) Then                Info CStr(Len(Text)) & " caracteres -> " & m_Pos(OutIndex)            Else                EmitText = Fail("No se pudo escribir " & m_Pos(OutIndex))            End If        Else            WriteOut Text        End If    End Function    Private Function Fail(ByVal Message As String, Optional ByVal Code As Long = CLI_FAILED) As Long        WriteErr Message        Fail = Code    End Function    ' ------------------------------------------------------------------------    '  Argumentos    ' ------------------------------------------------------------------------    ' Divide la linea con las reglas de Windows (comillas incluidas) y separa    ' posicionales y opciones (--nombre valor, --nombre=valor o -n valor).    Private Sub ParseArgs(ByVal pCmdLine As LongPtr, ByVal SkipFirst As Boolean)        Dim argv As LongPtr, n As Long, i As Long, p As LongPtr, a As String, optName As String, eq As Long        Dim args() As String, cnt As Long        m_PosCount = 0        m_OptCount = 0        Erase m_Pos        Erase m_OptName        Erase m_OptValue        argv = CommandLineToArgvW(pCmdLine, n)        If argv = 0 Then Exit Sub        If n > 0 Then ReDim args(0 To n - 1)        For i = 0 To n - 1            CopyMemory p, ByVal (argv + i * LenB(p)), LenB(p)            args(i) = String$(lstrlenW(p), vbNullChar)            If Len(args(i)) > 0 Then CopyMemory ByVal StrPtr(args(i)), ByVal p, Len(args(i)) * 2        Next        LocalFree argv        i = IIf(SkipFirst, 1, 0)        Do While i < n            a = args(i)            If (Left$(a, 2) = "--" And Len(a) > 2) Or (Left$(a, 1) = "-" And Len(a) = 2 And Not IsNumeric(a)) Then                optName = LCase$(Mid$(a, IIf(Left$(a, 2) = "--", 3, 2)))                eq = InStr(1, optName, "=")                If eq > 0 Then                    AddOpt Left$(optName, eq - 1), Mid$(a, Len(a) - (Len(optName) - eq) + 1)                ElseIf InStr(1, FLAG_OPTIONS, "|" & optName & "|") > 0 Then                    AddOpt optName, "1"                ElseIf i + 1 < n Then                    AddOpt optName, args(i + 1)                    i = i + 1                Else                    AddOpt optName, ""                End If            Else                ReDim Preserve m_Pos(0 To m_PosCount)                m_Pos(m_PosCount) = a                m_PosCount = m_PosCount + 1            End If            i = i + 1        Loop    End Sub    Private Sub AddOpt(ByVal OptionName As String, ByVal Value As String)        ReDim Preserve m_OptName(0 To m_OptCount)        ReDim Preserve m_OptValue(0 To m_OptCount)        m_OptName(m_OptCount) = OptionName        m_OptValue(m_OptCount) = Value        m_OptCount = m_OptCount + 1    End Sub    Private Function HasOpt(ByVal OptionName As String) As Boolean        Dim k As Long        For k = 0 To m_OptCount - 1            If m_OptName(k) = OptionName Then HasOpt = True: Exit Function        Next    End Function    Private Function Opt(ByVal OptionName As String, Optional ByVal Dflt As String) As String        Dim k As Long        For k = m_OptCount - 1 To 0 Step -1            If m_OptName(k) = OptionName Then Opt = m_OptValue(k): Exit Function        Next        Opt = Dflt    End Function    ' ------------------------------------------------------------------------    '  Consola    ' ------------------------------------------------------------------------    Private Sub OpenConsole()        If m_ConsoleReady Then Exit Sub        m_ConsoleReady = True        ' Si el proceso ya tiene salida (aplicacion de consola o redireccion) se        ' usa; si no, se engancha a la consola del proceso que lo lanzo.        m_hOut = GetStdHandle(STD_OUTPUT_HANDLE)        m_hErr = GetStdHandle(STD_ERROR_HANDLE)        If m_hOut = 0 Or m_hOut = -1 Then            AttachConsole ATTACH_PARENT_PROCESS            m_hOut = GetStdHandle(STD_OUTPUT_HANDLE)            m_hErr = GetStdHandle(STD_ERROR_HANDLE)        End If    End Sub    Private Sub WriteHandle(ByVal h As LongPtr, ByVal Text As String)        Dim mode As Long, written As Long, b() As Byte, n As Long        If h = 0 Or h = -1 Or Len(Text) = 0 Then Exit Sub        If GetConsoleMode(h, mode) <> 0 Then            WriteConsoleW h, StrPtr(Text), Len(Text), written, 0        Else            ' Redirigido a archivo o tuberia: UTF-8            n = WideCharToMultiByte(CP_UTF8, 0, StrPtr(Text), Len(Text), 0, 0, 0, 0)            If n <= 0 Then Exit Sub            ReDim b(0 To n - 1)            WideCharToMultiByte CP_UTF8, 0, StrPtr(Text), Len(Text), VarPtr(b(0)), n, 0, 0            WriteFile h, VarPtr(b(0)), n, written, 0        End If    End Sub    Private Sub WriteOut(ByVal Text As String)        m_Output = m_Output & Text & vbCrLf        WriteHandle m_hOut, Text & vbCrLf    End Sub    Private Sub WriteErr(ByVal Text As String)        m_Output = m_Output & Text & vbCrLf        If m_hErr <> 0 And m_hErr <> -1 Then WriteHandle m_hErr, Text & vbCrLf Else WriteHandle m_hOut, Text & vbCrLf    End Sub    ' Mensajes informativos (se omiten con --quiet).    Private Sub Info(ByVal Text As String)        If Not m_Quiet Then WriteOut Text    End SubEnd Module