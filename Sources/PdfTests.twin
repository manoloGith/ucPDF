' ============================================================================'  PdfTests.twin'  Apartado 4 - Pruebas Win32/Win64.''  Ejecuta RunPdfTests() compilando el proyecto como Win32 y despues como'  Win64 (o llama a RunPdfTestsMain desde Sub Main). Cada prueba escribe una'  linea "OK"/"FALLO" en la ventana Inmediato y el resumen se devuelve como'  cadena. Necesita samples\sample.pdf y pdfium.dll de la arquitectura'  correspondiente en <App.Path>\x86 o <App.Path>\x64.' ============================================================================[Description("Pruebas del motor PDF para Win32 y Win64")]Module PdfTests    Private m_Passed As Long    Private m_Failed As Long    Private m_Log As String    Private Sub Check(ByVal Condition As Boolean, ByVal Name As String, Optional ByVal Detail As String)        Dim msg As String        If Condition Then            m_Passed = m_Passed + 1            msg = "OK     " & Name        Else            m_Failed = m_Failed + 1            msg = "FALLO  " & Name            If Len(Detail) > 0 Then msg = msg & "  -> " & Detail        End If        Debug.Print msg        m_Log = m_Log & msg & vbCrLf    End Sub    Public Function DefaultSamplePath() As String        Dim base As String        base = App.Path        If Right$(base, 1) <> "\" Then base = base & "\"        If FileExists(base & "samples\sample.pdf") Then            DefaultSamplePath = base & "samples\sample.pdf"        Else            DefaultSamplePath = base & "..\samples\sample.pdf"        End If    End Function    Public Function RunPdfTests(Optional ByVal SamplePath As String, Optional ByVal PdfiumPath As String) As String        Dim doc As PdfDocument, dib As PdfDib, ok As Boolean, ptrSize As Long, lp As LongPtr        Dim txt As String, x As Long, y As Long, nonWhite As Long, white As Long, px As Long        Dim tp As LongPtr, pg As LongPtr, h As LongPtr, found As Long        Dim pdfX As Double, pdfY As Double, devX As Long, devY As Long        Dim bad() As Byte, refs As Long, acquired As Boolean        m_Passed = 0        m_Failed = 0        m_Log = ""        If Len(SamplePath) = 0 Then SamplePath = DefaultSamplePath()        ' --- Arquitectura ---------------------------------------------------        ptrSize = LenB(lp)        #If Win64 Then            Check ptrSize = 8, "Arquitectura Win64: LongPtr de 8 bytes", "LenB = " & ptrSize        #Else            Check ptrSize = 4, "Arquitectura Win32: LongPtr de 4 bytes", "LenB = " & ptrSize        #End If        Check LoWordS(&HFFFE0010) = &H10, "LoWordS extrae la palabra baja"        Check HiWordS(&HFFFE0010) = -2, "HiWordS conserva el signo (delta de rueda)"        ' --- GDI+ (barra de herramientas) -----------------------------------        Check GdipAcquire(), "GDI+ se inicializa"        Check ArgbFromColorRef(&HFF&) = &HFFFF0000, "ArgbFromColorRef: rojo opaco", Hex$(ArgbFromColorRef(&HFF&))        Check ArgbFromColorRef(&HD77800, &H40) = &H400078D7, "ArgbFromColorRef: azul con alfa", Hex$(ArgbFromColorRef(&HD77800, &H40))        Set dib = New PdfDib        If dib.Create(32, 32) Then            Dim g As LongPtr, gpb As LongPtr            If GdipCreateFromHDC(dib.hDC, g) = GP_OK Then                gpb = GpBrush(&HFF0000FF)                GdipFillRectangle g, gpb, 0, 0, 32, 32                GdipDeleteBrush gpb                GdipDeleteGraphics g            End If            Check (dib.PixelAt(16, 16) And &HFFFFFF) = &HFF&, "GDI+ dibuja sobre el DIB (azul)", Hex$(dib.PixelAt(16, 16))        End If        Set dib = Nothing        GdipRelease        ' --- Carga de PDFium ------------------------------------------------        refs = PdfiumRefCount        ok = PdfiumAcquire(PdfiumPath)        Check ok, "PDFium se carga e inicializa", PdfiumLoadError        If Not ok Then GoTo Done        acquired = True        Check Len(PdfiumLoadedPath) > 0, "pdfium.dll cargada desde " & PdfiumLoadedPath        Check PdfiumRefCount = refs + 1, "Recuento de referencias tras Acquire"        ' --- Apertura -------------------------------------------------------        Set doc = New PdfDocument        ok = doc.OpenFile(SamplePath, , PdfiumPath)        Check ok, "Abrir " & SamplePath, doc.LastErrorText        If Not ok Then GoTo Done        Check doc.PageCount = 2, "Numero de paginas = 2", CStr(doc.PageCount)        Check Abs(doc.PageWidth(0) - 612) < 0.01 And Abs(doc.PageHeight(0) - 792) < 0.01, "Tamano de pagina 612 x 792 pt"        ' --- Renderizado ----------------------------------------------------        Set dib = New PdfDib        Check dib.Create(306, 396), "Crear DIB de 306 x 396"        Check doc.RenderTo(0, dib, 0, 0, 306, 396, 0, FPDF_ANNOT), "Renderizar pagina 1"        For y = 0 To dib.Height - 1 Step 2            For x = 0 To dib.Width - 1 Step 2                px = dib.PixelAt(x, y) And &HFFFFFF                If px = &HFFFFFF Then white = white + 1 Else nonWhite = nonWhite + 1            Next        Next        Check white > 0 And nonWhite > 0, "La pagina renderizada contiene fondo y contenido", "blancos=" & white & " otros=" & nonWhite        ' El rectangulo azul (0.2, 0.4, 0.8) ocupa x 72..272, y 242..392 pt        px = dib.PixelAt(86, 158)        Check ((px And &HFF&) > 150) And (((px And &HFF0000) \ &H10000) < 100), "Color del rectangulo en la posicion esperada", Hex$(px)        ' Formato de mapa de bits: con un formato erroneo (BGR de 24 bpp sobre un        ' DIB de 32 bpp) aparece una banda negra a la derecha y franjas en el color.        Check FPDFBitmap_BGRx = 3, "Constante FPDFBitmap_BGRx = 3", CStr(FPDFBitmap_BGRx)        px = dib.PixelAt(300, 158) And &HFFFFFF        Check px = &HFFFFFF, "Borde derecho de la pagina en blanco (sin banda negra)", Hex$(px)        Check (dib.PixelAt(86, 158) And &HFFFFFF) = (dib.PixelAt(87, 158) And &HFFFFFF) And _              (dib.PixelAt(87, 158) And &HFFFFFF) = (dib.PixelAt(88, 158) And &HFFFFFF), _              "Relleno azul uniforme (sin franjas verticales)", Hex$(dib.PixelAt(86, 158)) & " " & Hex$(dib.PixelAt(87, 158)) & " " & Hex$(dib.PixelAt(88, 158))        ' Renderizado de un mosaico desplazado (zoom alto, solo una porcion)        Check dib.Create(100, 100), "Crear DIB de mosaico"        Check doc.RenderTo(0, dib, -400, -1300, 2448, 3168, 0, FPDF_ANNOT), "Renderizar mosaico al 400%"        px = dib.PixelAt(50, 50)        Check ((px And &HFF&) > 150) And (((px And &HFF0000) \ &H10000) < 100), "El mosaico muestra la zona correcta", Hex$(px)        ' Rotacion 90 grados: el DIB se intercambia de ancho/alto        Check dib.Create(396, 306), "Crear DIB apaisado"        Check doc.RenderTo(0, dib, 0, 0, 396, 306, 1, FPDF_ANNOT), "Renderizar con rotacion de 90 grados"        ' --- Texto ----------------------------------------------------------        txt = doc.GetText(0)        Check InStr(1, txt, "Hola ucPDF", vbBinaryCompare) > 0, "Extraer texto de la pagina 1", txt        Check doc.CharCount(0) > 20, "Recuento de caracteres", CStr(doc.CharCount(0))        Check doc.GetText(0, 5, 5) = "ucPDF", "Extraer subcadena (5, 5)", doc.GetText(0, 5, 5)        ' --- Busqueda -------------------------------------------------------        tp = doc.TextPageHandle(0)        h = FPDFText_FindStart(tp, StrPtr("UCPDF"), 0, 0)        found = -1        If FPDFText_FindNext(h) <> 0 Then found = FPDFText_GetSchResultIndex(h)        FPDFText_FindClose h        Check found = 5, "Buscar sin distinguir mayusculas", CStr(found)        h = FPDFText_FindStart(tp, StrPtr("UCPDF"), FPDF_MATCHCASE, 0)        found = -1        If FPDFText_FindNext(h) <> 0 Then found = FPDFText_GetSchResultIndex(h)        FPDFText_FindClose h        Check found = -1, "Buscar distinguiendo mayusculas no encuentra 'UCPDF'"        tp = doc.TextPageHandle(1)        h = FPDFText_FindStart(tp, StrPtr("ucPDF"), 0, 0)        found = -1        If FPDFText_FindNext(h) <> 0 Then found = FPDFText_GetSchResultIndex(h)        FPDFText_FindClose h        Check found >= 0, "Buscar en la pagina 2", CStr(found)        ' --- Coordenadas (seleccion) ---------------------------------------        pg = doc.PageHandle(0)        Check FPDF_PageToDevice(pg, 0, 0, 612, 792, 0, 100#, 700#, devX, devY) <> 0, "PageToDevice"        Check devX = 100 And devY = 92, "PageToDevice (100,700) -> (100,92)", devX & "," & devY        Check FPDF_DeviceToPage(pg, 0, 0, 612, 792, 0, devX, devY, pdfX, pdfY) <> 0, "DeviceToPage"        Check Abs(pdfX - 100) < 1 And Abs(pdfY - 700) < 1, "Ida y vuelta de coordenadas", pdfX & "," & pdfY        tp = doc.TextPageHandle(0)        found = FPDFText_GetCharIndexAtPos(tp, 80#, 710#, 5#, 5#)        Check found >= 0 And found <= 2, "Caracter bajo el cursor (inicio de 'Hola')", CStr(found)        ' --- Liberacion de paginas -----------------------------------------        doc.ReleasePagesExcept -1, -2        Check doc.GetText(1) <> "", "Recarga diferida tras liberar paginas"        ' --- Guardar copia (boton Guardar) -----------------------------------        Check PathFolder("C:\docs\a\x.pdf") = "C:\docs\a", "PathFolder"        Check PathFileName("C:\docs\a\x.pdf") = "x.pdf", "PathFileName"        Dim tmpPdf As String, doc2 As PdfDocument        tmpPdf = Environ$("TEMP") & "\ucpdf_prueba_guardar.pdf"        Check doc.SaveCopy(tmpPdf), "SaveCopy escribe " & tmpPdf        Check doc.FileName = tmpPdf, "SaveCopy actualiza FileName", doc.FileName        Set doc2 = New PdfDocument        Check doc2.OpenFile(tmpPdf, , PdfiumPath), "Abrir la copia guardada", doc2.LastErrorText        Check doc2.PageCount = doc.PageCount, "La copia tiene las mismas paginas", CStr(doc2.PageCount)        Set doc2 = Nothing        Kill tmpPdf        ' --- Organizar: mover paginas y guardar ----------------------------        Dim doc3 As PdfDocument, tmp2 As String        Set doc3 = New PdfDocument        If doc3.OpenFile(SamplePath, , PdfiumPath) Then            Check Not doc3.Edited, "Documento recien abierto sin cambios"            Check doc3.MovePage(1, 0), "MovePage(1, 0): la segunda pagina pasa a ser la primera", doc3.LastErrorText            Check InStr(1, doc3.GetText(0), "Segunda pagina") = 1, "Tras mover, la pagina 1 es la antigua 2", Left$(doc3.GetText(0), 20)            Check InStr(1, doc3.GetText(1), "Hola ucPDF") = 1, "Tras mover, la pagina 2 es la antigua 1", Left$(doc3.GetText(1), 20)            Check doc3.Edited, "El documento queda marcado como editado"            tmp2 = Environ$("TEMP") & "\ucpdf_prueba_reordenado.pdf"            Check doc3.SaveCopy(tmp2), "Guardar el PDF reordenado (FPDF_SaveAsCopy, callback CDecl)"            Set doc2 = New PdfDocument            If doc2.OpenFile(tmp2, , PdfiumPath) Then                Check InStr(1, doc2.GetText(0), "Segunda pagina") = 1, "El PDF guardado conserva el nuevo orden", Left$(doc2.GetText(0), 20)                Check doc2.PageCount = 2, "El PDF guardado tiene 2 paginas", CStr(doc2.PageCount)            Else                Check False, "Abrir el PDF reordenado", doc2.LastErrorText            End If            Set doc2 = Nothing            Kill tmp2            Check doc3.MovePage(0, 1), "MovePage(0, 1): devolver al orden original"            Check InStr(1, doc3.GetText(0), "Hola ucPDF") = 1, "Orden original restaurado"        End If        Set doc3 = Nothing        ' --- Edicion de paginas (cabecera de organizar) ----------------------        Dim ed As PdfDocument, src As PdfDocument, sel() As Long, tmp3 As String        Set ed = New PdfDocument        Set src = New PdfDocument        If ed.OpenFile(SamplePath, , PdfiumPath) And src.OpenFile(SamplePath, , PdfiumPath) Then            ReDim sel(0 To 0)            sel(0) = 0            Check ed.RotatePages(sel, 1, 1), "Girar la pagina 1 a la derecha"            Check Abs(ed.PageWidth(0) - 792) < 0.01 And Abs(ed.PageHeight(0) - 612) < 0.01, "Tras girar, la pagina 1 mide 792 x 612", ed.PageWidth(0) & " x " & ed.PageHeight(0)            Check ed.RotatePages(sel, 1, -1), "Girar la pagina 1 a la izquierda (vuelve a 612 x 792)"            Check Abs(ed.PageWidth(0) - 612) < 0.01, "Giro deshecho", CStr(ed.PageWidth(0))            Check ed.InsertBlankPage(1, 300, 400), "Insertar una pagina en blanco despues de la 1"            Check ed.PageCount = 3 And Abs(ed.PageWidth(1) - 300) < 0.01, "La pagina en blanco es la 2 (300 x 400)", ed.PageCount & " / " & ed.PageWidth(1)            Check ed.DeletePages(sel, 1) = True And ed.PageCount = 2, "Eliminar la pagina 1", CStr(ed.PageCount)            Check Abs(ed.PageWidth(0) - 300) < 0.01, "Tras eliminar, la primera es la pagina en blanco"            Check ed.ImportAllPages(src, 1) = 2, "Insertar las 2 paginas de otro PDF despues de la 1"            Check InStr(1, ed.GetText(1), "Hola ucPDF") = 1 And ed.PageCount = 4, "Paginas importadas en su sitio", ed.PageCount & " / " & Left$(ed.GetText(1), 12)            sel(0) = 0            Check ed.ReplacePages(sel, 1, src) = 1, "Reemplazar la pagina 1 por la 1 del archivo"            Check InStr(1, ed.GetText(0), "Hola ucPDF") = 1 And ed.PageCount = 4, "Pagina reemplazada sin cambiar el total", ed.PageCount & " / " & Left$(ed.GetText(0), 12)            ReDim sel(0 To 1)            sel(0) = 2            sel(1) = 3            tmp3 = Environ$("TEMP") & "\ucpdf_prueba_extraer.pdf"            Check ed.ExtractPages(sel, 2, tmp3), "Extraer las paginas 3 y 4 a un documento nuevo"            Set doc2 = New PdfDocument            If doc2.OpenFile(tmp3, , PdfiumPath) Then                Check doc2.PageCount = 2 And InStr(1, doc2.GetText(1), "Segunda") = 1, "El documento extraido tiene las 2 paginas", doc2.PageCount & " / " & Left$(doc2.GetText(1), 12)            Else                Check False, "Abrir el documento extraido", doc2.LastErrorText            End If            Set doc2 = Nothing            Kill tmp3            Check ed.CropToContent(0, 8), "Recortar margenes en blanco de la pagina 1"            ed.RefreshStructure            Check ed.PageWidth(0) < 612 And ed.PageHeight(0) < 792, "La pagina recortada es mas pequena", ed.PageWidth(0) & " x " & ed.PageHeight(0)            Check InStr(1, ed.GetText(0), "Hola ucPDF") = 1, "El texto sigue presente tras recortar"        End If        Set ed = Nothing        Set src = Nothing        ' --- Errores --------------------------------------------------------        ReDim bad(0 To 15)        ok = doc.OpenBytes(bad)        Check Not ok And doc.LastError = FPDF_ERR_FORMAT, "Datos no PDF -> FPDF_ERR_FORMAT", CStr(doc.LastError)        ok = doc.OpenFile(SamplePath & ".noexiste")        Check Not ok And doc.LastError = FPDF_ERR_FILE, "Archivo inexistente -> FPDF_ERR_FILE", CStr(doc.LastError)        Set doc = Nothing        Set dib = Nothing    Done:        Set doc = Nothing        Set dib = Nothing        If acquired Then PdfiumRelease        Check PdfiumRefCount = refs, "Recuento de referencias restaurado", CStr(PdfiumRefCount)        m_Log = m_Log & vbCrLf & "Plataforma: " & IIf(LenB(lp) = 8, "Win64", "Win32") & _                "   Correctas: " & m_Passed & "   Fallidas: " & m_Failed & vbCrLf        Debug.Print "Correctas: " & m_Passed & "   Fallidas: " & m_Failed        RunPdfTests = m_Log    End Function    Public Property Get TestsFailed() As Long        TestsFailed = m_Failed    End Property    ' Punto de entrada opcional (Sub Main) para ejecutar las pruebas como EXE.    Public Sub RunPdfTestsMain()        Dim r As String        r = RunPdfTests()        MsgBox r, IIf(m_Failed = 0, vbInformation, vbExclamation), "ucPDF - pruebas " & PdfiumArchFolder()    End SubEnd Module