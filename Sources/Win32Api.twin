' ============================================================================'  Win32Api.twin'  Declaraciones Win32 (user32, gdi32, kernel32, comctl32, msimg32, comdlg32)'  y utilidades compartidas por el control ucPDF.'  Todas las declaraciones son PtrSafe y validas para Win32 y Win64.' ============================================================================[Description("Declaraciones Win32 y utilidades del control ucPDF")]Module Win32Api    ' --- Estructuras ---------------------------------------------------------    Public Type RECT        Left As Long        Top As Long        Right As Long        Bottom As Long    End Type    Public Type POINTAPI        X As Long        Y As Long    End Type    Public Type BITMAPINFOHEADER        biSize As Long        biWidth As Long        biHeight As Long        biPlanes As Integer        biBitCount As Integer        biCompression As Long        biSizeImage As Long        biXPelsPerMeter As Long        biYPelsPerMeter As Long        biClrUsed As Long        biClrImportant As Long    End Type    Public Type SCROLLINFO        cbSize As Long        fMask As Long        nMin As Long        nMax As Long        nPage As Long        nPos As Long        nTrackPos As Long    End Type    Public Type PAINTSTRUCT        hdc As LongPtr        fErase As Long        rcPaint As RECT        fRestore As Long        fIncUpdate As Long        rgbReserved(0 To 31) As Byte    End Type    Public Type TRACKMOUSEEVENTSTRUCT        cbSize As Long        dwFlags As Long        hwndTrack As LongPtr        dwHoverTime As Long    End Type    ' OPENFILENAMEW: en Win32 todos los campos son de 4 bytes (empaquetado = natural);    ' en Win64 la alineacion natural del UDT coincide con la de Windows.    Public Type OPENFILENAMEW        lStructSize As Long        hwndOwner As LongPtr        hInstance As LongPtr        lpstrFilter As LongPtr        lpstrCustomFilter As LongPtr        nMaxCustFilter As Long        nFilterIndex As Long        lpstrFile As LongPtr        nMaxFile As Long        lpstrFileTitle As LongPtr        nMaxFileTitle As Long        lpstrInitialDir As LongPtr        lpstrTitle As LongPtr        Flags As Long        nFileOffset As Integer        nFileExtension As Integer        lpstrDefExt As LongPtr        lCustData As LongPtr        lpfnHook As LongPtr        lpTemplateName As LongPtr        pvReserved As LongPtr        dwReserved As Long        FlagsEx As Long    End Type    Public Type DOCINFOW        cbSize As Long        lpszDocName As LongPtr        lpszOutput As LongPtr        lpszDatatype As LongPtr        fwType As Long    End Type    ' --- Mensajes -----------------------------------------------------------    Public Const WM_SETFOCUS As Long = &H7    Public Const WM_KILLFOCUS As Long = &H8    Public Const WM_SIZE As Long = &H5    Public Const WM_PAINT As Long = &HF    Public Const WM_ERASEBKGND As Long = &H14    Public Const WM_SETCURSOR As Long = &H20    Public Const WM_NCDESTROY As Long = &H82    Public Const WM_GETDLGCODE As Long = &H87    Public Const WM_KEYDOWN As Long = &H100    Public Const WM_HSCROLL As Long = &H114    Public Const WM_VSCROLL As Long = &H115    Public Const WM_MOUSEMOVE As Long = &H200    Public Const WM_LBUTTONDOWN As Long = &H201    Public Const WM_LBUTTONUP As Long = &H202    Public Const WM_LBUTTONDBLCLK As Long = &H203    Public Const WM_RBUTTONDOWN As Long = &H204    Public Const WM_MBUTTONDOWN As Long = &H207    Public Const WM_MBUTTONUP As Long = &H208    Public Const WM_MOUSEWHEEL As Long = &H20A    Public Const WM_MOUSEHWHEEL As Long = &H20E    Public Const WM_CAPTURECHANGED As Long = &H215    Public Const WM_DPICHANGED_AFTERPARENT As Long = &H2E3    Public Const DLGC_WANTARROWS As Long = &H1    Public Const DLGC_WANTCHARS As Long = &H80    Public Const HTCLIENT As Long = 1    Public Const MK_SHIFT As Long = &H4    Public Const MK_CONTROL As Long = &H8    ' --- Barras de desplazamiento -------------------------------------------    Public Const SB_HORZ As Long = 0    Public Const SB_VERT As Long = 1    Public Const SB_LINEUP As Long = 0    Public Const SB_LINEDOWN As Long = 1    Public Const SB_PAGEUP As Long = 2    Public Const SB_PAGEDOWN As Long = 3    Public Const SB_THUMBPOSITION As Long = 4    Public Const SB_THUMBTRACK As Long = 5    Public Const SB_TOP As Long = 6    Public Const SB_BOTTOM As Long = 7    Public Const SIF_RANGE As Long = &H1    Public Const SIF_PAGE As Long = &H2    Public Const SIF_POS As Long = &H4    Public Const SIF_TRACKPOS As Long = &H10    Public Const SIF_ALL As Long = &H17    ' --- Teclas virtuales ---------------------------------------------------    Public Const VK_SHIFT As Long = &H10    Public Const VK_CONTROL As Long = &H11    Public Const VK_PRIOR As Long = &H21    Public Const VK_NEXT As Long = &H22    Public Const VK_END As Long = &H23    Public Const VK_HOME As Long = &H24    Public Const VK_LEFT As Long = &H25    Public Const VK_UP As Long = &H26    Public Const VK_RIGHT As Long = &H27    Public Const VK_DOWN As Long = &H28    Public Const VK_ADD As Long = &H6B    Public Const VK_SUBTRACT As Long = &H6D    Public Const VK_F3 As Long = &H72    Public Const VK_OEM_PLUS As Long = &HBB    Public Const VK_OEM_MINUS As Long = &HBD    ' --- Cursores -----------------------------------------------------------    Public Const IDC_ARROW As Long = 32512    Public Const IDC_IBEAM As Long = 32513    Public Const IDC_HAND As Long = 32649    Public Const IDC_SIZEALL As Long = 32646    Public Const IDC_CROSS As Long = 32515    Public Const IDC_SIZENWSE As Long = 32642    Public Const IDC_SIZENESW As Long = 32643    Public Const IDC_SIZEWE As Long = 32644    Public Const IDC_SIZENS As Long = 32645    ' --- GDI ----------------------------------------------------------------    Public Const BI_RGB As Long = 0    Public Const DIB_RGB_COLORS As Long = 0    Public Const SRCCOPY As Long = &HCC0020    Public Const HALFTONE As Long = 4    Public Const TRANSPARENT As Long = 1    Public Const LOGPIXELSX As Long = 88    Public Const LOGPIXELSY As Long = 90    Public Const HORZRES As Long = 8    Public Const VERTRES As Long = 10    Public Const DT_CENTER As Long = &H1    Public Const DT_VCENTER As Long = &H4    Public Const DT_SINGLELINE As Long = &H20    Public Const DT_NOPREFIX As Long = &H800    Public Const DT_END_ELLIPSIS As Long = &H8000&    Public Const COLOR_BTNFACE As Long = 15    Public Const COLOR_BTNSHADOW As Long = 16    Public Const COLOR_GRAYTEXT As Long = 17    Public Const COLOR_HIGHLIGHT As Long = 13    Public Const COLOR_APPWORKSPACE As Long = 12    ' --- Portapapeles / memoria ---------------------------------------------    Public Const CF_UNICODETEXT As Long = 13    Public Const GMEM_MOVEABLE As Long = &H2    Public Const CP_UTF8 As Long = 65001    Public Const INVALID_FILE_ATTRIBUTES As Long = -1    Public Const FILE_ATTRIBUTE_DIRECTORY As Long = &H10    ' --- kernel32 -----------------------------------------------------------    Public Declare PtrSafe Sub CopyMemory Lib "kernel32" Alias "RtlMoveMemory" (ByRef Destination As Any, ByRef Source As Any, ByVal Length As LongPtr)    Public Declare PtrSafe Function LoadLibraryW Lib "kernel32" (ByVal lpLibFileName As LongPtr) As LongPtr    Public Declare PtrSafe Function GetModuleFileNameW Lib "kernel32" (ByVal hModule As LongPtr, ByVal lpFilename As LongPtr, ByVal nSize As Long) As Long    Public Declare PtrSafe Function GetFileAttributesW Lib "kernel32" (ByVal lpFileName As LongPtr) As Long    Public Declare PtrSafe Function WideCharToMultiByte Lib "kernel32" (ByVal CodePage As Long, ByVal dwFlags As Long, ByVal lpWideCharStr As LongPtr, ByVal cchWideChar As Long, ByVal lpMultiByteStr As LongPtr, ByVal cbMultiByte As Long, ByVal lpDefaultChar As LongPtr, ByVal lpUsedDefaultChar As LongPtr) As Long    Public Declare PtrSafe Function GlobalAlloc Lib "kernel32" (ByVal uFlags As Long, ByVal dwBytes As LongPtr) As LongPtr    Public Declare PtrSafe Function GlobalLock Lib "kernel32" (ByVal hMem As LongPtr) As LongPtr    Public Declare PtrSafe Function GlobalUnlock Lib "kernel32" (ByVal hMem As LongPtr) As Long    Public Declare PtrSafe Function GlobalFree Lib "kernel32" (ByVal hMem As LongPtr) As LongPtr    Public Declare PtrSafe Function MulDiv Lib "kernel32" (ByVal nNumber As Long, ByVal nNumerator As Long, ByVal nDenominator As Long) As Long    ' --- user32 -------------------------------------------------------------    Public Declare PtrSafe Function BeginPaint Lib "user32" (ByVal hWnd As LongPtr, ByRef lpPaint As PAINTSTRUCT) As LongPtr    Public Declare PtrSafe Function EndPaint Lib "user32" (ByVal hWnd As LongPtr, ByRef lpPaint As PAINTSTRUCT) As Long    Public Declare PtrSafe Function GetClientRect Lib "user32" (ByVal hWnd As LongPtr, ByRef lpRect As RECT) As Long    Public Declare PtrSafe Function InvalidateRect Lib "user32" (ByVal hWnd As LongPtr, ByVal lpRect As LongPtr, ByVal bErase As Long) As Long    Public Declare PtrSafe Function UpdateWindow Lib "user32" (ByVal hWnd As LongPtr) As Long    Public Declare PtrSafe Function SetScrollInfo Lib "user32" (ByVal hWnd As LongPtr, ByVal nBar As Long, ByRef lpsi As SCROLLINFO, ByVal bRedraw As Long) As Long    Public Declare PtrSafe Function GetScrollInfo Lib "user32" (ByVal hWnd As LongPtr, ByVal nBar As Long, ByRef lpsi As SCROLLINFO) As Long    Public Declare PtrSafe Function ScreenToClient Lib "user32" (ByVal hWnd As LongPtr, ByRef lpPoint As POINTAPI) As Long    Public Declare PtrSafe Function GetCursorPos Lib "user32" (ByRef lpPoint As POINTAPI) As Long    Public Declare PtrSafe Function SetCapture Lib "user32" (ByVal hWnd As LongPtr) As LongPtr    Public Declare PtrSafe Function ReleaseCapture Lib "user32" () As Long    Public Declare PtrSafe Function GetCapture Lib "user32" () As LongPtr    Public Declare PtrSafe Function SetFocusAPI Lib "user32" Alias "SetFocus" (ByVal hWnd As LongPtr) As LongPtr    Public Declare PtrSafe Function LoadCursorW Lib "user32" (ByVal hInstance As LongPtr, ByVal lpCursorName As LongPtr) As LongPtr    Public Declare PtrSafe Function SetCursor Lib "user32" (ByVal hCursor As LongPtr) As LongPtr    Public Declare PtrSafe Function GetKeyState Lib "user32" (ByVal nVirtKey As Long) As Integer    Public Declare PtrSafe Function GetDpiForWindow Lib "user32" (ByVal hWnd As LongPtr) As Long    Public Declare PtrSafe Function GetDC Lib "user32" (ByVal hWnd As LongPtr) As LongPtr    Public Declare PtrSafe Function ReleaseDC Lib "user32" (ByVal hWnd As LongPtr, ByVal hdc As LongPtr) As Long    Public Declare PtrSafe Function GetSysColor Lib "user32" (ByVal nIndex As Long) As Long    Public Declare PtrSafe Function DrawTextW Lib "user32" (ByVal hdc As LongPtr, ByVal lpchText As LongPtr, ByVal cchText As Long, ByRef lprc As RECT, ByVal format As Long) As Long    Public Declare PtrSafe Function FillRect Lib "user32" (ByVal hdc As LongPtr, ByRef lprc As RECT, ByVal hbr As LongPtr) As Long    Public Declare PtrSafe Function FrameRect Lib "user32" (ByVal hdc As LongPtr, ByRef lprc As RECT, ByVal hbr As LongPtr) As Long    Public Declare PtrSafe Function OpenClipboard Lib "user32" (ByVal hWndNewOwner As LongPtr) As Long    Public Declare PtrSafe Function EmptyClipboard Lib "user32" () As Long    Public Declare PtrSafe Function SetClipboardData Lib "user32" (ByVal uFormat As Long, ByVal hMem As LongPtr) As LongPtr    Public Declare PtrSafe Function CloseClipboard Lib "user32" () As Long    ' --- Ventanas hijas (cuadro de busqueda) ------------------------------    Public Declare PtrSafe Function CreateWindowExW Lib "user32" (ByVal dwExStyle As Long, ByVal lpClassName As LongPtr, ByVal lpWindowName As LongPtr, ByVal dwStyle As Long, ByVal x As Long, ByVal y As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal hWndParent As LongPtr, ByVal hMenu As LongPtr, ByVal hInstance As LongPtr, ByVal lpParam As LongPtr) As LongPtr    Public Declare PtrSafe Function DestroyWindow Lib "user32" (ByVal hWnd As LongPtr) As Long    Public Declare PtrSafe Function MoveWindow Lib "user32" (ByVal hWnd As LongPtr, ByVal x As Long, ByVal y As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal bRepaint As Long) As Long    Public Declare PtrSafe Function ShowWindow Lib "user32" (ByVal hWnd As LongPtr, ByVal nCmdShow As Long) As Long    Public Declare PtrSafe Function EnableWindow Lib "user32" (ByVal hWnd As LongPtr, ByVal bEnable As Long) As Long    Public Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal Msg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr    Public Declare PtrSafe Function GetWindowTextW Lib "user32" (ByVal hWnd As LongPtr, ByVal lpString As LongPtr, ByVal nMaxCount As Long) As Long    Public Declare PtrSafe Function GetWindowTextLengthW Lib "user32" (ByVal hWnd As LongPtr) As Long    Public Declare PtrSafe Function SetWindowTextW Lib "user32" (ByVal hWnd As LongPtr, ByVal lpString As LongPtr) As Long    Public Declare PtrSafe Function GetFocus Lib "user32" () As LongPtr    Public Declare PtrSafe Function TrackMouseEvent Lib "user32" (ByRef lpEventTrack As TRACKMOUSEEVENTSTRUCT) As Long    Public Declare PtrSafe Function GetModuleHandleW Lib "kernel32" (ByVal lpModuleName As LongPtr) As LongPtr    #If Win64 Then        Public Declare PtrSafe Function GetWindowLongPtrW Lib "user32" (ByVal hWnd As LongPtr, ByVal nIndex As Long) As LongPtr        Public Declare PtrSafe Function SetWindowLongPtrW Lib "user32" (ByVal hWnd As LongPtr, ByVal nIndex As Long, ByVal dwNewLong As LongPtr) As LongPtr    #Else        Public Declare PtrSafe Function GetWindowLongPtrW Lib "user32" Alias "GetWindowLongW" (ByVal hWnd As LongPtr, ByVal nIndex As Long) As LongPtr        Public Declare PtrSafe Function SetWindowLongPtrW Lib "user32" Alias "SetWindowLongW" (ByVal hWnd As LongPtr, ByVal nIndex As Long, ByVal dwNewLong As LongPtr) As LongPtr    #End If    Public Const GWL_STYLE As Long = -16    Public Const WS_CHILD As Long = &H40000000    Public Const WS_VISIBLE As Long = &H10000000    Public Const WS_CLIPCHILDREN As Long = &H2000000    Public Const WS_TABSTOP As Long = &H10000    Public Const ES_AUTOHSCROLL As Long = &H80    Public Const SW_HIDE As Long = 0    Public Const SW_SHOWNA As Long = 8    Public Const WM_SETFONT As Long = &H30    Public Const WM_CHAR As Long = &H102    Public Const WM_CTLCOLOREDIT As Long = &H133    Public Const WM_CTLCOLORSTATIC As Long = &H138    Public Const WHITE_BRUSH As Long = 0    Public Const WM_MOUSELEAVE As Long = &H2A3    Public Const EM_SETSEL As Long = &HB1    Public Const EM_SETCUEBANNER As Long = &H1501    Public Const DLGC_WANTALLKEYS As Long = &H4    Public Const TME_LEAVE As Long = &H2    Public Const VK_RETURN As Long = &HD    Public Const VK_ESCAPE As Long = &H1B    ' --- comctl32 (subclasificacion) ---------------------------------------    Public Declare PtrSafe Function SetWindowSubclass Lib "comctl32" (ByVal hWnd As LongPtr, ByVal pfnSubclass As LongPtr, ByVal uIdSubclass As LongPtr, ByVal dwRefData As LongPtr) As Long    Public Declare PtrSafe Function RemoveWindowSubclass Lib "comctl32" (ByVal hWnd As LongPtr, ByVal pfnSubclass As LongPtr, ByVal uIdSubclass As LongPtr) As Long    Public Declare PtrSafe Function DefSubclassProc Lib "comctl32" (ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr    ' --- gdi32 --------------------------------------------------------------    Public Declare PtrSafe Function CreateCompatibleDC Lib "gdi32" (ByVal hdc As LongPtr) As LongPtr    Public Declare PtrSafe Function DeleteDC Lib "gdi32" (ByVal hdc As LongPtr) As Long    Public Declare PtrSafe Function CreateDIBSection Lib "gdi32" (ByVal hdc As LongPtr, ByRef pbmi As BITMAPINFOHEADER, ByVal usage As Long, ByRef ppvBits As LongPtr, ByVal hSection As LongPtr, ByVal dwOffset As Long) As LongPtr    Public Declare PtrSafe Function SelectObject Lib "gdi32" (ByVal hdc As LongPtr, ByVal hObject As LongPtr) As LongPtr    Public Declare PtrSafe Function DeleteObject Lib "gdi32" (ByVal hObject As LongPtr) As Long    Public Declare PtrSafe Function BitBlt Lib "gdi32" (ByVal hdcDest As LongPtr, ByVal xDest As Long, ByVal yDest As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal hdcSrc As LongPtr, ByVal xSrc As Long, ByVal ySrc As Long, ByVal dwRop As Long) As Long    Public Declare PtrSafe Function StretchDIBits Lib "gdi32" (ByVal hdc As LongPtr, ByVal xDest As Long, ByVal yDest As Long, ByVal DestWidth As Long, ByVal DestHeight As Long, ByVal xSrc As Long, ByVal ySrc As Long, ByVal SrcWidth As Long, ByVal SrcHeight As Long, ByVal lpBits As LongPtr, ByRef lpbmi As BITMAPINFOHEADER, ByVal iUsage As Long, ByVal rop As Long) As Long    Public Declare PtrSafe Function SetStretchBltMode Lib "gdi32" (ByVal hdc As LongPtr, ByVal mode As Long) As Long    Public Declare PtrSafe Function SetBrushOrgEx Lib "gdi32" (ByVal hdc As LongPtr, ByVal x As Long, ByVal y As Long, ByVal lppt As LongPtr) As Long    Public Declare PtrSafe Function SetBkColor Lib "gdi32" (ByVal hdc As LongPtr, ByVal color As Long) As Long    Public Declare PtrSafe Function GetStockObject Lib "gdi32" (ByVal index As Long) As LongPtr    Public Declare PtrSafe Function CreateSolidBrush Lib "gdi32" (ByVal color As Long) As LongPtr    Public Declare PtrSafe Function CreateFontW Lib "gdi32" (ByVal cHeight As Long, ByVal cWidth As Long, ByVal cEscapement As Long, ByVal cOrientation As Long, ByVal cWeight As Long, ByVal bItalic As Long, ByVal bUnderline As Long, ByVal bStrikeOut As Long, ByVal iCharSet As Long, ByVal iOutPrecision As Long, ByVal iClipPrecision As Long, ByVal iQuality As Long, ByVal iPitchAndFamily As Long, ByVal pszFaceName As LongPtr) As LongPtr    Public Declare PtrSafe Function SetBkMode Lib "gdi32" (ByVal hdc As LongPtr, ByVal mode As Long) As Long    Public Declare PtrSafe Function SetTextColor Lib "gdi32" (ByVal hdc As LongPtr, ByVal color As Long) As Long    Public Declare PtrSafe Function GetDeviceCaps Lib "gdi32" (ByVal hdc As LongPtr, ByVal index As Long) As Long    Public Declare PtrSafe Function CreateDCW Lib "gdi32" (ByVal pwszDriver As LongPtr, ByVal pwszDevice As LongPtr, ByVal pszPort As LongPtr, ByVal pdm As LongPtr) As LongPtr    Public Declare PtrSafe Function GetDefaultPrinterW Lib "winspool.drv" (ByVal pszBuffer As LongPtr, ByRef pcchBuffer As Long) As Long    Public Declare PtrSafe Function StartDocW Lib "gdi32" (ByVal hdc As LongPtr, ByRef lpdi As DOCINFOW) As Long    Public Declare PtrSafe Function EndDoc Lib "gdi32" (ByVal hdc As LongPtr) As Long    Public Declare PtrSafe Function AbortDoc Lib "gdi32" (ByVal hdc As LongPtr) As Long    Public Declare PtrSafe Function StartPage Lib "gdi32" (ByVal hdc As LongPtr) As Long    Public Declare PtrSafe Function EndPage Lib "gdi32" (ByVal hdc As LongPtr) As Long    ' --- msimg32 / oleaut32 / comdlg32 --------------------------------------    ' BLENDFUNCTION se pasa por valor empaquetado en un Long (SourceConstantAlpha * &H10000).    Public Declare PtrSafe Function AlphaBlend Lib "msimg32" (ByVal hdcDest As LongPtr, ByVal xDest As Long, ByVal yDest As Long, ByVal wDest As Long, ByVal hDest As Long, ByVal hdcSrc As LongPtr, ByVal xSrc As Long, ByVal ySrc As Long, ByVal wSrc As Long, ByVal hSrc As Long, ByVal blendFunction As Long) As Long    Public Declare PtrSafe Function OleTranslateColor Lib "oleaut32" (ByVal clr As Long, ByVal hpal As LongPtr, ByRef lpcolorref As Long) As Long    Public Declare PtrSafe Function SetTimer Lib "user32" (ByVal hWnd As LongPtr, ByVal nIDEvent As LongPtr, ByVal uElapse As Long, ByVal lpTimerFunc As LongPtr) As LongPtr    Public Declare PtrSafe Function KillTimer Lib "user32" (ByVal hWnd As LongPtr, ByVal uIDEvent As LongPtr) As Long    Public Declare PtrSafe Function MessageBoxW Lib "user32" (ByVal hWnd As LongPtr, ByVal lpText As LongPtr, ByVal lpCaption As LongPtr, ByVal uType As Long) As Long    Public Declare PtrSafe Function StretchBlt Lib "gdi32" (ByVal hdcDest As LongPtr, ByVal xDest As Long, ByVal yDest As Long, ByVal wDest As Long, ByVal hDest As Long, ByVal hdcSrc As LongPtr, ByVal xSrc As Long, ByVal ySrc As Long, ByVal wSrc As Long, ByVal hSrc As Long, ByVal rop As Long) As Long    Public Const WM_CLOSE As Long = &H10    Public Const WM_QUERYENDSESSION As Long = &H11    Public Const WM_TIMER As Long = &H113    Public Const MB_YESNOCANCEL As Long = &H3    Public Const MB_ICONWARNING As Long = &H30    Public Const IDYES As Long = 6    Public Const IDNO As Long = 7    Public Const IDCANCEL As Long = 2    Public Const VK_DELETE As Long = &H2E    Public Declare PtrSafe Function GetOpenFileNameW Lib "comdlg32" (ByRef ofn As OPENFILENAMEW) As Long    Public Declare PtrSafe Function GetSaveFileNameW Lib "comdlg32" (ByRef ofn As OPENFILENAMEW) As Long    Public Declare PtrSafe Function GetAncestor Lib "user32" (ByVal hWnd As LongPtr, ByVal gaFlags As Long) As LongPtr    Public Declare PtrSafe Function CreateFileW Lib "kernel32" (ByVal lpFileName As LongPtr, ByVal dwDesiredAccess As Long, ByVal dwShareMode As Long, ByVal lpSecurityAttributes As LongPtr, ByVal dwCreationDisposition As Long, ByVal dwFlagsAndAttributes As Long, ByVal hTemplateFile As LongPtr) As LongPtr    Public Declare PtrSafe Function DeleteFileW Lib "kernel32" (ByVal lpFileName As LongPtr) As Long    Public Declare PtrSafe Function GetCurrentProcessId Lib "kernel32" () As Long    Public Declare PtrSafe Function ReadFile Lib "kernel32" (ByVal hFile As LongPtr, ByVal lpBuffer As LongPtr, ByVal nNumberOfBytesToRead As Long, ByRef lpNumberOfBytesRead As Long, ByVal lpOverlapped As LongPtr) As Long    Public Declare PtrSafe Function GetFileSize Lib "kernel32" (ByVal hFile As LongPtr, ByRef lpFileSizeHigh As Long) As Long    Public Declare PtrSafe Function GetProcessHeap Lib "kernel32" () As LongPtr    Public Declare PtrSafe Function HeapAlloc Lib "kernel32" (ByVal hHeap As LongPtr, ByVal dwFlags As Long, ByVal dwBytes As LongPtr) As LongPtr    Public Declare PtrSafe Function HeapFree Lib "kernel32" (ByVal hHeap As LongPtr, ByVal dwFlags As Long, ByVal lpMem As LongPtr) As Long    Public Const GENERIC_READ As Long = &H80000000    Public Const FILE_SHARE_READ As Long = &H1    Public Const OPEN_EXISTING As Long = 3    Public Declare PtrSafe Function WriteFile Lib "kernel32" (ByVal hFile As LongPtr, ByVal lpBuffer As LongPtr, ByVal nNumberOfBytesToWrite As Long, ByRef lpNumberOfBytesWritten As Long, ByVal lpOverlapped As LongPtr) As Long    Public Declare PtrSafe Function CloseHandle Lib "kernel32" (ByVal hObject As LongPtr) As Long    Public Const OFN_OVERWRITEPROMPT As Long = &H2    Public Const OFN_HIDEREADONLY As Long = &H4    Public Const OFN_PATHMUSTEXIST As Long = &H800    Public Const OFN_FILEMUSTEXIST As Long = &H1000    Public Const OFN_NOREADONLYRETURN As Long = &H8000&    Public Const OFN_EXPLORER As Long = &H80000    Public Const OFN_ENABLESIZING As Long = &H800000    Public Const GA_ROOT As Long = 2    Public Const GENERIC_WRITE As Long = &H40000000    Public Const CREATE_ALWAYS As Long = 2    Public Const FILE_ATTRIBUTE_NORMAL As Long = &H80    Public Declare PtrSafe Function PrintDlgW Lib "comdlg32" (ByVal lppd As LongPtr) As Long    ' ========================================================================    '  Utilidades    ' ========================================================================    Public Function IMax(ByVal a As Long, ByVal b As Long) As Long        If a > b Then IMax = a Else IMax = b    End Function    Public Function IMin(ByVal a As Long, ByVal b As Long) As Long        If a < b Then IMin = a Else IMin = b    End Function    Public Function DMax(ByVal a As Double, ByVal b As Double) As Double        If a > b Then DMax = a Else DMax = b    End Function    Public Function DMin(ByVal a As Double, ByVal b As Double) As Double        If a < b Then DMin = a Else DMin = b    End Function    ' Palabra baja con signo de un WPARAM/LPARAM (valido en 32 y 64 bits).    Public Function LoWordS(ByVal v As LongPtr) As Long        Dim w As Integer        CopyMemory w, ByVal VarPtr(v), 2        LoWordS = w    End Function    ' Palabra alta con signo de un WPARAM/LPARAM (valido en 32 y 64 bits).    Public Function HiWordS(ByVal v As LongPtr) As Long        Dim w As Integer        CopyMemory w, ByVal (VarPtr(v) + 2), 2        HiWordS = w    End Function    ' Convierte OLE_COLOR (incluidos colores de sistema) a COLORREF.    Public Function ToColorRef(ByVal OleColor As Long) As Long        Dim c As Long        If OleTranslateColor(OleColor, 0, c) <> 0 Then c = OleColor And &HFFFFFF        ToColorRef = c    End Function    ' Convierte OLE_COLOR a pixel BGRA (32 bpp) para escribir en un DIB.    Public Function ToPixel(ByVal OleColor As Long) As Long        Dim c As Long        c = ToColorRef(OleColor)        ToPixel = ((c And &HFF&) * &H10000) Or (c And &HFF00&) Or ((c \ &H10000) And &HFF&)    End Function    ' Cadena terminada en nulo codificada en UTF-8.    Public Function Utf8z(ByVal s As String) As Byte()        Dim b() As Byte, n As Long        If Len(s) = 0 Then            ReDim b(0 To 0)            Utf8z = b            Exit Function        End If        n = WideCharToMultiByte(CP_UTF8, 0, StrPtr(s), Len(s), 0, 0, 0, 0)        ReDim b(0 To n)        If n > 0 Then WideCharToMultiByte CP_UTF8, 0, StrPtr(s), Len(s), VarPtr(b(0)), n, 0, 0        Utf8z = b    End Function    ' Permite escribir textos con tildes en un fuente ASCII:    ' Txt("P&aacute;gina") -> "Pagina" con tilde.    Public Function Txt(ByVal s As String) As String        s = Replace$(s, "&aacute;", ChrW$(&HE1))        s = Replace$(s, "&eacute;", ChrW$(&HE9))        s = Replace$(s, "&iacute;", ChrW$(&HED))        s = Replace$(s, "&oacute;", ChrW$(&HF3))        s = Replace$(s, "&uacute;", ChrW$(&HFA))        s = Replace$(s, "&Uacute;", ChrW$(&HDA))        s = Replace$(s, "&ntilde;", ChrW$(&HF1))        s = Replace$(s, "&iquest;", ChrW$(&HBF))        s = Replace$(s, "&mdash;", ChrW$(&H2014))        Txt = s    End Function    Public Function FileExists(ByVal Path As String) As Boolean        Dim a As Long        If Len(Path) = 0 Then Exit Function        a = GetFileAttributesW(StrPtr(Path))        FileExists = (a <> INVALID_FILE_ATTRIBUTES) And ((a And FILE_ATTRIBUTE_DIRECTORY) = 0)    End Function    Public Function FolderExists(ByVal Path As String) As Boolean        Dim a As Long        If Len(Path) = 0 Then Exit Function        a = GetFileAttributesW(StrPtr(Path))        FolderExists = (a <> INVALID_FILE_ATTRIBUTES) And ((a And FILE_ATTRIBUTE_DIRECTORY) <> 0)    End Function    ' Carpeta de una ruta (sin barra final) y nombre de archivo.    Public Function PathFolder(ByVal Path As String) As String        Dim k As Long        k = InStrRev(Path, "\")        If k > 0 Then PathFolder = Left$(Path, k - 1)    End Function    Public Function PathFileName(ByVal Path As String) As String        Dim k As Long        k = InStrRev(Path, "\")        If k > 0 Then PathFileName = Mid$(Path, k + 1) Else PathFileName = Path    End Function    ' Escribe un bufer en disco con ruta Unicode (sobrescribe si existe).    Public Function WriteAllBytes(ByVal Path As String, ByVal pData As LongPtr, ByVal Size As Long) As Boolean        Dim h As LongPtr, written As Long        h = CreateFileW(StrPtr(Path), GENERIC_WRITE, 0, 0, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)        If h = -1 Or h = 0 Then Exit Function        If Size > 0 Then            If WriteFile(h, pData, Size, written, 0) <> 0 Then WriteAllBytes = (written = Size)        Else            WriteAllBytes = True        End If        CloseHandle h    End Function    Public Function ModulePath(ByVal hModule As LongPtr) As String        Dim buf As String, n As Long        buf = String$(1024, vbNullChar)        n = GetModuleFileNameW(hModule, StrPtr(buf), 1024)        If n > 0 Then ModulePath = Left$(buf, n)    End Function    Public Function MakeRect(ByVal l As Long, ByVal t As Long, ByVal r As Long, ByVal b As Long) As RECT        MakeRect.Left = l        MakeRect.Top = t        MakeRect.Right = r        MakeRect.Bottom = b    End Function    Public Sub FillSolid(ByVal hdc As LongPtr, ByRef rc As RECT, ByVal ColorRef As Long)        Dim hbr As LongPtr        hbr = CreateSolidBrush(ColorRef)        FillRect hdc, rc, hbr        DeleteObject hbr    End Sub    Public Sub FrameSolid(ByVal hdc As LongPtr, ByRef rc As RECT, ByVal ColorRef As Long, Optional ByVal Thickness As Long = 1)        Dim hbr As LongPtr, i As Long, r As RECT        hbr = CreateSolidBrush(ColorRef)        r = rc        For i = 1 To Thickness            FrameRect hdc, r, hbr            r.Left = r.Left + 1: r.Top = r.Top + 1: r.Right = r.Right - 1: r.Bottom = r.Bottom - 1        Next        DeleteObject hbr    End Sub    Public Function SetClipboardUnicode(ByVal hWndOwner As LongPtr, ByVal Text As String) As Boolean        Dim cb As LongPtr, hMem As LongPtr, p As LongPtr        If Len(Text) = 0 Then Exit Function        cb = (Len(Text) + 1) * 2        hMem = GlobalAlloc(GMEM_MOVEABLE, cb)        If hMem = 0 Then Exit Function        p = GlobalLock(hMem)        CopyMemory ByVal p, ByVal StrPtr(Text), cb        GlobalUnlock hMem        If OpenClipboard(hWndOwner) <> 0 Then            EmptyClipboard            If SetClipboardData(CF_UNICODETEXT, hMem) <> 0 Then                SetClipboardUnicode = True            Else                GlobalFree hMem            End If            CloseClipboard        Else            GlobalFree hMem        End If    End FunctionEnd Module